{
  "name": "llmdeepdive",
  "version": "0.3.0",
  "private": true,
  "description": "llmdeepdive.com \u2014 a free, bilingual, interactive course on large language models, from first principles to frontier research.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/content-parity.mjs && astro build && node scripts/gen-headers.mjs",
    "preview": "astro preview",
    "typecheck": "astro check --minimumSeverity error",
    "lint": "ast-grep scan",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "bench": "node scripts/bench.mjs",
    "check": "node scripts/check.mjs",
    "content:parity": "node scripts/content-parity.mjs",
    "content:stubs": "node scripts/content-stubs.mjs",
    "content:graph": "node scripts/content-graph.mjs",
    "content:citations": "node scripts/content-citations.mjs",
    "content:assets": "node scripts/assets-exist.mjs",
    "budget": "node scripts/bundle-budget.mjs",
    "a11y:contrast": "node scripts/a11y-contrast.mjs",
    "cf": "node node_modules/wrangler/bin/wrangler.js",
    "deploy:staging": "node node_modules/wrangler/bin/wrangler.js deploy --env staging",
    "deploy:production": "node node_modules/wrangler/bin/wrangler.js deploy --env production"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/sitemap": "3.7.3",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/three": "0.185.3",
    "astro": "7.1.6",
    "astro-pagefind": "2.0.1",
    "katex": "^0.18.1",
    "pagefind": "1.5.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "unist-util-visit": "^5.1.0",
    "wrangler": "4.118.0"
  }
}
