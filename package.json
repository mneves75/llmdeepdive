{
  "name": "llmdeepdive",
  "version": "0.8.0",
  "private": true,
  "description": "llmdeepdive.com — a free, bilingual, interactive course on large language models, from first principles to efficient inference.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/content-parity.mjs && astro build && node scripts/finalize-dist.mjs && node scripts/gen-headers.mjs && node scripts/link-integrity.mjs",
    "preview": "astro preview",
    "typecheck": "astro check --minimumSeverity error",
    "lint": "ast-grep scan",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.mjs\"",
    "bench": "node scripts/bench.mjs",
    "links": "node scripts/link-integrity.mjs",
    "content:parity": "node scripts/content-parity.mjs",
    "content:stubs": "node scripts/content-stubs.mjs",
    "content:graph": "node scripts/content-graph.mjs",
    "content:citations": "node scripts/content-citations.mjs",
    "content:assets": "node scripts/assets-exist.mjs",
    "budget": "node scripts/bundle-budget.mjs",
    "a11y:contrast": "node scripts/a11y-contrast.mjs",
    "privacy": "node scripts/private-refs.mjs",
    "cf": "node node_modules/wrangler/bin/wrangler.js",
    "deploy:staging": "node node_modules/wrangler/bin/wrangler.js deploy --env staging",
    "deploy:production": "node node_modules/wrangler/bin/wrangler.js deploy --env production",
    "content:figures": "node scripts/content-figures.mjs",
    "render:check": "node scripts/render-check.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.0",
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-condensed": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/three": "0.185.3",
    "astro": "7.2.8",
    "astro-pagefind": "2.0.1",
    "katex": "^0.18.1",
    "pagefind": "1.5.2",
    "playwright": "1.63.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "satori": "0.33.5",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "^5.1.0",
    "wrangler": "4.131.0"
  }
}
