{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llmdeepdive",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-02",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Array form, NOT `true`. Assets are matched before the Worker by default,
    // so with this scoped to /api/* an HTML/CSS/font request never starts an
    // isolate. `true` would invoke the Worker for every asset — billable and
    // slower. This is the whole performance argument for the architecture.
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "llmdeepdive",
      "database_id": "5cff656a-2247-4c6b-b241-c99ea52c3b44",
      "migrations_dir": "migrations/d1"
    }
  ],

  // Named environments do NOT inherit `vars`, `assets`, or any binding from the
  // top level. Each env below re-declares everything; a staging deploy that
  // omits them goes up broken and silent.
  "env": {
    "staging": {
      "name": "llmdeepdive-staging",
      "vars": { "APP_BASE_URL": "https://llmdeepdive-staging.mvneves.workers.dev" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "llmdeepdive-staging",
          "database_id": "0322d8f8-f554-4236-9bd3-40518bbe06d0",
          "migrations_dir": "migrations/d1"
        }
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*"]
      },
      "observability": { "enabled": true, "head_sampling_rate": 1 }
    },
    "production": {
      "name": "llmdeepdive",
      "vars": { "APP_BASE_URL": "https://llmdeepdive.com" },
      // custom_domain provisions the DNS record and certificate for the apex.
      "routes": [
        { "pattern": "llmdeepdive.com", "custom_domain": true },
        { "pattern": "www.llmdeepdive.com", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "llmdeepdive",
          "database_id": "5cff656a-2247-4c6b-b241-c99ea52c3b44",
          "migrations_dir": "migrations/d1"
        }
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*"]
      },
      "observability": { "enabled": true, "head_sampling_rate": 1 }
    }
  }
}
