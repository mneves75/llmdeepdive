{
  "permissions": {
    "ask": [
      "Edit(./wrangler.jsonc)",
      "Bash(pnpm deploy:production*)",
      "Bash(pnpm run deploy:production*)",
      "Bash(pnpm cf deploy*)",
      "Bash(pnpm run cf deploy*)",
      "Bash(wrangler deploy*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" stop -- 'pnpm typecheck && pnpm lint && pnpm test'",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
