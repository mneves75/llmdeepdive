---
/**
 * `not_found_handling: "404-page"` in wrangler.jsonc serves the nearest
 * `404.html` walking up from the requested path. Without this file that setting
 * resolved to nothing and every bad URL returned a zero-byte body — verified
 * against production before this page existed.
 *
 * `/pt-br/404.astro` is the sibling that covers the Portuguese subtree.
 */
import Base from '~/layouts/Base.astro'
---

<Base
  title="Page not found — llmdeepdive"
  description="That page does not exist. Start from the tracks, the anatomy explorer, or the first lesson."
  locale="en"
  path="/404"
  marker="notfound-en"
  noindex
>
  <section class="notfound">
    <h1><span class="code" aria-hidden="true">404</span>That page does not exist</h1>
    <p class="measure">
      The link may be out of date, or the lesson may have been renamed. Everything
      in the course is reachable from these three places.
    </p>
    <ul class="routes">
      <li><a href="/tracks/">All tracks</a><span>The full course, in order</span></li>
      <li><a href="/explore/">Anatomy explorer</a><span>Take a transformer apart</span></li>
      <li>
        <a href="/lessons/0-orientation-and-foundations/0.1-what-is-a-language-model/">Start at lesson 0.1</a>
        <span>What is a language model?</span>
      </li>
    </ul>
  </section>

  <style>
    .notfound { max-width: 48rem; margin-inline: auto; padding: var(--space-3xl) var(--space-lg); }
    h1 { margin-block-end: var(--space-md); font-size: clamp(var(--text-3xl), 7vw, var(--text-4xl)); text-transform: uppercase; }
    .code { display: block; margin-bottom: var(--space-sm); color: var(--coral); font: var(--weight-semibold) var(--text-lg) var(--font-data); letter-spacing: 0; }
    .measure { color: var(--ink-muted); font-size: var(--text-lg); }
    .routes { margin: var(--space-xl) 0 0; padding: 0; list-style: none; border-bottom: 1px solid var(--rule-strong); }
    .routes li { position: relative; display: grid; gap: var(--space-3xs); padding: var(--space-md) 0; border-top: 1px solid var(--rule-strong); }
    .routes a { font: var(--weight-bold) var(--text-xl) var(--font-display); text-decoration: none; }
    /* The whole row answers the click, not just its words. */
    .routes a::after { content: ''; position: absolute; inset: 0; }
    .routes li:hover a { color: var(--accent); }
    .routes span { color: var(--ink-muted); font: var(--text-sm) var(--font-ui); }
  </style>
</Base>
