---
import Base from '~/layouts/Base.astro'
import Explorer from '~/components/explorer/Explorer.astro'
import { brandTitle, breadcrumbNode, exploreCard } from '~/lib/seo'
---

<Base
  title={brandTitle('Anatomy of an LLM: interactive 3D transformer')}
  description="Rotate a transformer, click into any component, and see the maths, the failure modes, and where it sits in the stack."
  locale="en"
  path="/explore/"
  marker="explore-en-anatomy"
  imageAlt={exploreCard('en').alt}
  structuredData={[breadcrumbNode('en', [{ name: 'Anatomy of an LLM', path: '/explore/' }])]}
>
  <section class="intro">
    <div class="intro__title">
      <h1>Anatomy<br />of an LLM</h1>
    </div>
    <div class="intro__brief">
      <p class="measure">
        One decoder block, built as an instrument. Follow a token from the base
        to the crown at the top, or select any of the twelve ports to examine
        its maths, failure modes and place in the stack.
      </p>
      <p class="intro__instruction">Drag to rotate · arrow keys move between ports</p>
    </div>
  </section>
  <Explorer locale="en" />
  <style>
    .intro {
      display: grid;
      grid-template-columns: minmax(16rem, 0.85fr) minmax(20rem, 1.15fr);
      gap: var(--space-xl);
      align-items: end;
      max-width: var(--shell-max);
      margin-inline: auto;
      padding: var(--space-xl) var(--space-lg) var(--space-lg);
    }
    h1 {
      margin: 0;
      max-width: 10ch;
      font: var(--weight-black) clamp(var(--text-3xl), 5.4vw, var(--text-5xl)) / 0.9 var(--font-display);
      font-stretch: var(--stretch-normal);
      letter-spacing: var(--tracking-tight);
      text-wrap: balance;
      overflow-wrap: break-word;
    }
    .intro__brief { display: grid; gap: var(--space-sm); max-width: 42rem; padding-block-end: var(--space-3xs); }
    .measure { margin: 0; color: var(--ink-muted); font-size: var(--text-lg); line-height: var(--leading-normal); text-wrap: pretty; }
    .intro__instruction {
      margin: 0;
      padding-block-start: var(--space-xs);
      border-block-start: 1px solid var(--rule);
      color: var(--ink-muted);
      font: var(--weight-medium) var(--text-xs) / var(--leading-snug) var(--font-display);
    }
    @media (max-width: 48rem) {
      .intro { grid-template-columns: minmax(0, 1fr); gap: var(--space-sm); padding: var(--space-md) var(--space-sm) var(--space-sm); }
      h1 { max-width: none; font-size: clamp(var(--text-3xl), 13vw, var(--text-5xl)); }
      .intro__brief { padding-block-end: 0; }
      .measure { font-size: var(--text-base); }
    }
  </style>
</Base>
