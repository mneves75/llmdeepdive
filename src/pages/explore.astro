---
import Base from '~/layouts/Base.astro'
import Explorer from '~/components/explorer/Explorer.astro'
---

<Base
  title="Anatomy of an LLM — llmdeepdive"
  description="Rotate a transformer, click into any component, and see the maths, the failure modes, and where it sits in the stack."
  locale="en"
  path="/explore/"
  marker="explore-en-anatomy"
>
  <section class="intro">
    <p class="eyebrow">The anatomy explorer</p>
    <h1>Anatomy of an LLM</h1>
    <p class="measure">
      A transformer block, drawn to scale and taken apart. Click any marker to
      open a component — or use the arrow keys.
    </p>
  </section>
  <Explorer locale="en" />
  <style>
    .intro { max-width: var(--shell-max); margin-inline: auto; padding: var(--space-xl) var(--space-lg) var(--space-md); }
    h1 { font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl)); margin-block: var(--space-2xs) var(--space-xs); }
    .measure { color: var(--ink-muted); }
  </style>
</Base>
