---
import Base from '~/layouts/Base.astro'
import Explorer from '~/components/explorer/Explorer.astro'
---

<Base
  title="Anatomy of an LLM — llmdeepdive"
  description="Rotate a transformer, click into any component, and see the maths, the failure modes, and where it sits in the stack."
  locale="en"
  path="/explore/"
  marker="explore-en-anatomy"
>
  <section class="intro">
    <div class="intro__title">
      <p class="eyebrow">The anatomy explorer · Interactive 3D specimen</p>
      <h1>Anatomy<br />of an LLM</h1>
    </div>
    <div class="intro__brief">
      <p class="measure">
        Rotate an exploded transformer block. Select any marker to examine its
        maths, failure modes, and place in the stack.
      </p>
      <p class="intro__instruction">Drag to rotate · Arrow keys move between markers</p>
    </div>
  </section>
  <Explorer locale="en" />
  <style>
    .intro {
      display: grid;
      grid-template-columns: minmax(16rem, 0.85fr) minmax(20rem, 1.15fr);
      gap: var(--space-xl);
      align-items: end;
      max-width: var(--shell-max);
      margin-inline: auto;
      padding: var(--space-lg) var(--space-lg) var(--space-md);
      border-block-start: 1px solid var(--rule);
    }
    .intro__title { display: grid; gap: var(--space-xs); }
    .intro .eyebrow { color: var(--accent); }
    h1 {
      max-width: 9ch;
      font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
      line-height: 0.88;
      text-transform: uppercase;
    }
    .intro__brief { display: grid; gap: var(--space-sm); max-width: 42rem; padding-block-end: var(--space-2xs); }
    .measure { margin: 0; color: var(--ink-muted); font-size: var(--text-lg); }
    .intro__instruction {
      margin: 0;
      padding-block-start: var(--space-xs);
      border-block-start: 1px solid var(--rule);
      color: var(--ink-faint);
      font-family: var(--font-data);
      font-size: var(--text-3xs);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
    }
    @media (max-width: 48rem) {
      .intro { grid-template-columns: 1fr; gap: var(--space-md); padding: var(--space-md) var(--space-sm); }
      h1 { max-width: none; font-size: clamp(var(--text-3xl), 15vw, var(--text-5xl)); }
      .intro__brief { padding-block-end: 0; }
    }
  </style>
</Base>
