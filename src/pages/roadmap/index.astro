---
import { getCollection } from 'astro:content'
import Base from '~/layouts/Base.astro'
import RoadmapPage from '~/components/RoadmapPage.astro'
import type { LessonEntry } from '~/lib/content'
import { ui } from '~/lib/i18n'
import { brandTitle, breadcrumbNode, roadmapCard } from '~/lib/seo'

const allLessons: LessonEntry[] = await getCollection('lessons')
const lessons = allLessons.filter((lesson) => lesson.data.locale === 'en')
---

<Base
  title={brandTitle('AI Engineering Roadmap & 100-Day Path')}
  description="Sixteen-level AI engineering roadmap, 100-day accelerated study path, portfolio proof rubric and production defense drills mapped to llmdeepdive lessons."
  locale="en"
  path="/roadmap/"
  marker="roadmap-en"
  imageAlt={roadmapCard('en').alt}
  structuredData={[breadcrumbNode('en', [{ name: ui.en.roadmap, path: '/roadmap/' }])]}
>
  <RoadmapPage locale="en" {lessons} />
</Base>
