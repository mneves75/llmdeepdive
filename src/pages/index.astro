---
import Base from '~/layouts/Base.astro'
---

<Base
  title="llmdeepdive — how language models actually work"
  description="A free, open-source course on large language models: from what a parameter is, to running a 2.8-trillion-parameter model on 8 GB of RAM."
  locale="en"
  path="/"
  marker="home-en-hero"
>
  <section class="hero">
    <p class="eyebrow">A free course · English &amp; Português</p>
    <h1>How language models<br />actually work.</h1>
    <p class="lede measure">
      From “what is a parameter?” to streaming a 2.8-trillion-parameter model off a
      disk on an 8&nbsp;GB laptop. Every claim cited, every lab computing real
      numbers, nothing behind a login.
    </p>
    <p class="aside-hand">Start anywhere. Understand everything.</p>
  </section>

  <style>
    .hero {
      max-width: var(--shell-max);
      margin-inline: auto;
      padding: var(--space-3xl) var(--space-lg) var(--space-2xl);
    }

    h1 {
      font-size: clamp(var(--text-3xl), 7vw, var(--text-5xl));
      margin-block: var(--space-sm) var(--space-md);
    }

    .lede {
      font-size: var(--text-lg);
      color: var(--ink-muted);
      line-height: var(--leading-relaxed);
    }

    .aside-hand {
      margin-top: var(--space-lg);
    }
  </style>
</Base>
