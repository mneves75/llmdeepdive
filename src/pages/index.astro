---
import { getCollection } from 'astro:content'
import Base from '~/layouts/Base.astro'
import Home from '~/components/Home.astro'
import type { LessonEntry, TrackEntry } from '~/lib/content'
import { brandTitle, homeCard, websiteNode } from '~/lib/seo'

// Counted from the corpus so the description cannot drift from what shipped.
const lessons: LessonEntry[] = await getCollection('lessons')
const tracks: TrackEntry[] = await getCollection('tracks')
const lessonCount = lessons.filter((lesson) => lesson.data.locale === 'en').length
const trackCount = tracks.filter((track) => track.data.locale === 'en').length
---

<Base
  title={brandTitle('How LLMs actually work: free bilingual course')}
  description={`A free, open-source bilingual course on large language models: ${lessonCount} complete lessons per language across ${trackCount} tracks, from foundations to the silicon that runs them.`}
  locale="en"
  path="/"
  marker="home-en-hero"
  imageAlt={homeCard('en', { tracks: trackCount, lessons: lessonCount }).alt}
  structuredData={[websiteNode]}
>
  <Home locale="en" />
</Base>
