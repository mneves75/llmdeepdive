---
import { getCollection } from 'astro:content'
import Base from '~/layouts/Base.astro'
import Home from '~/components/Home.astro'
import type { LessonEntry, TrackEntry } from '~/lib/content'

// Contado a partir do corpus para a descrição nunca divergir do que foi publicado.
const lessons: LessonEntry[] = await getCollection('lessons')
const tracks: TrackEntry[] = await getCollection('tracks')
const lessonCount = lessons.filter((lesson) => lesson.data.locale === 'pt-br').length
const trackCount = tracks.filter((track) => track.data.locale === 'pt-br').length
---

<Base
  title="llmdeepdive — como os modelos de linguagem realmente funcionam"
  description={`Um curso bilíngue, livre e de código aberto sobre modelos de linguagem: ${lessonCount} aulas completas em cada idioma, em ${trackCount} tracks, dos fundamentos ao silício que os executa.`}
  locale="pt-br"
  path="/"
  marker="home-ptbr-hero"
>
  <Home locale="pt-br" />
</Base>
