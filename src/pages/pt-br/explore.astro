---
import Base from '~/layouts/Base.astro'
import Explorer from '~/components/explorer/Explorer.astro'
import { brandTitle, breadcrumbNode, exploreCard } from '~/lib/seo'
---

<Base
  title={brandTitle('Anatomia de um LLM: transformer 3D interativo')}
  description="Gire um transformer, clique em qualquer componente e veja a matemática, os modos de falha e onde ele se encaixa na pilha."
  locale="pt-br"
  path="/explore/"
  marker="explore-ptbr-anatomia"
  imageAlt={exploreCard('pt-br').alt}
  structuredData={[breadcrumbNode('pt-br', [{ name: 'Anatomia de um LLM', path: '/explore/' }])]}
>
  <section class="intro">
    <div class="intro__title">
      <h1>Anatomia<br />de um LLM</h1>
    </div>
    <div class="intro__brief">
      <p class="measure">
        Um bloco decodificador construído como um instrumento. Acompanhe um
        token da base até a coroa, no topo, ou selecione qualquer uma das doze
        portas para examinar a matemática, os modos de falha e o lugar dela na
        pilha.
      </p>
      <p class="intro__instruction">Arraste para girar · as setas percorrem as portas</p>
    </div>
  </section>
  <Explorer locale="pt-br" />
  <style>
    .intro {
      display: grid;
      grid-template-columns: minmax(16rem, 0.85fr) minmax(20rem, 1.15fr);
      gap: var(--space-xl);
      align-items: end;
      max-width: var(--shell-max);
      margin-inline: auto;
      padding: var(--space-xl) var(--space-lg) var(--space-lg);
    }
    h1 {
      margin: 0;
      max-width: 10ch;
      font: var(--weight-black) clamp(var(--text-3xl), 5.4vw, var(--text-5xl)) / 0.9 var(--font-display);
      font-stretch: var(--stretch-condensed);
      letter-spacing: var(--tracking-tight);
      text-wrap: balance;
      overflow-wrap: break-word;
    }
    .intro__brief { display: grid; gap: var(--space-sm); max-width: 42rem; padding-block-end: var(--space-3xs); }
    .measure { margin: 0; color: var(--ink-muted); font-size: var(--text-lg); line-height: var(--leading-normal); text-wrap: pretty; }
    .intro__instruction {
      margin: 0;
      padding-block-start: var(--space-xs);
      border-block-start: 1px solid var(--rule);
      color: var(--ink-muted);
      font: var(--weight-medium) var(--text-xs) / var(--leading-snug) var(--font-display);
    }
    @media (max-width: 48rem) {
      .intro { grid-template-columns: minmax(0, 1fr); gap: var(--space-sm); padding: var(--space-md) var(--space-sm) var(--space-sm); }
      h1 { max-width: none; font-size: clamp(var(--text-3xl), 13vw, var(--text-5xl)); }
      .intro__brief { padding-block-end: 0; }
      .measure { font-size: var(--text-base); }
    }
  </style>
</Base>
