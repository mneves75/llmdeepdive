---
import Base from '~/layouts/Base.astro'
import Explorer from '~/components/explorer/Explorer.astro'
---

<Base
  title="Anatomia de um LLM — llmdeepdive"
  description="Gire um transformer, clique em qualquer componente e veja a matemática, os modos de falha e onde ele se encaixa na pilha."
  locale="pt-br"
  path="/explore/"
  marker="explore-ptbr-anatomia"
>
  <section class="intro">
    <p class="eyebrow">O explorador de anatomia</p>
    <h1>Anatomia de um LLM</h1>
    <p class="measure">
      Um bloco transformer, desenhado em escala e desmontado. Clique num marcador
      para abrir um componente — ou use as setas do teclado.
    </p>
  </section>
  <Explorer locale="pt-br" />
  <style>
    .intro { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: var(--space-xl); align-items: end; max-width: var(--shell-max); margin-inline: auto; padding: var(--space-2xl) var(--space-lg) var(--space-xl); }
    .intro .eyebrow { grid-column: 1 / -1; color: var(--accent); }
    h1 { max-width: 12ch; font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl)); text-transform: uppercase; }
    .measure { margin: 0; color: var(--ink-muted); font-size: var(--text-lg); }
    @media (max-width: 48rem) { .intro { grid-template-columns: 1fr; padding-inline: var(--space-sm); } .intro .eyebrow { grid-column: auto; } }
  </style>
</Base>
