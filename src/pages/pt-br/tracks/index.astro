---
import { getCollection } from 'astro:content'
import Base from '~/layouts/Base.astro'
import TrackListing from '~/components/TrackListing.astro'
import type { LessonEntry, TrackEntry } from '~/lib/content'
import { ui } from '~/lib/i18n'
import { brandTitle, breadcrumbNode, tracksCard } from '~/lib/seo'

const allTracks: TrackEntry[] = await getCollection('tracks')
const allLessons: LessonEntry[] = await getCollection('lessons')
const tracks = allTracks.filter((track) => track.data.locale === 'pt-br')
const lessons = allLessons.filter((lesson) => lesson.data.locale === 'pt-br')
tracks.sort((left, right) => left.data.order - right.data.order)
---

<Base
  title={brandTitle('Trilhas de aprendizagem: o currículo completo de LLMs')}
  description="Explore o currículo do llmdeepdive por trilha, dos fundamentos à inferência avançada."
  locale="pt-br"
  path="/tracks/"
  marker="tracks-ptbr-index"
  imageAlt={tracksCard('pt-br', { tracks: tracks.length, lessons: lessons.length }).alt}
  structuredData={[breadcrumbNode('pt-br', [{ name: ui['pt-br'].tracks, path: '/tracks/' }])]}
>
  <div class="track-index">
    <h1>Trilhas de aprendizagem</h1>
    <p class="lede">Um caminho conectado dos primeiros princípios aos sistemas modernos de modelos de linguagem.</p>
    <TrackListing locale="pt-br" {tracks} {lessons} linkedTitles />
  </div>
</Base>

<style>
  .track-index { max-width: 78rem; margin-inline: auto; padding: var(--space-3xl) var(--space-lg); }
  h1 { max-width: 12ch; margin-block: 0 var(--space-md); font-size: clamp(var(--text-3xl), 7vw, var(--text-5xl)); hyphens: auto; text-transform: uppercase; }
  .lede { max-width: var(--measure); color: var(--ink-muted); font-size: var(--text-lg); margin-bottom: var(--space-2xl); }
  @media (max-width: 42rem) { .track-index { padding: var(--space-2xl) var(--space-sm); } }
</style>
