---
import { getCollection } from 'astro:content'
import Base from '~/layouts/Base.astro'
import TrackListing from '~/components/TrackListing.astro'
import type { LessonEntry, TrackEntry } from '~/lib/content'

const allTracks: TrackEntry[] = await getCollection('tracks')
const allLessons: LessonEntry[] = await getCollection('lessons')
const tracks = allTracks.filter((track) => track.data.locale === 'pt-br')
const lessons = allLessons.filter((lesson) => lesson.data.locale === 'pt-br')
tracks.sort((left, right) => left.data.order - right.data.order)
---

<Base
  title="Trilhas de aprendizagem — llmdeepdive"
  description="Explore o currículo do llmdeepdive por trilha, dos fundamentos à inferência avançada."
  locale="pt-br"
  path="/tracks/"
  marker="tracks-ptbr-index"
>
  <div class="track-index">
    <p class="eyebrow">Currículo</p>
    <h1>Trilhas de aprendizagem</h1>
    <p class="lede">Um caminho conectado dos primeiros princípios aos sistemas modernos de modelos de linguagem.</p>
    <TrackListing locale="pt-br" {tracks} {lessons} linkedTitles />
  </div>
</Base>

<style>
  .track-index { max-width: 70rem; margin-inline: auto; padding: var(--space-2xl) var(--space-lg); }
  h1 { font-size: clamp(var(--text-3xl), 7vw, var(--text-5xl)); }
  .lede { max-width: var(--measure); color: var(--ink-muted); font-size: var(--text-lg); margin-bottom: var(--space-xl); }
</style>
