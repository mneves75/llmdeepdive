---
import { getCollection } from 'astro:content'
import Base from '~/layouts/Base.astro'
import TracksIndex from '~/components/TracksIndex.astro'
import type { LessonEntry, TrackEntry } from '~/lib/content'
import { ui } from '~/lib/i18n'
import { brandTitle, breadcrumbNode, tracksCard } from '~/lib/seo'

const allTracks: TrackEntry[] = await getCollection('tracks')
const allLessons: LessonEntry[] = await getCollection('lessons')
const tracks = allTracks.filter((track) => track.data.locale === 'pt-br')
const lessons = allLessons.filter((lesson) => lesson.data.locale === 'pt-br')
tracks.sort((left, right) => left.data.order - right.data.order)
---

<Base
  title={brandTitle('Trilhas de aprendizagem: currículo de LLMs')}
  description="Explore o currículo do llmdeepdive por trilha, dos fundamentos à inferência avançada."
  locale="pt-br"
  path="/tracks/"
  marker="tracks-ptbr-index"
  imageAlt={tracksCard('pt-br', { tracks: tracks.length, lessons: lessons.length }).alt}
  structuredData={[breadcrumbNode('pt-br', [{ name: ui['pt-br'].tracks, path: '/tracks/' }])]}
>
  <TracksIndex locale="pt-br" {tracks} {lessons} />
</Base>

