---
import { getCollection } from 'astro:content'
import Base from '~/layouts/Base.astro'
import TrackPage from '~/components/TrackPage.astro'
import type { LessonEntry, TrackEntry } from '~/lib/content'
import { ui } from '~/lib/i18n'
import { brandTitle, breadcrumbNode, trackCard } from '~/lib/seo'

export async function getStaticPaths() {
  const allTracks: TrackEntry[] = await getCollection('tracks')
  const allLessons: LessonEntry[] = await getCollection('lessons')
  const tracks = allTracks.filter((track) => track.data.locale === 'pt-br')
  const lessons = allLessons.filter((lesson) => lesson.data.locale === 'pt-br')
  const ordered = [...tracks].sort((left, right) => left.data.order - right.data.order)
  return ordered.map((track, index) => ({
    params: { track: track.data.id },
    props: { track, lessons: lessons.filter((lesson) => lesson.data.track === track.data.id), nextTrack: ordered[index + 1] },
  }))
}

interface Props {
  track: TrackEntry
  lessons: LessonEntry[]
  nextTrack?: TrackEntry
}

const { track, lessons, nextTrack } = Astro.props
const path = `/tracks/${track.data.id}/`
---

<Base
  title={brandTitle(`${track.data.title} · curso de LLM`)}
  description={track.data.summary}
  locale="pt-br"
  path={path}
  marker={`track-ptbr-${track.data.id}`}
  imageAlt={trackCard('pt-br', { track: track.data, lessons: lessons.length }).alt}
  structuredData={[breadcrumbNode('pt-br', [{ name: ui['pt-br'].tracks, path: '/tracks/' }, { name: track.data.title, path }])]}
>
  <TrackPage locale="pt-br" {track} {lessons} {nextTrack} />
</Base>

