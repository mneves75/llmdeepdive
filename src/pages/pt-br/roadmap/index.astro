---
import { getCollection } from 'astro:content'
import Base from '~/layouts/Base.astro'
import RoadmapPage from '~/components/RoadmapPage.astro'
import type { LessonEntry } from '~/lib/content'
import { ui } from '~/lib/i18n'
import { brandTitle, breadcrumbNode, roadmapCard } from '~/lib/seo'

const allLessons: LessonEntry[] = await getCollection('lessons')
const lessons = allLessons.filter((lesson) => lesson.data.locale === 'pt-br')
---

<Base
  title={brandTitle('Roteiro de Engenharia de IA e 100 Dias')}
  description="Roteiro de 16 níveis em engenharia de IA, trilha acelerada de 100 dias, rubrica de portfólio e simulações de defesa ligados às aulas do llmdeepdive."
  locale="pt-br"
  path="/roadmap/"
  marker="roadmap-pt-br"
  imageAlt={roadmapCard('pt-br').alt}
  structuredData={[breadcrumbNode('pt-br', [{ name: ui['pt-br'].roadmap, path: '/roadmap/' }])]}
>
  <RoadmapPage locale="pt-br" {lessons} />
</Base>
