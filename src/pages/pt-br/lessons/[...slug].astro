---
import { getCollection, render } from 'astro:content'
import Lesson from '~/layouts/Lesson.astro'
import Figure from '~/components/Figure.astro'
import { sortLessons, trackOf, type LessonEntry, type TrackEntry } from '~/lib/content'

export async function getStaticPaths() {
  const allLessons: LessonEntry[] = await getCollection('lessons')
  const allTracks: TrackEntry[] = await getCollection('tracks')
  const lessons = allLessons.filter((lesson) => lesson.data.locale === 'pt-br')
  const tracks = allTracks.filter((track) => track.data.locale === 'pt-br')
  const ordered = sortLessons(lessons, tracks)
  return ordered.map((lesson, index) => ({
    params: { slug: `${lesson.data.track}/${lesson.data.id}` },
    props: {
      lesson,
      track: trackOf(lesson, tracks),
      previous: index > 0 ? ordered[index - 1] : undefined,
      next: index + 1 < ordered.length ? ordered[index + 1] : undefined,
      prerequisites: ordered.filter((candidate) => lesson.data.prerequisites.includes(candidate.data.id)),
    },
  }))
}

interface Props {
  lesson: LessonEntry
  track: TrackEntry
  previous?: LessonEntry
  next?: LessonEntry
  prerequisites: LessonEntry[]
}

const { lesson, track, previous, next, prerequisites } = Astro.props
const { Content, headings } = await render(lesson)
---

<Lesson {lesson} {track} {previous} {next} {prerequisites} {headings}>
  <Content components={{ Figure }} />
</Lesson>
