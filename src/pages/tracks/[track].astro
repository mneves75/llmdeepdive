---
import { getCollection } from 'astro:content'
import Base from '~/layouts/Base.astro'
import TrackListing from '~/components/TrackListing.astro'
import type { LessonEntry, TrackEntry } from '~/lib/content'

export async function getStaticPaths() {
  const allTracks: TrackEntry[] = await getCollection('tracks')
  const allLessons: LessonEntry[] = await getCollection('lessons')
  const tracks = allTracks.filter((track) => track.data.locale === 'en')
  const lessons = allLessons.filter((lesson) => lesson.data.locale === 'en')
  return tracks.map((track) => ({
    params: { track: track.data.id },
    props: { track, lessons: lessons.filter((lesson) => lesson.data.track === track.data.id) },
  }))
}

interface Props {
  track: TrackEntry
  lessons: LessonEntry[]
}

const { track, lessons } = Astro.props
---

<Base
  title={`${track.data.title} — llmdeepdive`}
  description={track.data.summary}
  locale="en"
  path={`/tracks/${track.data.id}/`}
  marker={`track-en-${track.data.id}`}
>
  <div class="track-page">
    <p class="eyebrow">Learning track</p>
    <h1>{track.data.title}</h1>
    <p class="lede">{track.data.summary}</p>
    <TrackListing locale="en" tracks={[track]} {lessons} />
  </div>
</Base>

<style>
  .track-page { max-width: 70rem; margin-inline: auto; padding: var(--space-2xl) var(--space-lg); }
  h1 { font-size: clamp(var(--text-3xl), 7vw, var(--text-5xl)); }
  .lede { max-width: var(--measure); color: var(--ink-muted); font-size: var(--text-lg); margin-bottom: var(--space-xl); }
</style>
