---
import { getCollection } from 'astro:content'
import Base from '~/layouts/Base.astro'
import TrackListing from '~/components/TrackListing.astro'
import type { LessonEntry, TrackEntry } from '~/lib/content'
import { ui } from '~/lib/i18n'
import { brandTitle, breadcrumbNode, trackCard } from '~/lib/seo'

export async function getStaticPaths() {
  const allTracks: TrackEntry[] = await getCollection('tracks')
  const allLessons: LessonEntry[] = await getCollection('lessons')
  const tracks = allTracks.filter((track) => track.data.locale === 'en')
  const lessons = allLessons.filter((lesson) => lesson.data.locale === 'en')
  return tracks.map((track) => ({
    params: { track: track.data.id },
    props: { track, lessons: lessons.filter((lesson) => lesson.data.track === track.data.id) },
  }))
}

interface Props {
  track: TrackEntry
  lessons: LessonEntry[]
}

const { track, lessons } = Astro.props
const path = `/tracks/${track.data.id}/`
---

<Base
  title={brandTitle(`${track.data.title} · LLM course`)}
  description={track.data.summary}
  locale="en"
  path={path}
  marker={`track-en-${track.data.id}`}
  imageAlt={trackCard('en', { track: track.data, lessons: lessons.length }).alt}
  structuredData={[breadcrumbNode('en', [{ name: ui.en.tracks, path: '/tracks/' }, { name: track.data.title, path }])]}
>
  <div class="track-page">
    <a class="back" href="/tracks/"><span aria-hidden="true">←</span> All tracks</a>
    <h1>{track.data.title}</h1>
    <p class="lede">{track.data.summary}</p>
    <TrackListing locale="en" tracks={[track]} {lessons} />
  </div>
</Base>

<style>
  .track-page { max-width: 78rem; margin-inline: auto; padding: var(--space-3xl) var(--space-lg); }
  .back { display: inline-flex; align-items: center; gap: var(--space-2xs); min-height: 2.75rem; color: var(--ink-muted); font: var(--weight-semibold) var(--text-sm) var(--font-ui); text-decoration: none; }
  .back:hover { color: var(--accent); }
  h1 { max-width: 13ch; margin-block: var(--space-md); font-size: clamp(var(--text-3xl), 7vw, var(--text-5xl)); hyphens: auto; overflow-wrap: anywhere; text-transform: uppercase; }
  .lede { max-width: var(--measure); color: var(--ink-muted); font-size: var(--text-lg); margin-bottom: var(--space-2xl); }
  @media (max-width: 42rem) { .track-page { padding: var(--space-2xl) var(--space-sm); } }
</style>
