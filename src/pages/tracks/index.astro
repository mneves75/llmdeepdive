---
import { getCollection } from 'astro:content'
import Base from '~/layouts/Base.astro'
import TrackListing from '~/components/TrackListing.astro'
import type { LessonEntry, TrackEntry } from '~/lib/content'
import { ui } from '~/lib/i18n'
import { brandTitle, breadcrumbNode, tracksCard } from '~/lib/seo'

const allTracks: TrackEntry[] = await getCollection('tracks')
const allLessons: LessonEntry[] = await getCollection('lessons')
const tracks = allTracks.filter((track) => track.data.locale === 'en')
const lessons = allLessons.filter((lesson) => lesson.data.locale === 'en')
tracks.sort((left, right) => left.data.order - right.data.order)
---

<Base
  title={brandTitle('Learning tracks: the full LLM curriculum')}
  description="Browse the llmdeepdive curriculum by track, from foundations through advanced inference."
  locale="en"
  path="/tracks/"
  marker="tracks-en-index"
  imageAlt={tracksCard('en', { tracks: tracks.length, lessons: lessons.length }).alt}
  structuredData={[breadcrumbNode('en', [{ name: ui.en.tracks, path: '/tracks/' }])]}
>
  <div class="track-index">
    <h1>Learning tracks</h1>
    <p class="lede">A connected path from first principles to modern language-model systems.</p>
    <TrackListing locale="en" {tracks} {lessons} linkedTitles />
  </div>
</Base>

<style>
  .track-index { max-width: 78rem; margin-inline: auto; padding: var(--space-3xl) var(--space-lg); }
  h1 { max-width: 12ch; margin-block: 0 var(--space-md); font-size: clamp(var(--text-3xl), 7vw, var(--text-5xl)); hyphens: auto; text-transform: uppercase; }
  .lede { max-width: var(--measure); color: var(--ink-muted); font-size: var(--text-lg); margin-bottom: var(--space-2xl); }
  @media (max-width: 42rem) { .track-index { padding: var(--space-2xl) var(--space-sm); } }
</style>
