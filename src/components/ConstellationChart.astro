---
/**
 * One track drawn as a constellation, in the sky's own coordinates.
 *
 * Lines are SVG geometry; stars, numbers and the reticle are HTML laid over it
 * at percentage positions, because an SVG child can carry neither a link nor
 * a view-transition name, and a label in SVG does not wrap. The same star
 * keeps the same transition name on the track page and in its lesson header,
 * so following a lesson flies its star from the chart into the plate.
 *
 * The chart is a picture of the list beside it: hidden from assistive tech and
 * out of the tab order, while still clickable. The list is the accessible path.
 */
import { lessonPath, type LessonEntry } from '~/lib/content'
import { positionOf, type Locale } from '~/lib/i18n'
import { constellationPath, constellationViewBox } from '~/lib/sky'
import { chartTransitionName, getSky, starTransitionName } from '~/lib/sky-data'

interface Props {
  locale: Locale
  trackId: string
  lessons: LessonEntry[]
  /** The lesson being read; draws the reticle on its star. */
  hereId?: string
  /** `mini`: a catalog thumbnail; draws itself as it scrolls into view. */
  variant: 'track' | 'here' | 'mini'
}

const { locale, trackId, lessons, hereId, variant } = Astro.props
const sky = await getSky(locale)
const constellation = sky.constellations.find((item) => item.id === trackId)
if (!constellation) throw new Error(`ConstellationChart: no constellation for ${locale}/${trackId}`)
const viewBox = constellationViewBox(constellation, variant === 'track' ? 30 : 24)
const [vx, vy, vw, vh] = viewBox.split(' ').map(Number) as [number, number, number, number]
const percent = (value: number, origin: number, span: number): string => `${(((value - origin) / span) * 100).toFixed(3)}%`
const byId = new Map(lessons.map((lesson) => [lesson.data.id, lesson]))

// The graticule: the sky's own coordinate lines that fall inside this frame,
// every 40 units, so every chart on the site shares one grid.
const STEP = 40
const meridians: number[] = []
for (let x = Math.ceil(vx / STEP) * STEP; x <= vx + vw; x += STEP) meridians.push(x)
const parallels: number[] = []
for (let y = Math.ceil(vy / STEP) * STEP; y <= vy + vh; y += STEP) parallels.push(y)
---

<figure
  class={`constellation constellation--${variant}`}
  data-tier={constellation.tier}
  data-here-chart={variant === 'here' ? '' : undefined}
  data-pagefind-ignore
  aria-hidden="true"
  style={`--aspect: ${vw} / ${vh}; --line: ${(vw / 380).toFixed(3)}; view-transition-name: ${chartTransitionName(trackId)}`}
>
  <svg class="constellation__lines" viewBox={viewBox} preserveAspectRatio="none" focusable="false">
    <g class="constellation__grid">
      {meridians.map((x) => <line x1={x} x2={x} y1={vy} y2={vy + vh} />)}
      {parallels.map((y) => <line x1={vx} x2={vx + vw} y1={y} y2={y} />)}
    </g>
    <path class="constellation__path" d={constellationPath(constellation)} pathLength="1" />
  </svg>
  {constellation.stars.map((star, index) => {
    const lesson = byId.get(star.id)
    const here = star.id === hereId
    const style = `left: ${percent(star.x, vx, vw)}; top: ${percent(star.y, vy, vh)}; --r: ${star.r}; --i: ${index}; view-transition-name: ${starTransitionName(star.id)}`
    return lesson ? (
      <a
        class="constellation__star"
        href={lessonPath(locale, lesson)}
        tabindex="-1"
        style={style}
        data-lesson-key={`${locale}:${star.id}`}
        data-here-star={here ? '' : undefined}
        aria-current={here ? 'page' : undefined}
      >
        <span class="constellation__dot"></span>
        <span class="constellation__number">{positionOf(star.id)}</span>
      </a>
    ) : null
  })}
  {(() => {
    const here = constellation.stars.find((star) => star.id === hereId)
    return here ? <span class="reticle constellation__reticle" style={`left: ${percent(here.x, vx, vw)}; top: ${percent(here.y, vy, vh)}`}></span> : null
  })()}
</figure>

<style>
  .constellation {
    position: relative;
    aspect-ratio: var(--aspect);
    width: 100%;
    margin: 0;
    color: var(--ink);
  }
  .constellation__lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .constellation__grid line { stroke: var(--grid); stroke-width: 1; stroke-dasharray: 1 3; vector-effect: non-scaling-stroke; }
  /* No non-scaling stroke here: with it, Chromium measures the pathLength="1"
     dash in screen space and a scaled-up chart draws only part of its line.
     The width is set in the chart's own units instead (--line ≈ 1px at 380px). */
  .constellation__path { fill: none; stroke: var(--tier); stroke-width: calc(var(--line) * 1.5); stroke-linejoin: round; opacity: 0.85; stroke-dasharray: 1; }

  .constellation__star {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.75rem;
    aspect-ratio: 1;
    translate: -50% -50%;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .constellation__dot {
    width: calc(0.4rem + var(--r) * 0.14rem);
    aspect-ratio: 1;
    border: 1.5px solid var(--tier);
    border-radius: 50%;
    background: var(--plate);
    transition: scale var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);
  }
  .constellation__star[data-complete='true'] .constellation__dot { background: var(--tier); }
  .constellation__star:hover .constellation__dot { scale: 1.45; }
  .constellation__number {
    position: absolute;
    top: 72%;
    left: 50%;
    translate: -50% 0;
    font: var(--weight-medium) var(--text-3xs) var(--font-data);
    white-space: nowrap;
    opacity: 0.85;
  }
  .constellation__star:hover .constellation__number { color: var(--ink); opacity: 1; }
  .constellation__star[aria-current='page'] .constellation__number { color: var(--reticle); font-weight: var(--weight-bold); opacity: 1; }
  .constellation__reticle { width: 2.4rem; }

  /* The here plate is small: numbers would crowd it. Only the current one shows. */
  .constellation--here .constellation__number { display: none; }
  .constellation--here .constellation__star[aria-current='page'] .constellation__number { display: block; top: 92%; }
  .constellation--here .constellation__dot,
  .constellation--mini .constellation__dot { width: calc(0.3rem + var(--r) * 0.1rem); }
  .constellation--mini .constellation__number { display: none; }
  .constellation--mini .constellation__star { width: 1.25rem; pointer-events: none; }

  @media (prefers-reduced-motion: no-preference) {
    /* Arriving on a track, the constellation draws itself in course order. */
    .constellation--track .constellation__path { animation: draw-line 1.4s var(--ease-in-out) 0.15s both; }
    .constellation--track .constellation__dot { animation: ignite var(--dur-slow) var(--ease-out) both; animation-delay: calc(0.2s + min(var(--i), 20) * 60ms); }
    /* In the catalog, each figure draws itself as it scrolls into view. */
    @supports (animation-timeline: view()) {
      .constellation--mini .constellation__path { animation: draw-line linear both; animation-timeline: view(); animation-range: entry 10% cover 40%; }
    }
    /* In a lesson the star has just flown in; the reticle then locks on. */
    .constellation__reticle { animation: lock-on 0.7s var(--ease-out) 0.35s both; }
  }
  @keyframes lock-on {
    from { opacity: 0; scale: 2.2; rotate: -45deg; }
    to { opacity: 1; scale: 1; rotate: 0deg; }
  }
</style>
