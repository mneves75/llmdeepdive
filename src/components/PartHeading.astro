---
/**
 * A lesson section title. The sequence is information here — how far through
 * the lesson's loop a section sits — so it rides inside the heading, hidden
 * from assistive tech because the rail already announces the order.
 */
interface Props { id: string; index: string; total: string }
const { id, index, total } = Astro.props
---

<h2 class="part-heading" id={id}><span class="part-index" aria-hidden="true">{index}<i>/{total}</i></span><slot /></h2>
