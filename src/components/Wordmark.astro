---
interface Props {
  href: string
  label: string
}
const { href, label } = Astro.props
---

<a class="wordmark" href={href} aria-label={label}>
  <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false" fill="none">
    <rect width="40" height="40" rx="4" fill="currentColor"/>
    <g class="wordmark__dial" stroke="var(--plate)" stroke-width="1.6">
      <circle cx="20" cy="20" r="11"/>
      <path d="M20 4v8m0 16v8M4 20h8m16 0h8"/>
    </g>
    <path fill="var(--plate)" d="m20 13 2 5 5 2-5 2-2 5-2-5-5-2 5-2Z"/>
  </svg>
  <span>llm<b>deepdive</b></span>
</a>

<style>
  .wordmark { display: inline-flex; align-items: center; gap: .55em; width: fit-content; max-width: 100%; min-height: 2.75rem; color: var(--ink); font: 470 1.42rem/1 var(--font-display); letter-spacing: -.065em; text-decoration: none; }
  .wordmark b { font-weight: 830; }
  .wordmark svg { width: 1.4em; height: 1.4em; flex: none; color: var(--reticle); }
  .wordmark__dial { transform-origin: center; transition: rotate var(--dur-slow) var(--ease-out); }
  .wordmark:is(:hover,:focus-visible) .wordmark__dial { rotate: 90deg; }
</style>
