---
/** Every track: the whole sky, then each constellation's lessons. Both locales. */
import TrackListing from '~/components/TrackListing.astro'
import SkyChart from '~/components/SkyChart.astro'
import type { LessonEntry, TrackEntry } from '~/lib/content'
import { partLabels, type Locale } from '~/lib/i18n'

interface Props { locale: Locale; tracks: TrackEntry[]; lessons: LessonEntry[] }
const { locale, tracks, lessons } = Astro.props
const parts = [...new Set(tracks.map((track) => track.data.part))]
const copy = locale === 'pt-br'
  ? {
      title: 'Trilhas de aprendizagem',
      lede: 'Dos fundamentos dos modelos de linguagem à construção de agentes e à engenharia de IA em produção.',
      tracks: 'trilhas',
      lessons: 'aulas',
      jump: 'Ir para uma parte',
      sky: 'O currículo como mapa do céu',
    }
  : {
      title: 'Learning tracks',
      lede: 'From the foundations of language models through building agents and running AI systems in production.',
      tracks: 'tracks',
      lessons: 'lessons',
      jump: 'Jump to a part',
      sky: 'The curriculum as a star chart',
    }
---

<div class="tracks">
  <header class="tracks__head">
    <div>
      <h1>{copy.title}</h1>
      <p>{copy.lede}</p>
    </div>
    <dl class="tracks__facts">
      <div><dt>{copy.tracks}</dt><dd>{tracks.length}</dd></div>
      <div><dt>{copy.lessons}</dt><dd>{lessons.length}</dd></div>
    </dl>
  </header>
  <nav class="tracks__jump" aria-label={copy.jump} data-pagefind-ignore>
    {parts.map((part) => <a href={`#part-${part}`}>{partLabels[locale][part].title} <span aria-hidden="true">↓</span></a>)}
  </nav>
  <details class="tracks__sky">
    <summary>{copy.sky}</summary>
    <SkyChart locale={locale} label={copy.sky} variant="index" />
  </details>
  <TrackListing locale={locale} {tracks} {lessons} detail="compact" />
</div>

<style>
  .tracks { max-width: var(--shell-max); margin-inline: auto; padding: clamp(2.5rem, 5vw, 5rem) clamp(1rem, 5vw, 4.5rem) var(--space-3xl); }
  .tracks__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.35fr); gap: var(--space-lg) var(--space-2xl); align-items: end; padding-bottom: var(--space-lg); }
  .tracks h1 { max-width: 14ch; font-size: clamp(2.5rem, 6vw, 6rem); font-weight: var(--weight-black); font-stretch: 90%; letter-spacing: -0.043em; }
  .tracks__head p { max-width: 44ch; margin: var(--space-sm) 0 0; color: var(--ink-muted); font-size: var(--text-lg); }
  .tracks__facts { display: grid; gap: 0.5rem; margin: 0; border-block: 1px solid var(--rule-strong); padding-block: var(--space-xs); }
  .tracks__facts > div { display: flex; flex-direction: row-reverse; justify-content: flex-end; align-items: baseline; gap: var(--space-xs); }
  .tracks__facts dt { color: var(--ink-muted); }
  .tracks__facts dd { min-width: 3ch; margin: 0; color: var(--reticle); font: var(--weight-black) clamp(1.45rem, 3vw, 2.65rem) / 1 var(--font-display); font-variant-numeric: tabular-nums; }
  .tracks__jump { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; border: 1px solid var(--rule-strong); background: var(--rule-strong); }
  .tracks__jump a { display: flex; justify-content: space-between; align-items: center; gap: 0.65rem; min-height: 3.25rem; padding: 0.6rem var(--space-sm); color: var(--ink); background: var(--plate-raised); font-weight: var(--weight-semibold); text-decoration: none; }
  .tracks__jump a:hover { background: var(--plate); color: var(--reticle); }
  .tracks__jump a span { color: var(--reticle); }
  .tracks__sky { margin-block: var(--space-md) var(--space-xl); padding-inline: var(--space-sm); border-inline-start: 2px solid var(--tier-core); background: var(--plate-raised); }
  .tracks__sky summary { cursor: pointer; color: var(--ink); min-height: 2.75rem; padding-block: 0.6rem; font-weight: var(--weight-semibold); }
  .tracks__sky[open] { padding-bottom: var(--space-sm); }
  @media (max-width: 52rem) {
    .tracks__head { grid-template-columns: minmax(0, 1fr); }
    .tracks__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 41rem) { .tracks__jump { grid-template-columns: minmax(0, 1fr); } }
</style>
