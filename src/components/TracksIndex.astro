---
/** Every track: the whole sky, then each constellation's lessons. Both locales. */
import TrackListing from '~/components/TrackListing.astro'
import SkyChart from '~/components/SkyChart.astro'
import type { LessonEntry, TrackEntry } from '~/lib/content'
import type { Locale } from '~/lib/i18n'

interface Props { locale: Locale; tracks: TrackEntry[]; lessons: LessonEntry[] }
const { locale, tracks, lessons } = Astro.props
const copy = locale === 'pt-br'
  ? {
      title: 'Trilhas de aprendizagem',
      lede: `Um caminho conectado dos primeiros princípios aos sistemas modernos: ${tracks.length} trilhas, ${lessons.length} aulas, cada uma uma estrela no mapa.`,
      sky: 'O currículo como mapa do céu',
    }
  : {
      title: 'Learning tracks',
      lede: `A connected path from first principles to modern systems: ${tracks.length} tracks, ${lessons.length} lessons, each one a star on the chart.`,
      sky: 'The curriculum as a star chart',
    }
---

<div class="tracks">
  <header class="tracks__head">
    <h1>{copy.title}</h1>
    <p>{copy.lede}</p>
  </header>
  <div class="tracks__sky">
    <SkyChart locale={locale} label={copy.sky} variant="index" />
  </div>
  <TrackListing locale={locale} {tracks} {lessons} detail="compact" />
</div>

<style>
  .tracks { max-width: 80rem; margin-inline: auto; padding: var(--space-2xl) clamp(var(--space-sm), 3vw, var(--space-lg)) var(--space-3xl); }
  .tracks__head { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-sm) var(--space-xl); align-items: end; }
  .tracks h1 { font-size: clamp(var(--text-3xl), 2rem + 3vw, var(--text-5xl)); font-weight: var(--weight-black); font-stretch: 92%; letter-spacing: -0.035em; hyphens: auto; }
  .tracks__head p { max-width: 40rem; margin: 0; color: var(--ink-muted); font-size: var(--text-lg); }
  .tracks__sky { margin-block: var(--space-xl) var(--space-3xl); }
  @media (max-width: 50rem) { .tracks__head { grid-template-columns: minmax(0, 1fr); } }
</style>
