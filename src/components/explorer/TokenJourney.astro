---
import type { Locale } from '~/lib/i18n'

interface Props { locale: Locale }
const pt = Astro.props.locale === 'pt-br'

const t = pt
  ? {
    legend: 'Etapas até o próximo token',
    steps: {
      prompt: { label: 'Prompt', title: 'Texto de entrada', body: 'A frase termina antes da resposta. O modelo usa esse texto para estimar o que pode vir a seguir.' },
      tokens: { label: 'Tokens', title: 'Texto vira IDs', body: 'O tokenizador divide o texto em pedaços chamados tokens. Cada token tem um ID. Um pedaço pode incluir um espaço ou só parte de uma palavra.' },
      context: { label: 'Contexto', title: 'O contexto muda os números', body: 'Cada ID vira um vetor, uma lista de números. A atenção usa os tokens anteriores para atualizar o vetor de “faz”.' },
      output: { label: 'Saída', title: 'Probabilidades para o próximo token', body: 'O vetor da última posição gera uma pontuação para cada token do vocabulário. As pontuações viram probabilidades para a escolha do próximo token.' },
    },
    next: 'Próximo token',
    tokens: ['A', ' api', 'cultora', ' faz'],
    contexts: [
      { prefix: 'A apicultora', vector: '[0,6 · −0,2 · 0,7]' },
      { prefix: 'A cozinheira', vector: '[−0,1 · 0,8 · 0,2]' },
    ],
    candidates: [' mel', ' cera', ' um'],
    others: 'Outros tokens',
    note: 'Tokenização, IDs, vetores e probabilidades ilustrativos.',
  }
  : {
    legend: 'Steps to the next token',
    steps: {
      prompt: { label: 'Prompt', title: 'Input text', body: 'The sentence ends before the answer. The model uses this text to estimate what could come next.' },
      tokens: { label: 'Tokens', title: 'Text becomes IDs', body: 'The tokenizer splits the text into pieces called tokens. Every token has an ID. A piece can include a space or just part of a word.' },
      context: { label: 'Context', title: 'Context changes the numbers', body: 'Each ID becomes a vector, a list of numbers. Attention uses earlier tokens to update the vector for “makes”.' },
      output: { label: 'Output', title: 'Probabilities for the next token', body: 'The vector at the last position produces a score for every token in the vocabulary. These scores become probabilities for choosing the next token.' },
    },
    next: 'Next token',
    tokens: ['The', ' bee', 'keeper', ' makes'],
    contexts: [
      { prefix: 'The beekeeper', vector: '[0.6 · −0.2 · 0.7]' },
      { prefix: 'The cook', vector: '[−0.1 · 0.8 · 0.2]' },
    ],
    candidates: [' honey', ' wax', ' a'],
    others: 'Other tokens',
    note: 'Illustrative tokenization, IDs, vectors and probabilities.',
  }

const prompt = t.tokens.join('')
const finalToken = t.tokens[3]
const tokenIds = [12, 47, 81, 24]
const probabilities = [66, 17, 10, 7]
---

<section class="journey" data-token-journey aria-label={t.legend}>
  <fieldset class="journey__instrument">
    <legend class="visually-hidden">{t.legend}</legend>
    <div class="journey__controls">
      {Object.entries(t.steps).map(([id, step]) => (
        <div class="journey__control">
          <input
            class="visually-hidden"
            type="radio"
            name="token-journey"
            id={`token-step-${id}`}
            aria-controls={`token-panel-${id}`}
            checked={id === 'prompt'}
          />
          <label for={`token-step-${id}`}>{step.label}</label>
        </div>
      ))}
    </div>

    <div class="journey__panels">
      <article class="journey__panel" id="token-panel-prompt" data-token-step="prompt">
        <div class="journey__copy">
          <h2>{t.steps.prompt.title}</h2>
          <p>{t.steps.prompt.body}</p>
        </div>
        <div class="journey__display">
          <p class="journey__prompt" data-token-motion>
            <span>{prompt}</span>{' '}<span class="journey__next">{t.next}</span>
          </p>
        </div>
      </article>

      <article class="journey__panel" id="token-panel-tokens" data-token-step="tokens">
        <div class="journey__copy">
          <h2>{t.steps.tokens.title}</h2>
          <p>{t.steps.tokens.body}</p>
        </div>
        <div class="journey__display">
          <ol class="journey__pieces">
            {t.tokens.map((piece, index) => (
              <li class="journey__piece" data-token-motion>
                <code>{JSON.stringify(piece)}</code>
                <span data-numeric>ID {tokenIds[index]}</span>
              </li>
            ))}
          </ol>
        </div>
      </article>

      <article class="journey__panel" id="token-panel-context" data-token-step="context">
        <div class="journey__copy">
          <h2>{t.steps.context.title}</h2>
          <p>{t.steps.context.body}</p>
        </div>
        <div class="journey__display">
          <dl class="journey__contexts">
            {t.contexts.map((row) => (
              <div class="journey__context" data-token-motion>
                <dt>{row.prefix}<strong>{finalToken}</strong></dt>
                <dd data-numeric>{row.vector}</dd>
              </div>
            ))}
          </dl>
        </div>
      </article>

      <article class="journey__panel" id="token-panel-output" data-token-step="output">
        <div class="journey__copy">
          <h2>{t.steps.output.title}</h2>
          <p>{t.steps.output.body}</p>
        </div>
        <div class="journey__display">
          <dl class="journey__distribution">
            {probabilities.map((probability, index) => (
              <div class="journey__candidate">
                <dt>{index < t.candidates.length ? <code>{JSON.stringify(t.candidates[index])}</code> : t.others}</dt>
                <dd>
                  <span class="journey__bar" style={`--probability: ${probability}%`} aria-hidden="true">
                    <span data-token-motion></span>
                  </span>
                  <span data-numeric data-token-probability>{probability}%</span>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </article>
    </div>
    <p class="journey__note">{t.note}</p>
  </fieldset>
</section>

<style>
  .journey {
    max-inline-size: var(--shell-max);
    margin: 0 auto clamp(2rem, 5vw, 4rem);
    padding-inline: var(--space-lg);
  }

  .journey__instrument {
    min-inline-size: 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    background: var(--plate-raised);
  }

  .journey__controls {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block-end: 1px solid var(--rule);
  }

  .journey__control + .journey__control { border-inline-start: 1px solid var(--rule); }

  .journey__control label {
    display: grid;
    min-block-size: 3rem;
    place-items: center;
    padding: var(--space-2xs) var(--space-3xs);
    border-block-end: 3px solid transparent;
    color: var(--ink-muted);
    font: var(--weight-bold) var(--text-sm) / 1.25 var(--font-display);
    text-align: center;
    cursor: pointer;
  }

  .journey__control label:hover { background: var(--plate); }
  .journey__control input:checked + label {
    border-block-end-color: currentColor;
    background: var(--plate);
    color: var(--accent);
  }
  .journey__control input:focus-visible + label {
    outline: 2px solid var(--focus);
    outline-offset: -4px;
  }

  .journey__panels { display: grid; }
  .journey__panel {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.55fr);
    visibility: hidden;
  }

  .journey:has(#token-step-prompt:checked) [data-token-step='prompt'],
  .journey:has(#token-step-tokens:checked) [data-token-step='tokens'],
  .journey:has(#token-step-context:checked) [data-token-step='context'],
  .journey:has(#token-step-output:checked) [data-token-step='output'] {
    visibility: visible;
    --token-arrival: token-arrival;
    --probability-fill: probability-fill;
  }

  .journey__copy {
    align-self: center;
    padding: clamp(1.1rem, 3.5vw, 3rem);
  }

  .journey__copy h2 {
    margin: 0;
    font-size: clamp(1.5rem, 1rem + 1.7vw, 3rem);
    letter-spacing: -0.043em;
    line-height: 1.03;
    text-wrap: balance;
  }

  .journey__copy p {
    max-inline-size: 36ch;
    margin: var(--space-xs) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-base);
  }

  .journey__display {
    display: grid;
    min-block-size: 16rem;
    place-items: center;
    padding: clamp(1rem, 3.5vw, 3rem);
    background: var(--night);
    color: var(--ink-on-night);
    color-scheme: dark;
  }

  .journey__pieces, .journey__contexts, .journey__distribution {
    inline-size: min(100%, 36rem);
  }

  .journey__prompt {
    inline-size: min(100%, 44rem);
    margin: 0;
    padding-block-end: var(--space-xs);
    border-block-end: 1px solid var(--rule-strong);
    font: var(--weight-black) clamp(1.7rem, 1rem + 2.8vw, 4rem) / 1 var(--font-display);
    letter-spacing: -0.052em;
  }

  .journey__next {
    display: inline-block;
    border: 1px dashed var(--accent);
    padding: var(--space-3xs) var(--space-2xs);
    color: var(--accent);
    font: var(--weight-normal) var(--text-xs) / 1.4 var(--font-body);
    letter-spacing: normal;
    vertical-align: middle;
  }

  .journey__pieces {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journey__piece {
    display: grid;
    min-inline-size: 0;
    gap: var(--space-xs);
    align-content: center;
    padding: var(--space-xs);
    border: 1px solid var(--rule-strong);
    background: var(--night-raised);
  }

  .journey__piece code, .journey__candidate code { white-space: pre; }
  .journey__piece span, .journey__context dd { color: var(--accent); }
  .journey__piece span { font-size: var(--text-xs); }

  .journey__context, .journey__candidate {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-sm);
    padding-block: var(--space-2xs);
    border-block-end: 1px solid var(--rule-strong);
  }

  .journey__context dt, .journey__candidate dt { min-inline-size: 0; }
  .journey__context strong { color: var(--accent); white-space: pre; }
  .journey__context dd, .journey__candidate dd { margin: 0; }
  .journey__context dd { font-size: var(--text-sm); white-space: nowrap; }

  .journey__candidate { grid-template-columns: minmax(0, 8rem) minmax(0, 1fr); }
  .journey__candidate dd {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4ch;
    align-items: center;
    gap: var(--space-2xs);
    text-align: end;
  }
  .journey__bar {
    block-size: 0.5rem;
    background: var(--rule);
  }
  .journey__bar > span {
    display: block;
    inline-size: var(--probability);
    block-size: 100%;
    background: var(--accent);
    transform-origin: left;
  }

  .journey__note {
    margin: 0;
    padding: var(--space-2xs) var(--space-sm);
    border-block-start: 1px solid var(--rule);
    color: var(--ink-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 52rem) {
    .journey__panel { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; }
    .journey__display { min-block-size: 11.5rem; }
    .journey__copy p { max-inline-size: 52ch; }
  }

  @media (max-width: 42rem) {
    .journey { padding-inline: var(--space-sm); }
    .journey__control label { font-size: var(--text-xs); overflow-wrap: anywhere; }
    .journey__pieces { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .journey__context { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .journey__candidate { grid-template-columns: minmax(0, 5.75rem) minmax(0, 1fr); }
    .journey__context dt { overflow-wrap: anywhere; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .journey__piece, .journey__context {
      animation: var(--token-arrival, none) 300ms cubic-bezier(0.18, 0.72, 0.25, 1) both;
    }
    .journey__piece:nth-child(2), .journey__context:nth-child(2) { animation-delay: 45ms; }
    .journey__piece:nth-child(3) { animation-delay: 90ms; }
    .journey__piece:nth-child(4) { animation-delay: 135ms; }
    .journey__bar > span { animation: var(--probability-fill, none) 430ms cubic-bezier(0.18, 0.72, 0.25, 1) both; }

    @keyframes token-arrival {
      from { opacity: 0; transform: translateX(-0.65rem); }
      to { opacity: 1; transform: translateX(0); }
    }

    @keyframes probability-fill {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }
  }
</style>
