---
import { getCollection } from 'astro:content'
import { COMPONENTS, LENS_LABELS, factText, lensText, type Lens } from '~/lib/explorer-data'
import { lessonPath, type LessonEntry } from '~/lib/content'
import { type Locale } from '~/lib/i18n'
import {
  DECKS,
  FRONT_AZIMUTH,
  RIM_RADIUS,
  bypassPaths,
  deckLayout,
  transformerMarkers,
} from '~/lib/three/scenes/transformer'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const isPt = locale === 'pt-br'

const t = {
  library: isPt ? 'Biblioteca de componentes' : 'Component library',
  scrollHint: isPt ? 'Deslize para ver os 12 componentes' : 'Swipe for all 12 components',
  // Read top to bottom as the instrument stands: output above, input below.
  layerKey: isPt
    ? [['lm-head', 'Saída', 'Cabeça de linguagem'], ['ffn', 'Cálculo', 'Feed-forward'], ['attention', 'Roteamento', 'Self-attention'], ['embedding', 'Entrada', 'Embeddings']]
    : [['lm-head', 'Output', 'LM head'], ['ffn', 'Compute', 'Feed-forward'], ['attention', 'Routing', 'Self-attention'], ['embedding', 'Input', 'Embeddings']],
  keyTitle: isPt ? 'Camadas, da entrada à saída' : 'Layers, input to output',
  how: isPt
    ? 'Arraste para girar · role para aproximar · as setas percorrem as portas · Escape fecha'
    : 'Drag to rotate · scroll to zoom · arrow keys move between ports · Escape closes',
  viewControls: isPt ? 'Controles da visualização' : 'View controls',
  motion: isPt ? 'Animar' : 'Animate',
  keyFacts: isPt ? 'Dados principais' : 'Key facts',
  viewLesson: isPt ? 'Ver a aula' : 'View lesson',
  isolate: isPt ? 'Isolar' : 'Isolate',
  reset: isPt ? 'Reiniciar' : 'Reset',
  annotations: isPt ? 'Anotações do espécime' : 'Specimen annotations',
  noWebgl: isPt
    ? 'Seu navegador não expõe WebGL, então a versão 3D não pode ser desenhada. O conteúdo abaixo é o mesmo.'
    : 'Your browser does not expose WebGL, so the 3D view cannot be drawn. Everything below is the same content.',
  params: isPt ? 'Parâmetros' : 'Parameters',
  cost: isPt ? 'Custo' : 'Cost',
  introduced: isPt ? 'Introduzido' : 'Introduced',
  variants: isPt ? 'Variantes' : 'Variants',
  posterTitle: isPt
    ? 'Elevação do instrumento: um bloco transformer, da camada de embeddings, embaixo, até a cabeça LM e o amostrador, em cima, com as 12 portas numeradas'
    : 'Elevation of the instrument: one transformer block, from the embedding deck at the bottom to the LM head and sampler at the top, with its 12 numbered ports',
}

const lenses: Lens[] = ['math', 'compare', 'animation', 'failure', 'context']
const first = COMPONENTS[0]!

/**
 * Resolve each component's lead lesson to a real URL at build time.
 *
 * The explorer stores bare lesson ids, but a lesson lives at
 * `/lessons/<track>/<id>/` — the track segment is only knowable from the
 * corpus. Building the href in the browser from the id alone produced a 404 for
 * every component. Resolving here means a stale id fails the build instead of
 * shipping a dead link, and the anchor is already correct before any script
 * runs (there is no `/lessons/` index route to fall back to).
 */
const allLessons: LessonEntry[] = await getCollection('lessons')
const lessons = allLessons.filter((lesson) => lesson.data.locale === locale)
const hrefByComponent = new Map<string, string>()
for (const component of COMPONENTS) {
  const leadId = component.lessons[0]
  const lesson = lessons.find((entry) => entry.data.id === leadId)
  if (!leadId || !lesson) {
    throw new Error(
      `Explorer component "${component.id}" points at lesson "${leadId ?? '(none)'}", ` +
        `which does not exist in the ${locale} corpus. Fix src/lib/explorer-data.ts.`,
    )
  }
  hrefByComponent.set(component.id, lessonPath(locale, lesson))
}
const firstLessonHref = hrefByComponent.get(first.id)!

/*
 * The poster is an engraved elevation of the same instrument, computed from the
 * scene's own layout, so the drawing a reader sees before (or without) WebGL
 * cannot disagree with the model that replaces it. A slightly raised
 * orthographic view from the camera's starting azimuth.
 */
const SCALE = 88
const CX = 150
const TOP_Y = 1.55
const CY = 34 + TOP_Y * SCALE
const TILT = 0.24
const right = { x: Math.cos(FRONT_AZIMUTH - Math.PI / 2), z: Math.sin(FRONT_AZIMUTH - Math.PI / 2) }
const toward = { x: Math.cos(FRONT_AZIMUTH), z: Math.sin(FRONT_AZIMUTH) }
const project = (x: number, y: number, z: number): [number, number] => [
  CX + SCALE * (x * right.x + z * right.z),
  CY - SCALE * y + SCALE * TILT * (x * toward.x + z * toward.z),
]
const fmt = (n: number): string => n.toFixed(1)
const layout = deckLayout()
const deckAt = (id: string) => layout.get(id) ?? { y: 0, plate: 0, rise: 0, top: 0 }
const rx = SCALE * RIM_RADIUS
const ry = rx * TILT
const cylinder = (y: number, thickness: number, radius = RIM_RADIUS) => {
  const [, top] = project(0, y + thickness / 2, 0)
  const [, bottom] = project(0, y - thickness / 2, 0)
  const r = SCALE * radius
  const e = r * TILT
  return {
    band: `M${fmt(CX - r)} ${fmt(top)}V${fmt(bottom)}A${fmt(r)} ${fmt(e)} 0 0 0 ${fmt(CX + r)} ${fmt(bottom)}V${fmt(top)}Z`,
    top: { cy: fmt(top), rx: fmt(r), ry: fmt(e) },
  }
}
const plates = DECKS.filter((deck) => deck.plate > 0.05).map((deck) => ({
  id: deck.id,
  porcelain: deck.id === 'embedding' || deck.id === 'lm-head',
  ...cylinder(deckAt(deck.id).y, deck.plate),
}))
const hoops = DECKS.filter((deck) => deck.plate <= 0.05).map((deck) => ({ id: deck.id, cy: fmt(project(0, deckAt(deck.id).y, 0)[1]) }))
const attention = deckAt('attention')
const domeBase = project(0, attention.y + attention.plate / 2, 0)[1]
const domeHeight = SCALE * (attention.rise - 0.02)
const domeRx = SCALE * 0.6
const ffn = deckAt('ffn')
const coreY = project(0, ffn.y + ffn.plate / 2 + 0.16, 0)[1]
const lmHead = deckAt('lm-head')
const logitBase = lmHead.y + lmHead.plate / 2
const logits = Array.from({ length: 13 }, (_, index) => {
  const angle = FRONT_AZIMUTH - Math.PI / 2 + (index / 12) * Math.PI
  const height = index === 6 ? 0.25 : 0.04 + 0.12 * Math.abs(Math.sin(index * 2.4))
  const [x, y0] = project(Math.cos(angle) * 0.8, logitBase, Math.sin(angle) * 0.8)
  return { x: fmt(x), y0: fmt(y0), y1: fmt(y0 - SCALE * height), sampled: index === 6 }
})
const bypasses = Object.values(bypassPaths()).map((points) =>
  points.map((point, index) => {
    const [x, y] = project(point.x, point.y, point.z)
    return `${index === 0 ? 'M' : 'L'}${fmt(x)} ${fmt(y)}`
  }).join(''),
)
const embedding = deckAt('embedding')
const plinth = cylinder(-1.94 + 0.07, 0.14, 1.22)
const [, footY] = project(0, -2.06, 0)
const [, crownY] = project(0, lmHead.top + 0.2, 0)
const [, axisBottom] = project(0, -1.8, 0)
const chevrons = DECKS.slice(0, -1).map((deck, index) => {
  const above = deckAt(DECKS[index + 1]!.id)
  const mid = (deckAt(deck.id).top + above.y - above.plate / 2) / 2
  return fmt(project(0, mid, 0)[1])
})
const ports = transformerMarkers()
  .map((marker, index) => {
    const [x, y, z] = marker.position
    const [sx, sy] = project(x, y, z)
    return { n: index + 1, x: fmt(sx), y: fmt(sy), facing: x * toward.x + z * toward.z > -0.1 }
  })
  .filter((port) => port.facing)
---

<section class="explorer" data-explorer data-locale={locale}>
  <nav class="index" aria-label={t.library}>
    <h2 class="index__title">{t.library}</h2>
    <ol class="index__list">
      {
        COMPONENTS.map((c, i) => (
          <li>
            <button
              type="button"
              class="index__item"
              data-component={c.id}
              data-lesson-href={hrefByComponent.get(c.id)}
              aria-current={i === 0 ? 'true' : 'false'}
            >
              <span class="index__port" data-numeric>{i + 1}</span>
              <span class="index__name">{c.name[locale]}</span>
              <span class="index__system">{c.system[locale]}</span>
            </button>
          </li>
        ))
      }
    </ol>
    <p class="index__hint">{t.scrollHint}</p>
  </nav>

  <div class="stage">
    <div class="stage__field">
      <div class="stage__bar">
        <div class="stage__tools" role="group" aria-label={t.viewControls}>
          <button type="button" data-tool="isolate" aria-pressed="false" disabled>{t.isolate}</button>
          <button type="button" data-tool="reset" disabled>{t.reset}</button>
          <label class="stage__motion">
            <input type="checkbox" data-tool="motion" checked disabled />
            <span>{t.motion}</span>
          </label>
        </div>
        <p class="stage__how">{t.how}</p>
      </div>

      <div class="stage__canvas-wrap">
        {/*
          Poster first. WebGL replaces it only once the renderer is proven to
          work, so a device without WebGL — or a chunk that fails to load —
          shows a real drawing rather than a blank box or a stuck spinner.
          Colours are tokens resolved under this field's dark color-scheme.
        */}
        <div class="stage__poster" data-poster>
          <svg viewBox="0 0 320 420" role="img" aria-labelledby="poster-title">
            <title id="poster-title">{t.posterTitle}</title>
            <g class="poster__chart">
              {[150, 108, 66].map((r) => <ellipse cx={CX} cy={fmt(footY)} rx={r} ry={fmt(r * TILT)} />)}
            </g>
            <g class="poster__steel">
              <ellipse cx={CX} cy={fmt(footY)} rx="38" ry={fmt(38 * TILT)} />
              <path d={`M${CX - 5} ${fmt(footY)}V${fmt(axisBottom)}M${CX + 5} ${fmt(footY)}V${fmt(axisBottom)}`} />
            </g>
            <path class="poster__enamel" d={plinth.band} />
            <ellipse class="poster__enamel poster__engraved" cx={CX} cy={plinth.top.cy} rx={plinth.top.rx} ry={plinth.top.ry} />
            <path class="poster__path" d={`M${CX} ${fmt(project(0, embedding.top, 0)[1])}V${fmt(crownY - 10)}`} />
            {bypasses.map((d) => <path class="poster__bypass" d={d} />)}
            {
              plates.map((plate) => (
                <g class={plate.porcelain ? 'poster__porcelain' : 'poster__enamel'}>
                  <path d={plate.band} />
                  <ellipse class="poster__engraved" cx={CX} cy={plate.top.cy} rx={plate.top.rx} ry={plate.top.ry} />
                </g>
              ))
            }
            {hoops.map((hoop) => <ellipse class="poster__hoop" cx={CX} cy={hoop.cy} rx={fmt(rx)} ry={fmt(ry)} />)}
            <g class="poster__dome">
              <path d={`M${fmt(CX - domeRx)} ${fmt(domeBase)}C${fmt(CX - domeRx)} ${fmt(domeBase - domeHeight * 1.3)} ${fmt(CX + domeRx)} ${fmt(domeBase - domeHeight * 1.3)} ${fmt(CX + domeRx)} ${fmt(domeBase)}`} />
              <path d={`M${fmt(CX - domeRx * 0.5)} ${fmt(domeBase + 6)}C${fmt(CX - domeRx * 0.5)} ${fmt(domeBase - domeHeight * 1.2)} ${fmt(CX + domeRx * 0.5)} ${fmt(domeBase - domeHeight * 1.2)} ${fmt(CX + domeRx * 0.5)} ${fmt(domeBase + 6)}`} />
            </g>
            <g class="poster__arcs">
              <path d={`M${CX + 14} ${fmt(domeBase - domeHeight * 0.8)}Q${CX - 10} ${fmt(domeBase - domeHeight * 1.1)} ${fmt(CX - domeRx * 0.8)} ${fmt(domeBase - domeHeight * 0.3)}`} />
              <path d={`M${CX + 14} ${fmt(domeBase - domeHeight * 0.8)}Q${CX + 30} ${fmt(domeBase - domeHeight * 0.95)} ${fmt(CX + domeRx * 0.75)} ${fmt(domeBase - domeHeight * 0.35)}`} />
              <path d={`M${CX + 14} ${fmt(domeBase - domeHeight * 0.8)}Q${CX - 4} ${fmt(domeBase - domeHeight * 0.55)} ${fmt(CX - domeRx * 0.3)} ${fmt(domeBase - domeHeight * 0.15)}`} />
            </g>
            <g class="poster__stars">
              <circle cx={CX + 14} cy={fmt(domeBase - domeHeight * 0.8)} r="3.4" />
              <circle cx={fmt(CX - domeRx * 0.8)} cy={fmt(domeBase - domeHeight * 0.3)} r="2.6" />
              <circle cx={fmt(CX + domeRx * 0.75)} cy={fmt(domeBase - domeHeight * 0.35)} r="2" />
              <circle cx={fmt(CX - domeRx * 0.3)} cy={fmt(domeBase - domeHeight * 0.15)} r="1.6" />
            </g>
            <circle class="poster__core" cx={CX} cy={fmt(coreY)} r={fmt(SCALE * 0.17)} />
            <ellipse class="poster__hoop" cx={CX} cy={fmt(coreY)} rx={fmt(SCALE * 0.25)} ry={fmt(SCALE * 0.1)} />
            <g class="poster__logits">
              {logits.map((bar) => <path class={bar.sampled ? 'is-sampled' : undefined} d={`M${bar.x} ${bar.y0}V${bar.y1}`} />)}
            </g>
            <ellipse class="poster__hoop" cx={CX} cy={fmt(crownY)} rx="14" ry={fmt(14 * TILT)} />
            <g class="poster__chevrons">
              {chevrons.map((y) => <path d={`M${CX - 4} ${Number(y) + 3}L${CX} ${Number(y) - 4}L${CX + 4} ${Number(y) + 3}Z`} />)}
            </g>
            <g class="poster__ports">
              {ports.map((port) => (
                <g>
                  <circle cx={port.x} cy={port.y} r="7.5" />
                  <text x={port.x} y={port.y} dy="0.35em">{port.n}</text>
                </g>
              ))}
            </g>
          </svg>
        </div>
        <canvas class="stage__canvas" data-stage-canvas hidden></canvas>

        {/* Leader lines for pinned labels; the client writes each path. */}
        <svg class="stage__leaders" data-leaders aria-hidden="true" focusable="false">
          {t.layerKey.map(([deck]) => <path data-leader={deck} />)}
          <path class="stage__leader-select" data-leader="select" />
        </svg>

        <div class="stage__key">
          <p class="stage__key-title">{t.keyTitle}</p>
          <ol class="stage__layer-key" data-layer-key>
            {t.layerKey.map(([deck, role, layer]) => <li data-layer-anchor={deck}><span>{role}</span>{layer}</li>)}
          </ol>
        </div>

        <div class="callout-card" data-callout hidden>
          <p class="callout-card__label" data-callout-label></p>
          <p class="callout-card__detail" data-callout-detail></p>
        </div>
      </div>

      {/*
        Text equivalent of the annotation layer. Linked from the canvas via
        aria-describedby, so a screen-reader user gets the same content the
        sighted user gets from the ports.
      */}
      <div class="visually-hidden" id="specimen-annotations">{t.annotations}</div>

      <p class="stage__nowebgl" data-nowebgl hidden>{t.noWebgl}</p>
    </div>
  </div>

  <article class="detail" aria-live="polite">
    <h2 class="detail__name">
      <span class="detail__port" data-numeric data-detail-port>1</span>
      <span data-detail-name>{first.name[locale]}</span>
    </h2>
    <p class="detail__system" data-detail-system>{first.system[locale]}</p>
    <p class="detail__tagline" data-detail-tagline>{first.tagline[locale]}</p>
    <p class="detail__summary" data-detail-summary>{first.summary[locale]}</p>

    <h3 class="detail__facts-title">{t.keyFacts}</h3>
    <dl class="detail__facts">
      <div><dt>{t.params}</dt><dd data-fact-params>{factText(first, 'params', locale)}</dd></div>
      <div><dt>{t.cost}</dt><dd data-fact-cost>{factText(first, 'cost', locale)}</dd></div>
      <div><dt>{t.introduced}</dt><dd data-fact-introduced>{factText(first, 'introduced', locale)}</dd></div>
      <div><dt>{t.variants}</dt><dd data-fact-variants>{factText(first, 'variants', locale)}</dd></div>
    </dl>

    <a class="detail__cta" data-detail-cta href={firstLessonHref}>
      <span>{t.viewLesson}</span> <span aria-hidden="true">→</span>
    </a>
  </article>

  <div class="lenses">
    {
      lenses.map((lens) => (
        <article class="lenses__item">
          <h3 class="lenses__title">{LENS_LABELS[lens][locale]}</h3>
          <p class="lenses__body" data-lens={lens}>{lensText(first, lens, locale)}</p>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { mountExplorer } from '~/lib/explorer-client'

  for (const el of document.querySelectorAll<HTMLElement>('[data-explorer]')) {
    mountExplorer(el)
  }
</script>

<style>
  .explorer {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(18rem, 0.72fr);
    grid-template-areas: 'index index' 'stage detail' 'lenses lenses';
    max-width: var(--shell-max);
    margin-inline: auto;
    padding-inline: var(--space-lg);
  }

  /* ---- Component index: twelve ports, in the order the token meets them ---- */

  .index {
    grid-area: index;
    display: grid;
    grid-template-columns: minmax(9rem, 0.2fr) minmax(0, 1fr);
    border-block: 1px solid var(--rule-strong);
  }
  .index__title {
    align-self: center;
    margin: 0;
    padding: var(--space-sm) var(--space-sm) var(--space-sm) 0;
    font: var(--weight-semibold) var(--text-sm) / var(--leading-snug) var(--font-display);
    color: var(--ink);
  }
  /* Two rows of six: every port visible at once where there is room. */
  .index__list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .index__list li { display: grid; border-inline-start: 1px solid var(--rule); }
  .index__list li:nth-child(n + 7) { border-block-start: 1px solid var(--rule); }
  .index__hint { display: none; }

  .index__item {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: var(--space-2xs);
    row-gap: 2px;
    align-content: start;
    width: 100%;
    padding: var(--space-sm) var(--space-xs);
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .index__item:hover { background: var(--plate-raised); }
  .index__item:focus-visible { outline-offset: -3px; }

  /* The port numeral is the 3D port's twin: a porcelain disc with an ink figure. */
  .index__port {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    font: var(--weight-bold) var(--text-2xs) / 1 var(--font-display);
    color: var(--ink);
    background: var(--plate);
  }
  .index__name {
    font: var(--weight-semibold) var(--text-sm) / var(--leading-snug) var(--font-display);
    hyphens: auto;
  }
  .index__system {
    font: var(--weight-normal) var(--text-2xs) / var(--leading-snug) var(--font-display);
    color: var(--ink-muted);
  }

  /* Current component: the reticle, the site's "you are here" mark. */
  .index__item[aria-current='true'] { background: var(--plate-raised); }
  .index__item[aria-current='true'] .index__port {
    border-color: var(--reticle);
    box-shadow: 0 0 0 2px var(--plate-raised), 0 0 0 3.5px var(--reticle);
  }
  .index__item[aria-current='true']::after {
    content: '';
    position: absolute;
    inset-inline: var(--space-xs);
    inset-block-end: 0;
    block-size: 2px;
    background: var(--reticle);
  }

  /* ---- Stage: the night plate, in both editions ---- */

  .stage {
    grid-area: stage;
    position: relative;
    display: grid;
    min-height: clamp(38rem, 72vh, 54rem);
    background: var(--night);
    color: var(--ink-on-night);
  }
  /* Tokens inside resolve to the field (dark) edition, whatever the page is. */
  .stage__field {
    color-scheme: dark;
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    min-height: 0;
    padding: var(--space-md);
    color: var(--ink);
  }

  .stage__bar {
    position: relative;
    z-index: var(--z-raised);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    align-items: center;
    justify-content: space-between;
    margin-block-end: var(--space-xs);
  }
  .stage__how {
    margin: 0;
    font: var(--weight-normal) var(--text-2xs) / var(--leading-snug) var(--font-display);
    color: var(--ink-muted);
  }

  .stage__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    border: 1px solid var(--rule-field);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .stage__tools button,
  .stage__motion {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0 var(--space-sm);
    border: 0;
    border-inline-end: 1px solid var(--rule-field);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: var(--weight-medium) var(--text-xs) / 1 var(--font-display);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .stage__motion { border-inline-end: 0; }
  .stage__tools button:hover:not(:disabled) { background: var(--accent-soft); }
  .stage__tools button:focus-visible { outline-offset: -3px; }
  .stage__tools button[aria-pressed='true'],
  .stage__tools button[aria-pressed='true']:hover { background: var(--accent); color: var(--accent-ink); }
  .stage__tools button:disabled { color: var(--ink-faint); cursor: default; }
  .stage__motion input { margin: 0; accent-color: var(--accent); }
  .stage__motion:has(input:disabled) { color: var(--ink-faint); cursor: default; }

  .stage__canvas-wrap {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 100%;
    block-size: 100%;
    min-inline-size: 0;
    min-height: 0;
    border-block: 1px solid var(--rule);
  }
  /* The renderer updates the canvas width/height attributes for its drawing
     buffer. A replaced element normally feeds that intrinsic ratio back into
     grid sizing, so resizing mobile → desktop could make the stage 1,680px
     tall. Taking it out of flow makes the wrapper the sole layout authority. */
  .stage__canvas { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; display: block; touch-action: none; cursor: grab; }
  .stage__canvas:active { cursor: grabbing; }
  .stage__canvas[data-over-port] { cursor: pointer; }
  .stage__canvas:focus-visible { outline-offset: -4px; }

  .stage__poster { display: grid; place-items: center; inline-size: 100%; block-size: 100%; }
