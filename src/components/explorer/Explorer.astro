---
import { getCollection } from 'astro:content'
import { COMPONENTS, LENS_LABELS, factText, lensText, type Lens } from '~/lib/explorer-data'
import { lessonPath, type LessonEntry } from '~/lib/content'
import { type Locale } from '~/lib/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const isPt = locale === 'pt-br'

const t = {
  library: isPt ? 'Biblioteca de componentes' : 'Component library',
  stageHint: isPt
    ? 'ESPÉCIME 3D · CLIQUE NUM PONTO PARA EXPLORAR'
    : '3D SPECIMEN · CLICK A DOT TO EXPLORE',
  tip: isPt
    ? ['Arraste para girar', 'Role para aproximar', 'Setas percorrem os pontos', 'Escape fecha']
    : ['Drag to rotate', 'Scroll to zoom', 'Arrow keys cycle the dots', 'Escape closes'],
  viewControls: isPt ? 'Controles da visualização' : 'View controls',
  autoRotate: isPt ? 'Girar sozinho' : 'Auto rotate',
  keyFacts: isPt ? 'Dados principais' : 'Key facts',
  viewLesson: isPt ? 'Ver a aula' : 'View lesson',
  isolate: isPt ? 'Isolar' : 'Isolate',
  reset: isPt ? 'Reiniciar' : 'Reset',
  annotations: isPt ? 'Anotações do espécime' : 'Specimen annotations',
  noWebgl: isPt
    ? 'Seu navegador não expõe WebGL, então a versão 3D não pode ser desenhada. O conteúdo abaixo é o mesmo.'
    : 'Your browser does not expose WebGL, so the 3D view cannot be drawn. Everything below is the same content.',
  params: isPt ? 'Parâmetros' : 'Parameters',
  cost: isPt ? 'Custo' : 'Cost',
  introduced: isPt ? 'Introduzido' : 'Introduced',
  variants: isPt ? 'Variantes' : 'Variants',
}

const lenses: Lens[] = ['math', 'compare', 'animation', 'failure', 'context']
const first = COMPONENTS[0]!

/**
 * Resolve each component's lead lesson to a real URL at build time.
 *
 * The explorer stores bare lesson ids, but a lesson lives at
 * `/lessons/<track>/<id>/` — the track segment is only knowable from the
 * corpus. Building the href in the browser from the id alone produced a 404 for
 * every component. Resolving here means a stale id fails the build instead of
 * shipping a dead link, and the anchor is already correct before any script
 * runs (there is no `/lessons/` index route to fall back to).
 */
const allLessons: LessonEntry[] = await getCollection('lessons')
const lessons = allLessons.filter((lesson) => lesson.data.locale === locale)
const hrefByComponent = new Map<string, string>()
for (const component of COMPONENTS) {
  const leadId = component.lessons[0]
  const lesson = lessons.find((entry) => entry.data.id === leadId)
  if (!leadId || !lesson) {
    throw new Error(
      `Explorer component "${component.id}" points at lesson "${leadId ?? '(none)'}", ` +
        `which does not exist in the ${locale} corpus. Fix src/lib/explorer-data.ts.`,
    )
  }
  hrefByComponent.set(component.id, lessonPath(locale, lesson))
}
const firstLessonHref = hrefByComponent.get(first.id)!
---

<section class="explorer" data-explorer data-locale={locale}>
  <!-- Library rail -->
  <nav class="rail panel" aria-label={t.library}>
    <p class="eyebrow rail__title">{t.library}</p>
    <ul class="rail__list">
      {
        COMPONENTS.map((c, i) => (
          <li>
            <button
              type="button"
              class="rail__item"
              data-component={c.id}
              data-lesson-href={hrefByComponent.get(c.id)}
              aria-current={i === 0 ? 'true' : 'false'}
              style={`--item-accent:${c.accent}`}
            >
              <span class="rail__name">{c.name[locale]}</span>
              <span class="rail__system">{c.system[locale]}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Stage -->
  <div class="stage panel">
    <aside class="tip" aria-hidden="true">
      <ul>{t.tip.map((line) => <li>{line}</li>)}</ul>
    </aside>

    <div class="stage__canvas-wrap">
      {/*
        Poster first. WebGL replaces it only once the renderer is proven to
        work, so a device without WebGL — or a chunk that fails to load — shows
        a real diagram rather than a blank box or a spinner stuck at 8%.
      */}
      <div class="stage__poster" data-poster>
        <svg viewBox="0 0 260 320" role="img" aria-labelledby="poster-title">
          <title id="poster-title">
            {isPt
              ? 'Diagrama de um bloco transformer, das embeddings até o amostrador'
              : 'Diagram of a transformer block, from embeddings up to the sampler'}
          </title>
          {
            [
              { y: 280, h: 22, c: '#1bb7c8' },
              { y: 252, h: 12, c: '#9fb6ba' },
              { y: 196, h: 48, c: '#f05d4e' },
              { y: 178, h: 10, c: '#52a675' },
              { y: 160, h: 12, c: '#9fb6ba' },
              { y: 110, h: 42, c: '#f2d45c' },
              { y: 92, h: 10, c: '#52a675' },
              { y: 62, h: 22, c: '#1bb7c8' },
            ].map((s) => (
              <rect x="40" y={s.y} width="180" height={s.h} rx="3" fill={s.c} opacity="0.9" />
            ))
          }
        </svg>
      </div>
      <canvas class="stage__canvas" data-stage-canvas hidden></canvas>
    </div>

    <div class="stage__tools" role="group" aria-label={t.viewControls}>
      <button type="button" data-tool="isolate" aria-pressed="false">{t.isolate}</button>
      <button type="button" data-tool="reset">{t.reset}</button>
      <label class="stage__rotate">
        <input type="checkbox" data-tool="autorotate" checked />
        <span>{t.autoRotate}</span>
      </label>
    </div>

    <p class="stage__hint eyebrow">{t.stageHint}</p>

    <!-- DOM callout: anchored to the 3D marker, but real HTML text. -->
    <div class="callout-card" data-callout hidden>
      <p class="callout-card__label" data-callout-label></p>
      <p class="callout-card__detail" data-callout-detail></p>
    </div>

    {/*
      Text equivalent of the annotation layer. Not decoration: it is linked from
      the canvas via aria-describedby, so a screen-reader user gets the same
      content the sighted user gets from the dots.
    */}
    <ul class="visually-hidden" id="specimen-annotations">
      <li>{t.annotations}</li>
    </ul>

    <p class="stage__nowebgl" data-nowebgl hidden>{t.noWebgl}</p>
  </div>

  <!-- Detail panel -->
  <article class="detail panel" aria-live="polite">
    <p class="eyebrow" data-detail-system>{first.system[locale]}</p>
    <h2 data-detail-name>{first.name[locale]}</h2>
    <p class="detail__tagline aside-hand" data-detail-tagline>{first.tagline[locale]}</p>
    <p class="detail__summary" data-detail-summary>{first.summary[locale]}</p>

    <p class="eyebrow detail__facts-title">{t.keyFacts}</p>
    <dl class="detail__facts">
      <div><dt>{t.params}</dt><dd data-fact-params>{factText(first, 'params', locale)}</dd></div>
      <div><dt>{t.cost}</dt><dd data-fact-cost>{factText(first, 'cost', locale)}</dd></div>
      <div><dt>{t.introduced}</dt><dd data-fact-introduced>{factText(first, 'introduced', locale)}</dd></div>
      <div><dt>{t.variants}</dt><dd data-fact-variants>{factText(first, 'variants', locale)}</dd></div>
    </dl>

    <a class="detail__cta" data-detail-cta href={firstLessonHref}>
      {t.viewLesson} <span aria-hidden="true">→</span>
    </a>
  </article>

  <!-- Five-lens card deck -->
  <div class="deck">
    {
      lenses.map((lens) => (
        <article class="deck__card panel">
          <p class="eyebrow deck__lens">{LENS_LABELS[lens][locale]}</p>
          <p class="deck__body" data-lens={lens}>{lensText(first, lens, locale)}</p>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { mountExplorer } from '~/lib/explorer-client'

  for (const el of document.querySelectorAll<HTMLElement>('[data-explorer]')) {
    mountExplorer(el)
  }
</script>

<style>
  .explorer {
    display: grid;
    grid-template-columns: var(--rail-w) minmax(0, 1fr) var(--panel-w);
    grid-template-areas: 'rail stage detail' 'deck deck deck';
    gap: 1px;
    max-width: var(--shell-max);
    margin-inline: auto;
    padding-inline: var(--space-lg);
  }

  .rail { grid-area: rail; padding: var(--space-sm); border-radius: var(--radius-sm) 0 0 var(--radius-sm); border-top: 4px solid var(--accent); }
  .rail__title { padding: var(--space-2xs) var(--space-2xs) var(--space-xs); }
  .rail__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }

  .rail__item {
    width: 100%;
    display: grid;
    gap: 1px;
    text-align: start;
    padding: var(--space-2xs) var(--space-xs);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
    font: inherit;
    color: inherit;
    transition: background var(--dur-fast) var(--ease-out);
  }

  .rail__item:hover { background: color-mix(in srgb, var(--item-accent) 8%, transparent); }

  .rail__item[aria-current='true'] {
    background: color-mix(in srgb, var(--item-accent) 14%, transparent);
    border-color: color-mix(in srgb, var(--item-accent) 40%, transparent);
  }

  .rail__name { font-family: var(--font-ui); font-size: var(--text-base); font-weight: var(--weight-semibold); }
  .rail__system {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .stage {
    grid-area: stage;
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto auto;
    min-height: 580px;
    padding: var(--space-md);
    overflow: hidden;
    color: var(--ink-on-abyss);
    background: var(--abyss);
    border-color: var(--abyss);
    border-radius: 0;
  }

  .stage__canvas-wrap { position: relative; display: grid; place-items: center; min-height: 0; }
  .stage__canvas { width: 100%; height: 100%; display: block; touch-action: none; }
  .stage__poster { display: grid; place-items: center; height: 100%; }
  .stage__poster svg { max-height: 100%; width: auto; }

  .tip {
    position: absolute;
    inset-block-start: var(--space-md);
    inset-inline-end: var(--space-md);
    z-index: var(--z-raised);
    max-width: 12rem;
    padding: var(--space-xs) var(--space-sm);
    color: var(--ink-muted-on-abyss);
    background: rgb(13 48 69 / 0.88);
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: var(--radius-xs);
    font-family: var(--font-data);
    font-size: var(--text-3xs);
    letter-spacing: 0.02em;
  }
  .tip ul { margin: 0; padding-inline-start: var(--space-sm); }

  .stage__tools { display: flex; flex-wrap: wrap; gap: var(--space-2xs); align-items: center; }
  .stage__tools button {
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    padding: 0.3rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--ink-muted-on-abyss);
    cursor: pointer;
  }
  .stage__tools button[aria-pressed='true'] { background: var(--accent); color: var(--accent-ink); border-color: transparent; }
  .stage__rotate { display: inline-flex; align-items: center; gap: 0.35rem; font-family: var(--font-ui); font-size: var(--text-2xs); color: var(--ink-muted-on-abyss); }
  .stage__hint { margin-block-start: var(--space-2xs); color: var(--ink-muted-on-abyss); }
  .stage__nowebgl { font-size: var(--text-sm); color: var(--ink-muted-on-abyss); margin-block-start: var(--space-2xs); }

  .callout-card {
    position: absolute;
    z-index: var(--z-overlay);
    max-width: 15rem;
    padding: var(--space-2xs) var(--space-xs);
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .callout-card[data-behind='true'] { opacity: 0.35; }
  .callout-card__label { margin: 0; font-family: var(--font-ui); font-size: var(--text-2xs); font-weight: 600; }
  .callout-card__detail { margin: 0.2rem 0 0; font-size: var(--text-sm); color: var(--ink-muted); line-height: var(--leading-snug); }

  .detail { grid-area: detail; padding: var(--space-md); align-content: start; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; border-top: 4px solid var(--sonar); }
  .detail h2 { font-size: var(--text-2xl); margin-block: var(--space-3xs) var(--space-2xs); }
  .detail__tagline { margin-block: 0 var(--space-sm); }
  .detail__summary { font-size: var(--text-sm); color: var(--ink-muted); }
  .detail__facts-title { margin-block-start: var(--space-md); }
  .detail__facts { margin: var(--space-2xs) 0 0; display: grid; gap: var(--space-2xs); }
  .detail__facts div { display: grid; gap: 1px; }
  .detail__facts dt {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .detail__facts dd { margin: 0; font-size: var(--text-sm); }

  .detail__cta {
    display: inline-flex;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-block-start: var(--space-md);
    padding: var(--space-2xs) var(--space-sm);
    background: var(--accent);
    color: var(--accent-ink);
    border-radius: var(--radius-sm);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .deck {
    grid-area: deck;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1px;
    margin-block-start: var(--space-lg);
    background: var(--rule-strong);
  }
  .deck__card { min-height: 11rem; padding: var(--space-md); container-type: inline-size; border: 0; border-top: 3px solid var(--accent); border-radius: 0; }
  .deck__card:nth-child(2) { border-top-color: var(--kelp); }
  .deck__card:nth-child(3) { border-top-color: var(--sonar); }
  .deck__card:nth-child(4), .deck__card:nth-child(5) { border-top-color: var(--coral); }
  .deck__lens { color: var(--accent); }
  .deck__body { font-size: var(--text-sm); color: var(--ink-muted); margin-block: var(--space-2xs) 0; }

  @container (min-width: 260px) {
    .deck__body { font-size: var(--text-base); }
  }

  @media (max-width: 1180px) {
    .explorer {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'stage' 'detail' 'rail' 'deck';
    }
    .stage { min-height: 60vh; }
    .rail { border-radius: var(--radius-sm); }
    .rail__list { grid-auto-flow: column; grid-auto-columns: minmax(12rem, 1fr); overflow-x: auto; }
    .detail { border-radius: var(--radius-sm); }
  }

  @media (max-width: 42rem) {
    .explorer { padding-inline: var(--space-sm); }
    .stage { min-height: 32rem; padding: var(--space-sm); }
    .tip { display: none; }
    .deck { grid-template-columns: 1fr; }
  }
</style>
