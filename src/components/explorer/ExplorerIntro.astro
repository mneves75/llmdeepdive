---
import type { Locale } from '~/lib/i18n'

interface Props { locale: Locale }
const pt = Astro.props.locale === 'pt-br'
---
<section class="intro" aria-labelledby="anatomy-title">
  <h1 id="anatomy-title">{pt ? 'Anatomia de um LLM' : 'Anatomy of an LLM'}</h1>
  <div>
    <p>{pt ? 'Siga um token da base ao topo do transformer. Selecione uma das 12 portas para investigar o componente e encontrar a aula correspondente.' : 'Trace a token from the base to the top of a transformer. Select one of 12 ports to investigate its component and find the related lesson.'}</p>
    <a href="#transformer-components">{pt ? 'Ir para os componentes' : 'Jump to the components'} <span aria-hidden="true">↓</span></a>
  </div>
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    gap: clamp(1.25rem, 7vw, 6rem);
    align-items: end;
    max-width: var(--shell-max);
    margin-inline: auto;
    padding: clamp(2rem, 4vw, 4.5rem) var(--space-lg) clamp(1.5rem, 3vw, 3rem);
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(2.55rem, 1.2rem + 5.3vw, 6rem);
    font-weight: var(--weight-black);
    line-height: 0.94;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .intro > div {
    max-width: 35ch;
    padding-inline-start: var(--space-sm);
    border-inline-start: 2px solid var(--reticle);
  }

  p { margin: 0; color: var(--ink-muted); font-size: var(--text-base); line-height: var(--leading-normal); }
  a {
    display: inline-flex;
    gap: var(--space-2xs);
    align-items: center;
    min-block-size: 2.75rem;
    margin-block-end: -0.4rem;
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }
  a:hover { color: var(--reticle); }

  @media (max-width: 48rem) {
    .intro { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 42rem) {
    .intro { padding-inline: var(--space-sm); }
  }
</style>
