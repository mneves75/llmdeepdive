---
import type { Locale } from '~/lib/i18n'

interface Props { locale: Locale }
const pt = Astro.props.locale === 'pt-br'
---
<section class="intro" aria-labelledby="anatomy-title">
  <h1 id="anatomy-title">{pt ? 'Anatomia de um LLM' : 'Anatomy of an LLM'}</h1>
  <a href="#transformer-components">{pt ? 'Explorar o transformer em 3D ↓' : 'Explore the 3D transformer ↓'}</a>
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-xs) clamp(1.5rem, 6vw, 6rem);
    align-items: end;
    max-width: var(--shell-max);
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 3.75rem) var(--space-lg) var(--space-md);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 1.35rem + 4.7vw, 6rem);
    font-weight: var(--weight-black);
    line-height: 0.94;
    letter-spacing: -0.065em;
    overflow-wrap: break-word;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    margin-block-end: -0.4rem;
    font-weight: var(--weight-semibold);
  }
  a:hover { color: var(--reticle); }

  @media (max-width: 62rem) {
    .intro { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 42rem) {
    .intro { padding-inline: var(--space-sm); padding-block-end: var(--space-xs); }
  }
</style>
