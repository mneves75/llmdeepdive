---
import { sampleDistribution } from '~/lib/sampling-math'
import type { Locale } from '~/lib/i18n'

interface Props { locale: Locale; href: string }
const { locale, href } = Astro.props
const pt = locale === 'pt-br'
const candidates = [
  { token: pt ? 'chuva' : 'rain', logit: 2.8 },
  { token: pt ? 'neve' : 'snow', logit: 1.9 },
  { token: pt ? 'café' : 'coffee', logit: 0.8 },
]
const initial = 0.4
const distribution = sampleDistribution({ candidates, temperature: initial, topK: candidates.length, topP: 1, minP: 0 })
const number = new Intl.NumberFormat(locale, { maximumFractionDigits: 1, minimumFractionDigits: 1 })
const percent = new Intl.NumberFormat(locale, { style: 'percent', maximumFractionDigits: 1 })
---
<section class="experiment" data-sampling-preview aria-labelledby="sampling-preview-title">
  <header>
    <div>
      <p>{pt ? 'Simulação de previsão' : 'Prediction simulation'}</p>
      <h2 id="sampling-preview-title">{pt ? 'Qual vem a seguir?' : 'What comes next?'}</h2>
    </div>
    <span class="experiment__signal" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  </header>
  <p class="experiment__prompt">{pt ? 'Abri a janela e senti cheiro de' : 'I opened the window and smelled'} <mark aria-label={pt ? 'lacuna' : 'blank'}>…</mark></p>
  <dl>
    {distribution?.tokens.map(({ token, finalProb }) => (
      <div class="experiment__row" data-preview-row>
        <dt>{token}</dt>
        <dd class="experiment__bar" aria-hidden="true"><span style={`--probability: ${finalProb}`}></span></dd>
        <dd data-preview-probability>{percent.format(finalProb)}</dd>
      </div>
    ))}
  </dl>
  <div class="experiment__control" data-preview-control data-candidates={JSON.stringify(candidates)} hidden>
    <label for="preview-temperature">{pt ? 'Temperatura' : 'Temperature'}</label>
    <output for="preview-temperature" aria-hidden="true">{number.format(initial)}</output>
    <input type="range" id="preview-temperature" min={initial} max="2" step="0.1" value={initial} />
  </div>
  <details>
    <summary>{pt ? 'O que muda ao aumentar a temperatura?' : 'What happens as temperature rises?'}</summary>
    <p>{pt ? 'As opções menos prováveis ganham peso. A opção favorita continua na frente, mas fica menos dominante. O exemplo usa três opções com pontuações ilustrativas.' : 'Less likely options gain weight. The leading option stays in front but becomes less dominant. This example uses three options with illustrative scores.'}</p>
  </details>
  <a href={href}>{pt ? 'Abra o laboratório de amostragem' : 'Open the sampling lab'} <span aria-hidden="true">↗</span></a>
</section>

<script>
  import { sampleDistribution } from '~/lib/sampling-math'

  const preview = document.querySelector('[data-sampling-preview]')
  const control = preview?.querySelector<HTMLElement>('[data-preview-control]')
  const input = control?.querySelector('input')
  const output = control?.querySelector('output')
  const rows = [...(preview?.querySelectorAll('[data-preview-row]') ?? [])].map((row) => ({
    bar: row.querySelector<HTMLElement>('.experiment__bar span'),
    value: row.querySelector('[data-preview-probability]'),
  }))
  if (control && input && output) {
    const locale = document.documentElement.lang
    const number = new Intl.NumberFormat(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 })
    const percent = new Intl.NumberFormat(locale, { style: 'percent', maximumFractionDigits: 1 })
    const candidates = JSON.parse(control.dataset.candidates ?? '[]') as Parameters<typeof sampleDistribution>[0]['candidates']
    const update = () => {
      const temperature = input.valueAsNumber
      const result = sampleDistribution({ candidates, temperature, topK: candidates.length, topP: 1, minP: 0 })
      if (!result) return
      output.value = number.format(temperature)
      const leader = result.tokens[0]
      input.setAttribute('aria-valuetext', leader
        ? `${output.value} · ${leader.token}: ${percent.format(leader.finalProb)}`
        : output.value)
      result.tokens.forEach(({ finalProb }, index) => {
        const row = rows[index]
        row?.bar?.style.setProperty('--probability', String(finalProb))
        if (row?.value) row.value.textContent = percent.format(finalProb)
      })
    }
    input.addEventListener('input', update)
    update()
    control.hidden = false
  }
</script>

<style>
  .experiment {
    min-width: 0;
    padding: clamp(1rem, 3.2vw, 2.2rem);
    border: 1px solid #49534e;
    border-radius: 1.25rem;
    color: #f4faf7;
    background: #1c2521;
    box-shadow: 0 1.4rem 3.5rem #080d0a55;
  }
  header { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  header p { color: #a9c1b4; font-size: 0.8rem; margin: 0 0 0.45rem; }
  h2 { font-size: clamp(1.35rem, 1rem + 1.15vw, 2rem); }
  .experiment__signal { display: flex; align-items: end; gap: 4px; height: 2rem; }
  .experiment__signal i { display: block; width: 5px; border-radius: 2px; background: #8df1bf; }
  .experiment__signal i:nth-child(1) { height: 35%; }
  .experiment__signal i:nth-child(2) { height: 60%; }
  .experiment__signal i:nth-child(3) { height: 45%; }
  .experiment__signal i:nth-child(4) { height: 100%; }
  .experiment__prompt { margin: 1.25rem 0; background: #131a17; border: 1px solid #47524d; border-radius: 0.5rem; padding: 0.8rem; font-family: var(--font-data); font-size: 0.9rem; }
  mark { color: #8df1bf; background: #294337; padding: 0.15em 0.4em; border-radius: 0.25rem; }
  dl { display: grid; gap: 0.6rem; }
  .experiment__row { display: grid; grid-template-columns: 6ch minmax(0, 1fr) 7ch; align-items: center; gap: 0.65rem; font: 0.85rem/1.4 var(--font-data); }
  .experiment__row dd:last-child { text-align: end; }
  .experiment__bar { background: #131a17; height: 0.55rem; border-radius: 2px; }
  .experiment__bar span {
    display: block; height: 100%; border-radius: inherit; background: #8df1bf;
    transform-origin: left; scale: var(--probability) 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .experiment__bar span { transition: scale 160ms ease-out; }
  }
  .experiment__control:not([hidden]) {
    display: grid; grid-template-columns: 1fr auto; align-items: center; margin-top: 1.15rem;
    color: #e3ece7; font-size: 0.9rem;
  }
  output { font-family: var(--font-data); }
  input { grid-column: 1 / -1; width: 100%; min-height: 2.75rem; accent-color: #8df1bf; cursor: ew-resize; }
  details { margin-top: 0.65rem; border-top: 1px solid #49534e; color: #d4e4db; font-size: 0.875rem; }
  summary { min-height: 2.75rem; padding-block: 0.6rem; cursor: pointer; }
  details p { margin: 0.1rem 0 0.65rem; }
  a { display: inline-block; padding-block: 0.4rem; color: #a7f7ce; text-decoration-color: currentColor; font-weight: 650; font-size: 0.875rem; }
  :focus-visible { outline-color: #8df1bf; }
</style>
