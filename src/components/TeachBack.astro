---
interface Props {
  lessonKey: string
  prompt: string
  modelAnswer: string
  locale: 'en' | 'pt-br'
}

const { lessonKey, prompt, modelAnswer, locale } = Astro.props
const copy = locale === 'pt-br'
  ? {
      label: 'Explique com suas palavras',
      hint: 'Mínimo: 80 caracteres e 15 palavras. Seu texto fica somente neste navegador.',
      placeholder: 'Escreva sua explicação aqui…',
      saved: 'Salvo somente neste dispositivo.',
      model: 'Ver uma resposta-modelo',
    }
  : {
      label: 'Explain it in your own words',
      hint: 'Minimum: 80 characters and 15 words. Your text stays only in this browser.',
      placeholder: 'Write your explanation here…',
      saved: 'Saved only on this device.',
      model: 'Show a model answer',
    }
---

<section class="learning-check panel" data-teach-back data-lesson-key={lessonKey}>
  <p class="prompt">{prompt}</p>
  <label>
    <span>{copy.label}</span>
    <textarea rows="7" minlength="80" placeholder={copy.placeholder}></textarea>
  </label>
  <p class="hint">{copy.hint}</p>
  <p class="status" role="status">{copy.saved}</p>
  <details>
    <summary>{copy.model}</summary>
    <p>{modelAnswer}</p>
  </details>
</section>

<script>
  const wordCount = (value: string): number => value.trim().split(/\s+/u).filter(Boolean).length

  for (const root of document.querySelectorAll<HTMLElement>('[data-teach-back]')) {
    const lessonKey = root.dataset.lessonKey
    const textarea = root.querySelector<HTMLTextAreaElement>('textarea')
    const status = root.querySelector<HTMLElement>('[role="status"]')
    if (!lessonKey || !textarea || !status) continue

    const storageKey = `ldd:teach-back:${lessonKey}`
    try {
      textarea.value = localStorage.getItem(storageKey) ?? ''
    } catch {
      textarea.value = ''
    }

    const update = (): void => {
      const valid = textarea.value.trim().length >= 80 && wordCount(textarea.value) >= 15
      root.dataset.complete = String(valid)
      status.textContent = valid
        ? (root.closest('[lang="pt-BR"]') ? 'Critério de teach-back atingido.' : 'Teach-back requirement met.')
        : (root.closest('[lang="pt-BR"]') ? 'Salvo somente neste dispositivo.' : 'Saved only on this device.')
      try {
        localStorage.setItem(storageKey, textarea.value)
      } catch {
        // The exercise remains usable when storage is unavailable.
      }
      document.dispatchEvent(new CustomEvent('ldd:teach-back', { detail: { lessonKey, valid } }))
    }

    textarea.addEventListener('input', update)
    update()
  }
</script>

<style>
  .learning-check { padding: var(--space-lg); }
  .prompt { font-size: var(--text-lg); margin-top: 0; }
  label, label span { display: block; }
  label span { font-family: var(--font-ui); font-size: var(--text-sm); margin-bottom: var(--space-xs); }
  textarea {
    box-sizing: border-box;
    width: 100%;
    resize: vertical;
    padding: var(--space-sm);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    color: var(--ink);
    background: var(--paper);
    font: inherit;
  }
  .hint, .status { color: var(--ink-muted); font-size: var(--text-sm); }
  [data-complete='true'] .status { color: var(--sage); font-weight: var(--weight-semibold); }
  details { border-top: 1px solid var(--rule); padding-top: var(--space-sm); }
  summary { cursor: pointer; font-family: var(--font-ui); font-size: var(--text-sm); }
</style>
