---
import { renderModelAnswer } from './learning-model-answer'

interface Props { lessonKey: string; prompt: string; modelAnswer: string; locale: 'en' | 'pt-br' }
const { lessonKey, prompt, modelAnswer, locale } = Astro.props
const copy = locale === 'pt-br'
  ? { label: 'Explique com suas palavras', hint: 'Escreva pelo menos 80 caracteres e 15 palavras.', privacy: 'Seu texto fica neste navegador.', waiting: 'Aguardando sua explicação.', count: '{c}/80 caracteres · {w}/15 palavras', clear: 'Apagar minha resposta', model: 'Comparar com uma resposta-modelo' }
  : { label: 'Explain it in your own words', hint: 'Write at least 80 characters and 15 words.', privacy: 'Your writing stays in this browser.', waiting: 'Waiting for your explanation.', count: '{c}/80 characters · {w}/15 words', clear: 'Clear my answer', model: 'Compare with a model answer' }
const modelAnswerParts = renderModelAnswer(modelAnswer)
---

<section class="learning-check" data-teach-back data-check-key={lessonKey}>
  <p class="learning-check__prompt">{prompt}</p>
  <label>
    <span>{copy.label}</span>
    <textarea rows="8" minlength="80" aria-describedby="teach-back-guidance"></textarea>
  </label>
  <div class="learning-check__meta">
    <p class="hint"><span id="teach-back-guidance">{copy.hint} {copy.privacy}</span> <span class="count" data-count data-template={copy.count}></span></p>
    <p class="status" role="status"><span aria-hidden="true"></span><span data-status-text>{copy.waiting}</span></p>
  </div>
  {/* Hidden until the script runs: without JavaScript nothing was stored, so
      there is nothing to clear. */}
  <button type="button" class="clear" data-teach-back-clear hidden>{copy.clear}</button>
  <details>
    <summary>{copy.model}</summary>
    <p>{modelAnswerParts.map((part) => part.kind === 'math'
      ? <Fragment set:html={part.html} />
      : part.value)}</p>
  </details>
</section>

<script>
  const wordCount = (value: string): number => value.trim().split(/\s+/u).filter(Boolean).length
  for (const root of document.querySelectorAll<HTMLElement>('[data-teach-back]')) {
    const lessonKey = root.dataset.checkKey
    const textarea = root.querySelector<HTMLTextAreaElement>('textarea')
    const statusText = root.querySelector<HTMLElement>('[data-status-text]')
    const clear = root.querySelector<HTMLButtonElement>('[data-teach-back-clear]')
    const count = root.querySelector<HTMLElement>('[data-count]')
    if (!lessonKey || !textarea || !statusText) continue
    const isPt = root.closest('[lang="pt-BR"]') !== null
    const storageKey = `ldd:teach-back:${lessonKey}`
    const waiting = statusText.textContent ?? ''
    // Loading an answer must not write one: persistence is only claimed for a
    // value this browser actually stored, and an unreadable store is not a
    // failed save until the learner tries to save something.
    let persisted = true
    try { textarea.value = localStorage.getItem(storageKey) ?? '' } catch { textarea.value = '' }
    const render = (): void => {
      const characters = textarea.value.trim().length
      const words = wordCount(textarea.value)
      const meetsRequirement = characters >= 80 && words >= 15
      // Progress toward the rule, shown rather than announced on every key.
      if (count) {
        count.textContent = (count.dataset.template ?? '').replace('{c}', String(Math.min(characters, 80))).replace('{w}', String(Math.min(words, 15)))
        count.dataset.met = String(meetsRequirement)
      }
      const valid = meetsRequirement && persisted
      root.dataset.complete = String(valid)
      root.dataset.saveError = String(!persisted)
      // A live region re-announces any write; only a real change is news.
      const message = !persisted
        ? (isPt ? 'Não foi possível salvar sua explicação neste navegador. A aula não será marcada como concluída.' : 'Could not save your explanation in this browser. The lesson will not be marked complete.')
        : meetsRequirement
          ? (isPt ? 'Sua explicação atingiu o mínimo e foi salva.' : 'Your explanation met both requirements and was saved.')
          : textarea.value.trim() === ''
            ? waiting
            : (isPt ? 'Rascunho salvo neste navegador.' : 'Draft saved in this browser.')
      if (statusText.textContent !== message) statusText.textContent = message
      document.dispatchEvent(new CustomEvent('ldd:teach-back', { detail: { lessonKey, valid } }))
    }
    textarea.addEventListener('input', () => {
      try {
        localStorage.setItem(storageKey, textarea.value)
        persisted = true
      } catch {
        persisted = false
      }
      render()
    })
    // The prose lives only in this browser, so this browser is the only place
    // a learner on a shared profile can remove it.
    if (clear) {
      clear.hidden = false
      clear.addEventListener('click', () => {
        try {
          localStorage.removeItem(storageKey)
        } catch {
          root.dataset.saveError = 'true'
          statusText.textContent = isPt ? 'Não foi possível apagar a resposta salva neste navegador.' : 'Could not clear the saved answer in this browser.'
          return
        }
        textarea.value = ''
        persisted = true
        render()
        textarea.focus()
      })
    }
    render()
  }
</script>

<style>
  .learning-check { display: grid; gap: var(--space-sm); overflow-wrap: anywhere; }
  .learning-check__prompt {
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    border-inline-start: 3px solid var(--tier-core);
    background: var(--plate-raised);
    font: var(--weight-medium) var(--text-lg) / 1.5 var(--font-body);
  }
  label, label > span { display: block; }
  label > span { margin-bottom: var(--space-2xs); font: var(--weight-semibold) var(--text-sm) var(--font-ui); }
  textarea {
    display: block;
    width: 100%;
    min-height: 12rem;
    resize: vertical;
    padding: var(--space-sm);
    border: 1px solid var(--rule-field);
    color: var(--ink);
    background: var(--plate);
    font: var(--text-base) / var(--leading-normal) var(--font-body);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  textarea::placeholder { color: var(--ink-faint); opacity: 1; }
  textarea:focus { border-color: var(--focus); outline: 2px solid var(--focus); outline-offset: 2px; }
  [data-complete='true'] textarea { border-color: var(--success); }
  .learning-check__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2xs) var(--space-md); }
  .hint, .status { margin: 0; color: var(--ink-muted); font-size: var(--text-xs); }
  .status { display: flex; align-items: baseline; gap: var(--space-2xs); }
  .count { display: block; margin-top: var(--space-3xs); color: var(--ink-faint); font-family: var(--font-data); font-variant-numeric: tabular-nums; }
  .count:empty { display: none; }
  .count[data-met='true'], [data-complete='true'] .status { color: var(--success); }
  .status [aria-hidden] { flex: none; width: 0.6rem; aspect-ratio: 1; border: 1px solid currentColor; }
  [data-complete='true'] .status [aria-hidden] { background: currentColor; animation: saved var(--dur-base) var(--ease-out); }
  [data-save-error='true'] .status { color: var(--danger); }
  @keyframes saved { from { scale: 0.5; } }
  .clear {
    justify-self: start;
    min-height: 2.75rem;
    padding-inline: var(--space-sm);
    border: 1px solid var(--rule-field);
    color: var(--ink-muted);
    font: var(--weight-medium) var(--text-xs) var(--font-ui);
    cursor: pointer;
  }
  .clear:hover { color: var(--ink); border-color: var(--ink); }
  details { border-block: 1px solid var(--rule); }
  summary { min-height: 2.75rem; padding-block: var(--space-xs); cursor: pointer; font: var(--weight-semibold) var(--text-sm) var(--font-ui); }
  details p { color: var(--ink-muted); }
</style>
