---
interface Props { lessonKey: string; prompt: string; modelAnswer: string; locale: 'en' | 'pt-br' }
const { lessonKey, prompt, modelAnswer, locale } = Astro.props
const copy = locale === 'pt-br'
  ? { label: 'Explique com suas palavras', hint: 'Mínimo: 80 caracteres e 15 palavras.', privacy: 'Seu texto fica somente neste navegador.', placeholder: 'Reconstrua a ideia aqui…', saved: 'Salvo somente neste dispositivo.', model: 'Comparar com uma resposta-modelo' }
  : { label: 'Explain it in your own words', hint: 'Minimum: 80 characters and 15 words.', privacy: 'Your writing stays only in this browser.', placeholder: 'Rebuild the idea here…', saved: 'Saved only on this device.', model: 'Compare with a model answer' }
---

<section class="learning-check" data-teach-back data-lesson-key={lessonKey}>
  <div class="learning-check__prompt"><span aria-hidden="true">⌁</span><p>{prompt}</p></div>
  <label>
    <span>{copy.label}</span>
    <textarea rows="8" minlength="80" placeholder={copy.placeholder}></textarea>
  </label>
  <div class="learning-check__meta">
    <p class="hint">{copy.hint} {copy.privacy}</p>
    <p class="status" role="status"><span aria-hidden="true">●</span>{copy.saved}</p>
  </div>
  <details>
    <summary>{copy.model}</summary>
    <p>{modelAnswer}</p>
  </details>
</section>

<script>
  const wordCount = (value: string): number => value.trim().split(/\s+/u).filter(Boolean).length
  for (const root of document.querySelectorAll<HTMLElement>('[data-teach-back]')) {
    const lessonKey = root.dataset.lessonKey
    const textarea = root.querySelector<HTMLTextAreaElement>('textarea')
    const status = root.querySelector<HTMLElement>('[role="status"]')
    if (!lessonKey || !textarea || !status) continue
    const storageKey = `ldd:teach-back:${lessonKey}`
    try { textarea.value = localStorage.getItem(storageKey) ?? '' } catch { textarea.value = '' }
    const update = (): void => {
      const valid = textarea.value.trim().length >= 80 && wordCount(textarea.value) >= 15
      root.dataset.complete = String(valid)
      status.lastChild!.textContent = valid
        ? (root.closest('[lang="pt-BR"]') ? ' Critério atingido.' : ' Requirement met.')
        : (root.closest('[lang="pt-BR"]') ? ' Salvo somente neste dispositivo.' : ' Saved only on this device.')
      try { localStorage.setItem(storageKey, textarea.value) } catch {}
      document.dispatchEvent(new CustomEvent('ldd:teach-back', { detail: { lessonKey, valid } }))
    }
    textarea.addEventListener('input', update)
    update()
  }
</script>

<style>
  .learning-check { border-block: 1px solid var(--rule-strong); }
  .learning-check__prompt { display: grid; grid-template-columns: auto 1fr; gap: var(--space-sm); padding-block: var(--space-lg); }
  .learning-check__prompt span { color: var(--sonar); font-size: var(--text-2xl); line-height: 1; }
  .learning-check__prompt p { margin: 0; font-size: var(--text-lg); }
  label, label > span { display: block; }
  label > span { margin-bottom: var(--space-xs); color: var(--ink-faint); font: var(--weight-semibold) var(--text-3xs) var(--font-data); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }
  textarea { display: block; width: 100%; resize: vertical; padding: var(--space-md); border: 1px solid var(--rule-strong); border-radius: var(--radius-sm); color: var(--ink); background: var(--paper-raised); font: var(--text-base) / var(--leading-normal) var(--font-body); }
  textarea::placeholder { color: var(--ink-faint); opacity: 1; }
  textarea:focus { border-color: var(--accent); outline: 3px solid color-mix(in srgb, var(--focus) 40%, transparent); outline-offset: 2px; }
  .learning-check__meta { display: flex; justify-content: space-between; gap: var(--space-md); padding-block: var(--space-sm); }
  .hint, .status { margin: 0; color: var(--ink-muted); font-size: var(--text-xs); }
  .status { white-space: nowrap; }
  .status span { color: var(--ink-faint); margin-right: var(--space-2xs); }
  [data-complete='true'] .status, [data-complete='true'] .status span { color: var(--kelp); font-weight: var(--weight-semibold); }
  details { padding-block: var(--space-md); border-top: 1px solid var(--rule); }
  summary { cursor: pointer; font: var(--weight-semibold) var(--text-sm) var(--font-ui); }
  @media (max-width: 34rem) { .learning-check__meta { display: grid; } .status { white-space: normal; } }
</style>
