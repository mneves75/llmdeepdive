---
import { renderModelAnswer } from './learning-model-answer'

interface Props { lessonKey: string; prompt: string; modelAnswer: string; locale: 'en' | 'pt-br' }
const { lessonKey, prompt, modelAnswer, locale } = Astro.props
const copy = locale === 'pt-br'
  ? { label: 'Explique com suas palavras', hint: 'Mínimo: 80 caracteres e 15 palavras.', privacy: 'Seu texto fica somente neste navegador.', placeholder: 'Reconstrua a ideia aqui…', waiting: 'Aguardando sua explicação.', clear: 'Apagar minha resposta', model: 'Comparar com uma resposta-modelo' }
  : { label: 'Explain it in your own words', hint: 'Minimum: 80 characters and 15 words.', privacy: 'Your writing stays only in this browser.', placeholder: 'Rebuild the idea here…', waiting: 'Waiting for your explanation.', clear: 'Clear my answer', model: 'Compare with a model answer' }
const modelAnswerParts = renderModelAnswer(modelAnswer)
---

<section class="learning-check" data-teach-back data-lesson-key={lessonKey}>
  <div class="learning-check__prompt"><span aria-hidden="true">⌁</span><p>{prompt}</p></div>
  <label>
    <span>{copy.label}</span>
    <textarea rows="8" minlength="80" placeholder={copy.placeholder}></textarea>
  </label>
  <div class="learning-check__meta">
    <p class="hint">{copy.hint} {copy.privacy}</p>
    <p class="status" role="status"><span aria-hidden="true">●</span><span data-status-text>{copy.waiting}</span></p>
  </div>
  {/* Hidden until the script runs: without JavaScript nothing was stored, so
      there is nothing to clear. */}
  <button type="button" class="clear" data-teach-back-clear hidden>{copy.clear}</button>
  <details>
    <summary>{copy.model}</summary>
    <p>{modelAnswerParts.map((part) => part.kind === 'math'
      ? <Fragment set:html={part.html} />
      : part.value)}</p>
  </details>
</section>

<script>
  const wordCount = (value: string): number => value.trim().split(/\s+/u).filter(Boolean).length
  for (const root of document.querySelectorAll<HTMLElement>('[data-teach-back]')) {
    const lessonKey = root.dataset.lessonKey
    const textarea = root.querySelector<HTMLTextAreaElement>('textarea')
    const statusText = root.querySelector<HTMLElement>('[data-status-text]')
    const clear = root.querySelector<HTMLButtonElement>('[data-teach-back-clear]')
    if (!lessonKey || !textarea || !statusText) continue
    const isPt = root.closest('[lang="pt-BR"]') !== null
    const storageKey = `ldd:teach-back:${lessonKey}`
    const waiting = statusText.textContent ?? ''
    // Loading an answer must not write one: persistence is only claimed for a
    // value this browser actually stored, and an unreadable store is not a
    // failed save until the learner tries to save something.
    let persisted = true
    try { textarea.value = localStorage.getItem(storageKey) ?? '' } catch { textarea.value = '' }
    const render = (): void => {
      const meetsRequirement = textarea.value.trim().length >= 80 && wordCount(textarea.value) >= 15
      const valid = meetsRequirement && persisted
      root.dataset.complete = String(valid)
      root.dataset.saveError = String(!persisted)
      statusText.textContent = !persisted
        ? (isPt ? 'Não foi possível salvar neste dispositivo. A lição não será marcada como concluída.' : 'Could not save on this device. The lesson will not be marked complete.')
        : meetsRequirement
          ? (isPt ? 'Critério atingido e salvo neste dispositivo.' : 'Requirement met and saved on this device.')
          : textarea.value.trim() === ''
            ? waiting
            : (isPt ? 'Salvo somente neste dispositivo.' : 'Saved only on this device.')
      document.dispatchEvent(new CustomEvent('ldd:teach-back', { detail: { lessonKey, valid } }))
    }
    textarea.addEventListener('input', () => {
      try {
        localStorage.setItem(storageKey, textarea.value)
        persisted = true
      } catch {
        persisted = false
      }
      render()
    })
    // The prose lives only in this browser, so this browser is the only place
    // a learner on a shared profile can remove it.
    if (clear) {
      clear.hidden = false
      clear.addEventListener('click', () => {
        try {
          localStorage.removeItem(storageKey)
        } catch {
          root.dataset.saveError = 'true'
          statusText.textContent = isPt ? 'Não foi possível apagar a resposta salva neste dispositivo.' : 'Could not clear the saved answer on this device.'
          return
        }
        textarea.value = ''
        persisted = true
        render()
        textarea.focus()
      })
    }
    render()
  }
</script>

<style>
  .learning-check { border-block: 1px solid var(--rule-strong); }
  .learning-check__prompt { display: grid; grid-template-columns: auto 1fr; gap: var(--space-sm); padding-block: var(--space-lg); }
  .learning-check__prompt span { color: var(--sonar); font-size: var(--text-2xl); line-height: 1; }
  .learning-check__prompt p { margin: 0; font-size: var(--text-lg); }
  label, label > span { display: block; }
  label > span { margin-bottom: var(--space-xs); color: var(--ink-faint); font: var(--weight-semibold) var(--text-3xs) var(--font-data); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }
  textarea { display: block; width: 100%; resize: vertical; padding: var(--space-md); border: 1px solid var(--rule-strong); border-radius: var(--radius-sm); color: var(--ink); background: var(--paper-raised); font: var(--text-base) / var(--leading-normal) var(--font-body); }
  textarea::placeholder { color: var(--ink-faint); opacity: 1; }
  textarea:focus { border-color: var(--accent); outline: 3px solid color-mix(in srgb, var(--focus) 40%, transparent); outline-offset: 2px; }
  .learning-check__meta { display: flex; justify-content: space-between; gap: var(--space-md); padding-block: var(--space-sm); }
  .hint, .status { margin: 0; color: var(--ink-muted); font-size: var(--text-xs); }
  .status { white-space: nowrap; }
  .status [aria-hidden] { color: var(--ink-faint); margin-right: var(--space-2xs); }
  [data-complete='true'] .status, [data-complete='true'] .status span { color: var(--kelp); font-weight: var(--weight-semibold); }
  [data-save-error='true'] .status, [data-save-error='true'] .status span { color: var(--coral); font-weight: var(--weight-semibold); }
  .clear { margin-block-end: var(--space-sm); padding: var(--space-2xs) var(--space-sm); border: 1px solid var(--rule-strong); border-radius: var(--radius-sm); color: var(--ink-muted); background: transparent; font: var(--text-xs) var(--font-ui); cursor: pointer; }
  .clear:hover { color: var(--ink); border-color: var(--ink-muted); }
  .clear:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  details { padding-block: var(--space-md); border-top: 1px solid var(--rule); }
  summary { cursor: pointer; font: var(--weight-semibold) var(--text-sm) var(--font-ui); }
  @media (max-width: 34rem) { .learning-check__meta { display: grid; } .status { white-space: normal; } }
</style>
