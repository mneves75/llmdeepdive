---
/**
 * The track's lessons beside the one being read.
 *
 * One element, two forms. It is a `popover`, so on narrower screens a button
 * opens it as a drawer with light dismiss, Escape and focus return for free;
 * on wide screens CSS shows it in place as a sticky sidebar (the user-agent
 * `display: none` of a closed popover is only a style, and is overridden).
 * No script.
 */
import { lessonPath, readingMinutes, type LessonEntry, type TrackEntry } from '~/lib/content'
import { positionOf, type Locale } from '~/lib/i18n'
import Icon from '~/components/Icon.astro'

interface Props {
  locale: Locale
  track: TrackEntry
  lessons: LessonEntry[]
  currentId: string
}

const { locale, track, lessons, currentId } = Astro.props
const ordered = [...lessons].sort((left, right) => left.data.order - right.data.order)
const copy = locale === 'pt-br'
  ? { label: `Aulas da trilha ${positionOf(track.data.id)}`, close: 'Fechar a lista de aulas', progress: '{n} de {m} concluídas', minutes: 'min' }
  : { label: `Lessons in track ${positionOf(track.data.id)}`, close: 'Close the lesson list', progress: '{n} of {m} complete', minutes: 'min' }
---

<nav class="syllabus" id="syllabus" popover aria-label={copy.label} data-syllabus data-tier={track.data.tier} data-pagefind-ignore>
  <div class="syllabus__head">
    <a class="syllabus__track" href={`${locale === 'pt-br' ? '/pt-br' : ''}/tracks/${track.data.id}/`}>
      <span class="syllabus__number" data-numeric>{positionOf(track.data.id)}</span>
      <span class="plate-name">{track.data.title}</span>
    </a>
    <button class="syllabus__close" type="button" popovertarget="syllabus" popovertargetaction="hide">
      <Icon name="close" /><span class="visually-hidden">{copy.close}</span>
    </button>
  </div>
  <p class="syllabus__progress" data-course-progress data-lesson-ids={ordered.map((lesson) => lesson.data.id).join(' ')} data-template={copy.progress} hidden>
    <span data-count></span>
  </p>
  <ol>
    {ordered.map((lesson) => {
      const current = lesson.data.id === currentId
      return (
        <li data-lesson-key={`${locale}:${lesson.data.id}`}>
          <a href={lessonPath(locale, lesson)} aria-current={current ? 'page' : undefined}>
            <span class="star-mark" aria-hidden="true"></span>
            <span class="syllabus__position" data-numeric>{positionOf(lesson.data.id)}</span>
            <span class="syllabus__title">{lesson.data.title}</span>
            <span class="syllabus__minutes" data-numeric>{readingMinutes(lesson)} {copy.minutes}</span>
          </a>
        </li>
      )
    })}
  </ol>
</nav>

<style>
  .syllabus {
    /* Preflight zeroes the popover's user-agent margin and inset; restate the
       drawer geometry explicitly (the same trap the search <dialog> hit). */
    position: fixed;
    inset: 0 auto 0 0;
    width: min(24rem, 100vw - 2.5rem);
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: var(--space-md) var(--space-sm) var(--space-xl);
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--ink);
    background: var(--plate);
    border: 0;
    border-right: 1px solid var(--rule-strong);
    box-shadow: var(--shadow-overlay);
  }
  .syllabus::backdrop { background: rgb(4 8 21 / 0.42); }
  @media (prefers-reduced-motion: no-preference) {
    .syllabus { transition: translate var(--dur-base) var(--ease-out), display var(--dur-base) allow-discrete, overlay var(--dur-base) allow-discrete; }
    .syllabus:popover-open { translate: 0 0; }
    @starting-style { .syllabus:popover-open { translate: -100% 0; } }
    .syllabus:not(:popover-open) { translate: -100% 0; }
  }

  .syllabus__head { display: flex; align-items: start; justify-content: space-between; gap: var(--space-sm); }
  .syllabus__track { display: grid; gap: var(--space-3xs); padding-block: var(--space-2xs); color: var(--ink); text-decoration: none; }
  .syllabus__track:hover { color: var(--tier); }
  .syllabus__number { color: var(--tier); font: var(--weight-bold) var(--text-2xl) / 1 var(--font-display); font-stretch: var(--stretch-wide); }
  .syllabus__track .plate-name { font-size: var(--text-2xs); line-height: 1.35; }
  .syllabus__close { display: grid; place-items: center; width: 2.75rem; aspect-ratio: 1; flex: none; padding: 0; border: 1px solid var(--rule); border-radius: var(--radius-sm); color: var(--ink-muted); background: transparent; cursor: pointer; }
  .syllabus__close:hover { color: var(--ink); border-color: var(--rule-strong); }
  .syllabus__progress { margin: var(--space-2xs) 0 0; color: var(--success); font: var(--weight-semibold) var(--text-xs) var(--font-ui); }

  .syllabus ol {
    position: relative;
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
  }
  /* The constellation line the marks hang on. */
  .syllabus ol::before { content: ''; position: absolute; left: calc(0.5rem + 0.9rem - 0.5px); top: 1.2rem; bottom: 1.2rem; width: 1px; background: var(--tier); opacity: 0.45; }
  .syllabus li a {
    position: relative;
    display: grid;
    grid-template-columns: 1.8rem 2.4rem minmax(0, 1fr) auto;
    column-gap: var(--space-2xs);
    align-items: baseline;
    min-height: 2.75rem;
    padding: 0.55rem 0.5rem 0.55rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: 1.35;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .syllabus li a:hover { color: var(--ink); background: var(--plate-raised); }
  .syllabus .star-mark { align-self: start; justify-self: center; margin-top: 0.28em; background: var(--plate); }
  .syllabus__position { color: var(--ink-faint); font: var(--text-xs) var(--font-data); }
  .syllabus__minutes { color: var(--ink-faint); font: var(--text-3xs) var(--font-data); white-space: nowrap; }
  .syllabus li a[aria-current='page'] { color: var(--ink); font-weight: var(--weight-semibold); }
  .syllabus li a[aria-current='page'] .star-mark { outline: 1.5px solid var(--reticle); outline-offset: 3px; }
  .syllabus li a[aria-current='page'] .syllabus__position { color: var(--reticle); }
  .syllabus li[data-complete='true'] > a > .star-mark { background: var(--tier); }

  /* Wide screens: in place, sticky, no drawer. */
  @media (min-width: 80rem) {
    .syllabus,
    .syllabus:not(:popover-open) {
      position: sticky;
      top: calc(var(--header-h) + var(--space-md));
      inset: auto;
      display: block;
      width: auto;
      height: auto;
      max-height: calc(100dvh - var(--header-h) - var(--space-xl));
      padding: 0 var(--space-2xs) var(--space-md) 0;
      translate: none;
      background: transparent;
      border: 0;
      box-shadow: none;
      scrollbar-width: thin;
    }
    .syllabus__close { display: none; }
    /* Lesson to lesson, the syllabus holds still; only its marks change. */
    .syllabus { view-transition-name: syllabus; }
  }
</style>
