---
import { formatInputValue } from '../../lib/lab-form'
import { labFormatters, upToOneDecimal, videoTokens } from '../../lib/lab-math'
/**
 * Lesson 10.1 — how many visual tokens a video clip becomes, made adjustable.
 *
 * The lesson works one clip by hand (60 s at 2 fps, 512 × 384 frames, Qwen3-VL's
 * 16-pixel patches, 2 × 2 spatial merge and two-frame temporal patches) and
 * this lab lets a reader move every one of those numbers. Width and height are
 * the frame size the encoder actually receives, after the processor's own
 * resize to its pixel budget; the lab does not model that budget, the
 * processor's 4–768 frame clamp, or the timestamp text tokens, and its note
 * says so.
 *
 * Server-rendered with its defaults already computed, so a reader without
 * JavaScript still gets the worked example rather than an apology.
 */
interface Props { locale: 'en' | 'pt-br' }
const { locale } = Astro.props
const isPt = locale === 'pt-br'

const copy = isPt
  ? {
      legend: 'Orçamento de tokens de um vídeo',
      seconds: 'Duração do clipe (s)',
      fps: 'Taxa de amostragem (frames/s)',
      width: 'Largura do frame no encoder (px)',
      height: 'Altura do frame no encoder (px)',
      patch: 'Patch espacial (px)',
      merge: 'Merge espacial',
      temporal: 'Patch temporal (frames)',
      context: 'Janela de contexto (tokens)',
      frames: 'Frames amostrados',
      groups: 'Grupos temporais',
      perGroup: 'Tokens por grupo',
      perFrame: 'Tokens por frame (efetivo)',
      total: 'Tokens visuais',
      share: 'Fração da janela',
      fits: 'Cabe, e sobra mais da metade da janela para texto.',
      tight: 'Cabe, mas o vídeo sozinho já ocupa mais da metade da janela.',
      over: 'Não cabe: só o vídeo já estoura a janela de contexto.',
      invalid: 'Informe duração entre 0,5 e 36.000 s, taxa entre 0,1 e 60 frames/s e lados entre 16 e 8.192 px, com pelo menos um frame amostrado. Use vírgula ou ponto para decimais.',
      note: 'Padrões: as configurações publicadas do Qwen3-VL (patch 16, merge 2 × 2, patch temporal 2, 2 fps). Largura e altura são o frame que o encoder recebe depois do resize do processador; cada lado é arredondado ao múltiplo de patch × merge mais próximo, com empate para o par. O laboratório mostra a aritmética sem limite: nos padrões publicados do Qwen3-VL-8B, o orçamento de pixels do processador encolheria os frames e limitaria qualquer clipe a cerca de 12.288 tokens. Também não modelados: o limite de 4 a 768 frames e os tokens de texto dos timestamps.',
    }
  : {
      legend: 'Token budget of one video',
      seconds: 'Clip length (s)',
      fps: 'Sampling rate (frames/s)',
      width: 'Frame width at the encoder (px)',
      height: 'Frame height at the encoder (px)',
      patch: 'Spatial patch (px)',
      merge: 'Spatial merge',
      temporal: 'Temporal patch (frames)',
      context: 'Context window (tokens)',
      frames: 'Sampled frames',
      groups: 'Temporal groups',
      perGroup: 'Tokens per group',
      perFrame: 'Tokens per frame (effective)',
      total: 'Visual tokens',
      share: 'Share of window',
      fits: 'Fits, leaving more than half the window for text.',
      tight: 'Fits, but the video alone takes more than half the window.',
      over: 'Does not fit: the video alone overflows the context window.',
      invalid: 'Enter a length from 0.5 to 36,000 s, a rate from 0.1 to 60 frames/s and sides from 16 to 8,192 px, with at least one sampled frame.',
      note: "Defaults: Qwen3-VL's published settings (patch 16, 2 × 2 merge, temporal patch 2, 2 fps). Width and height are the frame the encoder receives after the processor's resize; each side snaps to the nearest multiple of patch × merge, ties to even. The lab shows the uncapped arithmetic: under the released Qwen3-VL-8B defaults, the processor's pixel budget would shrink frames and cap any clip near 12,288 tokens. Also not modelled: its 4–768 frame clamp and the text tokens of the timestamps.",
    }

// Defaults mirror the worked example in the lesson body.
const defaults = { seconds: 60, fps: 2, width: 512, height: 384, patch: 16, merge: 2, temporal: 2, context: 262144 }
const worked = videoTokens(defaults)
if (worked === null) throw new Error('VideoTokenLab defaults must produce a result')

const patches = [14, 16]
const merges = [1, 2]
const temporals = [1, 2]
const contexts = [32768, 131072, 262144]
const { whole, oneDecimal } = labFormatters(locale)
const perFrameFormat = upToOneDecimal(locale)
---

<form class="lab" data-lab="video-tokens" aria-label={copy.legend}>
  <div class="lab__controls">
    <label>
      <span>{copy.seconds}</span>
      <input type="text" name="seconds" value={formatInputValue(defaults.seconds, locale)} data-min="0.5" data-max="36000" inputmode="decimal" autocomplete="off" spellcheck="false" required />
    </label>
    <label>
      <span>{copy.fps}</span>
      <input type="text" name="fps" value={formatInputValue(defaults.fps, locale)} data-min="0.1" data-max="60" inputmode="decimal" autocomplete="off" spellcheck="false" required />
    </label>
    <label>
      <span>{copy.width}</span>
      <input type="text" name="width" value={formatInputValue(defaults.width, locale)} data-min="16" data-max="8192" inputmode="decimal" autocomplete="off" spellcheck="false" required />
    </label>
    <label>
      <span>{copy.height}</span>
      <input type="text" name="height" value={formatInputValue(defaults.height, locale)} data-min="16" data-max="8192" inputmode="decimal" autocomplete="off" spellcheck="false" required />
    </label>
    <label>
      <span>{copy.patch}</span>
      <select name="patch">
        {patches.map((p) => <option value={p} selected={p === defaults.patch}>{p}</option>)}
      </select>
    </label>
    <label>
      <span>{copy.merge}</span>
      <select name="merge">
        {merges.map((m) => <option value={m} selected={m === defaults.merge}>{`${m} × ${m}`}</option>)}
      </select>
    </label>
    <label>
      <span>{copy.temporal}</span>
      <select name="temporal">
        {temporals.map((t) => <option value={t} selected={t === defaults.temporal}>{t}</option>)}
      </select>
    </label>
    <label>
      <span>{copy.context}</span>
      <select name="context">
        {contexts.map((c) => <option value={c} selected={c === defaults.context}>{whole.format(c)}</option>)}
      </select>
    </label>
  </div>

  {/* Always in the accessibility tree, empty until needed: a live region that
      only appears when it is revealed is often never announced. */}
  <p class="lab__validation" data-out="validation" data-invalid={copy.invalid} role="status"></p>

  <output class="lab__out" aria-live="polite">
    <div class="lab__stat"><span>{copy.frames}</span><b data-out="frames">{whole.format(worked.frames)}</b></div>
    <div class="lab__stat"><span>{copy.groups}</span><b data-out="groups">{whole.format(worked.groups)}</b></div>
    <div class="lab__stat"><span>{copy.perGroup}</span><b data-out="pergroup">{whole.format(worked.perGroup)}</b></div>
    <div class="lab__stat"><span>{copy.perFrame}</span><b data-out="perframe">{perFrameFormat.format(worked.perFrame)}</b></div>
    <div class="lab__stat lab__stat--lead"><span>{copy.total}</span><b data-out="total">{whole.format(worked.total)}</b></div>
    <div class="lab__stat"><span>{copy.share}</span><b data-out="share">{oneDecimal.format(worked.share)}%</b></div>
  </output>

  {/* The script reads verdict copy from data-* so it stays data-free (CSP). */}
  <p class="lab__verdict" data-out="verdict" data-fits={copy.fits} data-tight={copy.tight} data-over={copy.over}>{copy[worked.verdict]}</p>
  <p class="lab__note">{copy.note}</p>
</form>

<script>
  import { pageLocale, readLabControl, showLabOutputs } from '../../lib/lab-form'
  import { labFormatters, upToOneDecimal, videoTokens } from '../../lib/lab-math'

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lab="video-tokens"]')) {
    const locale = pageLocale(form)
    const { whole, oneDecimal } = labFormatters(locale)
    const perFrameFormat = upToOneDecimal(locale)
    const invalid = form.querySelector<HTMLElement>('[data-out="validation"]')?.dataset.invalid ?? ''
    const verdicts = form.querySelector<HTMLElement>('[data-out="verdict"]')?.dataset ?? {}
    const blank = { frames: '—', groups: '—', pergroup: '—', perframe: '—', total: '—', share: '—', verdict: '' }

    const update = (): void => {
      // Read every control before deciding, so each invalid one is marked.
      const [seconds, fps, width, height, patch, merge, temporal, context] = ['seconds', 'fps', 'width', 'height', 'patch', 'merge', 'temporal', 'context'].map((name) => readLabControl(form, name, locale))
      if (seconds == null || fps == null || width == null || height == null || patch == null || merge == null || temporal == null || context == null) {
        showLabOutputs(form, blank, invalid)
        return
      }
      // Valid fields can still sample zero frames (0.6 s at 1 fps): nothing to count.
      const result = videoTokens({ seconds, fps, width, height, patch, merge, temporal, context })
      if (result === null) {
        showLabOutputs(form, blank, invalid)
        return
      }
      showLabOutputs(form, {
        frames: whole.format(result.frames),
        groups: whole.format(result.groups),
        pergroup: whole.format(result.perGroup),
        perframe: perFrameFormat.format(result.perFrame),
        total: whole.format(result.total),
        share: `${oneDecimal.format(result.share)}%`,
        verdict: verdicts[result.verdict] ?? '',
      }, '')
    }

    form.addEventListener('input', update)
    form.addEventListener('change', update)
    form.addEventListener('submit', (event) => { event.preventDefault(); update() })
    update()
  }
</script>

