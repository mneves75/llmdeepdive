---
import { formatInputValue } from '../../lib/lab-form'
import { SAMPLING_PRESETS, sampleDistribution } from '../../lib/sampling-math'
/**
 * Lesson 7.4 — Interactive next-token sampling lab: Temperature, Top-K, Top-P
 * (nucleus), and Min-P over realistic logit presets.
 *
 * Reuses `src/styles/lab.css` (`.lab__loads` table + `--share` bars) so it
 * adds zero bytes to lesson CSS and zero CSP hashes, while server-rendering
 * exact Qwen3.8-27B instruct defaults (`T = 0.7`, `top-p = 0.80`, `min-p = 0`).
 */
interface Props { locale: 'en' | 'pt-br' }
const { locale } = Astro.props
const isPt = locale === 'pt-br'

const copy = isPt
  ? {
      legend: 'Amostragem do próximo token: temperature, top-k, top-p e min-p',
      preset: 'Contexto de entrada (logits)',
      temperature: 'Temperature (0,05 a 5,0)',
      topK: 'Top-k (1 a 6)',
      topP: 'Top-p / nucleus (0,05 a 1,0)',
      minP: 'Min-p (0,0 a 1,0)',
      leader: 'Líder após filtro',
      survivors: 'Tokens mantidos',
      entropy: 'Entropia (bits)',
      choices: 'Opções efetivas (2^H)',
      colToken: 'Token',
      colLogit: 'Logit',
      colRaw: 'Softmax bruto',
      colFinal: 'Após filtros',
      cut: 'cortado',
      invalid: 'Informe temperature (0,05–5,0), top-k inteiro (1–6), top-p (0,05–1,0) e min-p (0,0–1,0).',
      note: 'A temperature reescala os logits antes do softmax; top-k, min-p e top-p cortam a cauda e renormalizam os sobreviventes para somar 100%. Compare "Fato" com "Texto livre" em T = 0,7 vs T = 1,0.',
    }
  : {
      legend: 'Next-token sampling: temperature, top-k, top-p and min-p',
      preset: 'Input context (logits)',
      temperature: 'Temperature (0.05 to 5.0)',
      topK: 'Top-k (1 to 6)',
      topP: 'Top-p / nucleus (0.05 to 1.0)',
      minP: 'Min-p (0.0 to 1.0)',
      leader: 'Top token share',
      survivors: 'Surviving tokens',
      entropy: 'Entropy (bits)',
      choices: 'Effective choices (2^H)',
      colToken: 'Token',
      colLogit: 'Logit',
      colRaw: 'Raw softmax',
      colFinal: 'After filters',
      cut: 'cut',
      invalid: 'Enter temperature (0.05–5.0), whole top-k (1–6), top-p (0.05–1.0), and min-p (0.0–1.0).',
      note: 'Temperature rescales logits before softmax; top-k, min-p, and top-p prune the tail and renormalize survivors to sum to 100%. Compare "Factual recall" against "Open text" at T = 0.7 vs T = 1.0.',
    }

const defaultPreset = SAMPLING_PRESETS[1]!
const defaults = { temperature: 0.7, topK: 4, topP: 0.8, minP: 0 }
const result = sampleDistribution({
  candidates: defaultPreset.candidates,
  temperature: defaults.temperature,
  topK: defaults.topK,
  topP: defaults.topP,
  minP: defaults.minP,
})!

const tag = isPt ? 'pt-BR' : 'en-US'
const pct = new Intl.NumberFormat(tag, { minimumFractionDigits: 1, maximumFractionDigits: 1 })
const two = new Intl.NumberFormat(tag, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
const one = new Intl.NumberFormat(tag, { minimumFractionDigits: 1, maximumFractionDigits: 1 })
---

<form class="lab" data-lab="token-sampling" aria-label={copy.legend}>
  <p class="lab__lead">{copy.legend} — <strong data-out="prompt">{defaultPreset.prompt[locale]}</strong></p>

  <div class="lab__controls">
    <label>
      <span>{copy.preset}</span>
      <select name="preset">
        {SAMPLING_PRESETS.map((p) => (
          <option value={p.id} selected={p.id === defaultPreset.id}>{p.label[locale]}</option>
        ))}
      </select>
    </label>
    <label>
      <span>{copy.temperature}</span>
      <input type="text" name="temperature" value={formatInputValue(defaults.temperature, locale)} data-min="0.05" data-max="5" inputmode="decimal" autocomplete="off" spellcheck="false" required />
    </label>
    <label>
      <span>{copy.topK}</span>
      <input type="text" name="topK" value={formatInputValue(defaults.topK, locale)} data-min="1" data-max="6" data-integer="" inputmode="numeric" autocomplete="off" spellcheck="false" required />
    </label>
    <label>
      <span>{copy.topP}</span>
      <input type="text" name="topP" value={formatInputValue(defaults.topP, locale)} data-min="0.05" data-max="1" inputmode="decimal" autocomplete="off" spellcheck="false" required />
    </label>
    <label>
      <span>{copy.minP}</span>
      <input type="text" name="minP" value={formatInputValue(defaults.minP, locale)} data-min="0" data-max="1" inputmode="decimal" autocomplete="off" spellcheck="false" required />
    </label>
  </div>

  <p class="lab__validation" data-out="validation" data-invalid={copy.invalid} role="status"></p>

  <output class="lab__out" aria-live="polite">
    <div class="lab__stat lab__stat--lead"><span>{copy.leader}</span><b data-out="leader">{`${pct.format(result.leaderProb * 100)}%`}</b></div>
    <div class="lab__stat"><span>{copy.survivors}</span><b data-out="survivors">{`${result.survivorCount} / ${result.tokens.length}`}</b></div>
    <div class="lab__stat"><span>{copy.entropy}</span><b data-out="entropy">{two.format(result.entropyBits)}</b></div>
    <div class="lab__stat"><span>{copy.choices}</span><b data-out="choices">{two.format(result.effectiveChoices)}</b></div>
  </output>

  <table class="lab__loads" data-sampling-table data-cut={copy.cut}>
    <thead>
      <tr>
        <th scope="col">{copy.colToken}</th>
        <th scope="col">{copy.colLogit}</th>
        <th scope="col">{copy.colRaw}</th>
        <th scope="col">{copy.colFinal}</th>
      </tr>
    </thead>
    <tbody>
      {result.tokens.map((row, index) => (
        <tr data-row={index}>
          <th scope="row" data-col="token">{row.token}</th>
          <td data-col="logit">{one.format(row.logit)}</td>
          <td>
            <div class="lab__load-cell">
              <span class="lab__load-bar"><i data-bar="raw" style={`--share: ${row.rawProb.toFixed(4)}`}></i></span>
              <b data-col="raw">{`${pct.format(row.rawProb * 100)}%`}</b>
            </div>
          </td>
          <td>
            <div class="lab__load-cell">
              <span class="lab__load-bar lab__load-bar--after"><i data-bar="final" style={`--share: ${row.finalProb.toFixed(4)}`}></i></span>
              <b data-col="final">{row.kept ? `${pct.format(row.finalProb * 100)}%` : copy.cut}</b>
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <p class="lab__note">{copy.note}</p>
</form>

<script>
  import { pageLocale, readLabControl, showLabOutputs } from '../../lib/lab-form'
  import { SAMPLING_PRESETS, sampleDistribution } from '../../lib/sampling-math'

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lab="token-sampling"]')) {
    const locale = pageLocale(form)
    const tag = locale === 'pt-br' ? 'pt-BR' : 'en-US'
    const pct = new Intl.NumberFormat(tag, { minimumFractionDigits: 1, maximumFractionDigits: 1 })
    const two = new Intl.NumberFormat(tag, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
    const one = new Intl.NumberFormat(tag, { minimumFractionDigits: 1, maximumFractionDigits: 1 })
    const invalid = form.querySelector<HTMLElement>('[data-out="validation"]')?.dataset.invalid ?? ''
    const promptEl = form.querySelector<HTMLElement>('[data-out="prompt"]')
    const table = form.querySelector<HTMLTableElement>('[data-sampling-table]')
    const cutLabel = table?.dataset.cut ?? 'cut'
    const select = form.querySelector<HTMLSelectElement>('select[name="preset"]')

    const update = (): void => {
      const preset = SAMPLING_PRESETS.find((p) => p.id === select?.value) ?? SAMPLING_PRESETS[0]!
      if (promptEl) promptEl.textContent = preset.prompt[locale]

      const temperature = readLabControl(form, 'temperature', locale)
      const topK = readLabControl(form, 'topK', locale)
      const topP = readLabControl(form, 'topP', locale)
      const minP = readLabControl(form, 'minP', locale)

      const blank = { leader: '—', survivors: '—', entropy: '—', choices: '—' }
      if (temperature == null || topK == null || topP == null || minP == null) {
        showLabOutputs(form, blank, invalid)
        for (const tr of form.querySelectorAll<HTMLTableRowElement>('tr[data-row]')) {
          const rawOut = tr.querySelector<HTMLElement>('[data-col="raw"]')
          const finOut = tr.querySelector<HTMLElement>('[data-col="final"]')
          const rawBar = tr.querySelector<HTMLElement>('[data-bar="raw"]')
          const finBar = tr.querySelector<HTMLElement>('[data-bar="final"]')
          if (rawOut) rawOut.textContent = '—'
          if (finOut) finOut.textContent = '—'
          rawBar?.style.setProperty('--share', '0')
          finBar?.style.setProperty('--share', '0')
        }
        return
      }

      const result = sampleDistribution({
        candidates: preset.candidates,
        temperature,
        topK,
        topP,
        minP,
      })
      if (!result) {
        showLabOutputs(form, blank, invalid)
        return
      }

      showLabOutputs(form, {
        leader: `${pct.format(result.leaderProb * 100)}%`,
        survivors: `${result.survivorCount} / ${result.tokens.length}`,
        entropy: two.format(result.entropyBits),
        choices: two.format(result.effectiveChoices),
      }, '')

      result.tokens.forEach((row, index) => {
        const tr = form.querySelector<HTMLTableRowElement>(`tr[data-row="${index}"]`)
        if (!tr) return
        const tok = tr.querySelector<HTMLElement>('[data-col="token"]')
        const log = tr.querySelector<HTMLElement>('[data-col="logit"]')
        const rawOut = tr.querySelector<HTMLElement>('[data-col="raw"]')
        const finOut = tr.querySelector<HTMLElement>('[data-col="final"]')
        const rawBar = tr.querySelector<HTMLElement>('[data-bar="raw"]')
        const finBar = tr.querySelector<HTMLElement>('[data-bar="final"]')
        if (tok) tok.textContent = row.token
        if (log) log.textContent = one.format(row.logit)
        if (rawOut) rawOut.textContent = `${pct.format(row.rawProb * 100)}%`
        if (finOut) finOut.textContent = row.kept ? `${pct.format(row.finalProb * 100)}%` : cutLabel
        rawBar?.style.setProperty('--share', row.rawProb.toFixed(4))
        finBar?.style.setProperty('--share', row.finalProb.toFixed(4))
      })
    }

    form.addEventListener('input', update)
    form.addEventListener('change', update)
    form.addEventListener('submit', (event) => { event.preventDefault(); update() })
    update()
  }
</script>
