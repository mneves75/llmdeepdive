---
import { formatInputValue } from '../../lib/lab-form'
import { labFormatters, retryBudget } from '../../lib/lab-math'
/**
 * Lesson 21.4 — what a bounded repair loop costs and how often it escalates.
 *
 * The loop stops at the first success or after the last attempt. The maths
 * assumes independent attempts, and the note says why real ones are not.
 * Server-rendered with the lesson's worked example.
 */
interface Props { locale: 'en' | 'pt-br' }
const { locale } = Astro.props
const isPt = locale === 'pt-br'

const copy = isPt
  ? {
      legend: 'Orçamento de um laço de reparo',
      success: 'Chance de uma tentativa passar nos testes (0 a 1)',
      attempts: 'Tentativas de reparo, no máximo',
      cost: 'Custo por tentativa (USD)',
      pSuccess: 'Termina com sucesso',
      pEscalate: 'Escala para uma pessoa',
      expected: 'Tentativas esperadas',
      expectedCost: 'Custo esperado',
      worst: 'Custo no pior caso',
      invalid: 'Informe uma chance entre 0 e 1, de 1 a 20 tentativas inteiras e um custo não negativo. Use vírgula ou ponto para decimais.',
      note: 'Supõe tentativas independentes. Na prática, uma tentativa que falhou por um motivo que a próxima compartilha (o teste está errado, falta contexto, o bug está fora dos arquivos permitidos) torna a escalada mais provável do que este número. Orce pelo pior caso, não pela média.',
    }
  : {
      legend: 'Budget of a repair loop',
      success: 'Chance one attempt passes the tests (0 to 1)',
      attempts: 'Repair attempts, at most',
      cost: 'Cost per attempt (USD)',
      pSuccess: 'Ends in success',
      pEscalate: 'Escalates to a person',
      expected: 'Expected attempts',
      expectedCost: 'Expected cost',
      worst: 'Worst-case cost',
      invalid: 'Enter a chance from 0 to 1, a whole number of attempts from 1 to 20 and a cost of zero or more.',
      note: 'Assumes independent attempts. In practice an attempt that failed for a reason the next one shares (the test is wrong, context is missing, the bug is outside the allowed files) makes escalation more likely than this number. Budget for the worst case, not the average.',
    }

const defaults = { success: 0.4, attempts: 3, costPerAttempt: 0.12 }
const result = retryBudget(defaults)
const { oneDecimal } = labFormatters(locale)
const tag = isPt ? 'pt-BR' : 'en-US'
const percent = (value: number): string => `${oneDecimal.format(value * 100)}%`
const money = new Intl.NumberFormat(tag, { minimumFractionDigits: 2, maximumFractionDigits: 4 })
const usd = (value: number): string => `USD ${money.format(value)}`
const twoDecimals = new Intl.NumberFormat(tag, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
---

<form class="lab" data-lab="retry-budget" aria-label={copy.legend}>
  <div class="lab__controls">
    <label>
      <span>{copy.success}</span>
      <input type="text" name="success" value={formatInputValue(defaults.success, locale)} data-min="0" data-max="1" inputmode="decimal" autocomplete="off" spellcheck="false" required />
    </label>
    <label>
      <span>{copy.attempts}</span>
      <input type="text" name="attempts" value={formatInputValue(defaults.attempts, locale)} data-min="1" data-max="20" inputmode="numeric" autocomplete="off" spellcheck="false" required />
    </label>
    <label>
      <span>{copy.cost}</span>
      <input type="text" name="cost" value={formatInputValue(defaults.costPerAttempt, locale)} data-min="0" data-max="1000000" inputmode="decimal" autocomplete="off" spellcheck="false" required />
    </label>
  </div>

  <p class="lab__validation" data-out="validation" data-invalid={copy.invalid} role="status"></p>

  <output class="lab__out" aria-live="polite">
    <div class="lab__stat"><span>{copy.pSuccess}</span><b data-out="success">{percent(result.pSuccess)}</b></div>
    <div class="lab__stat lab__stat--lead"><span>{copy.pEscalate}</span><b data-out="escalate">{percent(result.pEscalate)}</b></div>
    <div class="lab__stat"><span>{copy.expected}</span><b data-out="expected">{twoDecimals.format(result.expectedAttempts)}</b></div>
    <div class="lab__stat"><span>{copy.expectedCost}</span><b data-out="expectedCost">{usd(result.expectedCost)}</b></div>
    <div class="lab__stat"><span>{copy.worst}</span><b data-out="worst">{usd(result.worstCost)}</b></div>
  </output>

  <p class="lab__note">{copy.note}</p>
</form>

<script>
  import { pageLocale, readLabControl, showLabOutputs } from '../../lib/lab-form'
  import { labFormatters, retryBudget } from '../../lib/lab-math'

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lab="retry-budget"]')) {
    const locale = pageLocale(form)
    const tag = locale === 'pt-br' ? 'pt-BR' : 'en-US'
    const { oneDecimal } = labFormatters(locale)
    const money = new Intl.NumberFormat(tag, { minimumFractionDigits: 2, maximumFractionDigits: 4 })
    const twoDecimals = new Intl.NumberFormat(tag, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
    const invalid = form.querySelector<HTMLElement>('[data-out="validation"]')?.dataset.invalid ?? ''

    const update = (): void => {
      const [success, attempts, cost] = ['success', 'attempts', 'cost'].map((name) => readLabControl(form, name, locale))
      if (success == null || attempts == null || cost == null || !Number.isInteger(attempts)) {
        showLabOutputs(form, { success: '—', escalate: '—', expected: '—', expectedCost: '—', worst: '—' }, invalid)
        return
      }
      const result = retryBudget({ success, attempts, costPerAttempt: cost })
      showLabOutputs(form, {
        success: `${oneDecimal.format(result.pSuccess * 100)}%`,
        escalate: `${oneDecimal.format(result.pEscalate * 100)}%`,
        expected: twoDecimals.format(result.expectedAttempts),
        expectedCost: `USD ${money.format(result.expectedCost)}`,
        worst: `USD ${money.format(result.worstCost)}`,
      }, '')
    }

    form.addEventListener('input', update)
    form.addEventListener('change', update)
    form.addEventListener('submit', (event) => { event.preventDefault(); update() })
    update()
  }
</script>
