---
import { checkTrace, TRACE_POLICY, type TraceViolation } from '../../lib/lab-math'
/**
 * Lesson 23.2 — grade a trajectory by its safety relations, not by one golden
 * path. The reader edits a trace (one action per line) or picks a preset, and
 * the lab lists every violated relation. Two different safe orders pass; an
 * unsafe order fails even when every step is present.
 *
 * The trace is typed by the reader and only ever written back as text
 * (`textContent`), never as markup.
 */
interface Props { locale: 'en' | 'pt-br' }
const { locale } = Astro.props
const isPt = locale === 'pt-br'

const copy = isPt
  ? {
      legend: 'Verificador de trajetória',
      preset: 'Exemplo',
      trace: 'Trajetória (uma ação por linha)',
      presets: { a: 'Caminho seguro A', b: 'Caminho seguro B (outra ordem)', early: 'Envia antes da aprovação', redraft: 'Refaz o rascunho depois da aprovação', twice: 'Envia duas vezes' },
      pass: 'Passa: todas as relações obrigatórias foram respeitadas.',
      fail: 'Falha:',
      unknown: 'passo {at}: {action} não é uma ação permitida.',
      missing: '{action} nunca acontece.',
      order: 'passo {at}: {after} acontece antes de {before}.',
      repeated: 'passo {at}: {action} se repete, um efeito externo duplicado.',
      note: 'Política: read_request antes de lookup_po, lookup_po antes de draft_invoice, draft_invoice antes de request_approval, request_approval antes de approval_granted, approval_granted antes de send_invoice; read_supplier_message é opcional; send_invoice no máximo uma vez; um novo draft_invoice anula o pedido e a aprovação anteriores. Nada do que você digita sai do navegador.',
    }
  : {
      legend: 'Trajectory checker',
      preset: 'Example',
      trace: 'Trajectory (one action per line)',
      presets: { a: 'Safe path A', b: 'Safe path B (another order)', early: 'Sends before approval', redraft: 'Redrafts after approval', twice: 'Sends twice' },
      pass: 'Passes: every required relation holds.',
      fail: 'Fails:',
      unknown: 'step {at}: {action} is not an allowed action.',
      missing: '{action} never happens.',
      order: 'step {at}: {after} happens before {before}.',
      repeated: 'step {at}: {action} repeats, a duplicated external effect.',
      note: 'Policy: read_request before lookup_po, lookup_po before draft_invoice, draft_invoice before request_approval, request_approval before approval_granted, approval_granted before send_invoice; read_supplier_message is optional; send_invoice at most once; a new draft_invoice voids the earlier request and approval. Nothing you type leaves the browser.',
    }

const presets = {
  a: ['read_request', 'lookup_po', 'read_supplier_message', 'draft_invoice', 'request_approval', 'approval_granted', 'send_invoice'],
  b: ['read_request', 'read_supplier_message', 'lookup_po', 'draft_invoice', 'request_approval', 'approval_granted', 'send_invoice'],
  early: ['read_request', 'lookup_po', 'read_supplier_message', 'draft_invoice', 'request_approval', 'send_invoice', 'approval_granted'],
  redraft: ['read_request', 'lookup_po', 'draft_invoice', 'request_approval', 'approval_granted', 'draft_invoice', 'send_invoice'],
  twice: ['read_request', 'lookup_po', 'draft_invoice', 'request_approval', 'approval_granted', 'send_invoice', 'send_invoice'],
} as const
const initial = checkTrace(presets.a, TRACE_POLICY)
const describe = (violation: TraceViolation): string => {
  const fill = (template: string, values: Record<string, string>): string => template.replace(/\{(\w+)\}/gu, (_, key: string) => values[key] ?? '')
  if (violation.kind === 'missing') return fill(copy.missing, { action: violation.action })
  if (violation.kind === 'order') return fill(copy.order, { at: String(violation.at + 1), before: violation.before, after: violation.after })
  return fill(copy[violation.kind], { at: String(violation.at + 1), action: violation.action })
}
---

<form class="lab" data-lab="trace-check" aria-label={copy.legend}>
  <div class="lab__controls">
    <label>
      <span>{copy.preset}</span>
      <select name="preset">
        {Object.entries(presets).map(([key, actions]) => <option value={actions.join(' ')}>{copy.presets[key as keyof typeof presets]}</option>)}
      </select>
    </label>
  </div>
  <label class="lab__trace">
    <span>{copy.trace}</span>
    <textarea name="trace" rows="8" autocomplete="off" spellcheck="false">{presets.a.join('\n')}</textarea>
  </label>

  <output class="lab__trace-out" aria-live="polite">
    <p class="lab__verdict" data-out="verdict" data-pass={copy.pass} data-fail={copy.fail}>{initial.violations.length === 0 ? copy.pass : copy.fail}</p>
    <ul class="lab__violations" data-out-list="violations" data-unknown={copy.unknown} data-missing={copy.missing} data-order={copy.order} data-repeated={copy.repeated}>
      {initial.violations.map((violation) => <li>{describe(violation)}</li>)}
    </ul>
  </output>
  <p class="lab__note">{copy.note}</p>
</form>

<script>
  import { checkTrace, TRACE_POLICY } from '../../lib/lab-math'

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lab="trace-check"]')) {
    const preset = form.elements.namedItem('preset')
    const trace = form.elements.namedItem('trace')
    const verdict = form.querySelector<HTMLElement>('[data-out="verdict"]')
    const list = form.querySelector<HTMLUListElement>('[data-out-list="violations"]')
    if (!(preset instanceof HTMLSelectElement) || !(trace instanceof HTMLTextAreaElement) || !verdict || !list) continue
    const messages = list.dataset
    const fill = (template: string | undefined, values: Record<string, string>): string => (template ?? '').replace(/\{(\w+)\}/gu, (_, key: string) => values[key] ?? '')

    const update = (): void => {
      // At most 64 steps of 64 characters: the trace is the reader's own text.
      const actions = trace.value.split('\n').map((line) => line.trim().slice(0, 64)).filter(Boolean).slice(0, 64)
      const { violations } = checkTrace(actions, TRACE_POLICY)
      verdict.textContent = (violations.length === 0 ? verdict.dataset.pass : verdict.dataset.fail) ?? ''
      list.replaceChildren(...violations.map((violation) => {
        const item = document.createElement('li')
        item.textContent = violation.kind === 'missing'
          ? fill(messages.missing, { action: violation.action })
          : violation.kind === 'order'
            ? fill(messages.order, { at: String(violation.at + 1), before: violation.before, after: violation.after })
            : fill(messages[violation.kind], { at: String(violation.at + 1), action: violation.action })
        return item
      }))
    }

    preset.addEventListener('change', () => { trace.value = preset.value.split(' ').join('\n'); update() })
    trace.addEventListener('input', update)
    form.addEventListener('submit', (event) => { event.preventDefault(); update() })
    update()
  }
</script>
