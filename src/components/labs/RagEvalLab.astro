---
import { formatInputValue } from '../../lib/lab-form'
import { retrievalMetrics } from '../../lib/engineering-math'
/**
 * Lesson 29.2 — Retrieval quality metrics: Recall@k, Precision@k, MRR and NDCG@k.
 *
 * Server-renders the exact worked example from lesson 29.2 (hits at ranks 2, 4,
 * 5 and 8 out of 5 relevant chunks, evaluated at k = 5) so readers without
 * JavaScript see the real numbers immediately.
 */
interface Props { locale: 'en' | 'pt-br' }
const { locale } = Astro.props
const isPt = locale === 'pt-br'

const copy = isPt
  ? {
      legend: 'Métricas de recuperação em top-k (Recall@k, RR e NDCG@k)',
      k: 'Corte k (1 a 8)',
      totalRelevant: 'Total de trechos relevantes no corpus (1 a 50)',
      ranksLegend: 'Marque quais posições retornadas são relevantes',
      rankPrefix: 'Posição',
      recall: 'Recall@k',
      precision: 'Precision@k',
      rr: 'RR (Reciprocal Rank)',
      ndcg: 'NDCG@k',
      invalid: 'Informe um k inteiro entre 1 e 8 e um total de trechos relevantes entre 1 e 50.',
      invalidHits: 'O corpus precisa ter pelo menos tantos trechos relevantes quanto os acertos que você marcou.',
      note: 'Recall@k mede o que entrou na janela top-k; RR (cuja média entre consultas é o MRR) olha para o primeiro acerto em toda a lista retornada, e NDCG@k mede o ganho ranqueado em top-k. Mover o acerto da posição 2 para a 1 mantém Recall@5 em 60,0% e dobra o RR de 0,500 para 1,000.',
    }
  : {
      legend: 'Top-k retrieval metrics (Recall@k, RR and NDCG@k)',
      k: 'Cutoff k (1 to 8)',
      totalRelevant: 'Total relevant chunks in corpus (1 to 50)',
      ranksLegend: 'Toggle which returned ranks are relevant',
      rankPrefix: 'Rank',
      recall: 'Recall@k',
      precision: 'Precision@k',
      rr: 'RR (Reciprocal Rank)',
      ndcg: 'NDCG@k',
      invalid: 'Enter a whole-number cutoff k from 1 to 8 and a whole number of relevant chunks from 1 to 50.',
      invalidHits: 'The corpus must have at least as many relevant chunks as the hits you marked.',
      note: 'Recall@k measures what made it into top-k; RR (whose average across queries is MRR) inspects the first relevant rank across the full returned list, and NDCG@k weights ranked gains inside top-k. Moving a hit from rank 2 to rank 1 keeps Recall@5 at 60.0% while doubling RR from 0.500 to 1.000.',
    }

const defaultHits = [false, true, false, true, true, false, false, true]
const defaults = { k: 5, totalRelevant: 5 }
const result = retrievalMetrics({ hits: defaultHits, totalRelevant: defaults.totalRelevant, k: defaults.k })
const pct = new Intl.NumberFormat(isPt ? 'pt-BR' : 'en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 })
const three = new Intl.NumberFormat(isPt ? 'pt-BR' : 'en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 })
---

<form class="lab" data-lab="rag-eval" aria-label={copy.legend}>
  <p class="lab__lead">{copy.legend}</p>
  <div class="lab__controls">
    <label>
      <span>{copy.k}</span>
      <input type="text" name="k" value={formatInputValue(defaults.k, locale)} data-min="1" data-max="8" data-integer="" inputmode="numeric" autocomplete="off" spellcheck="false" required />
    </label>
    <label>
      <span>{copy.totalRelevant}</span>
      <input type="text" name="totalRelevant" value={formatInputValue(defaults.totalRelevant, locale)} data-min="1" data-max="50" data-integer="" inputmode="numeric" autocomplete="off" spellcheck="false" required />
    </label>
  </div>

  <fieldset class="lab__ranks">
    <legend>{copy.ranksLegend}</legend>
    <div class="lab__rank-row">
      {defaultHits.map((checked, index) => (
        <label class="lab__rank-chip">
          <input type="checkbox" name={`rank-${index + 1}`} checked={checked} />
          <span data-numeric>#{index + 1}</span>
          <span class="visually-hidden">{copy.rankPrefix} {index + 1}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <p class="lab__validation" data-out="validation" data-invalid={copy.invalid} data-invalid-hits={copy.invalidHits} role="status"></p>

  <output class="lab__out" aria-live="polite">
    <div class="lab__stat lab__stat--lead"><span>{copy.recall}</span><b data-out="recall">{result ? `${pct.format(result.recallAtK * 100)}%` : '—'}</b></div>
    <div class="lab__stat"><span>{copy.precision}</span><b data-out="precision">{result ? `${pct.format(result.precisionAtK * 100)}%` : '—'}</b></div>
    <div class="lab__stat"><span>{copy.rr}</span><b data-out="rr">{result ? three.format(result.rr) : '—'}</b></div>
    <div class="lab__stat"><span>{copy.ndcg}</span><b data-out="ndcg">{result ? three.format(result.ndcgAtK) : '—'}</b></div>
  </output>

  <p class="lab__note">{copy.note}</p>
</form>

<style>
  .lab__ranks { margin: var(--space-md) 0 0; padding: 0; border: 0; }
  .lab__ranks legend { margin-bottom: var(--space-xs); color: var(--ink-muted); font: var(--weight-semibold) var(--text-xs) var(--font-ui); }
  .lab__rank-row { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .lab__rank-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0 var(--space-sm);
    border: 1px solid var(--rule-field);
    border-radius: var(--radius-sm);
    background: var(--plate);
    color: var(--ink);
    font: var(--weight-semibold) var(--text-xs) var(--font-data);
    cursor: pointer;
  }
  .lab__rank-chip:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); color: var(--ink); }
  .lab__rank-chip input { accent-color: var(--accent); width: 1rem; height: 1rem; }
</style>

<script>
  import { markLabControl, pageLocale, readLabControl, showLabOutputs } from '../../lib/lab-form'
  import { retrievalMetrics } from '../../lib/engineering-math'

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lab="rag-eval"]')) {
    const locale = pageLocale(form)
    const tag = locale === 'pt-br' ? 'pt-BR' : 'en-US'
    const pct = new Intl.NumberFormat(tag, { minimumFractionDigits: 1, maximumFractionDigits: 1 })
    const three = new Intl.NumberFormat(tag, { minimumFractionDigits: 3, maximumFractionDigits: 3 })
    const messages = form.querySelector<HTMLElement>('[data-out="validation"]')?.dataset ?? {}

    const update = (): void => {
      const k = readLabControl(form, 'k', locale)
      const totalRelevant = readLabControl(form, 'totalRelevant', locale)
      const blank = { recall: '—', precision: '—', rr: '—', ndcg: '—' }
      if (k == null || totalRelevant == null) {
        showLabOutputs(form, blank, messages.invalid ?? '')
        return
      }
      const boxes = [...form.querySelectorAll<HTMLInputElement>('input[type="checkbox"][name^="rank-"]')]
      const hits = boxes.map((box) => box.checked)
      const checkedCount = hits.filter(Boolean).length
      if (totalRelevant < checkedCount) {
        markLabControl(form, 'totalRelevant')
        showLabOutputs(form, blank, messages.invalidHits ?? '')
        return
      }
      const result = retrievalMetrics({ hits, totalRelevant, k })
      if (!result) {
        showLabOutputs(form, blank, messages.invalid ?? '')
        return
      }
      showLabOutputs(form, {
        recall: `${pct.format(result.recallAtK * 100)}%`,
        precision: `${pct.format(result.precisionAtK * 100)}%`,
        rr: three.format(result.rr),
        ndcg: three.format(result.ndcgAtK),
      }, '')
    }

    form.addEventListener('input', update)
    form.addEventListener('change', update)
    form.addEventListener('submit', (event) => { event.preventDefault(); update() })
    update()
  }
</script>
