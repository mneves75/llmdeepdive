---
import { formatInputValue } from '../../lib/lab-form'
import { moeBalance } from '../../lib/moe-math'
/**
 * Lesson 5.14 — the loss-free balancing loop, with the router frozen.
 *
 * The lesson's trap is that a balance loss can read 1 while the load is badly
 * uneven, so the lab reports token counts rather than a loss. The batch and the
 * router scores never change here: the only thing moving is the selection bias,
 * which isolates the balancer. That is also the lab's honest limit, and the note
 * says so.
 *
 * Server-rendered with its defaults already computed, so a reader without
 * JavaScript gets a worked example rather than an apology.
 */
interface Props { locale: 'en' | 'pt-br' }
const { locale } = Astro.props
const isPt = locale === 'pt-br'

const copy = isPt
  ? {
      legend: 'O laço de balanceamento, passo a passo',
      skew: 'Quanto o lote prefere os experts de número baixo (0 a 1,5)',
      rate: 'Passo do viés por atualização',
      steps: 'Passos a executar',
      before: 'Antes',
      after: 'Depois',
      maxBefore: 'MaxVio antes',
      maxAfter: 'MaxVio depois',
      best: 'Menor MaxVio atingido',
      at: 'no passo',
      invalid: 'Informe uma inclinação entre 0 e 1,5, com até duas casas decimais. Use vírgula ou ponto.',
      note: 'Router congelado: o lote e os scores do router não mudam, então a única coisa que se move é o viés de seleção. No treino real os dois mudam. O passo fixo passa do alvo e volta, por isso o menor valor pode ficar abaixo do valor final.',
      converged: 'O laço terminou abaixo de 0,1: a carga está perto de uniforme.',
      oscillating: 'O laço oscila em torno do alvo. O menor valor mostra o quão perto ele chegou.',
    }
  : {
      legend: 'The balancing loop, one step at a time',
      skew: 'How strongly the batch prefers low-numbered experts (0 to 1.5)',
      rate: 'Bias step per update',
      steps: 'Steps to run',
      before: 'Before',
      after: 'After',
      maxBefore: 'MaxVio before',
      maxAfter: 'MaxVio after',
      best: 'Lowest MaxVio reached',
      at: 'at step',
      invalid: 'Enter a skew from 0 to 1.5 with up to two decimals.',
      note: 'Frozen router: the batch and the router scores never change, so the only thing moving is the selection bias. Real training changes both. The fixed step walks past the target and comes back, which is why the lowest value can sit below the final one.',
      converged: 'The loop finished below 0.1: the load is close to uniform.',
      oscillating: 'The loop oscillates around the target. The lowest value shows how close it got.',
    }

// Defaults mirror the worked example in the lesson body.
const defaults = { experts: 8, tokens: 64, skew: 0.5, rate: 0.02, steps: 40 }
const run = moeBalance(defaults)
const rates = [0.01, 0.02, 0.05, 0.1]
const stepOptions = [10, 20, 40, 80]
const twoDecimals = new Intl.NumberFormat(isPt ? 'pt-BR' : 'en-US', {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
})
const oneDecimal = new Intl.NumberFormat(isPt ? 'pt-BR' : 'en-US', {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
})
const experts = Array.from({ length: defaults.experts }, (_, index) => index)
const status = run.best.maxVio < 0.1 ? copy.converged : copy.oscillating
---

<form class="lab" data-lab="moe-balance" aria-label={copy.legend}>
  <p class="lab__lead">{copy.legend}</p>
  <div class="lab__controls">
    <label>
      <span>{copy.skew}</span>
      <input type="text" name="skew" value={formatInputValue(defaults.skew, locale)} data-min="0" data-max="1.5" inputmode="decimal" autocomplete="off" spellcheck="false" required />
    </label>
    <label>
      <span>{copy.rate}</span>
      <select name="rate">
        {rates.map((rate) => <option value={rate} selected={rate === defaults.rate}>{formatInputValue(rate, locale)}</option>)}
      </select>
    </label>
    <label>
      <span>{copy.steps}</span>
      <select name="steps">
        {stepOptions.map((steps) => <option value={steps} selected={steps === defaults.steps}>{steps}</option>)}
      </select>
    </label>
  </div>

  <p class="lab__validation" data-out="validation" data-invalid={copy.invalid} role="status"></p>

  <output class="lab__out" aria-live="polite">
    <div class="lab__stat"><span>{copy.maxBefore}</span><b data-out="max-before">{twoDecimals.format(run.maxVioBefore)}</b></div>
    <div class="lab__stat"><span>{copy.maxAfter}</span><b data-out="max-after">{twoDecimals.format(run.maxVioAfter)}</b></div>
    <div class="lab__stat lab__stat--lead"><span>{copy.best}</span><b data-out="best">{twoDecimals.format(run.best.maxVio)}</b></div>
  </output>

  <ol class="lab__loads" aria-label={`${copy.before} / ${copy.after}`}>
    <li class="lab__loads-head" aria-hidden="true">
      <span></span>
      <span>{copy.before}</span>
      <b></b>
      <span>{copy.after}</span>
      <b></b>
    </li>
    {experts.map((expert) => {
      const before = run.before[expert] ?? 0
      const after = run.after[expert] ?? 0
      return (
        <li>
          <span class="lab__load-name">e{expert}</span>
          <span class="lab__load-bar" aria-hidden="true"><i style={`--share: ${(before / defaults.tokens).toFixed(4)}`} data-out={`bar-before-${expert}`}></i></span>
          <b data-out={`before-${expert}`}>{before}</b>
          <span class="lab__load-bar lab__load-bar--after" aria-hidden="true"><i style={`--share: ${(after / defaults.tokens).toFixed(4)}`} data-out={`bar-after-${expert}`}></i></span>
          <b data-out={`after-${expert}`}>{after}</b>
        </li>
      )
    })}
  </ol>

  <p class="lab__verdict" data-out="status" data-converged={copy.converged} data-oscillating={copy.oscillating}>{status}</p>
  <p class="lab__note">{copy.note}</p>
</form>

<script>
  import { pageLocale, readLabControl, showLabOutputs } from '../../lib/lab-form'
  import { moeBalance } from '../../lib/moe-math'

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lab="moe-balance"]')) {
    const locale = pageLocale(form)
    const invalid = form.querySelector<HTMLElement>('[data-out="validation"]')?.dataset.invalid ?? ''
    const twoDecimals = new Intl.NumberFormat(locale === 'pt-br' ? 'pt-BR' : 'en-US', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    })

    const update = (): void => {
      const [skew, rate, steps] = ['skew', 'rate', 'steps'].map((name) => readLabControl(form, name, locale))
      if (skew == null || rate == null || steps == null) {
        showLabOutputs(form, { 'max-before': '—', 'max-after': '—', best: '—', status: '' }, invalid)
        return
      }
      const experts = form.querySelectorAll<HTMLElement>('[data-out^="before-"]').length
      const tokens = 64
      const run = moeBalance({ experts, tokens, skew, rate, steps })
      const values: Record<string, string> = {
        'max-before': twoDecimals.format(run.maxVioBefore),
        'max-after': twoDecimals.format(run.maxVioAfter),
        best: twoDecimals.format(run.best.maxVio),
      }
      for (let expert = 0; expert < experts; expert += 1) {
        const before = run.before[expert] ?? 0
        const after = run.after[expert] ?? 0
        values[`before-${expert}`] = String(before)
        values[`after-${expert}`] = String(after)
        const beforeBar = form.querySelector<HTMLElement>(`[data-out="bar-before-${expert}"]`)
        const afterBar = form.querySelector<HTMLElement>(`[data-out="bar-after-${expert}"]`)
        beforeBar?.style.setProperty('--share', (before / tokens).toFixed(4))
        afterBar?.style.setProperty('--share', (after / tokens).toFixed(4))
      }
      const status = form.querySelector<HTMLElement>('[data-out="status"]')
      values.status = status?.dataset[run.best.maxVio < 0.1 ? 'converged' : 'oscillating'] ?? ''
      showLabOutputs(form, values, '')
    }

    form.addEventListener('input', update)
    form.addEventListener('change', update)
    form.addEventListener('submit', (event) => { event.preventDefault(); update() })
    update()
  }
</script>
