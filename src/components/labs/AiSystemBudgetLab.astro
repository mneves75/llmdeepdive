---
import { formatInputValue } from '../../lib/lab-form'
import { aiSystemBudget } from '../../lib/engineering-math'
import { labFormatters } from '../../lib/lab-math'
/**
 * Lesson 31.1 — End-to-end AI system latency, semantic-cache risk, and
 * pay-as-you-go vs provisioned-throughput monthly economics.
 *
 * Server-renders the exact worked example from lesson 31.1 so readers without
 * JavaScript get the complete calculation immediately.
 */
interface Props { locale: 'en' | 'pt-br' }
const { locale } = Astro.props
const isPt = locale === 'pt-br'

const copy = isPt
  ? {
      legend: 'Orçamento de latência, cache semântico e capacidade reservada',
      retrievalMs: 'Recuperação + rerank (ms)',
      guardrailMs: 'Guardrails entrada/saída (ms)',
      ttftMs: 'TTFT do modelo (ms)',
      outputTokens: 'Tokens de saída',
      decodeTps: 'Velocidade de decode (tok/s)',
      cacheHitPct: 'Taxa de acerto do cache (%)',
      cacheLookupMs: 'Latência do cache (ms)',
      falseHitPct: 'Falsos acertos entre os acertos do cache (%)',
      monthlyRequestsK: 'Volume mensal (milhares de req)',
      costPer1kUncachedUsd: 'Custo sem cache por 1.000 req (USD)',
      provisionedMonthlyUsd: 'Capacidade reservada mensal (USD)',
      uncached: 'Latência sem cache',
      effective: 'Latência média efetiva',
      falseHits: 'Falsos acertos por 10.000 requisições',
      monthlyPayg: 'Mensal PAYG (com cache)',
      monthlySaved: 'Economia mensal do cache',
      verdictPayg: 'Pay-as-you-go vence com o volume atual.',
      verdictProvisioned: 'Capacidade reservada vence o PAYG neste volume.',
      verdictClose: 'A diferença de custo é menor que 10% do menor valor. Compare a latência p99 e a capacidade para picos.',
      invalid: 'Confira os campos marcados. Use pelo menos 1 token de saída e 1 token/s de decode. Os percentuais vão de 0 a 100.',
      note: 'A latência média mascara o p99: requisições sem acerto no cache ainda pagam toda a cadeia de recuperação, guardrails, prefill e decode. Um cache semântico com 35% de acertos e 2% de falsos acertos devolve 70 respostas erradas a cada 10.000 requisições.',
    }
  : {
      legend: 'End-to-end latency, semantic-cache risk and provisioned throughput',
      retrievalMs: 'Retrieval + rerank (ms)',
      guardrailMs: 'Input/output guardrails (ms)',
      ttftMs: 'Model TTFT (ms)',
      outputTokens: 'Output tokens',
      decodeTps: 'Decode speed (tok/s)',
      cacheHitPct: 'Cache hit rate (%)',
      cacheLookupMs: 'Cache lookup (ms)',
      falseHitPct: 'False hits among cache hits (%)',
      monthlyRequestsK: 'Monthly traffic (thousands of req)',
      costPer1kUncachedUsd: 'Uncached cost per 1,000 req (USD)',
      provisionedMonthlyUsd: 'Monthly provisioned cost (USD)',
      uncached: 'Uncached latency',
      effective: 'Mean effective latency',
      falseHits: 'False hits per 10,000 requests',
      monthlyPayg: 'Monthly PAYG (cached)',
      monthlySaved: 'Monthly cache savings',
      verdictPayg: 'Pay-as-you-go wins at this volume.',
      verdictProvisioned: 'Provisioned throughput beats PAYG at this volume.',
      verdictClose: 'The cost difference is less than 10% of the lower cost. Compare p99 latency and capacity for traffic spikes.',
      invalid: 'Check the marked fields. Enter at least 1 output token and a decode speed of at least 1 token/s. Percentages range from 0 to 100.',
      note: 'Mean latency hides p99: cache misses still pay the full retrieval, guardrail, prefill and decode chain. A semantic cache with a 35% hit rate and a 2% false-hit rate serves 70 wrong cached answers per 10,000 requests.',
    }

const defaults = {
  retrievalMs: 85,
  guardrailMs: 45,
  ttftMs: 240,
  outputTokens: 250,
  decodeTps: 60,
  cacheHitPct: 35,
  cacheLookupMs: 18,
  falseHitPct: 2,
  monthlyRequestsK: 1000,
  costPer1kUncachedUsd: 4.5,
  provisionedMonthlyUsd: 2600,
}

const result = aiSystemBudget({
  retrievalMs: defaults.retrievalMs,
  guardrailMs: defaults.guardrailMs,
  ttftMs: defaults.ttftMs,
  outputTokens: defaults.outputTokens,
  decodeTps: defaults.decodeTps,
  cacheHitRate: defaults.cacheHitPct / 100,
  cacheLookupMs: defaults.cacheLookupMs,
  falseHitRate: defaults.falseHitPct / 100,
  monthlyRequestsK: defaults.monthlyRequestsK,
  costPer1kUncachedUsd: defaults.costPer1kUncachedUsd,
  provisionedMonthlyUsd: defaults.provisionedMonthlyUsd,
})

const { whole, oneDecimal } = labFormatters(locale)
const usd = (value: number): string => `USD ${whole.format(value)}`
const verdictText = result?.provisionedVerdict === 'provisioned'
  ? copy.verdictProvisioned
  : result?.provisionedVerdict === 'close'
    ? copy.verdictClose
    : copy.verdictPayg

const fields = [
  ['retrievalMs', copy.retrievalMs, 0, 60000, 'decimal'],
  ['guardrailMs', copy.guardrailMs, 0, 60000, 'decimal'],
  ['ttftMs', copy.ttftMs, 0, 60000, 'decimal'],
  ['outputTokens', copy.outputTokens, 1, 100000, 'numeric'],
  ['decodeTps', copy.decodeTps, 1, 10000, 'decimal'],
  ['cacheHitPct', copy.cacheHitPct, 0, 100, 'decimal'],
  ['cacheLookupMs', copy.cacheLookupMs, 0, 10000, 'decimal'],
  ['falseHitPct', copy.falseHitPct, 0, 100, 'decimal'],
  ['monthlyRequestsK', copy.monthlyRequestsK, 0, 10000000, 'decimal'],
  ['costPer1kUncachedUsd', copy.costPer1kUncachedUsd, 0, 100000, 'decimal'],
  ['provisionedMonthlyUsd', copy.provisionedMonthlyUsd, 0, 10000000, 'decimal'],
] as const
---

<form class="lab" data-lab="ai-system-budget" aria-label={copy.legend}>
  <p class="lab__lead">{copy.legend}</p>
  <div class="lab__controls">
    {fields.map(([name, label, min, max, mode]) => (
      <label>
        <span>{label}</span>
        <input type="text" name={name} value={formatInputValue(defaults[name], locale)} data-min={min} data-max={max} data-integer={mode === 'numeric' ? '' : undefined} inputmode={mode} autocomplete="off" spellcheck="false" required />
      </label>
    ))}
  </div>

  <p class="lab__validation" data-out="validation" data-invalid={copy.invalid} role="status"></p>

  <output class="lab__out" aria-live="polite">
    <div class="lab__stat"><span>{copy.uncached}</span><b data-out="uncached">{result ? `${whole.format(result.uncachedLatencyMs)} ms` : '—'}</b></div>
    <div class="lab__stat lab__stat--lead"><span>{copy.effective}</span><b data-out="effective">{result ? `${whole.format(result.effectiveLatencyMs)} ms` : '—'}</b></div>
    <div class="lab__stat"><span>{copy.falseHits}</span><b data-out="falseHits">{result ? oneDecimal.format(result.falseHitsPer10k) : '—'}</b></div>
    <div class="lab__stat"><span>{copy.monthlyPayg}</span><b data-out="monthlyPayg">{result ? usd(result.monthlyCachedUsd) : '—'}</b></div>
    <div class="lab__stat"><span>{copy.monthlySaved}</span><b data-out="monthlySaved">{result ? usd(result.monthlySavingsUsd) : '—'}</b></div>
  </output>

  <p class="lab__verdict" data-out="verdict" data-payg={copy.verdictPayg} data-provisioned={copy.verdictProvisioned} data-close={copy.verdictClose}>{verdictText}</p>
  <p class="lab__note">{copy.note}</p>
</form>

<script>
  import { pageLocale, readLabControl, showLabOutputs } from '../../lib/lab-form'
  import { aiSystemBudget } from '../../lib/engineering-math'
  import { labFormatters } from '../../lib/lab-math'

  const NAMES = [
    'retrievalMs', 'guardrailMs', 'ttftMs', 'outputTokens', 'decodeTps',
    'cacheHitPct', 'cacheLookupMs', 'falseHitPct', 'monthlyRequestsK',
    'costPer1kUncachedUsd', 'provisionedMonthlyUsd',
  ] as const

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lab="ai-system-budget"]')) {
    const locale = pageLocale(form)
    const { whole, oneDecimal } = labFormatters(locale)
    const usd = (value: number): string => `USD ${whole.format(value)}`
    const invalid = form.querySelector<HTMLElement>('[data-out="validation"]')?.dataset.invalid ?? ''
    const verdicts = form.querySelector<HTMLElement>('[data-out="verdict"]')?.dataset ?? {}

    const update = (): void => {
      const [
        retrievalMs, guardrailMs, ttftMs, outputTokens, decodeTps,
        cacheHitPct, cacheLookupMs, falseHitPct, monthlyRequestsK,
        costPer1kUncachedUsd, provisionedMonthlyUsd,
      ] = NAMES.map((name) => readLabControl(form, name, locale))
      const blank = { uncached: '—', effective: '—', falseHits: '—', monthlyPayg: '—', monthlySaved: '—', verdict: '' }
      if (
        retrievalMs == null || guardrailMs == null || ttftMs == null || outputTokens == null || decodeTps == null ||
        cacheHitPct == null || cacheLookupMs == null || falseHitPct == null || monthlyRequestsK == null ||
        costPer1kUncachedUsd == null || provisionedMonthlyUsd == null
      ) {
        showLabOutputs(form, blank, invalid)
        return
      }
      const result = aiSystemBudget({
        retrievalMs,
        guardrailMs,
        ttftMs,
        outputTokens,
        decodeTps,
        cacheHitRate: cacheHitPct / 100,
        cacheLookupMs,
        falseHitRate: falseHitPct / 100,
        monthlyRequestsK,
        costPer1kUncachedUsd,
        provisionedMonthlyUsd,
      })
      if (!result) {
        showLabOutputs(form, blank, invalid)
        return
      }
      showLabOutputs(form, {
        uncached: `${whole.format(result.uncachedLatencyMs)} ms`,
        effective: `${whole.format(result.effectiveLatencyMs)} ms`,
        falseHits: oneDecimal.format(result.falseHitsPer10k),
        monthlyPayg: usd(result.monthlyCachedUsd),
        monthlySaved: usd(result.monthlySavingsUsd),
        verdict: verdicts[result.provisionedVerdict] ?? '',
      }, '')
    }

    form.addEventListener('input', update)
    form.addEventListener('change', update)
    form.addEventListener('submit', (event) => { event.preventDefault(); update() })
    update()
  }
</script>
