---
/**
 * Lesson 9.10 — the capstone comparison, made adjustable.
 *
 * The lesson prices one workload three ways and states every assumption inline.
 * This lab exposes those assumptions as inputs, because the break-even point is
 * the whole lesson: it moves with volume, price and throughput, and a reader who
 * only sees one worked example tends to remember the verdict instead of the
 * method. Prices are the reader's to override — the defaults are date-stamped.
 *
 * Server-rendered with defaults already computed, so it degrades to a real
 * worked comparison without JavaScript.
 */
import { formatInputValue } from '../../lib/lab-number'

interface Props { locale: 'en' | 'pt-br' }
const { locale } = Astro.props
const isPt = locale === 'pt-br'

const copy = isPt
  ? {
      legend: 'Custo mensal do mesmo workload: endpoint gerenciado ou GPU alugada',
      inTokens: 'Tokens de entrada por mês (milhões)',
      outTokens: 'Tokens de saída por mês (milhões)',
      priceIn: 'Preço de entrada (USD por milhão)',
      priceOut: 'Preço de saída (USD por milhão)',
      gpuHour: 'GPU alugada (USD por hora)',
      throughput: 'Throughput sustentado (tokens de saída por segundo)',
      managed: 'Endpoint gerenciado',
      selfHosted: 'GPU própria alugada',
      utilisation: 'Utilização da frota',
      gpus: 'GPUs necessárias',
      verdictManaged: 'O endpoint gerenciado sai mais barato neste volume.',
      verdictSelf: 'A GPU alugada sai mais barata neste volume.',
      verdictClose: 'Os dois custam quase o mesmo: decida por operação, não por preço.',
      verdictTie: 'Sem volume e sem preço, não há o que comparar.',
      invalid: 'Informe volumes e preços não negativos e throughput de pelo menos 1 token por segundo. Use vírgula ou ponto para decimais.',
      overflow: 'Esses valores são grandes demais para calcular. Reduza volumes ou preços.',
      note: 'Preços por token padrão: Workers AI, agosto de 2026; o custo gerenciado exibido é bruto antes da franquia diária gratuita de neurons. A GPU alugada é cobrada por hora ligada, não por token — por isso a utilização é a variável que decide. Aluguel e energia variam por região e contrato; troque pelos seus números.',
    }
  : {
      legend: 'Monthly cost of the same workload: managed endpoint or rented GPU',
      inTokens: 'Input tokens per month (millions)',
      outTokens: 'Output tokens per month (millions)',
      priceIn: 'Input price (USD per million)',
      priceOut: 'Output price (USD per million)',
      gpuHour: 'Rented GPU (USD per hour)',
      throughput: 'Sustained throughput (output tokens per second)',
      managed: 'Managed endpoint',
      selfHosted: 'Rented GPU',
      utilisation: 'Fleet utilisation',
      gpus: 'GPUs required',
      verdictManaged: 'The managed endpoint is cheaper at this volume.',
      verdictSelf: 'The rented GPU is cheaper at this volume.',
      verdictClose: 'The two are within a rounding error: decide on operations, not price.',
      verdictTie: 'With no volume and no prices there is nothing to compare.',
      invalid: 'Enter non-negative volumes and prices, with throughput of at least 1 token per second.',
      overflow: 'These values are too large to calculate. Reduce the volumes or prices.',
      note: 'Default token prices: Workers AI, as of Aug 2026; managed cost shown is gross before the daily free-neuron allocation. A rented GPU bills for wall-clock hours, not tokens, which is why utilisation is the deciding variable. Rental and power vary by region and contract; substitute your own numbers.',
    }

const defaults = { inM: 200, outM: 40, priceIn: 0.45, priceOut: 3.2, gpuHour: 2.5, tps: 800 }
const HOURS = 730

const managed = defaults.inM * defaults.priceIn + defaults.outM * defaults.priceOut
// One GPU bills for the whole month whether or not it is busy, and it cannot
// exceed its own throughput: past 100% the workload needs more machines, so the
// rental cost has to scale or the comparison quietly prices a fleet that cannot
// do the work.
const secondsNeeded = (defaults.outM * 1e6) / defaults.tps
const monthSeconds = HOURS * 3600
const gpus = Math.max(1, Math.ceil(secondsNeeded / monthSeconds))
const rented = defaults.gpuHour * HOURS * gpus
const utilisation = (secondsNeeded / (gpus * monthSeconds)) * 100
const cheapest = Math.min(managed, rented)
// Only an empty configuration is "nothing to compare". Two equal nonzero costs
// are an exact break-even, which is the most interesting answer the lab gives.
const verdict = managed === 0 && rented === 0
  ? copy.verdictTie
  : Math.abs(managed - rented) / Math.max(cheapest, 1e-9) < 0.1
    ? copy.verdictClose
    : managed < rented ? copy.verdictManaged : copy.verdictSelf

const localeTag = isPt ? 'pt-BR' : 'en-US'
const whole = new Intl.NumberFormat(localeTag, { maximumFractionDigits: 0 })
const oneDecimal = new Intl.NumberFormat(localeTag, { minimumFractionDigits: 1, maximumFractionDigits: 1 })
---

<form class="lab-cost" data-lab="cost-per-token" aria-label={copy.legend}>
  <div class="lab-cost__controls">
    <label><span>{copy.inTokens}</span><input type="text" name="inM" value={formatInputValue(defaults.inM, locale)} data-min="0" inputmode="decimal" autocomplete="off" spellcheck="false" required /></label>
    <label><span>{copy.outTokens}</span><input type="text" name="outM" value={formatInputValue(defaults.outM, locale)} data-min="0" inputmode="decimal" autocomplete="off" spellcheck="false" required /></label>
    <label><span>{copy.priceIn}</span><input type="text" name="priceIn" value={formatInputValue(defaults.priceIn, locale)} data-min="0" inputmode="decimal" autocomplete="off" spellcheck="false" required /></label>
    <label><span>{copy.priceOut}</span><input type="text" name="priceOut" value={formatInputValue(defaults.priceOut, locale)} data-min="0" inputmode="decimal" autocomplete="off" spellcheck="false" required /></label>
    <label><span>{copy.gpuHour}</span><input type="text" name="gpuHour" value={formatInputValue(defaults.gpuHour, locale)} data-min="0" inputmode="decimal" autocomplete="off" spellcheck="false" required /></label>
    <label><span>{copy.throughput}</span><input type="text" name="tps" value={formatInputValue(defaults.tps, locale)} data-min="1" inputmode="decimal" autocomplete="off" spellcheck="false" required /></label>
  </div>

  {/* Always in the accessibility tree, empty until needed: a live region that
      only appears when it is revealed is often never announced. */}
  <p class="lab-cost__validation" data-out="validation" data-invalid={copy.invalid} data-overflow={copy.overflow} role="status"></p>

  <output class="lab-cost__out" aria-live="polite">
    <div class="lab-cost__stat"><span>{copy.managed}</span><b data-out="managed">USD {whole.format(managed)}</b></div>
    <div class="lab-cost__stat"><span>{copy.selfHosted}</span><b data-out="rented">USD {whole.format(rented)}</b></div>
    <div class="lab-cost__stat"><span>{copy.gpus}</span><b data-out="gpus">{whole.format(gpus)}</b></div>
    <div class="lab-cost__stat"><span>{copy.utilisation}</span><b data-out="util">{oneDecimal.format(utilisation)}%</b></div>
  </output>

  <p class="lab-cost__verdict" data-out="verdict">{verdict}</p>
  <p class="lab-cost__note">{copy.note}</p>
</form>

<script>
  import { parseDecimal } from '../../lib/lab-number'

  const HOURS = 730

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lab="cost-per-token"]')) {
    const isPt = form.closest('[lang="pt-BR"]') !== null
    const text = isPt
      ? { managed: 'O endpoint gerenciado sai mais barato neste volume.', self: 'A GPU alugada sai mais barata neste volume.', close: 'Os dois custam quase o mesmo: decida por operação, não por preço.', tie: 'Sem volume e sem preço, não há o que comparar.' }
      : { managed: 'The managed endpoint is cheaper at this volume.', self: 'The rented GPU is cheaper at this volume.', close: 'The two are within a rounding error: decide on operations, not price.', tie: 'With no volume and no prices there is nothing to compare.' }
    const locale = isPt ? 'pt-BR' : 'en-US'
    const whole = new Intl.NumberFormat(locale, { maximumFractionDigits: 0 })
    const oneDecimal = new Intl.NumberFormat(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 })
    const out = (name: string): HTMLElement | null => form.querySelector(`[data-out="${name}"]`)
    const num = (name: string): number | null => {
      const control = form.elements.namedItem(name)
      if (!(control instanceof HTMLInputElement)) return null
      let value = parseDecimal(control.value, isPt ? 'pt-br' : 'en')
      if (value !== null && value < Number(control.dataset.min ?? 0)) value = null
      if (value === null) control.setAttribute('aria-invalid', 'true')
      else control.removeAttribute('aria-invalid')
      return value
    }
    const show = (values: Record<'managed' | 'rented' | 'gpus' | 'util' | 'verdict', string>, message: string): void => {
      for (const [name, value] of Object.entries(values)) {
        const element = out(name)
        if (element) element.textContent = value
      }
      const validation = out('validation')
      if (validation) validation.textContent = message
    }
    // Never leave the last valid answer beside an input that cannot produce one.
    const blank = (message: string): void => show({ managed: '—', rented: '—', gpus: '—', util: '—', verdict: '' }, message)

    const update = (): void => {
      const inM = num('inM'), outM = num('outM'), priceIn = num('priceIn')
      const priceOut = num('priceOut'), gpuHour = num('gpuHour'), tps = num('tps')
      const validation = out('validation')
      if (inM === null || outM === null || priceIn === null || priceOut === null || gpuHour === null || tps === null) {
        blank(validation?.dataset.invalid ?? '')
        return
      }

      const managed = inM * priceIn + outM * priceOut
      const monthSeconds = HOURS * 3600
      const secondsNeeded = (outM * 1e6) / tps
      const gpus = Math.max(1, Math.ceil(secondsNeeded / monthSeconds))
      const rented = gpuHour * HOURS * gpus
      const utilisation = (secondsNeeded / (gpus * monthSeconds)) * 100
      if (![managed, secondsNeeded, gpus, rented, utilisation].every(Number.isFinite)) {
        blank(validation?.dataset.overflow ?? '')
        return
      }

      const cheapest = Math.min(managed, rented)
      show({
        managed: `USD ${whole.format(managed)}`,
        rented: `USD ${whole.format(rented)}`,
        gpus: whole.format(gpus),
        util: `${oneDecimal.format(utilisation)}%`,
        verdict: managed === 0 && rented === 0
          ? text.tie
          : Math.abs(managed - rented) / Math.max(cheapest, 1e-9) < 0.1
            ? text.close
            : managed < rented ? text.managed : text.self,
      }, '')
    }

    form.addEventListener('input', update)
    form.addEventListener('submit', (event) => { event.preventDefault(); update() })
    update()
  }
</script>

<style>
  .lab-cost { display: grid; gap: var(--space-md); padding: var(--space-lg); border: 1px solid var(--rule-strong); border-radius: var(--radius-md); background: var(--paper-raised); }
  .lab-cost__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: var(--space-md); }
  .lab-cost label { display: grid; gap: var(--space-2xs); }
  .lab-cost label > span { color: var(--ink-faint); font: var(--weight-semibold) var(--text-3xs) var(--font-data); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }
  .lab-cost input { width: 100%; padding: var(--space-xs) var(--space-sm); border: 1px solid var(--rule-strong); border-radius: var(--radius-sm); color: var(--ink); background: var(--paper); font: var(--text-base) var(--font-data); }
  .lab-cost input:focus { border-color: var(--accent); outline: 3px solid color-mix(in srgb, var(--focus) 40%, transparent); outline-offset: 2px; }
  .lab-cost input[aria-invalid='true'] { border-color: var(--coral); }
  .lab-cost__validation { margin: 0; color: var(--coral); font-size: var(--text-xs); font-weight: var(--weight-semibold); }
  /* The empty region stays in the tree; cancel the grid gap it would add. */
  .lab-cost__validation:empty { margin-block-start: calc(-1 * var(--space-md)); }
  .lab-cost__out { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: var(--space-md); padding-block: var(--space-md); border-block: 1px solid var(--rule); }
  .lab-cost__stat { display: grid; gap: var(--space-2xs); }
  .lab-cost__stat span { color: var(--ink-muted); font-size: var(--text-2xs); }
  .lab-cost__stat b { font: var(--weight-bold) var(--text-xl) var(--font-display); }
  .lab-cost__verdict { margin: 0; font-weight: var(--weight-semibold); color: var(--accent); }
  .lab-cost__note { margin: 0; color: var(--ink-muted); font-size: var(--text-xs); }
</style>
