---
import { formatInputValue } from '../../lib/lab-form'
import { contextBudget, labFormatters } from '../../lib/lab-math'
/**
 * Lesson 19.3 — where a request's context window goes.
 *
 * The output reserve comes off the top; instructions, tool schemas and
 * retrieved chunks are fixed for the request; the conversation history gets
 * the rest. The reader moves each part and sees how far the history must be
 * compressed. Server-rendered with the lesson's worked example.
 */
interface Props { locale: 'en' | 'pt-br' }
const { locale } = Astro.props
const isPt = locale === 'pt-br'

const copy = isPt
  ? {
      legend: 'Orçamento de contexto de uma requisição',
      window: 'Janela de contexto (tokens)',
      reserve: 'Reservado para a resposta (tokens)',
      instructions: 'Instruções de sistema (tokens)',
      tools: 'Schemas de ferramentas (tokens)',
      chunks: 'Trechos recuperados',
      chunkTokens: 'Tokens por trecho',
      history: 'Histórico da conversa (tokens)',
      limit: 'Limite de entrada',
      used: 'Entrada usada',
      over: 'Excesso',
      historyLimit: 'Histórico máximo',
      fits: 'Cabe. A sobra é o espaço para mais histórico ou mais trechos.',
      over_: 'Não cabe: comprima o histórico até o máximo mostrado, ou recupere menos trechos.',
      fixedOver: 'Não cabe nem sem histórico: as partes fixas já passam do limite de entrada.',
      invalid: 'Informe números inteiros não negativos; a janela precisa ser maior que a reserva.',
      note: 'Conte tokens com o tokenizer do seu modelo (aula 1.4): contagens de outro tokenizer erram. Um histórico que cabe não é um histórico útil; a aula mostra como medir o que a compressão perde.',
    }
  : {
      legend: 'Context budget of one request',
      window: 'Context window (tokens)',
      reserve: 'Reserved for the answer (tokens)',
      instructions: 'System instructions (tokens)',
      tools: 'Tool schemas (tokens)',
      chunks: 'Retrieved chunks',
      chunkTokens: 'Tokens per chunk',
      history: 'Conversation history (tokens)',
      limit: 'Input limit',
      used: 'Input used',
      over: 'Over by',
      historyLimit: 'History allowed',
      fits: 'Fits. The headroom is room for more history or more chunks.',
      over_: 'Does not fit: compress the history to the allowed size, or retrieve fewer chunks.',
      fixedOver: 'Does not fit even with no history: the fixed parts alone exceed the input limit.',
      invalid: 'Enter whole numbers of zero or more; the window must exceed the reserve.',
      note: 'Count tokens with your model’s own tokenizer (lesson 1.4): counts from another tokenizer are wrong. A history that fits is not a history that kept what mattered; the lesson shows how to measure what compression loses.',
    }

const defaults = { window: 32768, reserveOutput: 4096, instructions: 1200, tools: 2400, chunks: 6, chunkTokens: 800, history: 21000 }
const result = contextBudget(defaults)
const { whole } = labFormatters(locale)
const fields = [
  ['window', copy.window, 1, 10000000],
  ['reserveOutput', copy.reserve, 0, 10000000],
  ['instructions', copy.instructions, 0, 10000000],
  ['tools', copy.tools, 0, 10000000],
  ['chunks', copy.chunks, 0, 1000],
  ['chunkTokens', copy.chunkTokens, 0, 100000],
  ['history', copy.history, 0, 10000000],
] as const
const verdictCopy = { fits: copy.fits, over: copy.over_, fixedOver: copy.fixedOver }
---

<form class="lab" data-lab="context-budget" aria-label={copy.legend}>
  <div class="lab__controls">
    {fields.map(([name, label, min, max]) => (
      <label>
        <span>{label}</span>
        <input type="text" name={name} value={formatInputValue(defaults[name], locale)} data-min={min} data-max={max} inputmode="numeric" autocomplete="off" spellcheck="false" required />
      </label>
    ))}
  </div>

  <p class="lab__validation" data-out="validation" data-invalid={copy.invalid} role="status"></p>

  <output class="lab__out" aria-live="polite">
    <div class="lab__stat"><span>{copy.limit}</span><b data-out="limit">{whole.format(result.inputLimit)}</b></div>
    <div class="lab__stat"><span>{copy.used}</span><b data-out="used">{whole.format(result.used)}</b></div>
    <div class="lab__stat"><span>{copy.over}</span><b data-out="over">{whole.format(result.over)}</b></div>
    <div class="lab__stat lab__stat--lead"><span>{copy.historyLimit}</span><b data-out="history">{whole.format(result.historyLimit)}</b></div>
  </output>

  <p class="lab__verdict" data-out="verdict" data-fits={copy.fits} data-over={copy.over_} data-fixed-over={copy.fixedOver}>{verdictCopy[result.verdict]}</p>
  <p class="lab__note">{copy.note}</p>
</form>

<script>
  import { pageLocale, readLabControl, showLabOutputs } from '../../lib/lab-form'
  import { contextBudget, labFormatters } from '../../lib/lab-math'

  const NAMES = ['window', 'reserveOutput', 'instructions', 'tools', 'chunks', 'chunkTokens', 'history'] as const

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lab="context-budget"]')) {
    const locale = pageLocale(form)
    const { whole } = labFormatters(locale)
    const invalid = form.querySelector<HTMLElement>('[data-out="validation"]')?.dataset.invalid ?? ''
    const verdicts = form.querySelector<HTMLElement>('[data-out="verdict"]')?.dataset ?? {}
    const blank = { limit: '—', used: '—', over: '—', history: '—', verdict: '' }

    const update = (): void => {
      // Read every control before deciding, so each invalid one is marked.
      const values = NAMES.map((name) => readLabControl(form, name, locale))
      const [windowSize, reserveOutput, instructions, tools, chunks, chunkTokens, history] = values
      if (windowSize == null || reserveOutput == null || instructions == null || tools == null || chunks == null || chunkTokens == null || history == null
        || !values.every((value) => Number.isInteger(value)) || windowSize <= reserveOutput) {
        showLabOutputs(form, blank, invalid)
        return
      }
      const result = contextBudget({ window: windowSize, reserveOutput, instructions, tools, chunks, chunkTokens, history })
      const verdict = result.verdict === 'fixedOver' ? verdicts.fixedOver : result.verdict === 'over' ? verdicts.over : verdicts.fits
      showLabOutputs(form, {
        limit: whole.format(result.inputLimit),
        used: whole.format(result.used),
        over: whole.format(result.over),
        history: whole.format(result.historyLimit),
        verdict: verdict ?? '',
      }, '')
    }

    form.addEventListener('input', update)
    form.addEventListener('change', update)
    form.addEventListener('submit', (event) => { event.preventDefault(); update() })
    update()
  }
</script>
