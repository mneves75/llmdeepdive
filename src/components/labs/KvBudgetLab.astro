---
/**
 * Lesson 9.3 — the memory budget of one accelerator, made adjustable.
 *
 * The lesson derives the arithmetic once; this lab lets a reader move the four
 * numbers that actually vary (usable memory, weight precision, context length,
 * per-sequence state) and watch the concurrency answer move with them. The
 * per-token KV figure is fixed at 64 KiB because it is a property of the model,
 * derived in lesson 7.2 — it is shown, not editable.
 *
 * Server-rendered with its defaults already computed, so a reader without
 * JavaScript still gets a worked budget rather than an apology.
 */
interface Props { locale: 'en' | 'pt-br' }
const { locale } = Astro.props
const isPt = locale === 'pt-br'

const copy = isPt
  ? {
      legend: 'Orçamento de memória de um acelerador',
      usable: 'Memória utilizável (GiB, como o runtime reporta)',
      precision: 'Precisão dos pesos',
      context: 'Contexto por sequência (tokens)',
      reserve: 'Reserva de runtime (GiB)',
      weights: 'Pesos',
      pool: 'Pool de KV',
      perSeq: 'Por sequência',
      seats: 'Sequências simultâneas',
      fits: 'Cabe, com folga.',
      tight: 'Cabe, mas sem margem para picos.',
      no: 'Não cabe: os pesos e a reserva já consomem a placa.',
      note: 'KV fixo em 64 KiB por token (16 camadas de attention, lição 7.2) mais 72 MiB de estado Gated DeltaNet por sequência, constante no comprimento.',
    }
  : {
      legend: 'Memory budget of one accelerator',
      usable: 'Usable memory (GiB, as your runtime reports it)',
      precision: 'Weight precision',
      context: 'Context per sequence (tokens)',
      reserve: 'Runtime reserve (GiB)',
      weights: 'Weights',
      pool: 'KV pool',
      perSeq: 'Per sequence',
      seats: 'Concurrent sequences',
      fits: 'Fits, with room to spare.',
      tight: 'Fits, but with no headroom for bursts.',
      no: 'Does not fit: weights and reserve already consume the card.',
      note: 'KV fixed at 64 KiB per token (16 attention layers, lesson 7.2) plus 72 MiB of Gated DeltaNet state per sequence, constant in length.',
    }

// Defaults mirror the worked example in the lesson body.
const PARAMS = 27e9
const KIB_PER_TOKEN = 64
const STATE_MIB = 72
const defaults = { usable: 79.6, bytes: 2, context: 32768, reserve: 6 }

const weightsGiB = (PARAMS * defaults.bytes) / 1024 ** 3
const poolGiB = defaults.usable - weightsGiB - defaults.reserve
const perSeqMiB = (defaults.context * KIB_PER_TOKEN) / 1024 + STATE_MIB
const seats = Math.max(0, Math.floor((poolGiB * 1024) / perSeqMiB))

const precisions = isPt
  ? [{ v: 2, l: 'bf16 (2 B)' }, { v: 1, l: 'FP8 (1 B)' }, { v: 0.5, l: '4 bits (0,5 B)' }]
  : [{ v: 2, l: 'bf16 (2 B)' }, { v: 1, l: 'FP8 (1 B)' }, { v: 0.5, l: '4-bit (0.5 B)' }]
const contexts = [8192, 32768, 131072, 262144]
---

<form class="lab-kv" data-lab="kv-budget" aria-label={copy.legend}>
  <div class="lab-kv__controls">
    <label>
      <span>{copy.usable}</span>
      <input type="number" name="usable" value={defaults.usable} min="1" max="1024" step="0.1" inputmode="decimal" />
    </label>
    <label>
      <span>{copy.precision}</span>
      <select name="bytes">
        {precisions.map((p) => <option value={p.v} selected={p.v === defaults.bytes}>{p.l}</option>)}
      </select>
    </label>
    <label>
      <span>{copy.context}</span>
      <select name="context">
        {contexts.map((c) => <option value={c} selected={c === defaults.context}>{c.toLocaleString(isPt ? 'pt-BR' : 'en-US')}</option>)}
      </select>
    </label>
    <label>
      <span>{copy.reserve}</span>
      <input type="number" name="reserve" value={defaults.reserve} min="0" max="64" step="0.5" inputmode="decimal" />
    </label>
  </div>

  <output class="lab-kv__out" aria-live="polite">
    <div class="lab-kv__stat"><span>{copy.weights}</span><b data-out="weights">{weightsGiB.toFixed(1)} GiB</b></div>
    <div class="lab-kv__stat"><span>{copy.pool}</span><b data-out="pool">{poolGiB.toFixed(1)} GiB</b></div>
    <div class="lab-kv__stat"><span>{copy.perSeq}</span><b data-out="perseq">{perSeqMiB.toFixed(0)} MiB</b></div>
    <div class="lab-kv__stat lab-kv__stat--lead"><span>{copy.seats}</span><b data-out="seats">{seats}</b></div>
  </output>

  <p class="lab-kv__verdict" data-out="verdict">{seats >= 8 ? copy.fits : seats > 0 ? copy.tight : copy.no}</p>
  <p class="lab-kv__note">{copy.note}</p>
</form>

<script>
  const KIB_PER_TOKEN = 64
  const STATE_MIB = 72
  const PARAMS = 27e9

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lab="kv-budget"]')) {
    const isPt = form.closest('[lang="pt-BR"]') !== null
    const text = isPt
      ? { fits: 'Cabe, com folga.', tight: 'Cabe, mas sem margem para picos.', no: 'Não cabe: os pesos e a reserva já consomem a placa.' }
      : { fits: 'Fits, with room to spare.', tight: 'Fits, but with no headroom for bursts.', no: 'Does not fit: weights and reserve already consume the card.' }
    const out = (name: string): HTMLElement | null => form.querySelector(`[data-out="${name}"]`)
    const num = (name: string): number => Number((form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement)?.value)

    const update = (): void => {
      const usable = num('usable')
      const bytes = num('bytes')
      const context = num('context')
      const reserve = num('reserve')
      if (![usable, bytes, context, reserve].every(Number.isFinite)) return

      const weights = (PARAMS * bytes) / 1024 ** 3
      const pool = usable - weights - reserve
      const perSeq = (context * KIB_PER_TOKEN) / 1024 + STATE_MIB
      const seats = Math.max(0, Math.floor((pool * 1024) / perSeq))

      const w = out('weights'); if (w) w.textContent = `${weights.toFixed(1)} GiB`
      const p = out('pool'); if (p) p.textContent = `${pool.toFixed(1)} GiB`
      const s = out('perseq'); if (s) s.textContent = `${perSeq.toFixed(0)} MiB`
      const n = out('seats'); if (n) n.textContent = String(seats)
      const v = out('verdict'); if (v) v.textContent = seats >= 8 ? text.fits : seats > 0 ? text.tight : text.no
    }

    form.addEventListener('input', update)
    form.addEventListener('submit', (event) => { event.preventDefault(); update() })
    update()
  }
</script>

<style>
  .lab-kv { display: grid; gap: var(--space-md); padding: var(--space-lg); border: 1px solid var(--rule-strong); border-radius: var(--radius-md); background: var(--paper-raised); }
  .lab-kv__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: var(--space-md); }
  .lab-kv label { display: grid; gap: var(--space-2xs); }
  .lab-kv label > span { color: var(--ink-faint); font: var(--weight-semibold) var(--text-3xs) var(--font-data); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }
  .lab-kv input, .lab-kv select { width: 100%; padding: var(--space-xs) var(--space-sm); border: 1px solid var(--rule-strong); border-radius: var(--radius-sm); color: var(--ink); background: var(--paper); font: var(--text-base) var(--font-data); }
  .lab-kv input:focus, .lab-kv select:focus { border-color: var(--accent); outline: 3px solid color-mix(in srgb, var(--focus) 40%, transparent); outline-offset: 2px; }
  .lab-kv__out { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: var(--space-md); padding-block: var(--space-md); border-block: 1px solid var(--rule); }
  .lab-kv__stat { display: grid; gap: var(--space-2xs); }
  .lab-kv__stat span { color: var(--ink-muted); font-size: var(--text-2xs); }
  .lab-kv__stat b { font: var(--weight-bold) var(--text-xl) var(--font-display); }
  .lab-kv__stat--lead b { color: var(--accent); }
  .lab-kv__verdict { margin: 0; font-weight: var(--weight-semibold); }
  .lab-kv__note { margin: 0; color: var(--ink-muted); font-size: var(--text-xs); }
</style>
