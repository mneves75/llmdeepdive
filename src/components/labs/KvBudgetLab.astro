---
import { QWEN } from '../../lib/model-facts'
import { formatInputValue } from '../../lib/lab-number'
/**
 * Lesson 9.3 — the memory budget of one accelerator, made adjustable.
 *
 * The lesson derives the arithmetic once; this lab lets a reader move the four
 * numbers that actually vary (usable memory, weight precision, context length,
 * per-sequence state) and watch the concurrency answer move with them. The
 * per-token KV figure is fixed at 64 KiB because it is a property of the model,
 * derived in lesson 7.2 — it is shown, not editable.
 *
 * Server-rendered with its defaults already computed, so a reader without
 * JavaScript still gets a worked budget rather than an apology.
 */
interface Props { locale: 'en' | 'pt-br' }
const { locale } = Astro.props
const isPt = locale === 'pt-br'

const copy = isPt
  ? {
      legend: 'Orçamento de memória de um acelerador',
      usable: 'Memória utilizável (GiB, como o runtime reporta)',
      precision: 'Precisão dos pesos',
      context: 'Contexto por sequência (tokens)',
      reserve: 'Reserva de runtime (GiB)',
      weights: 'Pesos',
      pool: 'Pool de KV',
      perSeq: 'Por sequência',
      seats: 'Sequências simultâneas',
      fits: 'Cabe, com folga.',
      tight: 'Cabe, mas sem margem para picos.',
      no: 'Não cabe: os pesos e a reserva já consomem a placa.',
      noSequence: 'Não cabe: o pool de KV restante é menor que uma sequência.',
      invalid: 'Informe memória utilizável entre 1 e 1.024 GiB e reserva entre 0 e 64 GiB. Use vírgula ou ponto para decimais.',
      note: `KV fixo em ${QWEN.kvKibPerToken.value} KiB por token (16 camadas de attention, lição 7.2) mais ${QWEN.deltaNetStateMib.value} MiB de estado Gated DeltaNet por sequência, constante no comprimento.`,
    }
  : {
      legend: 'Memory budget of one accelerator',
      usable: 'Usable memory (GiB, as your runtime reports it)',
      precision: 'Weight precision',
      context: 'Context per sequence (tokens)',
      reserve: 'Runtime reserve (GiB)',
      weights: 'Weights',
      pool: 'KV pool',
      perSeq: 'Per sequence',
      seats: 'Concurrent sequences',
      fits: 'Fits, with room to spare.',
      tight: 'Fits, but with no headroom for bursts.',
      no: 'Does not fit: weights and reserve already consume the card.',
      noSequence: 'Does not fit: the remaining KV pool is smaller than one sequence.',
      invalid: 'Enter usable memory from 1 to 1,024 GiB and a runtime reserve from 0 to 64 GiB.',
      note: `KV fixed at ${QWEN.kvKibPerToken.value} KiB per token (16 attention layers, lesson 7.2) plus ${QWEN.deltaNetStateMib.value} MiB of Gated DeltaNet state per sequence, constant in length.`,
    }

// Defaults mirror the worked example in the lesson body.
const PARAMS = QWEN.paramsTotal.value
const KIB_PER_TOKEN = QWEN.kvKibPerToken.value
const STATE_MIB = QWEN.deltaNetStateMib.value
const defaults = { usable: 79.6, bytes: 2, context: 32768, reserve: 6 }

const weightsGiB = (PARAMS * defaults.bytes) / 1024 ** 3
const poolGiB = defaults.usable - weightsGiB - defaults.reserve
const perSeqMiB = (defaults.context * KIB_PER_TOKEN) / 1024 + STATE_MIB
const seats = Math.max(0, Math.floor((poolGiB * 1024) / perSeqMiB))

const precisions = isPt
  ? [{ v: 2, l: 'bf16 (2 B)' }, { v: 1, l: 'FP8 (1 B)' }, { v: 0.5, l: '4 bits (0,5 B)' }]
  : [{ v: 2, l: 'bf16 (2 B)' }, { v: 1, l: 'FP8 (1 B)' }, { v: 0.5, l: '4-bit (0.5 B)' }]
const contexts = [8192, 32768, 131072, 262144]
const localeTag = isPt ? 'pt-BR' : 'en-US'
const oneDecimal = new Intl.NumberFormat(localeTag, { minimumFractionDigits: 1, maximumFractionDigits: 1 })
const integer = new Intl.NumberFormat(localeTag, { maximumFractionDigits: 0 })
---

<form class="lab-kv" data-lab="kv-budget" data-params={PARAMS} data-kib-per-token={KIB_PER_TOKEN} data-state-mib={STATE_MIB} aria-label={copy.legend}>
  <div class="lab-kv__controls">
    <label>
      <span>{copy.usable}</span>
      <input type="text" name="usable" value={formatInputValue(defaults.usable, locale)} data-min="1" data-max="1024" inputmode="decimal" autocomplete="off" spellcheck="false" required />
    </label>
    <label>
      <span>{copy.precision}</span>
      <select name="bytes">
        {precisions.map((p) => <option value={p.v} selected={p.v === defaults.bytes}>{p.l}</option>)}
      </select>
    </label>
    <label>
      <span>{copy.context}</span>
      <select name="context">
        {contexts.map((c) => <option value={c} selected={c === defaults.context}>{integer.format(c)}</option>)}
      </select>
    </label>
    <label>
      <span>{copy.reserve}</span>
      <input type="text" name="reserve" value={formatInputValue(defaults.reserve, locale)} data-min="0" data-max="64" inputmode="decimal" autocomplete="off" spellcheck="false" required />
    </label>
  </div>

  {/* Always in the accessibility tree, empty until needed: a live region that
      only appears when it is revealed is often never announced. */}
  <p class="lab-kv__validation" data-out="validation" data-invalid={copy.invalid} role="status"></p>

  <output class="lab-kv__out" aria-live="polite">
    <div class="lab-kv__stat"><span>{copy.weights}</span><b data-out="weights">{oneDecimal.format(weightsGiB)} GiB</b></div>
    <div class="lab-kv__stat"><span>{copy.pool}</span><b data-out="pool">{oneDecimal.format(poolGiB)} GiB</b></div>
    <div class="lab-kv__stat"><span>{copy.perSeq}</span><b data-out="perseq">{integer.format(perSeqMiB)} MiB</b></div>
    <div class="lab-kv__stat lab-kv__stat--lead"><span>{copy.seats}</span><b data-out="seats">{integer.format(seats)}</b></div>
  </output>

  <p class="lab-kv__verdict" data-out="verdict">{seats >= 8 ? copy.fits : seats > 0 ? copy.tight : poolGiB > 0 ? copy.noSequence : copy.no}</p>
  <p class="lab-kv__note">{copy.note}</p>
</form>

<script>
  import { parseDecimal } from '../../lib/lab-number'

  const readFact = (form: HTMLFormElement, name: string): number => Number(form.dataset[name])

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lab="kv-budget"]')) {
    const isPt = form.closest('[lang="pt-BR"]') !== null
    const PARAMS = readFact(form, 'params')
    const KIB_PER_TOKEN = readFact(form, 'kibPerToken')
    const STATE_MIB = readFact(form, 'stateMib')
    if (![PARAMS, KIB_PER_TOKEN, STATE_MIB].every(Number.isFinite)) continue
    const text = isPt
      ? { fits: 'Cabe, com folga.', tight: 'Cabe, mas sem margem para picos.', no: 'Não cabe: os pesos e a reserva já consomem a placa.', noSequence: 'Não cabe: o pool de KV restante é menor que uma sequência.' }
      : { fits: 'Fits, with room to spare.', tight: 'Fits, but with no headroom for bursts.', no: 'Does not fit: weights and reserve already consume the card.', noSequence: 'Does not fit: the remaining KV pool is smaller than one sequence.' }
    const locale = isPt ? 'pt-BR' : 'en-US'
    const oneDecimal = new Intl.NumberFormat(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 })
    const integer = new Intl.NumberFormat(locale, { maximumFractionDigits: 0 })
    const out = (name: string): HTMLElement | null => form.querySelector(`[data-out="${name}"]`)
    const num = (name: string): number | null => {
      const control = form.elements.namedItem(name)
      let value: number | null = null
      if (control instanceof HTMLSelectElement) {
        value = Number(control.value)
      } else if (control instanceof HTMLInputElement) {
        value = parseDecimal(control.value, isPt ? 'pt-br' : 'en')
        const min = Number(control.dataset.min ?? Number.NEGATIVE_INFINITY)
        const max = Number(control.dataset.max ?? Number.POSITIVE_INFINITY)
        if (value !== null && (value < min || value > max)) value = null
        if (value === null) control.setAttribute('aria-invalid', 'true')
        else control.removeAttribute('aria-invalid')
      }
      return value !== null && Number.isFinite(value) ? value : null
    }
    const show = (values: Record<'weights' | 'pool' | 'perseq' | 'seats' | 'verdict', string>, message: string): void => {
      for (const [name, value] of Object.entries(values)) {
        const element = out(name)
        if (element) element.textContent = value
      }
      const validation = out('validation')
      if (validation) validation.textContent = message
    }

    const update = (): void => {
      const usable = num('usable')
      const bytes = num('bytes')
      const context = num('context')
      const reserve = num('reserve')
      if (usable === null || bytes === null || context === null || reserve === null) {
        // Never leave the last valid answer beside an invalid input.
        show({ weights: '—', pool: '—', perseq: '—', seats: '—', verdict: '' }, out('validation')?.dataset.invalid ?? '')
        return
      }

      const weights = (PARAMS * bytes) / 1024 ** 3
      const pool = usable - weights - reserve
      const perSeq = (context * KIB_PER_TOKEN) / 1024 + STATE_MIB
      const seats = Math.max(0, Math.floor((pool * 1024) / perSeq))
      show({
        weights: `${oneDecimal.format(weights)} GiB`,
        pool: `${oneDecimal.format(pool)} GiB`,
        perseq: `${integer.format(perSeq)} MiB`,
        seats: integer.format(seats),
        verdict: seats >= 8 ? text.fits : seats > 0 ? text.tight : pool > 0 ? text.noSequence : text.no,
      }, '')
    }

    form.addEventListener('input', update)
    form.addEventListener('change', update)
    form.addEventListener('submit', (event) => { event.preventDefault(); update() })
    update()
  }
</script>

<style>
  .lab-kv { display: grid; gap: var(--space-md); padding: var(--space-lg); border: 1px solid var(--rule-strong); border-radius: var(--radius-md); background: var(--paper-raised); }
  .lab-kv__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: var(--space-md); }
  .lab-kv label { display: grid; gap: var(--space-2xs); }
  .lab-kv label > span { color: var(--ink-faint); font: var(--weight-semibold) var(--text-3xs) var(--font-data); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }
  .lab-kv input, .lab-kv select { width: 100%; padding: var(--space-xs) var(--space-sm); border: 1px solid var(--rule-strong); border-radius: var(--radius-sm); color: var(--ink); background: var(--paper); font: var(--text-base) var(--font-data); }
  .lab-kv input:focus, .lab-kv select:focus { border-color: var(--accent); outline: 3px solid color-mix(in srgb, var(--focus) 40%, transparent); outline-offset: 2px; }
  .lab-kv input[aria-invalid='true'], .lab-kv select[aria-invalid='true'] { border-color: var(--coral); }
  .lab-kv__validation { margin: 0; color: var(--coral); font-size: var(--text-xs); font-weight: var(--weight-semibold); }
  /* The empty region stays in the tree; cancel the grid gap it would add. */
  .lab-kv__validation:empty { margin-block-start: calc(-1 * var(--space-md)); }
  .lab-kv__out { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: var(--space-md); padding-block: var(--space-md); border-block: 1px solid var(--rule); }
  .lab-kv__stat { display: grid; gap: var(--space-2xs); }
  .lab-kv__stat span { color: var(--ink-muted); font-size: var(--text-2xs); }
  .lab-kv__stat b { font: var(--weight-bold) var(--text-xl) var(--font-display); }
  .lab-kv__stat--lead b { color: var(--accent); }
  .lab-kv__verdict { margin: 0; font-weight: var(--weight-semibold); }
  .lab-kv__note { margin: 0; color: var(--ink-muted); font-size: var(--text-xs); }
</style>
