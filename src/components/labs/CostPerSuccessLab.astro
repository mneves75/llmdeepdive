---
import { formatInputValue } from '../../lib/lab-form'
import { costPerSuccess, labFormatters, rateWithInterval, usdFormatter } from '../../lib/lab-math'
/**
 * Lesson 25.2 — the cost of one successful task, not of one run.
 *
 * Failed runs and the person who reviews every run are part of the bill, and
 * a few dozen trials leave a wide interval around the success rate, so the lab
 * shows both. Server-rendered with the lesson's worked example.
 */
interface Props { locale: 'en' | 'pt-br' }
const { locale } = Astro.props
const isPt = locale === 'pt-br'

const copy = isPt
  ? {
      legend: 'Custo por tarefa bem-sucedida',
      runs: 'Execuções',
      successes: 'Execuções bem-sucedidas',
      model: 'Modelo por execução (USD)',
      sandbox: 'Sandbox por execução (USD)',
      minutes: 'Revisão humana por execução (minutos)',
      hourly: 'Custo da hora de revisão (USD)',
      perRun: 'Por execução',
      total: 'Total',
      perSuccess: 'Por sucesso',
      rate: 'Taxa de sucesso (IC 95%)',
      none: 'nenhum sucesso',
      invalid: 'Informe de 1 a 100.000 execuções inteiras, sucessos inteiros a partir de 0 e custos não negativos. Use vírgula ou ponto para decimais.',
      invalidSuccesses: 'As execuções bem-sucedidas não podem passar do número de execuções.',
      note: 'O intervalo é o de Wilson para uma proporção, válido se as execuções forem independentes. Com 30 execuções ele vai de cerca de 63% a 90%: dois sistemas cujos intervalos se sobrepõem tanto não foram separados por este teste. Registre modelo, versão, data e hardware junto com o número.',
    }
  : {
      legend: 'Cost per successful task',
      runs: 'Runs',
      successes: 'Successful runs',
      model: 'Model per run (USD)',
      sandbox: 'Sandbox per run (USD)',
      minutes: 'Human review per run (minutes)',
      hourly: 'Review cost per hour (USD)',
      perRun: 'Per run',
      total: 'Total',
      perSuccess: 'Per success',
      rate: 'Success rate (95% CI)',
      none: 'no successes',
      invalid: 'Enter a whole number of runs from 1 to 100,000, a whole number of successes from 0, and costs of zero or more.',
      invalidSuccesses: 'Successful runs cannot exceed the number of runs.',
      note: 'The interval is the Wilson interval for a proportion, valid if runs are independent. At 30 runs it spans roughly 63% to 90%: two systems whose intervals overlap that much were not told apart by this test. Record the model, version, date and hardware with the number.',
    }

const defaults = { runs: 30, successes: 24, modelCost: 0.08, sandboxCost: 0.02, reviewMinutes: 1.5, reviewHourly: 40 }
const result = costPerSuccess(defaults)
const { whole } = labFormatters(locale)
const usd = usdFormatter(locale, 3)
const fields = [
  ['runs', copy.runs, 1, 100000, 'numeric'],
  ['successes', copy.successes, 0, 100000, 'numeric'],
  ['modelCost', copy.model, 0, 1000000, 'decimal'],
  ['sandboxCost', copy.sandbox, 0, 1000000, 'decimal'],
  ['reviewMinutes', copy.minutes, 0, 100000, 'decimal'],
  ['reviewHourly', copy.hourly, 0, 100000, 'decimal'],
] as const
---

<form class="lab" data-lab="cost-per-success" aria-label={copy.legend}>
  <p class="lab__lead">{copy.legend}</p>
  <div class="lab__controls">
    {fields.map(([name, label, min, max, mode]) => (
      <label>
        <span>{label}</span>
        <input type="text" name={name} value={formatInputValue(defaults[name], locale)} data-min={min} data-max={max} data-integer={mode === 'numeric'} inputmode={mode} autocomplete="off" spellcheck="false" required />
      </label>
    ))}
  </div>

  <p class="lab__validation" data-out="validation" data-invalid={copy.invalid} data-invalid-successes={copy.invalidSuccesses} role="status"></p>

  <output class="lab__out" aria-live="polite">
    <div class="lab__stat"><span>{copy.perRun}</span><b data-out="perRun">{usd(result.costPerRun)}</b></div>
    <div class="lab__stat"><span>{copy.total}</span><b data-out="total">{usd(result.total)}</b></div>
    <div class="lab__stat lab__stat--lead"><span>{copy.perSuccess}</span><b data-out="perSuccess" data-none={copy.none}>{result.perSuccess === null ? copy.none : usd(result.perSuccess)}</b></div>
    <div class="lab__stat"><span>{copy.rate}</span><b data-out="rate">{rateWithInterval(whole, result)}</b></div>
  </output>

  <p class="lab__note">{copy.note}</p>
</form>

<script>
  import { markLabControl, pageLocale, readLabControl, showLabOutputs } from '../../lib/lab-form'
  import { costPerSuccess, labFormatters, rateWithInterval, usdFormatter } from '../../lib/lab-math'

  const NAMES = ['runs', 'successes', 'modelCost', 'sandboxCost', 'reviewMinutes', 'reviewHourly'] as const

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lab="cost-per-success"]')) {
    const locale = pageLocale(form)
    const { whole } = labFormatters(locale)
    const usd = usdFormatter(locale, 3)
    const messages = form.querySelector<HTMLElement>('[data-out="validation"]')?.dataset ?? {}
    const none = form.querySelector<HTMLElement>('[data-out="perSuccess"]')?.dataset.none ?? ''

    const update = (): void => {
      const values = NAMES.map((name) => readLabControl(form, name, locale))
      const [runs, successes, modelCost, sandboxCost, reviewMinutes, reviewHourly] = values
      const blank = { perRun: '—', total: '—', perSuccess: '—', rate: '—' }
      if (runs == null || successes == null || modelCost == null || sandboxCost == null || reviewMinutes == null || reviewHourly == null) {
        showLabOutputs(form, blank, messages.invalid ?? '')
        return
      }
      if (successes > runs) {
        markLabControl(form, 'successes')
        showLabOutputs(form, blank, messages.invalidSuccesses ?? '')
        return
      }
      const result = costPerSuccess({ runs, successes, modelCost, sandboxCost, reviewMinutes, reviewHourly })
      showLabOutputs(form, {
        perRun: usd(result.costPerRun),
        total: usd(result.total),
        perSuccess: result.perSuccess === null ? none : usd(result.perSuccess),
        rate: rateWithInterval(whole, result),
      }, '')
    }

    form.addEventListener('input', update)
    form.addEventListener('change', update)
    form.addEventListener('submit', (event) => { event.preventDefault(); update() })
    update()
  }
</script>
