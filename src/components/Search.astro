---
import type { Locale } from '~/lib/i18n'
import Icon from '~/components/Icon.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const isPt = locale === 'pt-br'

const t = {
  open: isPt ? 'Buscar' : 'Search',
  label: isPt ? 'Buscar nas aulas' : 'Search lessons',
  placeholder: isPt ? 'Buscar aulas, conceitos…' : 'Search lessons, concepts…',
  empty: isPt ? 'Nada encontrado.' : 'No results.',
  searching: isPt ? 'Buscando…' : 'Searching…',
  unavailable: isPt ? 'A busca está indisponível. Tente novamente.' : 'Search is unavailable. Try again.',
  hint: isPt ? 'Digite pelo menos dois caracteres.' : 'Enter at least two characters.',
  close: isPt ? 'Fechar (Esc)' : 'Close (Esc)',
  shortcut: isPt ? 'Atalho: tecla barra' : 'Shortcut: slash key',
  results: isPt ? 'Resultados' : 'Results',
  countOne: isPt ? '1 resultado' : '1 result',
  countOther: isPt ? '{n} resultados' : '{n} results',
  navigate: isPt ? 'Percorrer' : 'Navigate',
  select: isPt ? 'Selecionar' : 'Select',
}
---

<button type="button" class="search-open" data-search-open aria-haspopup="dialog" aria-keyshortcuts="/ Control+K Meta+K">
  <Icon name="search" />
  <span class="search-open__label">{t.open}</span>
  {/* `/` works on every platform; ⌘K and Ctrl+K are accepted too. */}
  <kbd title={t.shortcut}>/</kbd>
</button>

{/*
  A native <dialog> rather than a hand-rolled overlay: focus trapping,
  inertness of the background and correct ARIA come from the platform. Escape
  is handled explicitly because a populated input[type="search"] consumes the
  first press to clear itself in Chromium.
  The reference project we studied hand-rolled role="dialog" with no focus trap
  and no Escape handler, which is an accessibility failure that is easy to avoid
  by not hand-rolling it.
*/}
<dialog class="search" data-search-dialog aria-labelledby="search-title" data-empty={t.empty} data-searching={t.searching} data-unavailable={t.unavailable} data-hint={t.hint} data-count-one={t.countOne} data-count-other={t.countOther}>
  <header class="search__header">
    <h2 id="search-title">{t.label}</h2>
    <button type="button" class="search__close" data-search-close aria-label={t.close}>
      <Icon name="close" size="1.15rem" />
    </button>
  </header>
  <form method="dialog" class="search__field">
    <Icon name="search" size="1.4rem" />
    <input
      type="search"
      class="search__input"
      data-search-input
      placeholder={t.placeholder}
      aria-label={t.label}
      autocomplete="off"
      spellcheck="false"
    />
  </form>

  <p class="search__status" data-search-status role="status" aria-live="polite">{t.hint}</p>
  <ul class="search__results" data-search-results aria-label={t.results}></ul>
  <footer class="search__keys" aria-hidden="true">
    <span><kbd>↑</kbd> <kbd>↓</kbd> {t.navigate}</span>
    <span><kbd>Enter</kbd> {t.select}</span>
  </footer>
</dialog>

{/*
  is:inline keeps the dynamic import of the build-generated Pagefind bundle out
  of Vite's resolver. The script reads its strings from data-* so it is
  byte-identical in both locales and costs one CSP hash, not one per locale.
*/}
<script is:inline>
  // Pagefind builds a per-language index keyed off <html lang>, so a pt-BR
  // visitor only ever downloads the pt-BR index. It is fetched on first open —
  // zero bytes on initial page load, and no Worker invocation ever.
  // Classic inline scripts share one global lexical scope; the block keeps
  // these bindings from colliding with any other inline script.
  {
  let pagefind = null
  let loading = null
  let loads = 0

  const dialog = document.querySelector('[data-search-dialog]')
  const input = document.querySelector('[data-search-input]')
  const list = document.querySelector('[data-search-results]')
  const status = document.querySelector('[data-search-status]')
  if (dialog && input && list && status) {
    const emptyText = dialog.dataset.empty ?? ''
    const hintText = dialog.dataset.hint ?? ''
    const searchingText = dialog.dataset.searching ?? ''
    const unavailableText = dialog.dataset.unavailable ?? ''
    const countText = (count) => count === 1
      ? dialog.dataset.countOne ?? String(count)
      : (dialog.dataset.countOther ?? '{n}').replace('{n}', String(count))
    const loadIndex = () => {
      if (pagefind) return Promise.resolve(pagefind)
      if (loading) return loading
      // Module failures and failed fragment requests are cached for the life
      // of the document and the Pagefind instance respectively.
      const indexUrl = loads === 0 ? '/pagefind/pagefind.js' : `/pagefind/pagefind.js?retry=${loads}`
      loads += 1
      loading = import(/* @vite-ignore */ indexUrl)
        .then(async (mod) => {
          await mod.options({ baseUrl: '/' })
          pagefind = mod
          return mod
        })
        .catch((err) => {
          // Search is an enhancement. If the index is missing the rest of the
          // site is unaffected, so fail visibly here and nowhere else.
          console.error('[search] index unavailable:', err)
          loading = null
          return null
        })
      return loading
    }

    const open = () => {
      if (!dialog.open) dialog.showModal()
      if (!pagefind) {
        if (input.value.trim().length >= 2) {
          void run(input.value)
        } else {
          const openedAt = seq
          void loadIndex().then((pf) => {
            if (openedAt === seq && dialog.open) status.textContent = pf ? hintText : unavailableText
          })
        }
      }
      input.focus()
    }

    const opener = document.querySelector('[data-search-open]')
    opener?.addEventListener('click', open)

    document.addEventListener('keydown', (ev) => {
      const typing =
        ev.target instanceof HTMLElement &&
        (ev.target.tagName === 'INPUT' ||
          ev.target.tagName === 'TEXTAREA' ||
          ev.target.isContentEditable)
      if ((ev.key === 'k' && (ev.metaKey || ev.ctrlKey)) || (ev.key === '/' && !typing)) {
        ev.preventDefault()
        open()
      }
    })

    let seq = 0
    let lastRendered = ''
    let pending = false
    const run = async (query) => {
      const mine = ++seq
      const trimmed = query.trim()
      if (trimmed.length < 2) {
        lastRendered = ''
        pending = false
        list.replaceChildren()
        status.textContent = hintText
        return false
      }
      pending = true
      lastRendered = ''
      list.replaceChildren()
      status.textContent = searchingText
      const pf = await loadIndex()
      if (mine !== seq) return false
      if (!pf) {
        pending = false
        status.textContent = unavailableText
        return false
      }

      let loaded
      try {
        const search = await pf.search(query)
        if (mine !== seq) return false // a newer keystroke already won
        loaded = await Promise.all(search.results.slice(0, 12).map((r) => r.data()))
      } catch (err) {
        console.error('[search] query failed:', err)
        if (pagefind === pf) {
          pagefind = null
          loading = null
        }
        if (mine === seq) {
          pending = false
          status.textContent = unavailableText
        }
        return false
      }
      if (mine !== seq) return false
      pending = false
      lastRendered = trimmed
      // With no real match, Pagefind retries shorter prefixes of the query, so
      // "zzqvx" highlights a one-letter formula symbol ("z") in some lesson.
      // Keep a result only if a highlighted word begins like a query term
      // (first three letters, accents folded): "caches" for "caching" stays,
      // "z" for "zzqvx" and "at" for "atenção" go.
      const fold = (text) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '')
      const stems = query.split(/\s+/).map(fold).filter(Boolean).map((term) => term.slice(0, 3))
      const relevant = (excerpt) => stems.length === 0 ||
        [...excerpt.matchAll(/<mark>(.*?)<\/mark>/g)].some(([, word]) => {
          const folded = fold(word)
          return folded !== '' && stems.some((stem) => folded.startsWith(stem))
        })
      const results = loaded.filter((r) => relevant(r.excerpt)).slice(0, 8)

      for (const r of results) {
        const li = document.createElement('li')
        const a = document.createElement('a')
        // The index is first-party build output, but this is the one place a
        // URL rather than text reaches the DOM. Reject protocol-relative paths
        // before parsing and verify the resolved origin stays identical.
        const raw = typeof r.url === 'string' ? r.url.trim() : ''
        if (!raw || /^[/\\]{2}/.test(raw)) continue
        let resolved
        try {
          resolved = new URL(raw, location.href)
        } catch {
          continue
        }
        if (resolved.origin !== location.origin || resolved.pathname.startsWith('//')) continue
        a.href = resolved.href
        const title = document.createElement('span')
        title.className = 'search__title'
        title.textContent = r.meta?.title ?? r.url
        const excerpt = document.createElement('span')
        excerpt.className = 'search__excerpt'
        // Pagefind returns highlighted HTML; keep it as text so the index can
        // never inject markup into the page.
        // Pagefind escapes the text it highlights; decode the entities it
        // emits after the tags are gone (`&amp;` last, so `&amp;lt;` stays literal).
        excerpt.textContent = r.excerpt.replace(/<[^>]*>/g, '')
          .replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&amp;/g, '&')
        a.append(title, excerpt)
        li.append(a)
        list.append(li)
      }
      const count = list.children.length
      status.textContent = count === 0 ? emptyText : countText(count)
      return count > 0
    }

    let debounce = 0
    input.addEventListener('input', () => {
      window.clearTimeout(debounce)
      seq += 1
      pending = true
      list.replaceChildren()
      debounce = window.setTimeout(() => void run(input.value), 120)
    })

    // Enter in the field flushes any pending query, then focuses the first
    // result only if the query is still current.
    dialog.querySelector('form')?.addEventListener('submit', async (ev) => {
      ev.preventDefault()
      window.clearTimeout(debounce)
      const query = (input.value ?? '').trim()
      if (query === lastRendered && !pending) {
        list.querySelector('a')?.focus()
        return
      }
      const current = await run(input.value ?? '')
      if (current && (input.value ?? '').trim() === query) list.querySelector('a')?.focus()
    })
    dialog.querySelector('[data-search-close]')?.addEventListener('click', () => {
      dialog.close()
      opener?.focus()
    })

    list.addEventListener('focusin', (ev) => {
      const link = ev.target
      if (!(link instanceof HTMLAnchorElement)) return
      // An oversized result can cover the scroll area while its title is
      // clipped. Align the top after the browser's native focus scroll.
      requestAnimationFrame(() => {
        if (document.activeElement !== link) return
        const region = list.getBoundingClientRect()
        const row = link.getBoundingClientRect()
        const title = link.querySelector('.search__title')?.getBoundingClientRect()
        if (row.top < region.top || (title && title.bottom > region.bottom)) {
          list.scrollTop += row.top - region.top
        }
      })
    })

    // Escape closes in one press even when the native search field has a value.
    // Arrow keys move through results; Enter follows the focused one.
    dialog.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') {
        ev.preventDefault()
        dialog.close()
        opener?.focus()
        return
      }
      if (ev.key !== 'ArrowDown' && ev.key !== 'ArrowUp') return
      const links = [...list.querySelectorAll('a')]
      if (links.length === 0) return
      ev.preventDefault()
      const idx = links.indexOf(document.activeElement)
      const next =
        ev.key === 'ArrowDown'
          ? links[idx < 0 ? 0 : (idx + 1) % links.length]
          : links[idx < 0 ? links.length - 1 : (idx - 1 + links.length) % links.length]
      next?.focus()
    })
  }
  }
</script>

<style>
  .search-open {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    padding: 0.35rem 0.55rem 0.35rem 0.65rem;
    border: 1px solid var(--rule-field);
    border-radius: var(--radius-sm);
    background: var(--plate);
    color: var(--ink-muted);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .search-open:hover { border-color: var(--accent); color: var(--accent); }

  .search-open kbd {
    display: grid;
    place-items: center;
    min-width: 1.35rem;
    height: 1.35rem;
    margin-inline-start: var(--space-2xs);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-xs);
    font-family: var(--font-data);
    font-size: var(--text-3xs);
  }

  /* A native modal <dialog>: Tailwind's preflight zeroes its UA `margin: auto`,
     which pinned it to the left edge, so centring is restated here. */
  .search {
    width: min(43rem, calc(100vw - 1.5rem));
    max-height: min(43rem, 84dvh);
    margin: 8dvh auto auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    border-block-start: 3px solid var(--reticle);
    border-radius: var(--radius-md);
    background: var(--plate);
    color: var(--ink);
    box-shadow: var(--shadow-overlay);
    opacity: 1;
    translate: 0 0;
    transition:
      opacity var(--dur-base) var(--ease-out),
      translate var(--dur-base) var(--ease-out),
      overlay var(--dur-base),
      display var(--dur-base);
    transition-behavior: allow-discrete;
  }

  .search:not([open]) { opacity: 0; translate: 0 -0.6rem; }

  @starting-style {
    .search[open] { opacity: 0; translate: 0 -0.6rem; }
  }

  .search::backdrop {
    background: color-mix(in srgb, var(--night) 72%, transparent);
    backdrop-filter: blur(4px);
    opacity: 1;
    transition: opacity var(--dur-base) var(--ease-out), overlay var(--dur-base), display var(--dur-base);
    transition-behavior: allow-discrete;
  }

  .search:not([open])::backdrop { opacity: 0; }

  @starting-style {
    .search[open]::backdrop { opacity: 0; }
  }

  .search[open] { display: flex; flex-direction: column; }

  .search__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    margin: var(--space-xs) var(--space-md);
  }

  .search__header h2 {
    margin: 0;
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
  }

  .search__field {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin: 0 var(--space-md);
    padding: 0 var(--space-xs);
    border: 1px solid var(--rule-field);
    border-radius: var(--radius-sm);
    background: var(--plate-raised);
    color: var(--reticle);
  }

  .search__field:focus-within { outline: 2px solid var(--reticle); outline-offset: 1px; }

  .search__input {
    flex: 1;
    min-width: 0;
    min-height: 3.25rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: max(1rem, var(--text-lg));
  }

  .search__input:focus { outline: none; }
  /* The dialog already has one close control; WebKit's clear-× beside it read
     as a second, different one. */
  .search__input::-webkit-search-cancel-button { appearance: none; }

  .search__close {
    display: grid;
    place-items: center;
    flex: none;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
  }

  .search__close:hover { border-color: var(--reticle); color: var(--reticle); }

  .search__status {
    margin: 0;
    padding: var(--space-xs) var(--space-md);
    font: var(--weight-medium) var(--text-xs) var(--font-ui);
    color: var(--ink-muted);
  }

  .search__results {
    flex: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    scrollbar-gutter: stable;
    overscroll-behavior: contain;
  }

  /* Results are built by the script at runtime, so they carry no Astro scope
     attribute: these rules must be :global() or they never match — which is how
     every result once rendered as one run-on paragraph. */
  .search__results :global(a) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: var(--space-3xs);
    position: relative;
    padding: var(--space-sm) calc(var(--space-md) + 1.25rem) var(--space-sm) var(--space-md);
    border-top: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }

  .search__results :global(a)::after {
    content: '';
    position: absolute;
    inset-inline-end: var(--space-md);
    inset-block-start: 50%;
    width: 0.45rem;
    height: 0.45rem;
    border-block-start: 1px solid currentColor;
    border-inline-end: 1px solid currentColor;
    rotate: 45deg;
    translate: 0 -50%;
    color: var(--ink-muted);
    transition: translate var(--dur-fast) var(--ease-out);
  }

  .search__results :global(a:hover),
  .search__results :global(a:focus-visible) {
    background: var(--plate-raised);
    box-shadow: inset 3px 0 var(--reticle);
  }

  .search__results :global(a:hover)::after,
  .search__results :global(a:focus-visible)::after {
    color: var(--reticle);
    translate: 0.18rem -50%;
  }

  .search__results :global(a:focus-visible) { outline-offset: -3px; }

  .search__results :global(.search__title) {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .search__results :global(.search__excerpt) {
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow-wrap: anywhere;
  }

  .search__keys {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    padding: var(--space-xs) var(--space-md);
    border-block-start: 1px solid var(--rule);
    background: var(--plate-raised);
    color: var(--ink-muted);
    font-size: var(--text-xs);
  }

  .search__keys kbd {
    padding: 0.15em 0.35em;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-xs);
    color: var(--ink);
    font-family: var(--font-data);
  }

  @media (max-width: 32rem) {
    .search-open { padding-inline: 0.6rem; }
    .search-open__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .search-open kbd { display: none; }
    .search { margin-block-start: 0.75rem; max-height: calc(100dvh - 1.5rem); }
    .search__header, .search__field { margin-inline: var(--space-sm); }
    .search__header h2 { font-size: clamp(1.05rem, 4.4vw, var(--text-xl)); }
    .search__keys { display: none; }
  }

  @media (max-height: 24rem) {
    .search { margin-block-start: 0.5rem; max-height: calc(100dvh - 1rem); }
    .search__header { margin-block: var(--space-3xs); }
    .search__header h2 { font-size: var(--text-base); }
    .search__input { min-height: 2.75rem; }
    .search__status { padding-block: var(--space-3xs); }
    .search__results :global(a) { min-block-size: 2.75rem; padding-block: var(--space-2xs); }
    .search__keys,
    .search__results :global(.search__excerpt) { display: none; }
  }
</style>
