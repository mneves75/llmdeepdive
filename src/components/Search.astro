---
import type { Locale } from '~/lib/i18n'
import Icon from '~/components/Icon.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const isPt = locale === 'pt-br'

const t = {
  open: isPt ? 'Buscar' : 'Search',
  label: isPt ? 'Buscar nas aulas' : 'Search lessons',
  placeholder: isPt ? 'Buscar aulas, conceitos…' : 'Search lessons, concepts…',
  empty: isPt ? 'Nada encontrado.' : 'No results.',
  hint: isPt ? 'Digite para buscar' : 'Type to search',
  close: isPt ? 'Fechar (Esc)' : 'Close (Esc)',
  shortcut: isPt ? 'Atalho: tecla barra' : 'Shortcut: slash key',
  results: isPt ? 'Resultados' : 'Results',
  countOne: isPt ? '1 resultado' : '1 result',
  countOther: isPt ? '{n} resultados' : '{n} results',
}
---

<button type="button" class="search-open" data-search-open aria-haspopup="dialog" aria-keyshortcuts="/ Control+K Meta+K">
  <Icon name="search" />
  <span class="search-open__label">{t.open}</span>
  {/* `/` works on every platform; ⌘K and Ctrl+K are accepted too. */}
  <kbd title={t.shortcut}>/</kbd>
</button>

{/*
  A native <dialog> rather than a hand-rolled overlay: focus trapping,
  inertness of the background and correct ARIA come from the platform. Escape
  is handled explicitly because a populated input[type="search"] consumes the
  first press to clear itself in Chromium.
  The reference project we studied hand-rolled role="dialog" with no focus trap
  and no Escape handler, which is an accessibility failure that is easy to avoid
  by not hand-rolling it.
*/}
<dialog class="search" data-search-dialog aria-label={t.label} data-empty={t.empty} data-hint={t.hint} data-count-one={t.countOne} data-count-other={t.countOther}>
  <form method="dialog" class="search__head">
    <Icon name="search" size="1.35rem" />
    <input
      type="search"
      class="search__input"
      data-search-input
      placeholder={t.placeholder}
      aria-label={t.label}
      autocomplete="off"
      spellcheck="false"
    />
    <button class="search__close" value="close" aria-label={t.close}>Esc</button>
  </form>

  <p class="search__status" data-search-status role="status" aria-live="polite">{t.hint}</p>
  <ul class="search__results" data-search-results aria-label={t.results}></ul>
</dialog>

{/*
  is:inline keeps the dynamic import of the build-generated Pagefind bundle out
  of Vite's resolver. The script reads its strings from data-* so it is
  byte-identical in both locales and costs one CSP hash, not one per locale.
*/}
<script is:inline>
  // Pagefind builds a per-language index keyed off <html lang>, so a pt-BR
  // visitor only ever downloads the pt-BR index. It is fetched on first open —
  // zero bytes on initial page load, and no Worker invocation ever.
  // Classic inline scripts share one global lexical scope; the block keeps
  // these bindings from colliding with any other inline script.
  {
  let pagefind = null
  let loading = null

  const dialog = document.querySelector('[data-search-dialog]')
  const input = document.querySelector('[data-search-input]')
  const list = document.querySelector('[data-search-results]')
  const status = document.querySelector('[data-search-status]')
  if (dialog && input && list && status) {
    const emptyText = dialog.dataset.empty ?? ''
    const hintText = dialog.dataset.hint ?? ''
    const countText = (count) => count === 1
      ? dialog.dataset.countOne ?? String(count)
      : (dialog.dataset.countOther ?? '{n}').replace('{n}', String(count))
    const loadIndex = () => {
      if (pagefind) return Promise.resolve(pagefind)
      if (loading) return loading
      loading = import(/* @vite-ignore */ '/pagefind/pagefind.js')
        .then(async (mod) => {
          await mod.options({ baseUrl: '/' })
          pagefind = mod
          return mod
        })
        .catch((err) => {
          // Search is an enhancement. If the index is missing the rest of the
          // site is unaffected, so fail visibly here and nowhere else.
          console.error('[search] index unavailable:', err)
          status.textContent = emptyText
          loading = null
          return null
        })
      return loading
    }

    const open = () => {
      if (!dialog.open) dialog.showModal()
      void loadIndex()
      input.focus()
    }

    const opener = document.querySelector('[data-search-open]')
    opener?.addEventListener('click', open)

    document.addEventListener('keydown', (ev) => {
      const typing =
        ev.target instanceof HTMLElement &&
        (ev.target.tagName === 'INPUT' ||
          ev.target.tagName === 'TEXTAREA' ||
          ev.target.isContentEditable)
      if ((ev.key === 'k' && (ev.metaKey || ev.ctrlKey)) || (ev.key === '/' && !typing)) {
        ev.preventDefault()
        open()
      }
    })

    let seq = 0
    const run = async (query) => {
      const mine = ++seq
      if (query.trim().length < 2) {
        list.innerHTML = ''
        status.textContent = hintText
        return
      }
      const pf = await loadIndex()
      if (!pf || mine !== seq) return

      let loaded
      try {
        const search = await pf.search(query)
        if (mine !== seq) return // a newer keystroke already won
        loaded = await Promise.all(search.results.slice(0, 12).map((r) => r.data()))
      } catch (err) {
        // A fragment that fails to load must not leave the dialog saying
        // "Type to search" forever; report it like a missing index.
        console.error('[search] query failed:', err)
        if (mine === seq) status.textContent = emptyText
        return
      }
      if (mine !== seq) return
      // With no real match, Pagefind retries shorter prefixes of the query, so
      // "zzqvx" highlights a one-letter formula symbol ("z") in some lesson.
      // Keep a result only if a highlighted word begins like a query term
      // (first three letters, accents folded): "caches" for "caching" stays,
      // "z" for "zzqvx" and "at" for "atenção" go.
      const fold = (text) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '')
      const stems = query.split(/\s+/).map(fold).filter(Boolean).map((term) => term.slice(0, 3))
      const relevant = (excerpt) => stems.length === 0 ||
        [...excerpt.matchAll(/<mark>(.*?)<\/mark>/g)].some(([, word]) => {
          const folded = fold(word)
          return folded !== '' && stems.some((stem) => folded.startsWith(stem))
        })
      const results = loaded.filter((r) => relevant(r.excerpt)).slice(0, 8)

      list.innerHTML = ''
      if (results.length === 0) {
        status.textContent = emptyText
        return
      }
      status.textContent = countText(results.length)
      for (const r of results) {
        const li = document.createElement('li')
        const a = document.createElement('a')
        // The index is first-party build output, but this is the one place a
        // URL rather than text reaches the DOM. Resolve and compare origins
        // rather than testing the string: `//evil.com` and `\\evil.com` both
        // pass a `startsWith('/')` check and both leave this origin.
        let resolved
        try {
          resolved = new URL(r.url, location.href)
        } catch {
          continue
        }
        if (resolved.origin !== location.origin) continue
        a.href = resolved.pathname + resolved.search + resolved.hash
        const title = document.createElement('span')
        title.className = 'search__title'
        title.textContent = r.meta?.title ?? r.url
        const excerpt = document.createElement('span')
        excerpt.className = 'search__excerpt'
        // Pagefind returns highlighted HTML; keep it as text so the index can
        // never inject markup into the page.
        excerpt.textContent = r.excerpt.replace(/<[^>]*>/g, '')
        a.append(title, excerpt)
        li.append(a)
        list.append(li)
      }
    }

    let debounce = 0
    input.addEventListener('input', () => {
      window.clearTimeout(debounce)
      debounce = window.setTimeout(() => void run(input.value), 120)
    })

    // Escape closes in one press even when the native search field has a value.
    // Arrow keys move through results; Enter follows the focused one.
    dialog.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') {
        ev.preventDefault()
        dialog.close()
        opener?.focus()
        return
      }
      if (ev.key !== 'ArrowDown' && ev.key !== 'ArrowUp') return
      const links = [...list.querySelectorAll('a')]
      if (links.length === 0) return
      ev.preventDefault()
      const idx = links.indexOf(document.activeElement)
      const next =
        ev.key === 'ArrowDown'
          ? links[idx < 0 ? 0 : (idx + 1) % links.length]
          : links[idx < 0 ? links.length - 1 : (idx - 1 + links.length) % links.length]
      next?.focus()
    })
  }
  }
</script>

<style>
  .search-open {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    padding: 0.35rem 0.55rem 0.35rem 0.65rem;
    border: 1px solid var(--rule-field);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink-muted);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .search-open:hover { border-color: var(--accent); color: var(--accent); }

  .search-open kbd {
    display: grid;
    place-items: center;
    min-width: 1.35rem;
    height: 1.35rem;
    margin-inline-start: var(--space-2xs);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-xs);
    font-family: var(--font-data);
    font-size: var(--text-3xs);
  }

  /* A native modal <dialog>: Tailwind's preflight zeroes its UA `margin: auto`,
     which pinned it to the left edge, so centring is restated here. */
  .search {
    width: min(46rem, calc(100vw - 2rem));
    max-height: min(40rem, calc(100dvh - 16vh));
    margin: 8vh auto auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-lg);
    opacity: 1;
    translate: 0 0;
    transition:
      opacity var(--dur-base) var(--ease-out),
      translate var(--dur-base) var(--ease-out),
      overlay var(--dur-base) allow-discrete,
      display var(--dur-base) allow-discrete;
  }

  .search:not([open]) { opacity: 0; translate: 0 -0.75rem; }

  @starting-style {
    .search[open] { opacity: 0; translate: 0 -0.75rem; }
  }

  .search::backdrop {
    background: color-mix(in srgb, var(--abyss) 74%, transparent);
    backdrop-filter: blur(5px);
    opacity: 1;
    transition: opacity var(--dur-base) var(--ease-out), overlay var(--dur-base) allow-discrete, display var(--dur-base) allow-discrete;
  }

  .search:not([open])::backdrop { opacity: 0; }

  @starting-style {
    .search[open]::backdrop { opacity: 0; }
  }

  .search[open] { display: flex; flex-direction: column; }

  .search__head {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    padding: var(--space-sm) var(--space-md);
    border-block-end: 2px solid var(--accent);
    color: var(--accent);
  }

  .search__input {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--text-lg);
  }

  .search__input:focus { outline: none; }
  /* The dialog already has one close control; WebKit's clear-× beside it read
     as a second, different one. */
  .search__input::-webkit-search-cancel-button { appearance: none; }

  .search__close {
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--ink-muted);
    font-family: var(--font-data);
    font-size: var(--text-3xs);
    cursor: pointer;
  }

  .search__close:hover { border-color: var(--accent); color: var(--accent); }

  .search__status {
    margin: 0;
    padding: var(--space-xs) var(--space-md);
    font-family: var(--font-data);
    font-size: var(--text-3xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .search__results {
    flex: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Results are built by the script at runtime, so they carry no Astro scope
     attribute: these rules must be :global() or they never match — which is how
     every result once rendered as one run-on paragraph. */
  .search__results :global(a) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3xs);
    padding: var(--space-sm) var(--space-md);
    border-top: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }

  .search__results :global(a:hover),
  .search__results :global(a:focus-visible) {
    color: var(--ink-on-abyss);
    background: var(--abyss-raised);
  }

  .search__results :global(a:focus-visible) { outline-offset: -3px; }

  .search__results :global(.search__title) {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .search__results :global(.search__excerpt) {
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .search__results :global(a:hover .search__excerpt),
  .search__results :global(a:focus-visible .search__excerpt) {
    color: var(--ink-muted-on-abyss);
  }

  @media (max-width: 32rem) {
    .search-open { padding-inline: 0.6rem; }
    .search-open__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .search-open kbd { display: none; }
    .search { margin-block-start: var(--space-sm); max-height: calc(100dvh - 2rem); }
  }
</style>
