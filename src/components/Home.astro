---
import { getCollection } from 'astro:content'
import type { Locale } from '~/lib/i18n'
import type { LessonEntry, TrackEntry } from '~/lib/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const isPt = locale === 'pt-br'
const base = isPt ? '/pt-br' : ''

const allTracks: TrackEntry[] = await getCollection('tracks')
const allLessons: LessonEntry[] = await getCollection('lessons')
const tracks = allTracks.filter((track) => track.data.locale === locale)
const lessons = allLessons.filter((lesson) => lesson.data.locale === locale)
tracks.sort((left, right) => left.data.order - right.data.order)

const countFor = (trackId: string): number =>
  lessons.filter((lesson) => lesson.data.track === trackId).length

// Derived, never hardcoded: "start here" always points at a lesson that exists.
const first = lessons
  .filter((lesson) => lesson.data.track === tracks[0]?.data.id)
  .sort((left, right) => left.data.order - right.data.order)[0]

const t = {
  eyebrow: isPt ? 'Curso livre · Português & English' : 'A free course · English & Português',
  title: isPt ? 'Como os modelos de linguagem realmente funcionam.' : 'How language models actually work.',
  lede: isPt
    ? 'De “o que é um parâmetro?” até transmitir um modelo de 2,8 trilhões de parâmetros direto do disco num notebook com 8 GB. Cada afirmação com fonte, cada laboratório calculando números reais, nada atrás de login.'
    : 'From “what is a parameter?” to streaming a 2.8-trillion-parameter model off a disk on an 8 GB laptop. Every claim cited, every lab computing real numbers, nothing behind a login.',
  start: isPt ? 'Começar do início' : 'Start at the beginning',
  explore: isPt ? 'Explorar a anatomia 3D' : 'Explore the 3D anatomy',
  howTitle: isPt ? 'Como funciona' : 'How it works',
  how: isPt
    ? [
        ['Conceito', 'O mecanismo real, sem enrolação.'],
        ['Analogia', 'A mesma ideia em linguagem simples.'],
        ['Prática', 'Números reais, calculados na hora.'],
        ['Explique de volta', 'Você explica; depois compara com a resposta modelo.'],
        ['Quiz', 'Com o porquê da resposta certa.'],
      ]
    : [
        ['Concept', 'The actual mechanism, no hand-waving.'],
        ['Analogy', 'The same idea in plain language.'],
        ['Lab', 'Real numbers, computed live.'],
        ['Teach-back', 'You explain it, then compare with a model answer.'],
        ['Quiz', 'With the reason the right answer is right.'],
      ],
  gate: isPt
    ? 'Uma aula só conta como concluída quando sua explicação tem substância e o quiz está certo. Clicar em “revelar” não é aprender. Tudo fica no seu navegador.'
    : 'A lesson counts as complete only when your teach-back has substance and the quiz is right. Clicking “reveal” is not learning. Everything stays in your browser.',
  tracksTitle: isPt ? 'Trilhas' : 'Tracks',
  lessonsWord: isPt ? 'aulas' : 'lessons',
  tiers: {
    foundations: isPt ? 'fundamentos' : 'foundations',
    core: isPt ? 'essencial' : 'core',
    advanced: isPt ? 'avançado' : 'advanced',
    frontier: isPt ? 'fronteira' : 'frontier',
  } as Record<string, string>,
  total: isPt ? 'aulas disponíveis agora' : 'lessons available now',
  wip: isPt
    ? 'Mais trilhas em escrita. O que está publicado está completo — não há aulas pela metade.'
    : 'More tracks are being written. What is published is finished — there are no half-written lessons.',
}
---

<section class="hero">
  <p class="eyebrow">{t.eyebrow}</p>
  <h1>{t.title}</h1>
  <p class="lede measure">{t.lede}</p>

  <div class="cta-row">
    {
      first && (
        <a class="cta cta--primary" href={`${base}/lessons/${first.data.track}/${first.data.id}/`}>
          {t.start} <span aria-hidden="true">→</span>
        </a>
      )
    }
    <a class="cta" href={`${base}/explore/`}>{t.explore}</a>
  </div>

  <p class="count">
    <strong>{lessons.length}</strong> {t.total}
  </p>
</section>

<section class="how">
  <h2 class="eyebrow">{t.howTitle}</h2>
  <ol class="how__list">
    {
      t.how.map(([name, desc]) => (
        <li>
          <strong>{name}</strong>
          <span>{desc}</span>
        </li>
      ))
    }
  </ol>
  <p class="aside-hand measure">{t.gate}</p>
</section>

<section class="tracks">
  <h2 class="eyebrow">{t.tracksTitle}</h2>
  <ul class="tracks__list">
    {
      tracks.map((track: TrackEntry) => (
        <li>
          <a href={`${base}/tracks/${track.data.id}/`}>
            <span class="tracks__tier" data-tier={track.data.tier}>
              {t.tiers[track.data.tier] ?? track.data.tier}
            </span>
            <span class="tracks__name">{track.data.title}</span>
            <span class="tracks__summary">{track.data.summary}</span>
            <span class="tracks__count">
              {countFor(track.data.id)} {t.lessonsWord}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="wip">{t.wip}</p>
</section>

<style>
  .hero,
  .how,
  .tracks {
    max-width: var(--shell-max);
    margin-inline: auto;
    padding-inline: var(--space-lg);
  }

  .hero { padding-block: var(--space-3xl) var(--space-lg); }

  h1 {
    font-size: clamp(var(--text-3xl), 7vw, var(--text-5xl));
    margin-block: var(--space-sm) var(--space-md);
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    line-height: var(--leading-relaxed);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-lg);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-md);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-full);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .cta--primary {
    background: var(--accent);
    border-color: transparent;
    color: light-dark(#fffaf3, #17181d);
  }

  .count {
    margin-block-start: var(--space-md);
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    color: var(--ink-faint);
  }

  .count strong { color: var(--ink); font-size: var(--text-sm); }

  .how { padding-block: var(--space-lg); }

  .how__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: var(--space-sm);
    margin-block: var(--space-sm) var(--space-md);
    padding: 0;
    counter-reset: step;
  }

  .how__list li {
    display: grid;
    gap: 2px;
    padding: var(--space-sm);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
  }

  .how__list li::before {
    counter-increment: step;
    content: counter(step);
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    color: var(--ink-faint);
  }

  .how__list strong { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 400; }
  .how__list span { font-size: var(--text-sm); color: var(--ink-muted); }

  .tracks { padding-block: var(--space-lg) var(--space-2xl); }

  .tracks__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-sm);
    margin-block: var(--space-sm) 0;
    padding: 0;
  }

  .tracks__list a {
    display: grid;
    gap: var(--space-3xs);
    height: 100%;
    padding: var(--space-md);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .tracks__list a:hover { border-color: var(--accent); }

  .tracks__tier {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .tracks__tier[data-tier='core'] { color: var(--accent); }
  .tracks__tier[data-tier='advanced'] { color: var(--violet); }
  .tracks__tier[data-tier='frontier'] { color: var(--sage); }

  .tracks__name { font-family: var(--font-display); font-size: var(--text-xl); }
  .tracks__summary { font-size: var(--text-sm); color: var(--ink-muted); }
  .tracks__count {
    margin-block-start: var(--space-2xs);
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    color: var(--ink-faint);
  }

  .wip {
    margin-block-start: var(--space-md);
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }
</style>
