---
import { trackTitleTransitionName } from '~/lib/sky-data'
import { getCollection } from 'astro:content'
import { positionOf, tierLabels, type Locale } from '~/lib/i18n'
import { lessonPath, readingMinutes, trackPath, type LessonEntry, type TrackEntry } from '~/lib/content'
import SkyChart from '~/components/SkyChart.astro'
import ConstellationChart from '~/components/ConstellationChart.astro'

interface Props { locale: Locale }

const { locale } = Astro.props
const isPt = locale === 'pt-br'
const base = isPt ? '/pt-br' : ''
const allTracks: TrackEntry[] = await getCollection('tracks')
const allLessons: LessonEntry[] = await getCollection('lessons')
const tracks = allTracks.filter((track) => track.data.locale === locale).sort((a, b) => a.data.order - b.data.order)
const lessons = allLessons.filter((lesson) => lesson.data.locale === locale)
const lessonsOf = (trackId: string): LessonEntry[] => lessons
  .filter((lesson) => lesson.data.track === trackId)
  .sort((a, b) => a.data.order - b.data.order)
// Derived, never written by hand: a literal drifts the moment a lesson lands.
const lessonCount = lessons.length
const trackCount = tracks.length
const tierNames = tierLabels[locale]
const first = lessonsOf(tracks[0]?.data.id ?? '')[0]

const hours = (minutes: number): string => {
  const h = Math.floor(minutes / 60)
  const m = minutes % 60
  return h === 0 ? `${m} min` : m === 0 ? `${h} h` : `${h} h ${m} min`
}

const t = {
  title: isPt ? 'Como os modelos de linguagem realmente funcionam' : 'How language models actually work',
  lede: isPt
    ? `Dos primeiros princípios à inferência eficiente e aos modelos de mundo, em ${lessonCount} aulas completas em cada idioma. Cada afirmação com fonte, cada laboratório com números reais, nada atrás de login.`
    : `From first principles to efficient inference and world models, in ${lessonCount} complete lessons per language. Every claim cited, every lab grounded in real numbers, nothing behind a login.`,
  facts: isPt ? `${trackCount} trilhas · ${lessonCount} aulas · inglês e português` : `${trackCount} tracks · ${lessonCount} lessons · English and Portuguese`,
  start: isPt ? `Começar pela aula ${positionOf(first?.data.id ?? '0.1')}` : `Start with lesson ${positionOf(first?.data.id ?? '0.1')}`,
  explore: isPt ? 'Abrir a anatomia' : 'Open the anatomy',
  continue: isPt ? 'Continuar de onde parou:' : 'Continue where you left off:',
  systemsReference: isPt ? 'Referência de inferência em CPU com streaming de pesos:' : 'Systems reference for CPU inference with weight streaming:',
  skyLabel: isPt ? 'O currículo como um mapa do céu: uma constelação por trilha' : 'The curriculum as a star chart: one constellation per track',
  skyCaption: isPt
    ? 'Cada estrela é uma aula; cada constelação, uma trilha, ligada na ordem do curso. As estrelas maiores são as aulas em que mais aulas se apoiam.'
    : 'Every star is a lesson; every constellation a track, joined in course order. The larger stars are the lessons most other lessons stand on.',
  loopTitle: isPt ? 'Cada aula fecha um ciclo' : 'Every lesson closes a loop',
  loopLede: isPt
    ? 'Você não só lê. Segue o mecanismo, testa a ideia e prova que consegue explicá-la.'
    : 'You do not just read. You follow the mechanism, test the idea, and prove you can explain it.',
  loop: isPt
    ? [
        ['Conceito', 'O mecanismo real, sem atalhos, com fontes.'],
        ['Analogia', 'A mesma ideia em linguagem simples.'],
        ['Laboratório', 'Números reais, calculados na hora, onde a aula tem um.'],
        ['Explique de volta', 'Você reconstrói a ideia com suas palavras.'],
        ['Teste seu entendimento', 'A resposta certa vem com o porquê.'],
      ]
    : [
        ['Concept', 'The actual mechanism, with no hand-waving, with sources.'],
        ['Analogy', 'The same idea in plain language.'],
        ['Lab', 'Real numbers, computed live, where a lesson has one.'],
        ['Teach it back', 'You rebuild the idea in your own words.'],
        ['Check your understanding', 'The right answer comes with the reason.'],
      ],
  gate: isPt
    ? 'A estrela da aula se preenche quando sua explicação tem substância e o quiz está certo. Seu texto fica neste navegador.'
    : 'A lesson’s star fills when your explanation has substance and the quiz is right. Your writing stays in this browser.',
  catalogTitle: isPt ? 'O catálogo completo' : 'The complete catalog',
  catalogLede: isPt
    ? `${trackCount} trilhas em uma sequência contínua: dos fundamentos ao silício e aos modelos que aprendem com vídeo.`
    : `${trackCount} tracks in one continuous sequence, from foundations to silicon and to models that learn from video.`,
  lessons: isPt ? 'aulas' : 'lessons',
  progress: isPt ? '{n} de {m} concluídas' : '{n} of {m} complete',
  closeTitle: isPt ? 'Comece pela superfície' : 'Start at the surface',
  closeBody: isPt
    ? 'A primeira aula explica o que um modelo de linguagem é e o que ele não é. Daí em diante, cada aula se apoia nas anteriores.'
    : 'The first lesson explains what a language model is and what it is not. From there, every lesson stands on the ones before it.',
}
---

<section class="hero">
  <div class="hero__copy">
    <h1>{t.title}</h1>
    <p class="hero__lede">{t.lede}</p>
    <div class="hero__actions">
      {first && <a class="button button--primary" href={lessonPath(locale, first)}>{t.start}<span aria-hidden="true">→</span></a>}
      <a class="button" href={`${base}/explore/`}>{t.explore}<span aria-hidden="true">→</span></a>
    </div>
    {/* Filled on this device only; every visitor receives it hidden. */}
    <p class="hero__continue" data-continue hidden>
      {t.continue} <a data-continue-link href={first ? lessonPath(locale, first) : `${base}/tracks/`}><b data-continue-position data-numeric></b> <span data-continue-title></span></a>
    </p>
    <p class="hero__facts">{t.facts}</p>
    <p class="hero__reference">{t.systemsReference} <a href="https://github.com/FareedKhan-dev/kimi-k3-in-c">Kimi K3 in C</a>.</p>
  </div>
  <div class="hero__sky">
    <SkyChart locale={locale} label={t.skyLabel} variant="hero" />
    <p class="hero__caption">{t.skyCaption}</p>
  </div>
</section>

<section class="loop" aria-labelledby="loop-heading">
  <header class="loop__header">
    <h2 id="loop-heading">{t.loopTitle}</h2>
    <p>{t.loopLede}</p>
  </header>
  <ol class="loop__steps">
    {t.loop.map(([name, description], index) => (
      <li style={`--step: ${index}`}>
        <span class="loop__node" aria-hidden="true"></span>
        <strong>{name}</strong>
        <p>{description}</p>
      </li>
    ))}
  </ol>
  <p class="loop__gate"><span class="star-mark" data-complete="true" aria-hidden="true"></span>{t.gate}</p>
</section>

<section class="catalog" aria-labelledby="catalog-heading">
  <header class="catalog__header">
    <h2 id="catalog-heading">{t.catalogTitle}</h2>
    <p>{t.catalogLede}</p>
  </header>
  <ol class="catalog__list">
    {tracks.map((track) => {
      const trackLessons = lessonsOf(track.data.id)
      const minutes = trackLessons.reduce((sum, lesson) => sum + readingMinutes(lesson), 0)
      return (
        <li class="catalog__row arrive" data-tier={track.data.tier}>
          <div class="catalog__figure">
            <ConstellationChart locale={locale} trackId={track.data.id} lessons={trackLessons} variant="mini" />
          </div>
          <div class="catalog__text">
            <h3>
              <a href={trackPath(locale, track.data.id)} style={`view-transition-name: ${trackTitleTransitionName(track.data.id)}`}>
                <b data-numeric>{positionOf(track.data.id)}</b> <span class="plate-name">{track.data.title}</span>
              </a>
            </h3>
            <p>{track.data.summary}</p>
          </div>
          <dl class="catalog__facts">
            <div><dt class="visually-hidden">{isPt ? 'Nível' : 'Tier'}</dt><dd class="catalog__tier">{tierNames[track.data.tier]}</dd></div>
            <div><dt class="visually-hidden">{isPt ? 'Aulas' : 'Lessons'}</dt><dd>{trackLessons.length} {t.lessons}</dd></div>
            <div><dt class="visually-hidden">{isPt ? 'Leitura' : 'Reading'}</dt><dd data-numeric>≈ {hours(minutes)}</dd></div>
          </dl>
          <p class="catalog__progress" data-course-progress data-lesson-ids={trackLessons.map((lesson) => lesson.data.id).join(' ')} data-template={t.progress} hidden>
            <span data-count></span>
          </p>
        </li>
      )
    })}
  </ol>
</section>

<section class="close">
  <div class="close__plate">
    <h2>{t.closeTitle}</h2>
    <p>{t.closeBody}</p>
    {first && <a class="button button--inverse" href={lessonPath(locale, first)}><span><b data-numeric>{positionOf(first.data.id)}</b> {first.data.title}</span><span aria-hidden="true">→</span></a>}
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(var(--space-lg), 3.5vw, var(--space-2xl));
    align-items: center;
    max-width: var(--shell-max);
    margin-inline: auto;
    padding: clamp(var(--space-xl), 7vh, var(--space-3xl)) clamp(var(--space-sm), 3vw, var(--space-lg));
  }
  .hero h1 {
    max-width: 13ch;
    font-size: clamp(2.75rem, min(4.8vw, 8.6vh), 5rem);
    font-weight: var(--weight-black);
    font-stretch: 92%;
    line-height: 0.94;
    letter-spacing: -0.035em;
    hyphens: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The headline unfolds: the width axis opens from condensed to its set
       width while the type settles. The signature of the display face. */
    .hero h1 { animation: unfold 1.1s var(--ease-out) both; }
    .hero__lede, .hero__actions, .hero__facts, .hero__reference { animation: settle var(--dur-slow) var(--ease-out) both; }
    .hero__lede { animation-delay: 0.25s; }
    .hero__actions { animation-delay: 0.35s; }
    .hero__facts, .hero__reference { animation-delay: 0.45s; }
  }
  @keyframes unfold { from { opacity: 0; font-stretch: 75%; letter-spacing: 0.02em; } to { opacity: 1; font-stretch: 92%; letter-spacing: -0.035em; } }
  @keyframes settle { from { opacity: 0; translate: 0 0.75rem; } }
  .hero__lede { max-width: 34rem; margin: var(--space-md) 0 0; color: var(--ink-muted); font-size: clamp(var(--text-base), 0.9rem + 0.4vw, var(--text-lg)); line-height: 1.55; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-top: var(--space-lg); }
  .hero__continue { max-width: 34rem; margin: var(--space-md) 0 0; padding: var(--space-xs) var(--space-sm); border: 1px solid var(--rule); border-radius: var(--radius-sm); color: var(--ink-muted); font-size: var(--text-sm); }
  .hero__continue a { color: var(--ink); font-weight: var(--weight-semibold); }
  .hero__continue b { color: var(--reticle); font-family: var(--font-data); }
  .hero__facts { margin: var(--space-lg) 0 0; color: var(--ink); font: var(--weight-semibold) var(--text-sm) var(--font-display); font-stretch: var(--stretch-wide); }
  .hero__reference { max-width: 34rem; margin: var(--space-2xs) 0 0; color: var(--ink-faint); font-size: var(--text-xs); }
  .hero__reference a { color: var(--ink-muted); }
  .hero__sky { min-width: 0; }
  .hero__caption { max-width: 40rem; margin: var(--space-md) 0 0; color: var(--ink-faint); font-size: var(--text-xs); }

  .loop { max-width: var(--shell-max); margin-inline: auto; padding: var(--space-3xl) clamp(var(--space-sm), 3vw, var(--space-lg)); border-top: 1px solid var(--rule); }
  .loop__header, .catalog__header { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-sm) var(--space-xl); align-items: end; }
  .loop h2, .catalog h2, .close h2 { font-size: clamp(var(--text-2xl), 1.2rem + 3vw, var(--text-4xl)); font-stretch: var(--stretch-wide); }
  .loop__header > p, .catalog__header > p { max-width: 40rem; margin: 0; color: var(--ink-muted); font-size: var(--text-lg); }
  .loop__steps { position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-md); margin: var(--space-2xl) 0 0; padding: 0; list-style: none; }
  /* The loop's line, and a signal that travels it as the section is read. */
  .loop__steps::before { content: ''; position: absolute; top: 0.55rem; left: 0.55rem; right: 0; height: 1px; background: var(--rule-strong); }
  .loop__steps::after { content: ''; position: absolute; top: 0.55rem; left: 0.55rem; right: 0; height: 2px; translate: 0 -0.5px; background: var(--reticle); transform-origin: 0 50%; scale: 0 1; }
  .loop__steps li { position: relative; display: grid; align-content: start; gap: var(--space-2xs); padding-top: var(--space-xl); }
  .loop__node { position: absolute; top: 0; left: 0; z-index: 1; width: 1.1rem; aspect-ratio: 1; border: 1.5px solid var(--ink); border-radius: 50%; background: var(--plate); }
  .loop__steps strong { font: var(--weight-bold) var(--text-xl) / 1.1 var(--font-display); }
  .loop__steps p { margin: 0; color: var(--ink-muted); font-size: var(--text-sm); }
  .loop__gate { display: flex; gap: var(--space-sm); align-items: center; max-width: 46rem; margin: var(--space-2xl) 0 0; color: var(--ink-muted); }
  .loop__gate .star-mark { --mark: var(--success); }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .loop { view-timeline: --loop block; }
      .loop__steps::after { animation-name: loop-line; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: --loop; animation-range: contain 0% contain 70%; }
      .loop__node { animation-name: loop-node; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: --loop; animation-range: contain calc(var(--step) * 14%) contain calc(var(--step) * 14% + 4%); }
    }
  }
  @keyframes loop-line { to { scale: 1 1; } }
  @keyframes loop-node { to { border-color: var(--reticle); background: var(--reticle); scale: 1.2; } }

  .catalog { max-width: var(--shell-max); margin-inline: auto; padding: var(--space-3xl) clamp(var(--space-sm), 3vw, var(--space-lg)); border-top: 1px solid var(--rule); }
  .catalog__list { margin: var(--space-2xl) 0 0; padding: 0; list-style: none; border-top: 1px solid var(--rule-strong); }
  .catalog__row {
    position: relative;
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr) 11rem;
    grid-template-areas: 'figure text facts' 'figure text progress';
    gap: var(--space-2xs) var(--space-xl);
    align-items: center;
    padding: var(--space-lg) var(--space-sm);
    border-bottom: 1px solid var(--rule);
    transition: background-color var(--dur-base) var(--ease-out);
  }
  .catalog__row:hover { background: var(--plate-raised); }
  .catalog__figure { grid-area: figure; }
  .catalog__text { grid-area: text; }
  .catalog__text h3 { font-size: clamp(var(--text-base), 0.9rem + 0.5vw, var(--text-lg)); line-height: 1.3; }
  .catalog__text h3 a { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-xs); min-width: 0; color: var(--ink); text-decoration: none; }
  .catalog__text h3 .plate-name { min-width: 0; overflow-wrap: break-word; }
  /* The whole row is the target. */
  .catalog__text h3 a::after { content: ''; position: absolute; inset: 0; }
  .catalog__text h3 b { color: var(--tier); font: var(--weight-bold) var(--text-2xl) / 1 var(--font-display); font-stretch: var(--stretch-wide); }
  .catalog__row:hover .plate-name { color: var(--tier); }
  .catalog__text p { max-width: 62ch; margin: var(--space-2xs) 0 0; color: var(--ink-muted); font-size: var(--text-sm); }
  .catalog__facts { grid-area: facts; display: grid; gap: 0.15rem; margin: 0; color: var(--ink-muted); font-size: var(--text-xs); text-align: end; }
  .catalog__facts dd { margin: 0; }
  .catalog__tier { color: var(--tier); font-weight: var(--weight-semibold); }
  .catalog__progress { grid-area: progress; margin: 0; color: var(--success); font: var(--weight-semibold) var(--text-xs) var(--font-ui); text-align: end; }

  .close { padding: var(--space-3xl) clamp(var(--space-sm), 3vw, var(--space-lg)); }
  .close__plate {
    color-scheme: dark;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: var(--space-lg) var(--space-xl);
    align-items: center;
    max-width: var(--shell-max);
    margin-inline: auto;
    padding: clamp(var(--space-xl), 5vw, var(--space-3xl));
    border-radius: var(--radius-xs);
    color: var(--ink-on-night);
    background: var(--night);
    /* The plate's neatline, inset like a printed chart's frame. */
    outline: 1px solid rgb(214 224 255 / 0.28);
    outline-offset: -0.75rem;
  }
  .close__plate p { margin: 0; color: var(--ink-muted-on-night); font-size: var(--text-lg); }
  .button--inverse { --button-ink: var(--night); border-color: var(--ink-on-night); background: var(--ink-on-night); }
  .button--inverse:hover { --button-ink: var(--night); background: #ffffff; }
  .button--inverse b { font-family: var(--font-data); }

  @media (max-width: 70rem) {
    .hero { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .hero h1 { max-width: 14ch; }
    .loop__steps { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: var(--space-xl); }
    .close__plate { grid-template-columns: minmax(0, 1fr); }
    .close__plate .button { justify-self: start; }
  }

  @media (max-width: 50rem) {
    .loop__header, .catalog__header { grid-template-columns: minmax(0, 1fr); }
    .hero__caption { padding-right: 0; padding-top: var(--space-xs); }
    /* Mobile: the loop runs down the page. */
    .loop__steps { grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
    .loop__steps::before, .loop__steps::after { top: 0.55rem; bottom: 0; left: 0.55rem; right: auto; width: 1px; height: auto; transform-origin: 50% 0; }
    .loop__steps::after { width: 2px; translate: -0.5px 0; scale: 1 0; }
    .loop__steps li { padding: 0 0 0 var(--space-xl); }
    .catalog__row { grid-template-columns: 5.5rem minmax(0, 1fr); grid-template-areas: 'figure text' 'figure facts' '. progress'; gap: var(--space-2xs) var(--space-md); padding-inline: 0; }
    .catalog__facts { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-sm); text-align: start; }
    .catalog__progress { text-align: start; }
  }

  @media (max-width: 30rem) {
    .hero__actions { display: grid; }
  }
</style>
