---
import { trackTitleTransitionName } from '~/lib/sky-data'
import { getCollection } from 'astro:content'
import { partLabels, positionOf, tierLabels, type Locale } from '~/lib/i18n'
import { lessonPath, readingMinutes, trackPath, type LessonEntry, type TrackEntry } from '~/lib/content'
import SkyChart from '~/components/SkyChart.astro'
import ConstellationChart from '~/components/ConstellationChart.astro'

interface Props { locale: Locale }

const { locale } = Astro.props
const isPt = locale === 'pt-br'
const base = isPt ? '/pt-br' : ''
const allTracks: TrackEntry[] = await getCollection('tracks')
const allLessons: LessonEntry[] = await getCollection('lessons')
const tracks = allTracks.filter((track) => track.data.locale === locale).sort((a, b) => a.data.order - b.data.order)
const lessons = allLessons.filter((lesson) => lesson.data.locale === locale)
const lessonsOf = (trackId: string): LessonEntry[] => lessons
  .filter((lesson) => lesson.data.track === trackId)
  .sort((a, b) => a.data.order - b.data.order)
// Derived, never written by hand: a literal drifts the moment a lesson lands.
const lessonCount = lessons.length
const trackCount = tracks.length
const tierNames = tierLabels[locale]
const parts = [...new Set(tracks.map((track) => track.data.part))]
const first = lessonsOf(tracks[0]?.data.id ?? '')[0]

const hours = (minutes: number): string => {
  const h = Math.floor(minutes / 60)
  const m = minutes % 60
  return h === 0 ? `${m} min` : m === 0 ? `${h} h` : `${h} h ${m} min`
}

const t = {
  title: isPt ? 'Como os modelos de linguagem realmente funcionam' : 'How language models actually work',
  lede: isPt
    ? `Dos primeiros princípios à inferência eficiente, aos modelos de mundo e aos sistemas de agentes construídos sobre eles, em ${lessonCount} aulas completas em cada idioma. Cada afirmação com fonte, cada laboratório com números reais, nada atrás de login.`
    : `From first principles to efficient inference, world models and the agent systems built on them, in ${lessonCount} complete lessons per language. Every claim cited, every lab grounded in real numbers, nothing behind a login.`,
  facts: isPt ? `${trackCount} trilhas · ${lessonCount} aulas · inglês e português` : `${trackCount} tracks · ${lessonCount} lessons · English and Portuguese`,
  start: isPt ? `Começar pela aula ${positionOf(first?.data.id ?? '0.1')}` : `Start with lesson ${positionOf(first?.data.id ?? '0.1')}`,
  explore: isPt ? 'Abrir a anatomia' : 'Open the anatomy',
  continue: isPt ? 'Continuar de onde parou:' : 'Continue where you left off:',
  systemsReference: isPt ? 'Referências de sistemas:' : 'Systems references:',
  systemsCpu: isPt ? '(streaming de pesos em CPU)' : '(CPU weight streaming)',
  systemsGpu: isPt ? '(motor Metal e CUDA 13)' : '(Metal & CUDA 13 engine)',
  skyLabel: isPt ? 'O currículo como um mapa do céu: uma constelação por trilha' : 'The curriculum as a star chart: one constellation per track',
  skyCaption: isPt
    ? 'Cada estrela é uma aula; cada constelação, uma trilha, ligada na ordem do curso. As estrelas maiores são as aulas em que mais aulas se apoiam.'
    : 'Every star is a lesson; every constellation a track, joined in course order. The larger stars are the lessons most other lessons stand on.',
  mechanicsTitle: isPt ? 'Três mecanismos que decidem a inferência real' : 'Three mechanisms that decide real inference',
  mechanicsLede: isPt
    ? 'Um servidor rápido não é um único truque. Ele amortiza leituras de pesos com speculative decoding, reaproveita o estado de prefixo entre turnos e mantém os pesos locais quando duas máquinas trabalham juntas.'
    : 'A fast server is not one trick. It amortizes weight reads with speculative decoding, reuses prefix state across turns, and keeps weights local when two machines work together.',
  mechanicsTabsLabel: isPt ? 'Mecanismos de inferência' : 'Inference mechanisms',
  mechanicsStages: isPt
    ? [
        {
          id: 'decode',
          num: '01',
          tab: 'Speculative decode paralelo',
          title: 'Propor em árvore, verificar numa leitura de pesos e efetivar sem perda',
          body: 'Em batch 1, o decode do Qwen3.8-27B é limitado pela leitura dos pesos na memória, não pela aritmética. Um drafter externo de difusão em blocos (z-lab/Qwen3.8-27B-DFlash2) propõe uma árvore curta de tokens futuros a baixo custo; o modelo alvo de 27B verifica todos os candidatos numa única passagem paralela e efetiva apenas os tokens idênticos ao decode sem especulação (--no-drafts). No Metal, até 128 streams concorrentes rascunham e verificam em rodadas de pista compartilhada.',
          nodes: [
            ['Drafter DFlash2 (4-bit)', 'Propõe uma árvore curta de candidatos para cada stream ativo.'],
            ['Verificação 27B em passagem única', 'Lê os pesos do modelo alvo uma vez para pontuar toda a árvore.'],
            ['Distribuição exata (--no-drafts)', 'Aceita o prefixo válido e amostra um token corrigido na primeira rejeição.'],
          ],
          metric: '162–226 tok/s',
          receipt: 'Decode greedy em stream único no Apple M5 Ultra (TensorFold/Qwen3.8-27B-MLX-4bit + z-lab/Qwen3.8-27B-DFlash2, contra 51,6 tok/s sem drafter), e 201,4 tok/s agregados em 8 streams concorrentes.',
          lessonHref: `${base}/lessons/7-inference-and-efficiency/7.5-beam-search-speculative-decoding-and-medusa/`,
          lessonLabel: 'Ler a aula 7.5 sobre speculative decoding →',
        },
        {
          id: 'reuse',
          num: '02',
          tab: 'Prefixo retido e compactação',
          title: 'Guardar o estado já calculado e compactar antes do teto da janela',
          body: 'Agentes em múltiplos turnos reenviam o system prompt, as definições de ferramentas e a conversa inteira a cada chamada. O cache de prefixo retém o KV cache e o estado recorrente híbrido dos turnos anteriores (exposto como cached_tokens) para que o novo turno processe apenas o sufixo inédito. Quando o histórico cresce, --compact-at resume turnos antigos numa nota estruturada e preserva turnos recentes e pares de ferramentas intactos.',
          nodes: [
            ['Prefixo retido (KV + estado recorrente)', 'System prompt, ferramentas e turnos anteriores permanecem prontos na memória.'],
            ['Sufixo do novo turno', 'O prefill calcula apenas as novas mensagens adicionadas pelo agente.'],
            ['Compactação determinística (--compact-at)', 'Resume turnos antigos sem quebrar pares tool_call e tool_result.'],
          ],
          metric: '0,28 s vs 1,29 s',
          receipt: 'Retomada com prefixo em cache contra prefill a frio no Apple M5 Ultra (TTFT 4,4× mais rápido), e 0,25–0,37 s de TTFT com 24,4–29,8 tok/s de decode entre 8k e 32k de contexto no M5 Pro de 64 GB.',
          lessonHref: `${base}/lessons/11-mac-studio-ultra-and-mlx/11.4-serving-from-a-mac-mlx-lm-server-and-mlx-serve/`,
          lessonLabel: 'Ler a aula 11.4 sobre servidores e cache de prompt →',
        },
        {
          id: 'cluster',
          num: '03',
          tab: 'Dois nós e controle de tráfego',
          title: 'Manter os pesos em casa no Thunderbolt 5 e conter loops de raciocínio',
          body: 'Um cabo Thunderbolt 5 move de 10 a 15 GB/s contra 1,2 TB/s da memória local do M5 Ultra — uma diferença de 80 a 120 vezes. Por isso os pesos ficam fixos em cada Mac e apenas ativações pequenas cruzam o cabo via RDMA/MCDMA. Em produção, guardas de admissão e de loop (--max-inflight, --thinking-budget, --loop-guard) cortam repetições de raciocínio antes que prendam as fatias de decode.',
          nodes: [
            ['Nó 0 (M5 Ultra · 1,2 TB/s local)', 'Mantém seu shard de pesos em memória unificada local.'],
            ['Link Thunderbolt 5 / MCDMA (10–15 GB/s)', 'Transporta apenas ativações entre camadas sem copiar pesos.'],
            ['Nó 1 + guardas (--loop-guard)', 'Streams concorrentes verificados stream por stream contra a execução solo.'],
          ],
          metric: '200–247 tok/s',
          receipt: 'Decode de código em stream único (179–186 tok/s em chat) no Qwen3.8-Flash-Next-MLX-6bit em dois Macs M5 Ultra de 256 GB via Thunderbolt 5 + MCDMA (--speed-up), ou 53,7 tok/s no kindlingai/glm-5.3-exlr8-k2-k3-k4.',
          lessonHref: `${base}/lessons/11-mac-studio-ultra-and-mlx/11.5-clustering-macs-mlx-distributed/`,
          lessonLabel: 'Ler a aula 11.5 sobre clusters Thunderbolt 5 →',
        },
      ]
    : [
        {
          id: 'decode',
          num: '01',
          tab: 'Parallel speculative decode',
          title: 'Propose a tree, verify in one weight read, and commit losslessly',
          body: 'At batch 1, Qwen3.8-27B decode is bound by reading weights from memory, not arithmetic. An external block-diffusion drafter (z-lab/Qwen3.8-27B-DFlash2) proposes a short tree of future tokens cheaply; the 27B target model verifies every candidate in a single parallel pass and commits only tokens identical to non-speculative decode (--no-drafts). On Metal, up to 128 concurrent streams draft and verify in shared lane rounds.',
          nodes: [
            ['DFlash2 drafter (4-bit)', 'Proposes a short candidate token tree for every active stream.'],
            ['Single-pass 27B target verify', 'Streams the target weights once to score the entire candidate tree.'],
            ['Exact distribution (--no-drafts)', 'Commits the accepted prefix and samples a corrected token on rejection.'],
          ],
          metric: '162–226 tok/s',
          receipt: 'Single-stream greedy decode on Apple M5 Ultra (TensorFold/Qwen3.8-27B-MLX-4bit + z-lab/Qwen3.8-27B-DFlash2, up from 51.6 tok/s without a drafter), and 201.4 tok/s aggregate across 8 concurrent streams.',
          lessonHref: `${base}/lessons/7-inference-and-efficiency/7.5-beam-search-speculative-decoding-and-medusa/`,
          lessonLabel: 'Read lesson 7.5 on speculative decoding →',
        },
        {
          id: 'reuse',
          num: '02',
          tab: 'Retained prefix & compaction',
          title: 'Keep the state already computed and compact before the window ceiling',
          body: 'Multi-turn agents resend the system prompt, tool definitions, and prior conversation on every step. A prefix cache retains the KV cache and hybrid recurrent state from earlier turns (reported as cached_tokens) so the next turn processes only the new suffix. When history grows, --compact-at summarizes older turns into a structured memory note while keeping recent turns and tool pairs verbatim.',
          nodes: [
            ['Retained prefix (KV + recurrent state)', 'System prompt, tool schemas, and prior turns stay hot in memory.'],
            ['New turn suffix only', 'Prefill evaluates only the newly appended user or tool messages.'],
            ['Deterministic compaction (--compact-at)', 'Summarizes older turns without splitting tool_call and tool_result pairs.'],
          ],
          metric: '0.28 s vs 1.29 s',
          receipt: 'Warm cached-prefix resume vs cold prefill on Apple M5 Ultra (4.4× faster TTFT), and 0.25–0.37 s warm TTFT with 24.4–29.8 tok/s decode across 8k–32k context on 64 GB M5 Pro.',
          lessonHref: `${base}/lessons/11-mac-studio-ultra-and-mlx/11.4-serving-from-a-mac-mlx-lm-server-and-mlx-serve/`,
          lessonLabel: 'Read lesson 11.4 on Mac servers and prompt caching →',
        },
        {
          id: 'cluster',
          num: '03',
          tab: 'Paired nodes & traffic guards',
          title: 'Keep weights local across Thunderbolt 5 and bound runaway reasoning',
          body: 'A Thunderbolt 5 cable moves 10 to 15 GB/s against 1.2 TB/s of M5 Ultra local memory — an 80 to 120× gap. Weights therefore stay pinned on each Mac while only small activations cross the link over RDMA/MCDMA. In production serving, admission and loop guards (--max-inflight, --thinking-budget, --loop-guard) halt verbatim reasoning loops before they saturate decode lanes.',
          nodes: [
            ['Node 0 (M5 Ultra · 1.2 TB/s local)', 'Holds its weight shard in local unified memory.'],
            ['Thunderbolt 5 / MCDMA link (10–15 GB/s)', 'Carries only inter-layer activations without moving weights.'],
            ['Node 1 + guards (--loop-guard)', 'Concurrent streams verified stream-for-stream against solo runs.'],
          ],
          metric: '200–247 tok/s',
          receipt: 'Single-stream code decode (179–186 tok/s chat) on Qwen3.8-Flash-Next-MLX-6bit across two 256 GB M5 Ultra Macs over Thunderbolt 5 + MCDMA (--speed-up), or 53.7 tok/s on kindlingai/glm-5.3-exlr8-k2-k3-k4.',
          lessonHref: `${base}/lessons/11-mac-studio-ultra-and-mlx/11.5-clustering-macs-mlx-distributed/`,
          lessonLabel: 'Read lesson 11.5 on Thunderbolt 5 clustering →',
        },
      ],
  loopTitle: isPt ? 'Cada aula fecha um ciclo' : 'Every lesson closes a loop',
  loopLede: isPt
    ? 'Você não só lê. Segue o mecanismo, testa a ideia e prova que consegue explicá-la.'
    : 'You do not just read. You follow the mechanism, test the idea, and prove you can explain it.',
  loop: isPt
    ? [
        ['Conceito', 'O mecanismo real, sem atalhos, com fontes.'],
        ['Analogia', 'A mesma ideia em linguagem simples.'],
        ['Laboratório', 'Números reais, calculados na hora, onde a aula tem um.'],
        ['Explique de volta', 'Você reconstrói a ideia com suas palavras.'],
        ['Teste seu entendimento', 'A resposta certa vem com o porquê.'],
      ]
    : [
        ['Concept', 'The actual mechanism, with no hand-waving, with sources.'],
        ['Analogy', 'The same idea in plain language.'],
        ['Lab', 'Real numbers, computed live, where a lesson has one.'],
        ['Teach it back', 'You rebuild the idea in your own words.'],
        ['Check your understanding', 'The right answer comes with the reason.'],
      ],
  gate: isPt
    ? 'A estrela da aula se preenche quando sua explicação tem substância e o quiz está certo. Seu texto fica neste navegador.'
    : 'A lesson’s star fills when your explanation has substance and the quiz is right. Your writing stays in this browser.',
  catalogTitle: isPt ? 'O catálogo completo' : 'The complete catalog',
  catalogLede: isPt
    ? `${trackCount} trilhas em duas partes: como um modelo funciona, dos fundamentos ao silício, e depois como construir sistemas que agem sobre a saída dele.`
    : `${trackCount} tracks in two parts: how a model works, from foundations to silicon, then how to build systems that act on its output.`,
  lessons: isPt ? 'aulas' : 'lessons',
  progress: isPt ? '{n} de {m} concluídas' : '{n} of {m} complete',
  closeTitle: isPt ? 'Comece pela superfície' : 'Start at the surface',
  closeBody: isPt
    ? 'A primeira aula explica o que um modelo de linguagem é e o que ele não é. Daí em diante, cada aula se apoia nas anteriores.'
    : 'The first lesson explains what a language model is and what it is not. From there, every lesson stands on the ones before it.',
}
---

<section class="hero">
  <div class="hero__copy">
    <h1>{t.title}</h1>
    <p class="hero__lede">{t.lede}</p>
    <div class="hero__actions">
      {first && <a class="button button--primary" href={lessonPath(locale, first)}>{t.start}<span aria-hidden="true">→</span></a>}
      <a class="button" href={`${base}/explore/`}>{t.explore}<span aria-hidden="true">→</span></a>
    </div>
    {/* Filled on this device only; every visitor receives it hidden. */}
    <p class="hero__continue" data-continue hidden>
      {t.continue} <a data-continue-link href={first ? lessonPath(locale, first) : `${base}/tracks/`}><b data-continue-position data-numeric></b> <span data-continue-title></span></a>
    </p>
    <p class="hero__facts">{t.facts}</p>
    <p class="hero__reference">
      {t.systemsReference}
      <a href="https://github.com/FareedKhan-dev/kimi-k3-in-c">Kimi K3 in C</a> {t.systemsCpu} ·
      <a href="https://github.com/ashhart/TensorFold/tree/v1.2.1">TensorFold</a> {t.systemsGpu}.
    </p>
  </div>
  <div class="hero__sky">
    <SkyChart locale={locale} label={t.skyLabel} variant="hero" />
    <p class="hero__caption">{t.skyCaption}</p>
  </div>
</section>

<section class="mechanics" aria-labelledby="mechanics-heading">
  <header class="mechanics__header">
    <h2 id="mechanics-heading">{t.mechanicsTitle}</h2>
    <p>{t.mechanicsLede}</p>
  </header>
  <div class="mechanics__frame" role="group" aria-label={t.mechanicsTabsLabel}>
    {t.mechanicsStages.map((stage, index) => (
      <input
        class="mechanics__radio visually-hidden"
        type="radio"
        name="mechanics-stage"
        id={`mechanics-${stage.id}`}
        checked={index === 0}
      />
    ))}
    <div class="mechanics__tabs" data-pagefind-ignore>
      {t.mechanicsStages.map((stage) => (
        <label class="mechanics__tab" id={`mechanics-${stage.id}-label`} for={`mechanics-${stage.id}`}>
          <span class="mechanics__tab-n" aria-hidden="true" data-numeric>{stage.num}</span>
          <span>{stage.tab}</span>
        </label>
      ))}
    </div>
    <div class="mechanics__panels" aria-live="polite">
      {t.mechanicsStages.map((stage, index) => (
        <article class="mechanics__panel" aria-labelledby={`mechanics-${stage.id}-label`}>
          <div class="mechanics__copy">
            <h3>{stage.title}</h3>
            <p>{stage.body}</p>
            <div class="mechanics__receipt">
              <strong class="mechanics__metric" data-numeric>{stage.metric}</strong>
              <p>{stage.receipt}</p>
            </div>
            <p class="mechanics__cta">
              <a href={stage.lessonHref}>{stage.lessonLabel}</a>
            </p>
          </div>
          <div class="mechanics__plate">
            <svg class="mechanics__svg" viewBox="0 0 480 210" aria-hidden="true" focusable="false">
              <rect class="mechanics__box" x="18" y="34" width="118" height="142" rx="4" />
              <rect class="mechanics__box mechanics__box--core" x="181" y="22" width="118" height="166" rx="4" />
              <rect class="mechanics__box" x="344" y="34" width="118" height="142" rx="4" />
              {index === 0 && (
                <g>
                  <path class="mechanics__wire" d="M 136 72 C 158 72, 160 66, 181 66" />
                  <path class="mechanics__wire" d="M 136 105 L 181 105" />
                  <path class="mechanics__wire mechanics__wire--muted" d="M 136 138 C 158 138, 160 144, 181 144" />
                  <path class="mechanics__wire mechanics__wire--active" d="M 299 86 L 344 86" />
                  <path class="mechanics__wire mechanics__wire--active" d="M 299 124 L 344 124" />
                  <circle class="mechanics__node" cx="77" cy="72" r="5" />
                  <circle class="mechanics__node" cx="77" cy="105" r="5" />
                  <circle class="mechanics__node mechanics__node--muted" cx="77" cy="138" r="4" />
                  <circle class="mechanics__node mechanics__node--core" cx="240" cy="86" r="6" />
                  <circle class="mechanics__node mechanics__node--core" cx="240" cy="124" r="6" />
                  <circle class="mechanics__node mechanics__node--commit" cx="403" cy="86" r="6" />
                  <circle class="mechanics__node mechanics__node--commit" cx="403" cy="124" r="6" />
                  <circle class="mechanics__pulse" cx="0" cy="0" r="3.5">
                    <animateMotion dur="3.6s" repeatCount="indefinite" path="M 77 72 L 240 86 L 403 86" />
                  </circle>
                  <circle class="mechanics__pulse" cx="0" cy="0" r="3.5">
                    <animateMotion dur="3.6s" begin="1.2s" repeatCount="indefinite" path="M 77 105 L 240 124 L 403 124" />
                  </circle>
                </g>
              )}
              {index === 1 && (
                <g>
                  <rect class="mechanics__cache-bar" x="34" y="58" width="86" height="18" rx="2" />
                  <rect class="mechanics__cache-bar" x="34" y="84" width="86" height="18" rx="2" />
                  <rect class="mechanics__cache-bar" x="34" y="110" width="86" height="18" rx="2" />
                  <path class="mechanics__wire mechanics__wire--active" d="M 120 93 L 181 93" />
                  <path class="mechanics__wire mechanics__wire--active" d="M 299 105 L 344 105" />
                  <circle class="mechanics__node mechanics__node--core" cx="240" cy="105" r="7" />
                  <circle class="mechanics__node mechanics__node--commit" cx="403" cy="105" r="7" />
                  <circle class="mechanics__pulse" cx="0" cy="0" r="4">
                    <animateMotion dur="3s" repeatCount="indefinite" path="M 120 93 L 240 105 L 403 105" />
                  </circle>
                </g>
              )}
              {index === 2 && (
                <g>
                  <rect class="mechanics__cache-bar" x="34" y="64" width="86" height="34" rx="2" />
                  <rect class="mechanics__cache-bar" x="34" y="112" width="86" height="34" rx="2" />
                  <rect class="mechanics__cache-bar" x="360" y="64" width="86" height="34" rx="2" />
                  <rect class="mechanics__cache-bar" x="360" y="112" width="86" height="34" rx="2" />
                  <path class="mechanics__wire mechanics__wire--active" d="M 136 88 L 344 88" />
                  <path class="mechanics__wire mechanics__wire--active" d="M 344 122 L 136 122" />
                  <circle class="mechanics__node mechanics__node--core" cx="240" cy="88" r="5.5" />
                  <circle class="mechanics__node mechanics__node--core" cx="240" cy="122" r="5.5" />
                  <circle class="mechanics__pulse" cx="0" cy="0" r="3.5">
                    <animateMotion dur="3.6s" repeatCount="indefinite" path="M 136 88 L 344 88" />
                  </circle>
                  <circle class="mechanics__pulse" cx="0" cy="0" r="3.5">
                    <animateMotion dur="3.6s" begin="1.8s" repeatCount="indefinite" path="M 344 122 L 136 122" />
                  </circle>
                </g>
              )}
            </svg>
            <ol class="mechanics__nodes">
              {stage.nodes.map(([nodeTitle, nodeDesc], nodeIdx) => (
                <li>
                  <span class="mechanics__node-num" aria-hidden="true" data-numeric>0{nodeIdx + 1}</span>
                  <div>
                    <strong>{nodeTitle}</strong>
                    <p>{nodeDesc}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="loop" aria-labelledby="loop-heading">
  <header class="loop__header">
    <h2 id="loop-heading">{t.loopTitle}</h2>
    <p>{t.loopLede}</p>
  </header>
  <ol class="loop__steps">
    {t.loop.map(([name, description], index) => (
      <li style={`--step: ${index}`}>
        <span class="loop__node" aria-hidden="true"></span>
        <strong>{name}</strong>
        <p>{description}</p>
      </li>
    ))}
  </ol>
  <p class="loop__gate"><span class="star-mark" data-complete="true" aria-hidden="true"></span>{t.gate}</p>
</section>

<section class="catalog" aria-labelledby="catalog-heading">
  <header class="catalog__header">
    <h2 id="catalog-heading">{t.catalogTitle}</h2>
    <p>{t.catalogLede}</p>
  </header>
  {parts.map((part) => (
    <section class="catalog__part" data-part={part} aria-labelledby={`part-${part}`}>
      <header class="catalog__part-head">
        <h3 id={`part-${part}`}>{partLabels[locale][part].title}</h3>
        <p>{partLabels[locale][part].summary}</p>
      </header>
      <ol class="catalog__list">
        {tracks.filter((track) => track.data.part === part).map((track) => {
          const trackLessons = lessonsOf(track.data.id)
          const minutes = trackLessons.reduce((sum, lesson) => sum + readingMinutes(lesson), 0)
          return (
            <li class="catalog__row arrive" data-tier={track.data.tier}>
              <div class="catalog__figure">
                <ConstellationChart locale={locale} trackId={track.data.id} lessons={trackLessons} variant="mini" />
              </div>
              <div class="catalog__text">
                <h4>
                  <a href={trackPath(locale, track.data.id)} style={`view-transition-name: ${trackTitleTransitionName(track.data.id)}`}>
                    <b data-numeric>{positionOf(track.data.id)}</b> <span class="plate-name">{track.data.title}</span>
                  </a>
                </h4>
                <p>{track.data.summary}</p>
              </div>
              <dl class="catalog__facts">
                <div><dt class="visually-hidden">{isPt ? 'Nível' : 'Tier'}</dt><dd class="catalog__tier">{tierNames[track.data.tier]}</dd></div>
                <div><dt class="visually-hidden">{isPt ? 'Aulas' : 'Lessons'}</dt><dd>{trackLessons.length} {t.lessons}</dd></div>
                <div><dt class="visually-hidden">{isPt ? 'Leitura' : 'Reading'}</dt><dd data-numeric>≈ {hours(minutes)}</dd></div>
              </dl>
              <p class="catalog__progress" data-course-progress data-lesson-ids={trackLessons.map((lesson) => lesson.data.id).join(' ')} data-template={t.progress} hidden>
                <span data-count></span>
              </p>
            </li>
          )
        })}
      </ol>
    </section>
  ))}
</section>

<section class="close">
  <div class="close__plate">
    <h2>{t.closeTitle}</h2>
    <p>{t.closeBody}</p>
    {first && <a class="button button--inverse" href={lessonPath(locale, first)}><span><b data-numeric>{positionOf(first.data.id)}</b> {first.data.title}</span><span aria-hidden="true">→</span></a>}
  </div>
</section>

