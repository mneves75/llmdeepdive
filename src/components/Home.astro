---
import { trackTitleTransitionName } from '~/lib/sky-data'
import { getCollection } from 'astro:content'
import { partLabels, positionOf, tierLabels, type Locale } from '~/lib/i18n'
import { lessonPath, readingMinutes, trackPath, type LessonEntry, type TrackEntry } from '~/lib/content'
import { TENSORFOLD_BENCHMARKS } from '~/lib/model-facts'
import SamplingPreview from '~/components/SamplingPreview.astro'
import SkyChart from '~/components/SkyChart.astro'
import ConstellationChart from '~/components/ConstellationChart.astro'

interface Props { locale: Locale }

const { locale } = Astro.props
const isPt = locale === 'pt-br'
const base = isPt ? '/pt-br' : ''
const allTracks: TrackEntry[] = await getCollection('tracks')
const allLessons: LessonEntry[] = await getCollection('lessons')
const tracks = allTracks.filter((track) => track.data.locale === locale).sort((a, b) => a.data.order - b.data.order)
const lessons = allLessons.filter((lesson) => lesson.data.locale === locale)
const lessonsOf = (trackId: string): LessonEntry[] => lessons
  .filter((lesson) => lesson.data.track === trackId)
  .sort((a, b) => a.data.order - b.data.order)
// Derived, never written by hand: a literal drifts the moment a lesson lands.
const lessonCount = lessons.length
const trackCount = tracks.length
const tierNames = tierLabels[locale]
const parts = [...new Set(tracks.map((track) => track.data.part))]
const first = lessonsOf(tracks[0]?.data.id ?? '')[0]

const studyPaths = {
  models: { title: isPt ? 'Entender os modelos' : 'Understand the models', summary: isPt ? 'Siga o caminho do texto até a previsão do próximo token.' : 'Follow the path from raw text to the next token prediction.' },
  agents: { title: isPt ? 'Construir agentes' : 'Build agents', summary: isPt ? 'Comece pela arquitetura de um agente e pelo estado que ele precisa guardar.' : 'Start with agent architecture and the state an agent needs to keep.' },
  engineering: { title: isPt ? 'Engenharia de IA' : 'Engineer AI systems', summary: isPt ? 'Use APIs de modelos e avance até RAG, avaliações e operação em produção.' : 'Work from model APIs through RAG, evaluation and production operations.' },
} as const
const sampleLesson = lessons.find((lesson) => lesson.data.id === '7.4-sampling')
if (!sampleLesson) throw new Error(`Missing sampling lesson for ${locale}`)

const hours = (minutes: number): string => {
  const h = Math.floor(minutes / 60)
  const m = minutes % 60
  return h === 0 ? `${m} min` : m === 0 ? `${h} h` : `${h} h ${m} min`
}

const t = {
  title: isPt ? 'Como os modelos de linguagem' : 'How language models',
  titleEnd: isPt ? 'realmente funcionam' : 'actually work',
  lede: isPt
    ? 'Explore como um modelo prevê o próximo token e pratique o que aprendeu em aulas e laboratórios.'
    : 'Explore how a model predicts the next token, then put what you learn to work in lessons and labs.',
  tracks: isPt ? 'trilhas' : 'tracks',
  languages: isPt ? 'Inglês e português' : 'English and Portuguese',
  start: isPt ? `Começar pela aula ${positionOf(first?.data.id ?? '0.1')}` : `Start with lesson ${positionOf(first?.data.id ?? '0.1')}`,
  roadmap: isPt ? 'Ver o roteiro' : 'View the roadmap',
  continue: isPt ? 'Continuar de onde parou:' : 'Continue where you left off:',
  systemsReference: isPt ? 'Referências de sistemas:' : 'Systems references:',
  systemsCpu: isPt ? '(streaming de pesos em CPU)' : '(CPU weight streaming)',
  systemsGpu: isPt ? '(motor Metal e CUDA 13)' : '(Metal & CUDA 13 engine)',
  skyLabel: isPt ? 'O currículo como um mapa do céu: uma constelação por trilha' : 'The curriculum as a star chart: one constellation per track',
  skyCaption: isPt
    ? 'Cada estrela é uma aula; cada constelação, uma trilha, ligada na ordem do curso. As estrelas maiores são as aulas em que mais aulas se apoiam.'
    : 'Every star is a lesson; every constellation a track, joined in course order. The larger stars are the lessons most other lessons stand on.',
  pipelineTitle: isPt ? 'Um forward pass em cinco estágios' : 'One forward pass in five stages',
  pipelineLede: isPt
    ? 'Acompanhe uma entrada do texto bruto até o próximo token ou chamada de ferramenta no Qwen3.8-27B. Escolha qualquer estágio para inspecionar as dimensões reais e ir direto à aula correspondente.'
    : 'Trace an input from raw text to the next token or tool call inside Qwen3.8-27B. Select any stage to inspect the real tensor shapes and jump straight to its lesson.',
  pipelineGroupLabel: isPt ? 'Estágios do forward pass de um LLM' : 'LLM forward-pass stages',
  pipelineExploreLabel: isPt ? 'Inspecionar na anatomia 3D →' : 'Inspect in the 3D anatomy →',
  pipelineStages: isPt
    ? [
        {
          id: 'tokenize',
          tab: 'Tokenização',
          title: 'Texto vira IDs inteiros de subpalavras (BPE)',
          body: 'Um modelo de linguagem não lê caracteres nem palavras inteiras: o tokenizador BPE divide a entrada em subpalavras frequentes e converte cada pedaço em um inteiro do vocabulário de 248.320 entradas.',
          shape: 'string → int32[seq_len]',
          cells: [
            ['def', '750'],
            [' fib', '14921'],
            ['(n):', '4128'],
            [' return', '470'],
          ],
          lessonHref: `${base}/lessons/1-text-to-tensors/1.2-tokenization-i/`,
          lessonLabel: 'Ler a aula 1.2 sobre tokenização BPE →',
        },
        {
          id: 'embed',
          tab: 'Embeddings',
          title: 'Cada ID busca um vetor denso de 5.120 números',
          body: 'Uma consulta de tabela na matriz de embeddings (248.320 × 5.120) mapeia cada ID inteiro para um ponto no espaço latente de 5.120 dimensões onde relações sintáticas e semânticas viram direção e distância.',
          shape: 'int32[4] → bf16[4, 5120]',
          cells: [
            ['ID 750', '[+0.12, -0.41, …, +0.08]'],
            ['ID 14921', '[-0.33, +0.27, …, -0.19]'],
            ['ID 4128', '[+0.05, +0.18, …, +0.44]'],
            ['ID 470', '[+0.49, -0.09, …, +0.22]'],
          ],
          lessonHref: `${base}/lessons/1-text-to-tensors/1.5-embeddings-meaning-as-geometry/`,
          lessonLabel: 'Ler a aula 1.5 sobre embeddings →',
        },
        {
          id: 'layers',
          tab: 'Atenção e FFN',
          title: '64 camadas misturam contexto e refinam o estado residual',
          body: 'Cada camada aplica RMSNorm, mistura tokens anteriores (via Gated DeltaNet ou atenção causal com GQA e RoPE), soma no fluxo residual e passa por um FFN SwiGLU. Ao final, o vetor do último token carrega o contexto inteiro.',
          shape: 'bf16[4, 5120] × 64 camadas → logits[248320]',
          cells: [
            ['Fluxo residual', 'd_model = 5.120'],
            ['Atenção / recorrência', '48 DeltaNet + 16 GQA'],
            ['FFN SwiGLU', 'd_ff = 17.408'],
            ['LM Head', 'projeta para 248.320 logits'],
          ],
          lessonHref: `${base}/lessons/4-transformer/4.2-self-attention/`,
          lessonLabel: 'Ler a aula 4.2 sobre self-attention →',
        },
        {
          id: 'sample',
          tab: 'Amostragem',
          title: 'Temperature, top-k, top-p e min-p escolhem o próximo token',
          body: 'Os logits são divididos pela temperature, viram probabilidades via softmax e têm a cauda cortada por top-k, min-p e top-p (nucleus) antes da renormalização. Com T = 0,7 e top-p = 0,80 sobre "def fib(n): return …", três candidatos dividem 100% da massa.',
          shape: 'logits[248320] → token_id (3 sobreviventes)',
          cells: [
            ['n', '56,6% (mantido)'],
            ['1', '27,7% (mantido)'],
            ['fib', '15,7% (mantido)'],
            ['0 / [ / None', 'cortados pelo top-p'],
          ],
          lessonHref: `${base}/lessons/7-inference-and-efficiency/7.4-sampling/`,
          lessonLabel: 'Abrir o laboratório interativo na aula 7.4 →',
        },
        {
          id: 'generate',
          tab: 'Geração e ferramentas',
          title: 'O token entra no KV cache — ou dispara um contrato de ferramenta',
          body: 'O token sorteado é anexado ao contexto e alimenta o próximo passo com KV cache reaproveitado. Em sistemas de agentes e produção, a decodificação restrita garante JSON válido para acionar buscas RAG ou APIs externas antes do turno seguinte.',
          shape: 'loop autoregressivo + JSON Schema / MCP',
          cells: [
            ['KV cache', 'evita recalcular o prefixo'],
            ['Stop / EOS', 'encerra texto ou abre tool_call'],
            ['Contrato tipado', 'valida argumentos antes de executar'],
            ['Resultado no turno', 'volta como observação do agente'],
          ],
          lessonHref: `${base}/lessons/15-tool-contracts-and-mcp/15.1-from-model-output-to-a-tool-request/`,
          lessonLabel: 'Ler a aula 15.1 sobre contratos de ferramentas →',
        },
      ]
    : [
        {
          id: 'tokenize',
          tab: 'Tokenization',
          title: 'Raw text becomes integer subword IDs (BPE)',
          body: 'A language model never reads raw characters or whole words: a BPE tokenizer splits the prompt into frequent subwords and maps each piece to an integer inside a 248,320-entry vocabulary.',
          shape: 'string → int32[seq_len]',
          cells: [
            ['def', '750'],
            [' fib', '14921'],
            ['(n):', '4128'],
            [' return', '470'],
          ],
          lessonHref: `${base}/lessons/1-text-to-tensors/1.2-tokenization-i/`,
          lessonLabel: 'Read lesson 1.2 on BPE tokenization →',
        },
        {
          id: 'embed',
          tab: 'Embeddings',
          title: 'Each ID looks up a dense 5,120-number vector',
          body: 'A table lookup into the embedding matrix (248,320 × 5,120) maps each integer ID to a vector of 5,120 numbers where syntactic and semantic structure becomes direction and distance.',
          shape: 'int32[4] → bf16[4, 5120]',
          cells: [
            ['ID 750', '[+0.12, -0.41, …, +0.08]'],
            ['ID 14921', '[-0.33, +0.27, …, -0.19]'],
            ['ID 4128', '[+0.05, +0.18, …, +0.44]'],
            ['ID 470', '[+0.49, -0.09, …, +0.22]'],
          ],
          lessonHref: `${base}/lessons/1-text-to-tensors/1.5-embeddings-meaning-as-geometry/`,
          lessonLabel: 'Read lesson 1.5 on embeddings →',
        },
        {
          id: 'layers',
          tab: 'Attention & FFN',
          title: '64 layers mix context and refine the residual stream',
          body: 'Each layer applies RMSNorm, mixes earlier tokens (via Gated DeltaNet or causal GQA attention with RoPE), adds back into the residual stream, and passes through a SwiGLU FFN. At the top, the final token vector carries the full prompt context.',
          shape: 'bf16[4, 5120] × 64 layers → logits[248320]',
          cells: [
            ['Residual stream', 'd_model = 5,120'],
            ['Attention / recurrence', '48 DeltaNet + 16 GQA'],
            ['SwiGLU FFN', 'd_ff = 17,408'],
            ['LM Head', 'projects to 248,320 logits'],
          ],
          lessonHref: `${base}/lessons/4-transformer/4.2-self-attention/`,
          lessonLabel: 'Read lesson 4.2 on self-attention →',
        },
        {
          id: 'sample',
          tab: 'Sampling',
          title: 'Temperature, top-k, top-p and min-p pick the next token',
          body: 'Logits are divided by temperature, turned into probabilities via softmax, and tail-pruned by top-k, min-p, and top-p (nucleus) before renormalizing. At T = 0.7 and top-p = 0.80 on "def fib(n): return …", three surviving tokens share 100% of the mass.',
          shape: 'logits[248320] → token_id (3 survivors)',
          cells: [
            ['n', '56.6% (kept)'],
            ['1', '27.7% (kept)'],
            ['fib', '15.7% (kept)'],
            ['0 / [ / None', 'cut by top-p'],
          ],
          lessonHref: `${base}/lessons/7-inference-and-efficiency/7.4-sampling/`,
          lessonLabel: 'Open the interactive sampling lab in lesson 7.4 →',
        },
        {
          id: 'generate',
          tab: 'Generation & tools',
          title: 'The token enters the KV cache — or triggers a tool contract',
          body: 'The sampled token is appended to the prompt for the next step while the KV cache avoids recomputing the prefix. In agent and production systems, constrained decoding emits schema-valid JSON to invoke RAG retrieval or external APIs before the next turn.',
          shape: 'autoregressive loop + JSON Schema / MCP',
          cells: [
            ['KV cache', 'reuses prior prefix state'],
            ['Stop / EOS', 'ends text or emits tool_call'],
            ['Typed contract', 'validates arguments before execution'],
            ['Tool result', 'feeds back as the next observation'],
          ],
          lessonHref: `${base}/lessons/15-tool-contracts-and-mcp/15.1-from-model-output-to-a-tool-request/`,
          lessonLabel: 'Read lesson 15.1 on tool contracts →',
        },
      ],
  mechanicsTitle: isPt ? 'Três mecanismos que decidem a inferência real' : 'Three mechanisms that decide real inference',
  mechanicsLede: isPt
    ? 'Um servidor rápido não é um único truque. Ele amortiza leituras de pesos com speculative decoding, reaproveita o estado de prefixo entre turnos e mantém os pesos locais quando duas máquinas trabalham juntas.'
    : 'A fast server is not one trick. It amortizes weight reads with speculative decoding, reuses prefix state across turns, and keeps weights local when two machines work together.',
  mechanicsTabsLabel: isPt ? 'Mecanismos de inferência' : 'Inference mechanisms',
  mechanicsStages: isPt
    ? [
        {
          id: 'decode',
          tab: 'Speculative decode paralelo',
          title: 'Propor em árvore, verificar numa leitura de pesos e efetivar sem perda',
          body: 'Em batch 1, o decode do Qwen3.8-27B é limitado pela leitura dos pesos na memória, não pela aritmética. Um drafter externo de difusão em blocos (z-lab/Qwen3.8-27B-DFlash2) propõe uma árvore curta de tokens futuros a baixo custo; o modelo alvo de 27B verifica todos os candidatos numa única passagem paralela e efetiva apenas os tokens idênticos ao decode sem especulação (--no-drafts). No Metal, até 128 streams concorrentes rascunham e verificam em rodadas de pista compartilhada.',
          nodes: [
            ['Drafter DFlash2 (4-bit)', 'Propõe uma árvore curta de candidatos para cada stream ativo.'],
            ['Verificação 27B em passagem única', 'Lê os pesos do modelo alvo uma vez para pontuar toda a árvore.'],
            ['Distribuição exata (--no-drafts)', 'Aceita o prefixo válido e amostra um token corrigido na primeira rejeição.'],
          ],
          metric: TENSORFOLD_BENCHMARKS.decode.metric[locale],
          receipt: TENSORFOLD_BENCHMARKS.decode.receipt[locale],
          lessonHref: `${base}/lessons/7-inference-and-efficiency/7.5-beam-search-speculative-decoding-and-medusa/`,
          lessonLabel: 'Ler a aula 7.5 sobre speculative decoding →',
        },
        {
          id: 'reuse',
          tab: 'Prefixo retido e compactação',
          title: 'Guardar o estado já calculado e compactar antes do teto da janela',
          body: 'Agentes em múltiplos turnos reenviam o system prompt, as definições de ferramentas e a conversa inteira a cada chamada. O cache de prefixo retém o KV cache e o estado recorrente híbrido dos turnos anteriores (exposto como cached_tokens) para que o novo turno processe apenas o sufixo inédito. Quando o histórico cresce, --compact-at resume turnos antigos numa nota estruturada e preserva turnos recentes e pares de ferramentas intactos.',
          nodes: [
            ['Prefixo retido (KV + estado recorrente)', 'System prompt, ferramentas e turnos anteriores permanecem prontos na memória.'],
            ['Sufixo do novo turno', 'O prefill calcula apenas as novas mensagens adicionadas pelo agente.'],
            ['Compactação determinística (--compact-at)', 'Resume turnos antigos sem quebrar pares tool_call e tool_result.'],
          ],
          metric: TENSORFOLD_BENCHMARKS.reuse.metric[locale],
          receipt: TENSORFOLD_BENCHMARKS.reuse.receipt[locale],
          lessonHref: `${base}/lessons/11-mac-studio-ultra-and-mlx/11.4-serving-from-a-mac-mlx-lm-server-and-mlx-serve/`,
          lessonLabel: 'Ler a aula 11.4 sobre servidores e cache de prompt →',
        },
        {
          id: 'cluster',
          tab: 'Dois nós e controle de tráfego',
          title: 'Manter os pesos em casa no Thunderbolt 5 e conter loops de raciocínio',
          body: 'Um cabo Thunderbolt 5 move de 10 a 15 GB/s contra 1,2 TB/s da memória local do M5 Ultra — uma diferença de 80 a 120 vezes. Por isso os pesos ficam fixos em cada Mac e apenas ativações pequenas cruzam o cabo via RDMA/MCDMA. Em produção, guardas de admissão e de loop (--max-inflight, --thinking-budget, --loop-guard) cortam repetições de raciocínio antes que prendam as fatias de decode.',
          nodes: [
            ['Nó 0 (M5 Ultra · 1,2 TB/s local)', 'Mantém seu shard de pesos em memória unificada local.'],
            ['Link Thunderbolt 5 / MCDMA (10–15 GB/s)', 'Transporta apenas ativações entre camadas sem copiar pesos.'],
            ['Nó 1 + guardas (--loop-guard)', 'Streams concorrentes verificados stream por stream contra a execução solo.'],
          ],
          metric: TENSORFOLD_BENCHMARKS.cluster.metric[locale],
          receipt: TENSORFOLD_BENCHMARKS.cluster.receipt[locale],
          lessonHref: `${base}/lessons/11-mac-studio-ultra-and-mlx/11.5-clustering-macs-mlx-distributed/`,
          lessonLabel: 'Ler a aula 11.5 sobre clusters Thunderbolt 5 →',
        },
      ]
    : [
        {
          id: 'decode',
          tab: 'Parallel speculative decode',
          title: 'Propose a tree, verify in one weight read, and commit losslessly',
          body: 'At batch 1, Qwen3.8-27B decode is bound by reading weights from memory, not arithmetic. An external block-diffusion drafter (z-lab/Qwen3.8-27B-DFlash2) proposes a short tree of future tokens cheaply; the 27B target model verifies every candidate in a single parallel pass and commits only tokens identical to non-speculative decode (--no-drafts). On Metal, up to 128 concurrent streams draft and verify in shared lane rounds.',
          nodes: [
            ['DFlash2 drafter (4-bit)', 'Proposes a short candidate token tree for every active stream.'],
            ['Single-pass 27B target verify', 'Streams the target weights once to score the entire candidate tree.'],
            ['Exact distribution (--no-drafts)', 'Commits the accepted prefix and samples a corrected token on rejection.'],
          ],
          metric: TENSORFOLD_BENCHMARKS.decode.metric[locale],
          receipt: TENSORFOLD_BENCHMARKS.decode.receipt[locale],
          lessonHref: `${base}/lessons/7-inference-and-efficiency/7.5-beam-search-speculative-decoding-and-medusa/`,
          lessonLabel: 'Read lesson 7.5 on speculative decoding →',
        },
        {
          id: 'reuse',
          tab: 'Retained prefix & compaction',
          title: 'Keep the state already computed and compact before the window ceiling',
          body: 'Multi-turn agents resend the system prompt, tool definitions, and prior conversation on every step. A prefix cache retains the KV cache and hybrid recurrent state from earlier turns (reported as cached_tokens) so the next turn processes only the new suffix. When history grows, --compact-at summarizes older turns into a structured memory note while keeping recent turns and tool pairs verbatim.',
          nodes: [
            ['Retained prefix (KV + recurrent state)', 'System prompt, tool schemas, and prior turns stay hot in memory.'],
            ['New turn suffix only', 'Prefill evaluates only the newly appended user or tool messages.'],
            ['Deterministic compaction (--compact-at)', 'Summarizes older turns without splitting tool_call and tool_result pairs.'],
          ],
          metric: TENSORFOLD_BENCHMARKS.reuse.metric[locale],
          receipt: TENSORFOLD_BENCHMARKS.reuse.receipt[locale],
          lessonHref: `${base}/lessons/11-mac-studio-ultra-and-mlx/11.4-serving-from-a-mac-mlx-lm-server-and-mlx-serve/`,
          lessonLabel: 'Read lesson 11.4 on Mac servers and prompt caching →',
        },
        {
          id: 'cluster',
          tab: 'Paired nodes & traffic guards',
          title: 'Keep weights local across Thunderbolt 5 and bound runaway reasoning',
          body: 'A Thunderbolt 5 cable moves 10 to 15 GB/s against 1.2 TB/s of M5 Ultra local memory — an 80 to 120× gap. Weights therefore stay pinned on each Mac while only small activations cross the link over RDMA/MCDMA. In production serving, admission and loop guards (--max-inflight, --thinking-budget, --loop-guard) halt verbatim reasoning loops before they saturate decode lanes.',
          nodes: [
            ['Node 0 (M5 Ultra · 1.2 TB/s local)', 'Holds its weight shard in local unified memory.'],
            ['Thunderbolt 5 / MCDMA link (10–15 GB/s)', 'Carries only inter-layer activations without moving weights.'],
            ['Node 1 + guards (--loop-guard)', 'Concurrent streams verified stream-for-stream against solo runs.'],
          ],
          metric: TENSORFOLD_BENCHMARKS.cluster.metric[locale],
          receipt: TENSORFOLD_BENCHMARKS.cluster.receipt[locale],
          lessonHref: `${base}/lessons/11-mac-studio-ultra-and-mlx/11.5-clustering-macs-mlx-distributed/`,
          lessonLabel: 'Read lesson 11.5 on Thunderbolt 5 clustering →',
        },
      ],
  loopTitle: isPt ? 'Cada aula fecha um ciclo' : 'Every lesson closes a loop',
  loopLede: isPt
    ? 'Você não só lê. Segue o mecanismo, testa a ideia e prova que consegue explicá-la.'
    : 'You do not just read. You follow the mechanism, test the idea, and prove you can explain it.',
  loop: isPt
    ? [
        ['Conceito', 'O mecanismo real, sem atalhos, com fontes.'],
        ['Analogia', 'A mesma ideia em linguagem simples.'],
        ['Laboratório', 'Números reais, calculados na hora, onde a aula tem um.'],
        ['Explique de volta', 'Você reconstrói a ideia com suas palavras.'],
        ['Teste seu entendimento', 'A resposta certa vem com o porquê.'],
      ]
    : [
        ['Concept', 'The actual mechanism, with no hand-waving, with sources.'],
        ['Analogy', 'The same idea in plain language.'],
        ['Lab', 'Real numbers, computed live, where a lesson has one.'],
        ['Teach it back', 'You rebuild the idea in your own words.'],
        ['Check your understanding', 'The right answer comes with the reason.'],
      ],
  gate: isPt
    ? 'A estrela da aula se preenche quando sua explicação tem substância e o quiz está certo. Seu texto fica neste navegador.'
    : 'A lesson’s star fills when your explanation has substance and the quiz is right. Your writing stays in this browser.',
  catalogTitle: isPt ? 'O catálogo completo' : 'The complete catalog',
  catalogLede: isPt
    ? `${trackCount} trilhas em três partes: como um modelo funciona, como construir agentes e como operar sistemas de IA em produção.`
    : `${trackCount} tracks in three parts: how a model works, how to build agents, and how to ship production AI systems.`,
  lessons: isPt ? 'aulas' : 'lessons',
  progress: isPt ? '{n} de {m} concluídas' : '{n} of {m} complete',
  closeTitle: isPt ? 'Comece pela superfície' : 'Start at the surface',
  closeBody: isPt
    ? 'A primeira aula explica o que um modelo de linguagem é e o que ele não é. Daí em diante, cada aula se apoia nas anteriores.'
    : 'The first lesson explains what a language model is and what it is not. From there, every lesson stands on the ones before it.',
}
---

<section class="hero" aria-labelledby="home-title">
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 id="home-title">{t.title}{' '}<span>{t.titleEnd}</span></h1>
      <p class="hero__lede">{t.lede}</p>
      <div class="hero__actions">
        {first && <a class="button button--primary" href={lessonPath(locale, first)}>{t.start}<span aria-hidden="true">→</span></a>}
        <a class="button" href="#study-paths">{isPt ? 'Escolher uma trilha' : 'Choose a path'}<span aria-hidden="true">↓</span></a>
      </div>
      {/* Filled on this device only; every visitor receives it hidden. */}
      <p class="hero__continue" data-continue hidden>
        {t.continue} <a data-continue-link href={first ? lessonPath(locale, first) : `${base}/tracks/`}><b data-continue-position data-numeric></b> <span data-continue-title></span></a>
      </p>
    </div>
    <SamplingPreview {locale} href={`${lessonPath(locale, sampleLesson)}#lab-heading`} />
    <ul class="hero__facts" aria-label={isPt ? 'Sobre o curso' : 'About the course'}>
      <li><b>{trackCount}</b> {t.tracks}</li>
      <li><b>{lessonCount}</b> {t.lessons}</li>
      <li>{t.languages}</li>
    </ul>
  </div>
</section>

<section class="study-paths" id="study-paths" aria-labelledby="study-paths-title">
  <div class="study-paths__head">
    <h2 id="study-paths-title">{isPt ? 'O que você quer aprender?' : 'What do you want to learn?'}</h2>
    <a href={`${base}/roadmap/`}>{t.roadmap} <span aria-hidden="true">↗</span></a>
  </div>
  <ul>
    {parts.map((part) => {
      const entry = tracks.find((track) => track.data.part === part)
      const path = studyPaths[part]
      if (!entry) return null
      return (
        <li>
          <a data-study-path data-tone={part} href={trackPath(locale, entry.data.id)}>
            <strong>{path.title}</strong>
            <span>{path.summary}</span>
            <span class="study-paths__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      )
    })}
  </ul>
</section>

<section class="pipeline" aria-labelledby="pipeline-heading">
  <header class="pipeline__header">
    <h2 id="pipeline-heading">{t.pipelineTitle}</h2>
    <p>{t.pipelineLede}</p>
  </header>
  <div class="pipeline__frame" role="group" aria-label={t.pipelineGroupLabel}>
    {t.pipelineStages.map((stage, index) => (
      <input
        class="pipeline__radio visually-hidden"
        type="radio"
        name="pipeline-stage"
        id={`pipeline-${stage.id}`}
        checked={index === 0}
      />
    ))}
    <div class="pipeline__tabs" data-pagefind-ignore>
      {t.pipelineStages.map((stage) => (
        <label class="pipeline__tab" id={`pipeline-${stage.id}-label`} for={`pipeline-${stage.id}`}>
          <span>{stage.tab}</span>
        </label>
      ))}
    </div>
    <div class="pipeline__panels" aria-live="polite">
      {t.pipelineStages.map((stage) => (
        <article class="pipeline__panel" aria-labelledby={`pipeline-${stage.id}-label`}>
          <div class="pipeline__copy">
            <h3>{stage.title}</h3>
            <p>{stage.body}</p>
            <div class="pipeline__links">
              <a href={stage.lessonHref}>{stage.lessonLabel}</a>
              <a href={`${base}/explore/`}>{t.pipelineExploreLabel}</a>
            </div>
          </div>
          <div class="pipeline__trace">
            <p class="pipeline__shape" data-numeric>{stage.shape}</p>
            <dl class="pipeline__cells">
              {stage.cells.map(([key, value]) => (
                <div class="pipeline__cell">
                  <dt>{key}</dt>
                  <dd data-numeric>{value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="mechanics" aria-labelledby="mechanics-heading">
  <header class="mechanics__header">
    <h2 id="mechanics-heading">{t.mechanicsTitle}</h2>
    <p>{t.mechanicsLede}</p>
  </header>
  <div class="mechanics__frame" role="group" aria-label={t.mechanicsTabsLabel}>
    {t.mechanicsStages.map((stage, index) => (
      <input
        class="mechanics__radio visually-hidden"
        type="radio"
        name="mechanics-stage"
        id={`mechanics-${stage.id}`}
        checked={index === 0}
      />
    ))}
    <div class="mechanics__tabs" data-pagefind-ignore>
      {t.mechanicsStages.map((stage) => (
        <label class="mechanics__tab" id={`mechanics-${stage.id}-label`} for={`mechanics-${stage.id}`}>
          <span>{stage.tab}</span>
        </label>
      ))}
    </div>
    <div class="mechanics__panels" aria-live="polite">
      {t.mechanicsStages.map((stage, index) => (
        <article class="mechanics__panel" aria-labelledby={`mechanics-${stage.id}-label`}>
          <div class="mechanics__copy">
            <h3>{stage.title}</h3>
            <p>{stage.body}</p>
            <div class="mechanics__receipt">
              <strong class="mechanics__metric" data-numeric>{stage.metric}</strong>
              <p>{stage.receipt}</p>
            </div>
            <p class="mechanics__cta">
              <a href={stage.lessonHref}>{stage.lessonLabel}</a>
            </p>
          </div>
          <div class="mechanics__plate">
            <svg class="mechanics__svg" viewBox="0 0 480 210" aria-hidden="true" focusable="false">
              <rect class="mechanics__box" x="18" y="34" width="118" height="142" rx="4" />
              <rect class="mechanics__box mechanics__box--core" x="181" y="22" width="118" height="166" rx="4" />
              <rect class="mechanics__box" x="344" y="34" width="118" height="142" rx="4" />
              {index === 0 && (
                <g>
                  <path class="mechanics__wire" d="M 136 72 C 158 72, 160 66, 181 66" />
                  <path class="mechanics__wire" d="M 136 105 L 181 105" />
                  <path class="mechanics__wire mechanics__wire--muted" d="M 136 138 C 158 138, 160 144, 181 144" />
                  <path class="mechanics__wire mechanics__wire--active" d="M 299 86 L 344 86" />
                  <path class="mechanics__wire mechanics__wire--active" d="M 299 124 L 344 124" />
                  <circle class="mechanics__node" cx="77" cy="72" r="5" />
                  <circle class="mechanics__node" cx="77" cy="105" r="5" />
                  <circle class="mechanics__node mechanics__node--muted" cx="77" cy="138" r="4" />
                  <circle class="mechanics__node mechanics__node--core" cx="240" cy="86" r="6" />
                  <circle class="mechanics__node mechanics__node--core" cx="240" cy="124" r="6" />
                  <circle class="mechanics__node mechanics__node--commit" cx="403" cy="86" r="6" />
                  <circle class="mechanics__node mechanics__node--commit" cx="403" cy="124" r="6" />
                  <circle class="mechanics__pulse" cx="0" cy="0" r="3.5">
                    <animateMotion dur="3.6s" repeatCount="indefinite" path="M 77 72 L 240 86 L 403 86" />
                  </circle>
                  <circle class="mechanics__pulse" cx="0" cy="0" r="3.5">
                    <animateMotion dur="3.6s" begin="1.2s" repeatCount="indefinite" path="M 77 105 L 240 124 L 403 124" />
                  </circle>
                </g>
              )}
              {index === 1 && (
                <g>
                  <rect class="mechanics__cache-bar" x="34" y="58" width="86" height="18" rx="2" />
                  <rect class="mechanics__cache-bar" x="34" y="84" width="86" height="18" rx="2" />
                  <rect class="mechanics__cache-bar" x="34" y="110" width="86" height="18" rx="2" />
                  <path class="mechanics__wire mechanics__wire--active" d="M 120 93 L 181 93" />
                  <path class="mechanics__wire mechanics__wire--active" d="M 299 105 L 344 105" />
                  <circle class="mechanics__node mechanics__node--core" cx="240" cy="105" r="7" />
                  <circle class="mechanics__node mechanics__node--commit" cx="403" cy="105" r="7" />
                  <circle class="mechanics__pulse" cx="0" cy="0" r="4">
                    <animateMotion dur="3s" repeatCount="indefinite" path="M 120 93 L 240 105 L 403 105" />
                  </circle>
                </g>
              )}
              {index === 2 && (
                <g>
                  <rect class="mechanics__cache-bar" x="34" y="64" width="86" height="34" rx="2" />
                  <rect class="mechanics__cache-bar" x="34" y="112" width="86" height="34" rx="2" />
                  <rect class="mechanics__cache-bar" x="360" y="64" width="86" height="34" rx="2" />
                  <rect class="mechanics__cache-bar" x="360" y="112" width="86" height="34" rx="2" />
                  <path class="mechanics__wire mechanics__wire--active" d="M 136 88 L 344 88" />
                  <path class="mechanics__wire mechanics__wire--active" d="M 344 122 L 136 122" />
                  <circle class="mechanics__node mechanics__node--core" cx="240" cy="88" r="5.5" />
                  <circle class="mechanics__node mechanics__node--core" cx="240" cy="122" r="5.5" />
                  <circle class="mechanics__pulse" cx="0" cy="0" r="3.5">
                    <animateMotion dur="3.6s" repeatCount="indefinite" path="M 136 88 L 344 88" />
                  </circle>
                  <circle class="mechanics__pulse" cx="0" cy="0" r="3.5">
                    <animateMotion dur="3.6s" begin="1.8s" repeatCount="indefinite" path="M 344 122 L 136 122" />
                  </circle>
                </g>
              )}
            </svg>
            <ol class="mechanics__nodes">
              {stage.nodes.map(([nodeTitle, nodeDesc], nodeIdx) => (
                <li>
                  <span class="mechanics__node-num" aria-hidden="true" data-numeric>0{nodeIdx + 1}</span>
                  <div>
                    <strong>{nodeTitle}</strong>
                    <p>{nodeDesc}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="loop" aria-labelledby="loop-heading">
  <header class="loop__header">
    <h2 id="loop-heading">{t.loopTitle}</h2>
    <p>{t.loopLede}</p>
  </header>
  <ol class="loop__steps">
    {t.loop.map(([name, description], index) => (
      <li style={`--step: ${index}`}>
        <span class="loop__node" aria-hidden="true"></span>
        <strong>{name}</strong>
        <p>{description}</p>
      </li>
    ))}
  </ol>
  <p class="loop__gate"><span class="star-mark" data-complete="true" aria-hidden="true"></span>{t.gate}</p>
</section>

<section class="atlas" aria-labelledby="atlas-heading">
  <header class="atlas__header">
    <h2 id="atlas-heading">{isPt ? 'Mapa do curso' : 'Course map'}</h2>
    <p>{t.skyCaption}</p>
  </header>
  <details>
    <summary>{isPt ? 'Explorar o mapa' : 'Explore the map'}</summary>
    <SkyChart locale={locale} label={t.skyLabel} variant="hero" />
  </details>
    <p class="hero__reference">
      {t.systemsReference}{' '}
      <a href="https://github.com/FareedKhan-dev/kimi-k3-in-c">Kimi K3 in C</a> {t.systemsCpu} ·{' '}
      <a href="https://github.com/ashhart/TensorFold/tree/v1.2.1">TensorFold</a> {t.systemsGpu}.
    </p>
</section>

<section class="catalog" aria-labelledby="catalog-heading">
  <header class="catalog__header">
    <h2 id="catalog-heading">{t.catalogTitle}</h2>
    <p>{t.catalogLede}</p>
  </header>
  {parts.map((part) => (
    <section class="catalog__part" data-part={part} aria-labelledby={`part-${part}`}>
      <header class="catalog__part-head">
        <h3 id={`part-${part}`}>{partLabels[locale][part].title}</h3>
        <p>{partLabels[locale][part].summary}</p>
      </header>
      <ol class="catalog__list">
        {tracks.filter((track) => track.data.part === part).map((track) => {
          const trackLessons = lessonsOf(track.data.id)
          const minutes = trackLessons.reduce((sum, lesson) => sum + readingMinutes(lesson), 0)
          return (
            <li class="catalog__row arrive" data-tier={track.data.tier}>
              <div class="catalog__figure">
                <ConstellationChart locale={locale} trackId={track.data.id} lessons={trackLessons} variant="mini" />
              </div>
              <div class="catalog__text">
                <h4>
                  <a href={trackPath(locale, track.data.id)} style={`view-transition-name: ${trackTitleTransitionName(track.data.id)}`}>
                    <b data-numeric>{positionOf(track.data.id)}</b> <span class="plate-name">{track.data.title}</span>
                  </a>
                </h4>
                <p>{track.data.summary}</p>
              </div>
              <dl class="catalog__facts">
                <div><dt class="visually-hidden">{isPt ? 'Nível' : 'Tier'}</dt><dd class="catalog__tier">{tierNames[track.data.tier]}</dd></div>
                <div><dt class="visually-hidden">{isPt ? 'Aulas' : 'Lessons'}</dt><dd>{trackLessons.length} {t.lessons}</dd></div>
                <div><dt class="visually-hidden">{isPt ? 'Leitura' : 'Reading'}</dt><dd data-numeric>≈ {hours(minutes)}</dd></div>
              </dl>
              <p class="catalog__progress" data-course-progress data-lesson-ids={trackLessons.map((lesson) => lesson.data.id).join(' ')} data-template={t.progress} hidden>
                <span data-count></span>
              </p>
            </li>
          )
        })}
      </ol>
    </section>
  ))}
</section>

<section class="close">
  <div class="close__plate">
    <h2>{t.closeTitle}</h2>
    <p>{t.closeBody}</p>
    {first && <a class="button button--inverse" href={lessonPath(locale, first)}><span><b data-numeric>{positionOf(first.data.id)}</b> {first.data.title}</span><span aria-hidden="true">→</span></a>}
  </div>
</section>

<style>
  .hero {
    --accent: var(--reticle);
    --accent-ink: light-dark(#ffffff, #121212);
    background: linear-gradient(90deg, var(--plate) 61.8%, var(--plate-raised) 61.8%);
    border-bottom: 1px solid var(--rule);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.14fr) minmax(0, 0.86fr);
    align-items: center;
    gap: clamp(2rem, 5.5vw, 5.5rem);
    max-width: var(--shell-max);
    margin-inline: auto;
    padding: clamp(3rem, 6vw, 6.25rem) clamp(1rem, 5vw, 4.5rem) 0;
  }
  .hero h1 {
    max-width: 13ch;
    font-size: clamp(3rem, 6.3vw, 6.75rem);
    font-weight: var(--weight-black);
    font-stretch: 90%;
    line-height: 0.96;
    letter-spacing: -0.046em;
    hyphens: auto;
  }
  .hero h1 span { display: block; color: var(--reticle); }
  .hero__lede { max-width: 38ch; margin: 1.4rem 0 0; color: var(--ink-muted); font-size: clamp(1rem, 1.6vw, 1.3rem); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1.75rem; }
  .hero__actions .button { min-height: 3.1rem; }
  .hero__continue { margin: 1rem 0 0; color: var(--ink-muted); font-size: var(--text-sm); }
  .hero__continue a { color: var(--accent); font-weight: 650; }
  .hero__facts { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.55rem 1.6rem; margin: 0; padding: 0.8rem 0; border-top: 1px solid var(--rule-strong); color: var(--ink-muted); list-style: none; font-size: var(--text-sm); }
  .hero__facts b { color: var(--ink); font: var(--weight-bold) 1.1rem / 1 var(--font-display); }
  .study-paths, .atlas, .loop, .pipeline, .mechanics, .catalog { max-width: var(--shell-max); margin-inline: auto; padding: clamp(2.75rem, 6vw, 6rem) clamp(1rem, 5vw, 4.5rem); }
  .study-paths__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: clamp(1.5rem, 2.6vw, 2.5rem); }
  .study-paths h2, .atlas h2, .loop h2, .catalog h2, .close h2, .pipeline h2, .mechanics h2 { font-size: clamp(2.1rem, 4.1vw, 4rem); font-stretch: 92%; letter-spacing: -0.034em; }
  .study-paths__head a { color: var(--reticle); font-weight: var(--weight-semibold); }
  .study-paths ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.85rem; margin: 0; padding: 0; list-style: none; }
  .study-paths li { display: grid; }
  .study-paths li a {
    --path-accent: var(--reticle);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: end;
    min-height: 10rem;
    gap: 0.6rem 1rem;
    padding: clamp(1rem, 2vw, 1.6rem);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--path-accent);
    border-radius: var(--radius-sm);
    background: var(--plate-raised);
    color: var(--ink);
    text-decoration: none;
  }
  .study-paths li a[data-tone="agents"] { --path-accent: var(--accent); }
  .study-paths li a[data-tone="engineering"] { --path-accent: var(--tier-core); }
  .study-paths li a:hover { border-color: var(--path-accent); color: var(--ink); background: var(--plate); }
  .study-paths li strong, .study-paths li span:not(.study-paths__arrow) { grid-column: 1; }
  .study-paths li strong { font: var(--weight-bold) clamp(1.35rem, 2.3vw, 2.05rem)/1.06 var(--font-display); overflow-wrap: break-word; }
  .study-paths li span { color: var(--ink-muted); font-size: var(--text-sm); }
  .study-paths li .study-paths__arrow { grid-area: 1 / 2; color: var(--path-accent); font-size: 1.4rem; }
  .study-paths a:hover .study-paths__arrow { translate: 0.24rem 0; }
  .atlas, .loop, .pipeline, .mechanics, .catalog { border-top: 1px solid var(--rule); }
  .atlas details { margin-top: var(--space-md); padding: var(--space-2xs) var(--space-sm); border: 1px solid var(--rule); background: var(--plate-raised); }
  .atlas summary { min-height: 2.75rem; padding-block: 0.55rem; color: var(--accent); cursor: pointer; }
  .atlas details[open] { background: var(--plate); }
  .atlas .hero__reference { margin: var(--space-sm) 0 0; color: var(--ink-muted); font-size: var(--text-xs); }
  @media (prefers-reduced-motion: no-preference) {
    .hero__copy { animation: home-arrival var(--dur-focal) var(--ease-out) both; }
    .hero__inner > :global([data-sampling-preview]) { animation: home-arrival var(--dur-focal) var(--ease-out) 90ms both; }
    .study-paths li a { transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
    .study-paths__arrow { transition: translate var(--dur-base) var(--ease-out); }
  }
  @keyframes home-arrival { from { translate: 0 0.9rem; } }
  @media (max-width: 55rem) {
    .hero { background: var(--plate); }
    .hero__inner { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
    .hero h1 { max-width: 16ch; font-size: clamp(2.4rem, 8.6vw, 5rem); hyphens: manual; }
  }
  @media (max-width: 45rem) {
    .study-paths ul { grid-template-columns: minmax(0, 1fr); }
    .study-paths li a { min-height: auto; }
  }

  .loop__header, .catalog__header, .pipeline__header, .mechanics__header, .atlas__header { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--space-sm) var(--space-xl); align-items: end; }
  .loop__header > p, .catalog__header > p, .pipeline__header > p, .mechanics__header > p, .atlas__header > p { max-width: 36rem; margin: 0; color: var(--ink-muted); font-size: var(--text-lg); }

  .pipeline__frame, .mechanics__frame {
    margin-top: var(--space-lg);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    background: var(--plate-raised);
  }
  .pipeline__tabs, .mechanics__tabs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }
  .mechanics__tabs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .pipeline__tab, .mechanics__tab {
    display: inline-flex;
    align-items: center;
    min-height: 3.15rem;
    padding: 0.65rem 0.85rem;
    border-top: 3px solid var(--tab-accent, transparent);
    color: var(--ink);
    background: var(--plate);
    font: var(--weight-semibold) var(--text-sm) / 1.2 var(--font-display);
    cursor: pointer;
    overflow-wrap: break-word;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .pipeline__tab:hover, .mechanics__tab:hover { background: var(--plate-raised); }
  .pipeline__panel, .mechanics__panel {
    display: none;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--space-xl);
    align-items: start;
    padding: clamp(var(--space-sm), 3vw, var(--space-lg));
  }
  .pipeline__radio:nth-of-type(1):checked ~ .pipeline__panels > .pipeline__panel:nth-child(1),
  .pipeline__radio:nth-of-type(2):checked ~ .pipeline__panels > .pipeline__panel:nth-child(2),
  .pipeline__radio:nth-of-type(3):checked ~ .pipeline__panels > .pipeline__panel:nth-child(3),
  .pipeline__radio:nth-of-type(4):checked ~ .pipeline__panels > .pipeline__panel:nth-child(4),
  .pipeline__radio:nth-of-type(5):checked ~ .pipeline__panels > .pipeline__panel:nth-child(5) {
    display: grid;
  }
  .pipeline__radio:nth-of-type(1):checked ~ .pipeline__tabs > .pipeline__tab:nth-child(1),
  .pipeline__radio:nth-of-type(2):checked ~ .pipeline__tabs > .pipeline__tab:nth-child(2),
  .pipeline__radio:nth-of-type(3):checked ~ .pipeline__tabs > .pipeline__tab:nth-child(3),
  .pipeline__radio:nth-of-type(4):checked ~ .pipeline__tabs > .pipeline__tab:nth-child(4),
  .pipeline__radio:nth-of-type(5):checked ~ .pipeline__tabs > .pipeline__tab:nth-child(5) {
    color: var(--reticle);
    background: var(--plate-raised);
    --tab-accent: var(--reticle);
  }
  .pipeline__radio:nth-of-type(1):focus-visible ~ .pipeline__tabs > .pipeline__tab:nth-child(1),
  .pipeline__radio:nth-of-type(2):focus-visible ~ .pipeline__tabs > .pipeline__tab:nth-child(2),
  .pipeline__radio:nth-of-type(3):focus-visible ~ .pipeline__tabs > .pipeline__tab:nth-child(3),
  .pipeline__radio:nth-of-type(4):focus-visible ~ .pipeline__tabs > .pipeline__tab:nth-child(4),
  .pipeline__radio:nth-of-type(5):focus-visible ~ .pipeline__tabs > .pipeline__tab:nth-child(5) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .pipeline__copy h3 {
    margin: 0;
    font: var(--weight-bold) clamp(var(--text-xl), 1.3rem + 1.15vw, var(--text-3xl)) / 1.08 var(--font-display);
    text-wrap: balance;
  }
  .pipeline__copy > p {
    margin: var(--space-sm) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-base);
    line-height: 1.55;
  }
  .pipeline__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
  .pipeline__trace {
    color-scheme: dark;
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
    padding: var(--space-md);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--night);
  }
  .pipeline__shape {
    margin: 0;
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--rule);
    color: var(--tier-core);
    font: var(--weight-semibold) var(--text-sm) / 1.3 var(--font-data);
    overflow-wrap: anywhere;
  }
