---
import { getCollection } from 'astro:content'
import { positionOf, tierLabels, type Locale } from '~/lib/i18n'
import { lessonPath, trackPath, type LessonEntry, type TrackEntry, type Tier } from '~/lib/content'

interface Props { locale: Locale }

const { locale } = Astro.props
const isPt = locale === 'pt-br'
const base = isPt ? '/pt-br' : ''
const allTracks: TrackEntry[] = await getCollection('tracks')
const allLessons: LessonEntry[] = await getCollection('lessons')
const tracks = allTracks.filter((track) => track.data.locale === locale).sort((a, b) => a.data.order - b.data.order)
const lessons = allLessons.filter((lesson) => lesson.data.locale === locale)
const countFor = (trackId: string): number => lessons.filter((lesson) => lesson.data.track === trackId).length
// Derived, never written by hand: the corpus grows track by track, and a literal
// here drifts silently the moment a lesson lands.
const lessonCount = lessons.length
const trackCount = tracks.length
const tierNames = tierLabels[locale]
const first = lessons
  .filter((lesson) => lesson.data.track === tracks[0]?.data.id)
  .sort((a, b) => a.data.order - b.data.order)[0]

// The hero cutaway is the curriculum itself: one stratum per tier, in descent
// order, thicker where there are more lessons. Derived, so it cannot drift.
const TIER_ORDER: Tier[] = ['foundations', 'core', 'advanced', 'frontier']
const strata = TIER_ORDER.flatMap((tier) => {
  const tierTracks = tracks.filter((track) => track.data.tier === tier)
  const firstTrack = tierTracks[0]
  const lastTrack = tierTracks.at(-1)
  if (!firstTrack || !lastTrack) return []
  const range = firstTrack === lastTrack
    ? positionOf(firstTrack.data.id)
    : `${positionOf(firstTrack.data.id)}–${positionOf(lastTrack.data.id)}`
  const lessonTotal = tierTracks.reduce((sum, track) => sum + countFor(track.data.id), 0)
  return [{ tier, href: trackPath(locale, firstTrack.data.id), range, lessonTotal, trackCount: tierTracks.length }]
})

const t = {
  title: isPt ? 'Como os modelos de linguagem realmente funcionam' : 'How language models actually work',
  lede: isPt
    ? `Dos primeiros princípios à inferência eficiente, em ${lessonCount} aulas completas em cada idioma. Cada afirmação com fonte, cada laboratório com números reais, nada atrás de login.`
    : `From first principles to efficient inference in ${lessonCount} complete lessons per language. Every claim cited, every lab grounded in real numbers, nothing behind a login.`,
  systemsReference: isPt
    ? 'Referência de inferência em CPU com streaming de pesos:'
    : 'Systems reference for CPU inference with weight streaming:',
  start: isPt ? 'Começar a descida' : 'Start the descent',
  explore: isPt ? 'Explorar a anatomia' : 'Explore the anatomy',
  lessons: isPt ? 'aulas' : 'lessons',
  trackWord: isPt ? ['trilha', 'trilhas'] : ['track', 'tracks'],
  coreLabel: isPt ? 'O currículo em corte, da superfície ao silício' : 'The curriculum in section, from surface to silicon',
  coreCaption: isPt ? `${trackCount} trilhas · ${lessonCount} aulas · da superfície ao silício` : `${trackCount} tracks · ${lessonCount} lessons · surface to silicon`,
  methodTitle: isPt ? 'Uma aula é uma investigação completa' : 'Every lesson is a complete investigation',
  methodLede: isPt
    ? 'Você não “consome conteúdo”. Segue o mecanismo, testa a ideia e prova que consegue explicá-la.'
    : 'You do not just consume content. You follow the mechanism, test the idea, and prove you can explain it.',
  how: isPt
    ? [
        ['Conceito', 'O mecanismo real, sem atalhos.'],
        ['Analogia', 'A mesma ideia em linguagem simples.'],
        ['Prática', 'Números reais, calculados na hora.'],
        ['Explique de volta', 'Você reconstrói a ideia com suas palavras.'],
        ['Quiz', 'A resposta certa vem com o porquê.'],
      ]
    : [
        ['Concept', 'The actual mechanism, with no hand-waving.'],
        ['Analogy', 'The same idea in plain language.'],
        ['Lab', 'Real numbers, computed live.'],
        ['Teach-back', 'You rebuild the idea in your own words.'],
        ['Quiz', 'The right answer comes with the reason.'],
      ],
  gate: isPt
    ? 'Uma aula só termina quando sua explicação tem substância e o quiz está certo. Seu texto fica neste navegador.'
    : 'A lesson finishes only when your explanation has substance and the quiz is right. Your writing stays in this browser.',
  tracksTitle: isPt ? 'O caminho completo, camada por camada' : 'The complete path, layer by layer',
  tracksLede: isPt
    ? `${trackCount} trilhas publicadas formam uma descida contínua: dos fundamentos ao silício que executa o modelo.`
    : `${trackCount} published tracks form one continuous descent, from foundations to the silicon that runs the model.`,
  enter: isPt ? 'Abrir trilha' : 'Enter track',
  published: isPt
    ? `${lessonCount} aulas completas em cada idioma, em ${trackCount} trilhas com paridade entre inglês e português.`
    : `${lessonCount} complete lessons per language across ${trackCount} tracks, with English and Portuguese in parity.`,
  closeTitle: isPt ? 'Sem conta. Sem paywall. Sem rastreamento.' : 'No account. No paywall. No tracking.',
  closeBody: isPt
    ? 'Seu progresso pertence ao seu dispositivo. O código e o currículo permanecem abertos.'
    : 'Your progress belongs to your device. The code and curriculum remain open.',
}
---

<!--
THESIS: Learning is a measured descent from intuition to mechanism, not a generic course-card catalog.
OWN-WORLD: Chart-white fields, abyssal navy sections, semantic survey pigments, contours, sounding markers, and precise cutaways.
STORY: Understand the promise, inspect the method, choose a depth, then begin a real lesson.
FIRST VIEWPORT: Value proposition and actions sit on the clear field; a layered transformer core rises from the abyss at right; proof stays directly below the actions.
FORM: Diagonal Descent, first-ranked staging after the committed world; seed 35d41bb4. The track path becomes a vertical survey on narrow screens.
-->

<section class="hero">
  <div class="hero__copy">
    <h1>{t.title}</h1>
    <p class="hero__lede">{t.lede}</p>
    <div class="hero__actions">
      {first && <a class="survey-button survey-button--primary" href={lessonPath(locale, first)}>{t.start}<span aria-hidden="true">↓</span></a>}
      <a class="survey-button" href={`${base}/explore/`}>{t.explore}<span aria-hidden="true">→</span></a>
    </div>
    <p class="hero__reference">{t.systemsReference} <a href="https://github.com/FareedKhan-dev/kimi-k3-in-c">Kimi K3 in C</a>.</p>
  </div>

  <nav class="core" aria-label={t.coreLabel}>
    <div class="core__chart" aria-hidden="true">
      <i class="contour contour--one"></i>
      <i class="contour contour--two"></i>
      <i class="contour contour--three"></i>
    </div>
    <ol class="core__layers">
      {strata.map((stratum, index) => (
        <li class={`core__layer core__layer--${stratum.tier}`} style={`--lessons:${stratum.lessonTotal};--depth:${index}`}>
          <a href={stratum.href}>
            <strong>{tierNames[stratum.tier]}</strong>
            <span>{stratum.trackCount === 1 ? t.trackWord[0] : t.trackWord[1]} {stratum.range} · {stratum.lessonTotal} {t.lessons}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="core__caption" aria-hidden="true">{t.coreCaption}</p>
  </nav>
</section>

<section class="method">
  <header>
    <h2>{t.methodTitle}</h2>
    <p>{t.methodLede}</p>
  </header>
  <ol class="method__steps">
    {t.how.map(([name, description], index) => (
      <li>
        <span class="method__number">{String(index + 1).padStart(2, '0')}</span>
        <strong>{name}</strong>
        <p>{description}</p>
      </li>
    ))}
  </ol>
  <p class="method__gate"><span class="sounding-marker" aria-hidden="true"></span>{t.gate}</p>
</section>

<section class="track-survey">
  <header class="track-survey__header">
    <h2>{t.tracksTitle}</h2>
    <p>{t.tracksLede}</p>
  </header>
  <ol class="descent-map">
    {tracks.map((track, index) => (
      <li class={`descent-map__item descent-map__item--${track.data.tier}`} style={`--track-index:${index}`}>
        <a href={`${base}/tracks/${track.data.id}/`}>
          <span class="descent-map__marker">{positionOf(track.data.id)}</span>
          <span class="descent-map__body">
            <span class="descent-map__meta">{tierNames[track.data.tier]} · {countFor(track.data.id)} {t.lessons}</span>
            <strong>{track.data.title}</strong>
            <span>{track.data.summary}</span>
          </span>
          <span class="descent-map__action">{t.enter}<b aria-hidden="true">↘</b></span>
        </a>
      </li>
    ))}
  </ol>
  <p class="track-survey__wip">{t.published}</p>
</section>

<section class="open-proof">
  <h2>{t.closeTitle}</h2>
  <p>{t.closeBody}</p>
  {first && <a class="survey-button survey-button--primary" href={lessonPath(locale, first)}>{t.start}<span aria-hidden="true">↓</span></a>}
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(30rem, 1.1fr);
    min-height: min(46rem, calc(100dvh - var(--header-h)));
    max-width: var(--shell-max);
    margin-inline: auto;
    overflow: hidden;
    border-bottom: 1px solid var(--rule-strong);
  }

  .hero__copy { align-self: center; padding: clamp(2.5rem, 7vh, 6rem) clamp(1.25rem, 5vw, 5rem); }
  /* Sized by the shorter viewport axis too, so the actions stay above the fold
     on a 1440×900 laptop instead of sitting on its bottom edge. */
  .hero h1 { max-width: 11ch; margin-block-end: var(--space-md); hyphens: auto; font-size: clamp(3rem, min(7.1vw, 10.5vh), var(--text-5xl)); text-transform: uppercase; }
  .hero__lede { max-width: 36rem; margin: 0; color: var(--ink-muted); font-size: clamp(var(--text-base), 1.45vw, var(--text-lg)); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-block: var(--space-lg) var(--space-md); }
  .hero__reference { max-width: 36rem; margin: 0; color: var(--ink-faint); font-size: var(--text-sm); }
  .hero__reference a { color: var(--ink-muted); text-decoration: underline; text-underline-offset: 0.16em; }

  .core { position: relative; min-height: 36rem; overflow: hidden; color: var(--ink-on-abyss); background: var(--abyss); clip-path: polygon(13% 0, 100% 0, 100% 100%, 0 100%, 0 18%); }
  .core__chart { position: absolute; inset: 0; opacity: 0.18; }
  .contour { position: absolute; border: 1px solid var(--cyan-bright); border-radius: 48% 52% 42% 58% / 56% 32% 68% 44%; }
  .contour--one { inset: 5% -12% 38% 8%; rotate: -7deg; }
  .contour--two { inset: 14% -4% 24% 19%; rotate: 8deg; }
  .contour--three { inset: 25% 8% 8% 30%; rotate: -4deg; }

  /* One stratum per tier, thicker with more lessons (a floor weight keeps the
     smallest tier legible, so thickness orders the tiers rather than claiming
     an exact ratio). The signal line and its
     sounding nodes belong to the list, so every node sits on a real layer. */
  .core__layers { position: absolute; inset: 12% 7% 13% 14%; display: flex; flex-direction: column; gap: 0.6rem; margin: 0; padding: 0 0 0 2.75rem; list-style: none; }
  .core__layers::before { content: ''; position: absolute; left: 0.95rem; top: 1.25rem; bottom: 1.25rem; width: 2px; background: var(--cyan-bright); opacity: 0.8; }
  .core__layer { --stratum: var(--accent); position: relative; flex: calc(var(--lessons) + 16) 1 0; min-height: 5.25rem; }
  .core__layer--core { --stratum: var(--kelp); }
  .core__layer--advanced { --stratum: var(--sonar); }
  .core__layer--frontier { --stratum: var(--coral); }
  .core__layer::before { content: ''; position: absolute; top: 1.15rem; left: -1.8rem; z-index: 1; width: 1rem; height: 1rem; border: 3px solid var(--abyss); border-radius: 50%; background: var(--stratum); box-shadow: 0 0 0 2px var(--stratum); }
  .core__layer a {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-2xs);
    height: 100%;
    margin-inline-start: calc(var(--depth) * 4%);
    padding: var(--space-sm) var(--space-lg) var(--space-md);
    border: 1px solid rgb(255 255 255 / 0.2);
    border-bottom: 0.45rem solid var(--stratum);
    color: inherit;
    background: var(--abyss-raised);
    clip-path: polygon(0 0, 100% 5%, 97% 100%, 3% 95%);
    text-decoration: none;
    transition: background var(--dur-base) var(--ease-out), translate var(--dur-base) var(--ease-out);
  }
  .core__layer a:hover { background: color-mix(in srgb, var(--stratum) 16%, var(--abyss-raised)); translate: 0.4rem 0; }
  /* clip-path would cut the global outline off, so focus draws inside. */
  .core__layer a:focus-visible { outline: 3px solid var(--sonar); outline-offset: -6px; }
  .core__layer strong { font: var(--weight-bold) clamp(var(--text-lg), 1.8vw, var(--text-xl)) var(--font-display); letter-spacing: -0.01em; text-transform: uppercase; }
  .core__layer span { color: var(--ink-muted-on-abyss); font: var(--text-2xs) var(--font-data); font-variant-numeric: tabular-nums; letter-spacing: 0.04em; }
  .core__caption { position: absolute; right: var(--space-lg); bottom: var(--space-md); margin: 0; color: var(--ink-muted-on-abyss); font: var(--text-3xs) var(--font-data); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }

  .method { max-width: var(--shell-max); margin-inline: auto; padding: var(--space-3xl) var(--space-lg); }
  .method > header { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(18rem, 1.2fr); gap: var(--space-sm) var(--space-xl); align-items: end; }
  .method h2 { max-width: 12ch; font-size: clamp(var(--text-2xl), 4.5vw, var(--text-4xl)); text-transform: uppercase; }
  .method > header > p:last-child { max-width: 42rem; margin: 0; color: var(--ink-muted); font-size: var(--text-lg); }
  .method__steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: var(--space-xl) 0 0; padding: 0; list-style: none; border-block: 1px solid var(--rule-strong); }
  .method__steps li { min-height: 13rem; padding: var(--space-lg) var(--space-md); border-inline-end: 1px solid var(--rule); }
  .method__steps li:last-child { border-inline-end: 0; }
  .method__number { display: block; margin-bottom: var(--space-xl); color: var(--accent); font: var(--weight-semibold) var(--text-xs) var(--font-data); }
  .method__steps strong { display: block; font: var(--weight-bold) var(--text-xl) var(--font-display); }
  .method__steps p { margin: var(--space-xs) 0 0; color: var(--ink-muted); font-size: var(--text-sm); }
  .method__gate { display: flex; gap: var(--space-sm); align-items: flex-start; max-width: 52rem; margin: var(--space-lg) 0 0 auto; color: var(--ink-muted); }

  .track-survey { color-scheme: dark; padding: var(--space-3xl) max(var(--space-lg), calc((100vw - var(--shell-max)) / 2 + var(--space-lg))); color: var(--ink-on-abyss); background: var(--abyss); overflow: hidden; }
  .track-survey__header { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(18rem, 1.2fr); gap: var(--space-sm) var(--space-xl); max-width: var(--shell-max); margin-inline: auto; }
  .track-survey h2 { max-width: 12ch; font-size: clamp(var(--text-2xl), 4.5vw, var(--text-4xl)); text-transform: uppercase; }
  .track-survey__header > p:last-child { max-width: 40rem; margin: 0; color: var(--ink-muted-on-abyss); font-size: var(--text-lg); }
  .descent-map { position: relative; display: grid; gap: 0; max-width: var(--shell-max); margin: var(--space-2xl) auto 0; padding: 0; list-style: none; }
  .descent-map::before { content: ''; position: absolute; left: 7.5%; top: 2rem; bottom: 2rem; width: 2px; background: linear-gradient(var(--accent), var(--kelp), var(--sonar), var(--coral)); transform: skewX(-14deg); transform-origin: top; }
  .descent-map__item { --tier-color: var(--accent); margin-inline-start: calc(var(--track-index) * 4.7%); }
  .descent-map__item--core { --tier-color: var(--kelp); }
  .descent-map__item--advanced { --tier-color: var(--sonar); }
  .descent-map__item--frontier { --tier-color: var(--coral); }
  .descent-map__item a { display: grid; grid-template-columns: 4.25rem minmax(0, 1fr) auto; gap: var(--space-lg); align-items: center; min-height: 8.2rem; padding: var(--space-md) var(--space-lg); border-top: 1px solid rgb(255 255 255 / 0.2); color: inherit; text-decoration: none; transition: background var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .descent-map__item a:hover { background: rgb(255 255 255 / 0.055); transform: translateX(0.65rem); }
  .descent-map__marker { display: grid; place-items: center; width: 3rem; aspect-ratio: 1; border: 2px solid var(--tier-color); border-radius: 50%; color: var(--tier-color); background: var(--abyss); font: var(--weight-semibold) var(--text-xs) var(--font-data); }
  .descent-map__body { display: grid; gap: var(--space-3xs); }
  .descent-map__meta { color: var(--tier-color); font: var(--text-3xs) var(--font-data); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }
  .descent-map__body strong { font: var(--weight-bold) clamp(var(--text-xl), 2.4vw, var(--text-2xl)) var(--font-display); }
  .descent-map__body > span:last-child { max-width: 65ch; color: var(--ink-muted-on-abyss); font-size: var(--text-sm); }
  .descent-map__action { display: flex; align-items: center; gap: var(--space-xs); color: var(--tier-color); font: var(--weight-semibold) var(--text-xs) var(--font-ui); white-space: nowrap; }
  .descent-map__action b { font-size: var(--text-lg); }
  .track-survey__wip { max-width: var(--shell-max); margin: var(--space-xl) auto 0; color: var(--ink-muted-on-abyss); font-size: var(--text-sm); }

  .open-proof { display: grid; grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.8fr) auto; gap: var(--space-xl); align-items: center; max-width: var(--shell-max); margin-inline: auto; padding: var(--space-3xl) var(--space-lg); }
  .open-proof h2 { max-width: 13ch; margin-top: var(--space-xs); font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl)); text-transform: uppercase; }
  .open-proof > p { margin: 0; color: var(--ink-muted); font-size: var(--text-lg); }

  @media (max-width: 70rem) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .method__steps { grid-template-columns: repeat(3, 1fr); }
    .method__steps li:nth-child(3) { border-inline-end: 0; }
    .method__steps li:nth-child(n + 4) { border-top: 1px solid var(--rule); }
    .open-proof { grid-template-columns: 1fr 1fr; }
    .open-proof > a { grid-column: 2; justify-self: start; }
  }

  @media (max-width: 50rem) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero__copy { padding-block: var(--space-3xl); }
    .core { min-height: 30rem; clip-path: polygon(0 7%, 100% 0, 100% 100%, 0 100%); }
    .method > header, .track-survey__header, .open-proof { grid-template-columns: minmax(0, 1fr); }
    .method__steps { grid-template-columns: minmax(0, 1fr); }
    .method__steps li { min-height: auto; border-inline-end: 0; border-top: 1px solid var(--rule); }
    .method__steps li:first-child { border-top: 0; }
    .method__number { margin-bottom: var(--space-md); }
    .descent-map::before { left: 1.5rem; transform: none; }
    .descent-map__item { margin-inline-start: 0; }
    .descent-map__item a { grid-template-columns: 3.25rem minmax(0, 1fr); gap: var(--space-sm); padding-inline: 0; }
    .descent-map__action { grid-column: 2; }
    .open-proof > a { grid-column: auto; }
  }

  @media (max-width: 30rem) {
    .hero h1 { font-size: 3.25rem; }
    .hero__actions { display: grid; }
    .core__layers { inset-inline: 6% 5%; padding-inline-start: 2.25rem; }
    .core__layers::before { left: 0.7rem; }
    .core__layer::before { left: -1.55rem; }
    .core__layer a { margin-inline-start: calc(var(--depth) * 2.5%); padding-inline: var(--space-md); }
    .core__caption { right: var(--space-sm); }
    .descent-map__body > span:last-child { font-size: var(--text-xs); }
  }
</style>
