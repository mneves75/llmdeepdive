---
import { ui, type Locale } from '~/lib/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = ui[locale]
---

<fieldset class="theme" data-theme-toggle>
  <legend class="visually-hidden">{t.theme}</legend>

  <label>
    <input type="radio" name="ldd-theme" value="light" />
    <span>{t.themeLight}</span>
  </label>
  <label>
    <input type="radio" name="ldd-theme" value="auto" checked />
    <span>{t.themeAuto}</span>
  </label>
  <label>
    <input type="radio" name="ldd-theme" value="dark" />
    <span>{t.themeDark}</span>
  </label>
</fieldset>

<script>
  // Three-state control. "Auto" removes the attribute entirely and lets
  // color-scheme: light dark + light-dark() resolve from the OS — which is why
  // the auto path needs no JavaScript at all after this listener is attached.
  const KEY = 'ldd-theme'
  const root = document.documentElement

  function read(): string {
    try {
      return localStorage.getItem(KEY) ?? 'auto'
    } catch {
      return 'auto'
    }
  }

  function apply(value: string): void {
    if (value === 'light' || value === 'dark') root.dataset.theme = value
    else delete root.dataset.theme
    try {
      if (value === 'auto') localStorage.removeItem(KEY)
      else localStorage.setItem(KEY, value)
    } catch {
      // Non-fatal: the theme still applies for this page view.
    }
  }

  for (const group of document.querySelectorAll('[data-theme-toggle]')) {
    const current = read()
    for (const input of group.querySelectorAll<HTMLInputElement>('input[name="ldd-theme"]')) {
      input.checked = input.value === current
      input.addEventListener('change', () => {
        if (!input.checked) return
        const commit = () => apply(input.value)
        // View Transitions make the theme swap read as a cross-fade rather than
        // a jump. Guarded: unsupported browsers just apply it directly.
        if (
          'startViewTransition' in document &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.startViewTransition(commit)
        } else {
          commit()
        }
      })
    }
  }
</script>

<style>
  .theme {
    display: inline-flex;
    gap: 0;
    margin: 0;
    padding: 2px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-full);
    background: var(--paper-raised);
  }

  .theme label {
    position: relative;
    display: inline-flex;
  }

  .theme input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    margin: 0;
  }

  .theme span {
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-full);
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    color: var(--ink-faint);
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .theme input:checked + span {
    background: var(--accent);
    color: light-dark(#fffaf3, #17181d);
  }

  .theme input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>
