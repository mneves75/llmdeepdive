---
import { ui, type Locale } from '~/lib/i18n'
import Icon from '~/components/Icon.astro'
interface Props { locale: Locale }
const { locale } = Astro.props
const t = ui[locale]
---

<fieldset class="theme" data-theme-toggle>
  <legend class="visually-hidden">{t.theme}</legend>
  <label><input type="radio" name="ldd-theme" value="light" /><span><Icon name="sun" /></span><b>{t.themeLight}</b></label>
  <label><input type="radio" name="ldd-theme" value="auto" checked /><span><Icon name="auto" /></span><b>{t.themeAuto}</b></label>
  <label><input type="radio" name="ldd-theme" value="dark" /><span><Icon name="moon" /></span><b>{t.themeDark}</b></label>
  <span class="visually-hidden" role="status" data-theme-status data-message={t.themeSaveError}></span>
</fieldset>

<script>
  type ThemeChoice = 'light' | 'dark' | 'auto'
  const KEY = 'ldd-theme'
  const root = document.documentElement
  const groups = [...document.querySelectorAll<HTMLElement>('[data-theme-toggle]')]

  // Anything other than an explicit light/dark choice means "follow the system".
  // The pre-paint script in Base.astro applies the same rule before first paint.
  const normalize = (value: string | null): ThemeChoice => value === 'light' || value === 'dark' ? value : 'auto'

  function read(): ThemeChoice {
    try {
      const stored = localStorage.getItem(KEY)
      const choice = normalize(stored)
      // Drop a corrupt value so every later reader agrees with what is shown.
      if (stored !== null && choice === 'auto') localStorage.removeItem(KEY)
      return choice
    } catch {
      return 'auto'
    }
  }

  function persist(choice: ThemeChoice): boolean {
    try {
      if (choice === 'auto') localStorage.removeItem(KEY)
      else localStorage.setItem(KEY, choice)
      return true
    } catch {
      return false
    }
  }

  function reflect(choice: ThemeChoice, saveFailed: boolean): void {
    if (choice === 'auto') delete root.dataset.theme
    else root.dataset.theme = choice
    for (const group of groups) {
      group.dataset.saveError = String(saveFailed)
      for (const input of group.querySelectorAll<HTMLInputElement>('input[name="ldd-theme"]')) input.checked = input.value === choice
      const status = group.querySelector<HTMLElement>('[data-theme-status]')
      const message = saveFailed ? status?.dataset.message ?? '' : ''
      if (status) status.textContent = message
      // The border alone is not an explanation; the title gives pointer users
      // the same sentence the status region announces.
      if (message) group.title = message
      else group.removeAttribute('title')
    }
  }

  reflect(read(), false)

  for (const group of groups) {
    for (const input of group.querySelectorAll<HTMLInputElement>('input[name="ldd-theme"]')) {
      input.addEventListener('change', () => {
        if (!input.checked) return
        const choice = normalize(input.value)
        const commit = () => reflect(choice, !persist(choice))
        if ('startViewTransition' in document && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.startViewTransition(commit)
        else commit()
      })
    }
  }

  // Another tab changed (or cleared) the preference: follow it here too.
  window.addEventListener('storage', (event) => {
    if (event.key === KEY || event.key === null) reflect(normalize(event.newValue), false)
  })
</script>

<style>
  .theme { display: inline-flex; margin: 0; padding: 0; border: 1px solid var(--rule-field); border-radius: var(--radius-sm); background: var(--paper); }
  .theme label { position: relative; display: inline-grid; place-items: center; min-width: 2.5rem; min-height: 2.625rem; border-inline-end: 1px solid var(--rule); cursor: pointer; }
  .theme label:last-child { border-inline-end: 0; }
  .theme input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .theme label > span { display: grid; place-items: center; width: 100%; height: 100%; color: var(--ink-muted); transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out); }
  .theme label:hover > span { color: var(--accent); }
  .theme b { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .theme input:checked + span { color: var(--accent-ink); background: var(--accent); }
  .theme input:focus-visible + span { outline: 3px solid var(--focus); outline-offset: 3px; }
  .theme[data-save-error='true'] { border-color: var(--coral); }
  @media (max-width: 28rem) { .theme label { min-width: 2rem; } }
</style>
