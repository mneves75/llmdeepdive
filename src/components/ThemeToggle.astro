---
import { ui, type Locale } from '~/lib/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props
const t = ui[locale]
---

<fieldset class="theme" data-theme-toggle>
  <legend class="visually-hidden">{t.theme}</legend>
  <label><input type="radio" name="ldd-theme" value="light" /><span aria-hidden="true">☀</span><b>{t.themeLight}</b></label>
  <label><input type="radio" name="ldd-theme" value="auto" checked /><span aria-hidden="true">◐</span><b>{t.themeAuto}</b></label>
  <label><input type="radio" name="ldd-theme" value="dark" /><span aria-hidden="true">●</span><b>{t.themeDark}</b></label>
</fieldset>

<script>
  const KEY = 'ldd-theme'
  const root = document.documentElement
  function read(): string { try { return localStorage.getItem(KEY) ?? 'auto' } catch { return 'auto' } }
  function apply(value: string): void {
    if (value === 'light' || value === 'dark') root.dataset.theme = value
    else delete root.dataset.theme
    try { if (value === 'auto') localStorage.removeItem(KEY); else localStorage.setItem(KEY, value) } catch {}
  }
  for (const group of document.querySelectorAll('[data-theme-toggle]')) {
    const current = read()
    for (const input of group.querySelectorAll<HTMLInputElement>('input[name="ldd-theme"]')) {
      input.checked = input.value === current
      input.addEventListener('change', () => {
        if (!input.checked) return
        const commit = () => apply(input.value)
        if ('startViewTransition' in document && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.startViewTransition(commit)
        else commit()
      })
    }
  }
</script>

<style>
  .theme { display: inline-flex; margin: 0; padding: 0; border: 1px solid var(--rule-strong); border-radius: var(--radius-sm); background: var(--paper); }
  .theme label { position: relative; display: inline-grid; place-items: center; min-width: 2.15rem; min-height: 2.15rem; border-inline-end: 1px solid var(--rule); cursor: pointer; }
  .theme label:last-child { border-inline-end: 0; }
  .theme input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .theme span { color: var(--ink-faint); font: var(--text-xs) var(--font-data); }
  .theme b { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .theme input:checked + span { display: grid; place-items: center; width: 100%; height: 100%; color: var(--accent-ink); background: var(--accent); }
  .theme input:focus-visible + span { outline: 3px solid var(--focus); outline-offset: 3px; }
  @media (max-width: 28rem) { .theme label { min-width: 1.85rem; } }
</style>
