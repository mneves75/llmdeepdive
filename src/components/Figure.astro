---
/**
 * Renders a figure from the registry. Authors write `<Figure id="…" />` in MDX
 * with no import — `Lesson.astro` supplies the component through
 * `<Content components={{ Figure }} />`, and MDX throws at BUILD time naming the
 * component if that wiring is ever lost.
 *
 * Three properties this component must never lose:
 *
 * 1. **Zero JavaScript.** Stepped figures switch with native radio inputs and
 *    sibling selectors. That is not cleverness for its own sake: the CSP line in
 *    `dist/_headers` is 1,693 of Cloudflare's 2,000 characters, and every
 *    distinct inline script costs ~55 of the remaining 307. Keyboard operation,
 *    focus and Tab behaviour come free from the radio group.
 * 2. **No inline `<style>`, ever.** A `define:vars` style block would emit one
 *    hash PER INSTANCE and destroy the CSP. The static scoped block below is
 *    linked into `_astro/Lesson.*.css` and costs zero hashes.
 * 3. **Strings live in HTML, geometry lives in SVG.** pt-BR runs 15–25% longer
 *    than English and SVG <text> does not wrap, so a label inside an <svg> is a
 *    clipped label.
 */
import FigureBodyView from '~/components/FigureBody.astro'
import { getFigure, FIGURE_IDS } from '~/lib/figures'
import { localeFromPath, type Locale } from '~/lib/i18n'
import type { FigureStepFrame, Localised } from '~/lib/figures/types'

interface Props {
  id: string
}

const { id } = Astro.props
const figure = getFigure(id)

// A missing figure is a build failure, not a blank space. The whole point of a
// registry is that a typo cannot reach a reader — the explorer once shipped 21
// dead lesson links because a value that had to match something else was never
// resolved against the real artefact.
if (!figure) {
  throw new Error(
    `<Figure id="${id}" /> does not exist in src/lib/figures/. ` +
      `Known ids: ${[...FIGURE_IDS].sort().join(', ')}`,
  )
}

const locale: Locale = localeFromPath(Astro.url.pathname)
const t = (value: Localised): string => value[locale]

const frames: readonly FigureStepFrame[] =
  figure.steps ?? (figure.body ? [{ label: figure.title, caption: figure.caption, body: figure.body }] : [])
if (frames.length === 0) {
  throw new Error(`Figure "${id}" declares neither a body nor any steps.`)
}
// The scoped CSS pairs radio N with panel N by explicit rule, so the cap is
// real. Six steps is already more than a reader will follow in one figure.
const MAX_STEPS = 6
if (frames.length > MAX_STEPS) {
  throw new Error(`Figure "${id}" has ${frames.length} steps; the stepper supports at most ${MAX_STEPS}.`)
}
const stepped = frames.length > 1
const group = `fig-${id}`

const stepsLabel = locale === 'pt-br' ? 'Etapas da figura' : 'Figure steps'
const derivedLabel = locale === 'pt-br' ? 'Derivado na aula' : 'Derived in lesson'
---

<figure class="figure" aria-labelledby={`${group}-caption`}>
  <div class="figure__frame" role="group" aria-label={t(figure.title)} data-stepped={stepped ? "" : undefined}>
    {stepped && frames.map((_, index) => (
      <input
        class="figure__radio visually-hidden"
        type="radio"
        name={group}
        id={`${group}-${index}`}
        checked={index === 0}
      />
    ))}

    {stepped && (
      <div class="figure__steps" data-pagefind-ignore aria-label={stepsLabel}>
        {frames.map((frame, index) => (
          <label class="figure__step-label" id={`${group}-${index}-label`} for={`${group}-${index}`}>
            <span class="figure__step-n" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            {t(frame.label)}
          </label>
        ))}
      </div>
    )}

    {/* A display:none -> block flip inside a live region is announced; without
        it, moving the radio changes the picture and says nothing. */}
    <div class="figure__panels" aria-live="polite">
      {frames.map((frame, index) => (
        <div
          class="figure__panel"
          aria-labelledby={stepped ? `${group}-${index}-label` : undefined}
        >
          <FigureBodyView body={frame.body} locale={locale} idBase={`${group}-${index}`} />
          {stepped && <p class="figure__step-caption">{t(frame.caption)}</p>}
        </div>
      ))}
    </div>
  </div>

  <figcaption id={`${group}-caption`}>
    <span class="figure__title">{t(figure.title)}</span>
    {t(figure.caption)}
    {figure.derivedFrom && (
      /* The locale prefix is load-bearing: without it a pt-BR reader following
         a Portuguese link label lands on the English lesson. EN is unprefixed,
         pt-BR lives under /pt-br/ (astro.config.mjs, prefixDefaultLocale:false). */
      <a
        class="figure__derived"
        href={`${locale === 'pt-br' ? '/pt-br' : ''}/lessons/${figure.derivedFrom}/`}
      >{derivedLabel} {figure.derivedFrom.split('/').pop()}</a>
    )}
  </figcaption>
</figure>

<style>
  /* Figures never inherit the 1.3rem lesson reading size — every label would
     render at 1.3rem and the whole diagram would blow past its column. */
  .figure {
    margin-block: 2em;
    margin-inline: 0;
    font-size: var(--text-sm);
  }
  .figure__frame {
    padding: var(--space-md);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--paper-raised);
  }

  /* --- stepper: native radios, sibling selectors, no script ------------- */
  .figure__steps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--rule);
  }
  .figure__step-label {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3xs);
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    font-size: var(--text-2xs);
    cursor: pointer;
  }
  .figure__step-n {
    color: var(--lesson-tier, var(--accent));
    font-family: var(--font-data);
    font-size: var(--text-3xs);
  }
  /* The input is `.visually-hidden`, NEVER display:none — display:none removes
     it from the tab order and the whole mechanism stops working for a keyboard
     user. The focus ring is therefore moved onto the visible label, in the
     per-step rules below.

     Panels are hidden ONLY inside a stepped figure. The `:checked ~` rules that
     bring one back exist only when there are radios, so hiding unconditionally
     rendered every single-panel figure invisible — correct geometry, correct
     markup, nothing on screen, and no gate that could see it. */
  .figure__frame[data-stepped] .figure__panel { display: none; }
  /* Explicit pairing, one rule per step, capped at MAX_STEPS in the component.
     A hidden panel is display:none so it leaves the accessibility tree too. */
  .figure__frame[data-stepped] .figure__radio:nth-of-type(1):checked ~ .figure__panels > .figure__panel:nth-child(1),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(2):checked ~ .figure__panels > .figure__panel:nth-child(2),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(3):checked ~ .figure__panels > .figure__panel:nth-child(3),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(4):checked ~ .figure__panels > .figure__panel:nth-child(4),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(5):checked ~ .figure__panels > .figure__panel:nth-child(5),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(6):checked ~ .figure__panels > .figure__panel:nth-child(6) {
    display: block;
  }
  .figure__frame[data-stepped] .figure__radio:nth-of-type(1):checked ~ .figure__steps > .figure__step-label:nth-child(1),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(2):checked ~ .figure__steps > .figure__step-label:nth-child(2),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(3):checked ~ .figure__steps > .figure__step-label:nth-child(3),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(4):checked ~ .figure__steps > .figure__step-label:nth-child(4),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(5):checked ~ .figure__steps > .figure__step-label:nth-child(5),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(6):checked ~ .figure__steps > .figure__step-label:nth-child(6) {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }
  /* The step number is --accent by default, which on the SELECTED label's
     --accent background is accent-on-accent and effectively invisible. It must
     take the same ink as the rest of that label. Same explicit pairing as
     above — there is no shorthand that reaches only the checked label. */
  .figure__frame[data-stepped] .figure__radio:nth-of-type(1):checked ~ .figure__steps > .figure__step-label:nth-child(1) .figure__step-n,
  .figure__frame[data-stepped] .figure__radio:nth-of-type(2):checked ~ .figure__steps > .figure__step-label:nth-child(2) .figure__step-n,
  .figure__frame[data-stepped] .figure__radio:nth-of-type(3):checked ~ .figure__steps > .figure__step-label:nth-child(3) .figure__step-n,
  .figure__frame[data-stepped] .figure__radio:nth-of-type(4):checked ~ .figure__steps > .figure__step-label:nth-child(4) .figure__step-n,
  .figure__frame[data-stepped] .figure__radio:nth-of-type(5):checked ~ .figure__steps > .figure__step-label:nth-child(5) .figure__step-n,
  .figure__frame[data-stepped] .figure__radio:nth-of-type(6):checked ~ .figure__steps > .figure__step-label:nth-child(6) .figure__step-n {
    color: inherit;
  }
  .figure__frame[data-stepped] .figure__radio:nth-of-type(1):focus-visible ~ .figure__steps > .figure__step-label:nth-child(1),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(2):focus-visible ~ .figure__steps > .figure__step-label:nth-child(2),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(3):focus-visible ~ .figure__steps > .figure__step-label:nth-child(3),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(4):focus-visible ~ .figure__steps > .figure__step-label:nth-child(4),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(5):focus-visible ~ .figure__steps > .figure__step-label:nth-child(5),
  .figure__frame[data-stepped] .figure__radio:nth-of-type(6):focus-visible ~ .figure__steps > .figure__step-label:nth-child(6) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .figure__step-caption {
    margin: var(--space-md) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-2xs);
    line-height: var(--leading-snug);
  }

  figcaption {
    margin-top: var(--space-sm);
    color: var(--ink-muted);
    font-size: var(--text-2xs);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }
  .figure__title {
    display: block;
    color: var(--ink);
    font: var(--weight-semibold) var(--text-3xs) var(--font-data);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .figure__derived { display: inline-block; margin-top: var(--space-3xs); }

  /* --- print: a stepper prints one state, a <details> prints closed ------
     Both are silent information loss on a course people print. */
  @media print {
    .figure { break-inside: avoid; }
    .figure__panel { display: block !important; }
    .figure__steps { display: none; }
    .figure :global(details) { display: block; }
    .figure :global(details > summary) { display: none; }
  }
</style>
