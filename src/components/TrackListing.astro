---
import { lessonPath, trackPath, type LessonEntry, type TrackEntry } from '~/lib/content'

interface Props {
  locale: 'en' | 'pt-br'
  tracks: TrackEntry[]
  lessons: LessonEntry[]
  linkedTitles?: boolean
}

const { locale, tracks, lessons, linkedTitles = false } = Astro.props
const lessonLabel = locale === 'pt-br' ? 'aulas disponíveis' : 'available lessons'
---

<div class="track-grid">
  {tracks.map((track) => {
    const trackLessons = lessons
      .filter((lesson) => lesson.data.track === track.data.id)
      .sort((left, right) => left.data.order - right.data.order)
    return (
      <section class="track-card panel">
        <p class="eyebrow">{track.data.tier} · {trackLessons.length} {lessonLabel}</p>
        <h2>
          {linkedTitles ? <a href={trackPath(locale, track.data.id)}>{track.data.title}</a> : track.data.title}
        </h2>
        <p>{track.data.summary}</p>
        <ol>
          {trackLessons.map((lesson) => (
            <li><a href={lessonPath(locale, lesson)}>{lesson.data.title}</a></li>
          ))}
        </ol>
      </section>
    )
  })}
</div>

<style>
  .track-grid { display: grid; gap: var(--space-lg); }
  .track-card { padding: var(--space-lg); }
  .track-card h2 { font-size: var(--text-xl); }
  .track-card > p:not(.eyebrow) { color: var(--ink-muted); }
  .track-card li { padding-block: var(--space-2xs); }
</style>
