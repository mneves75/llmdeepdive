---
import { lessonPath, trackPath, type LessonEntry, type TrackEntry } from '~/lib/content'

interface Props {
  locale: 'en' | 'pt-br'
  tracks: TrackEntry[]
  lessons: LessonEntry[]
  linkedTitles?: boolean
}

const { locale, tracks, lessons, linkedTitles = false } = Astro.props
const isPt = locale === 'pt-br'
const lessonLabel = isPt ? 'aulas disponíveis' : 'available lessons'
const openLabel = isPt ? 'Abrir trilha' : 'Open track'
---

<div class="curriculum-map">
  {tracks.map((track) => {
    const trackLessons = lessons
      .filter((lesson) => lesson.data.track === track.data.id)
      .sort((left, right) => left.data.order - right.data.order)
    const sequence = String(track.data.order + 1).padStart(2, '0')
    return (
      <section class={`track-section track-section--${track.data.tier}`} style={`--track-order:${track.data.order}`}>
        <header>
          <span class="track-section__marker">{sequence}</span>
          <div>
            <p class="track-section__meta">{track.data.tier} · {trackLessons.length} {lessonLabel}</p>
            <h2>{linkedTitles ? <a href={trackPath(locale, track.data.id)}>{track.data.title}</a> : track.data.title}</h2>
            <p>{track.data.summary}</p>
          </div>
          {linkedTitles && <a class="track-section__open" href={trackPath(locale, track.data.id)}>{openLabel}<span aria-hidden="true">↘</span></a>}
        </header>
        <ol>
          {trackLessons.map((lesson, index) => (
            <li>
              <span>{sequence}.{String(index + 1).padStart(2, '0')}</span>
              <a href={lessonPath(locale, lesson)}>{lesson.data.title}</a>
              <b aria-hidden="true">→</b>
            </li>
          ))}
        </ol>
      </section>
    )
  })}
</div>

<style>
  .curriculum-map { position: relative; display: grid; gap: var(--space-xl); }
  .curriculum-map::before { content: ''; position: absolute; left: 1.45rem; top: 2rem; bottom: 2rem; width: 2px; background: linear-gradient(var(--accent), var(--kelp), var(--sonar), var(--coral)); }
  .track-section { --tier-color: var(--accent); position: relative; padding-left: 5rem; }
  .track-section--core { --tier-color: var(--kelp); }
  .track-section--advanced { --tier-color: var(--sonar); }
  .track-section--frontier { --tier-color: var(--coral); }
  .track-section > header { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-lg); align-items: end; padding: var(--space-lg) 0; border-top: 1px solid var(--rule-strong); }
  .track-section__marker { position: absolute; left: 0; top: 1.5rem; z-index: 1; display: grid; place-items: center; width: 3rem; aspect-ratio: 1; border: 2px solid var(--tier-color); border-radius: 50%; color: var(--tier-color); background: var(--paper); font: var(--weight-semibold) var(--text-xs) var(--font-data); }
  .track-section__meta { margin: 0 0 var(--space-xs); color: var(--tier-color); font: var(--text-3xs) var(--font-data); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }
  .track-section h2 { font-size: clamp(var(--text-xl), 3vw, var(--text-3xl)); }
  .track-section h2 a { text-decoration: none; }
  .track-section header p:last-child { max-width: 54rem; margin: var(--space-xs) 0 0; color: var(--ink-muted); }
  .track-section__open { display: inline-flex; gap: var(--space-xs); align-items: center; color: var(--tier-color); font: var(--weight-semibold) var(--text-xs) var(--font-ui); white-space: nowrap; }
  .track-section ol { margin: 0; padding: 0; list-style: none; border-bottom: 1px solid var(--rule-strong); }
  .track-section li { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) auto; gap: var(--space-sm); align-items: baseline; padding: 0.7rem 0; border-top: 1px solid var(--rule); }
  .track-section li > span { color: var(--ink-faint); font: var(--text-3xs) var(--font-data); }
  .track-section li a { font-weight: var(--weight-medium); text-decoration: none; }
  .track-section li a:hover { color: var(--tier-color); }
  .track-section li b { color: var(--tier-color); font-weight: var(--weight-normal); }

  @media (min-width: 70rem) {
    .track-section { margin-left: calc(var(--track-order) * 1.5rem); }
  }
  @media (max-width: 42rem) {
    .track-section { padding-left: 3.75rem; }
    .track-section > header { grid-template-columns: 1fr; gap: var(--space-sm); }
    .track-section__marker { width: 2.6rem; }
    .track-section li { grid-template-columns: 3.5rem minmax(0, 1fr); }
    .track-section li b { display: none; }
  }
</style>
