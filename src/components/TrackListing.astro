---
import { lessonPath, trackPath, type LessonEntry, type TrackEntry } from '~/lib/content'
import { positionOf, tierLabels, type Locale } from '~/lib/i18n'
import Icon from '~/components/Icon.astro'

interface Props {
  locale: Locale
  tracks: TrackEntry[]
  lessons: LessonEntry[]
  /** The track index links each title; a single-track page already shows it as its h1. */
  linkedTitles?: boolean
}

const { locale, tracks, lessons, linkedTitles = false } = Astro.props
const isPt = locale === 'pt-br'
const copy = isPt
  ? { lessons: 'aulas', open: 'Abrir trilha', done: 'Concluída neste dispositivo', progress: '{n} de {m} concluídas neste dispositivo' }
  : { lessons: 'lessons', open: 'Open track', done: 'Completed on this device', progress: '{n} of {m} completed on this device' }
---

<div class="curriculum-map" data-curriculum>
  {tracks.map((track) => {
    const trackLessons = lessons
      .filter((lesson) => lesson.data.track === track.data.id)
      .sort((left, right) => left.data.order - right.data.order)
    return (
      <section class={`track-section track-section--${track.data.tier}`} style={`--track-order:${track.data.order}`} aria-labelledby={linkedTitles ? `track-${track.data.id}` : undefined}>
        <header>
          <span class="track-section__marker" aria-hidden="true">{positionOf(track.data.id)}</span>
          <div>
            <p class="track-section__meta">{tierLabels[locale][track.data.tier]} · {trackLessons.length} {copy.lessons}</p>
            {linkedTitles && (
              <>
                <h2 id={`track-${track.data.id}`}><a href={trackPath(locale, track.data.id)}>{track.data.title}</a></h2>
                <p>{track.data.summary}</p>
              </>
            )}
            {/* Filled in on this device only; the HTML is the same for everyone. */}
            <p class="track-section__progress" data-progress data-template={copy.progress} hidden></p>
          </div>
          {linkedTitles && <a class="track-section__open" href={trackPath(locale, track.data.id)}>{copy.open}<span aria-hidden="true">↘</span></a>}
        </header>
        <ol>
          {trackLessons.map((lesson) => (
            <li data-lesson-key={`${locale}:${lesson.data.id}`}>
              <span class="track-section__position">{positionOf(lesson.data.id)}</span>
              <a href={lessonPath(locale, lesson)}>{lesson.data.title}</a>
              <span class="track-section__done" data-done hidden>
                <Icon name="check" />
                <span class="visually-hidden">{copy.done}</span>
              </span>
            </li>
          ))}
        </ol>
      </section>
    )
  })}
</div>

<script>
  // Completion is written by the lesson page (`ldd:complete:<locale>:<id>`);
  // this only reads it. Nothing leaves the browser and the HTML never varies.
  for (const map of document.querySelectorAll<HTMLElement>('[data-curriculum]')) {
    for (const section of map.querySelectorAll<HTMLElement>('.track-section')) {
      const rows = [...section.querySelectorAll<HTMLElement>('[data-lesson-key]')]
      let done = 0
      for (const row of rows) {
        let complete = false
        try { complete = localStorage.getItem(`ldd:complete:${row.dataset.lessonKey}`) === 'true' } catch { complete = false }
        if (!complete) continue
        done += 1
        row.dataset.complete = 'true'
        const marker = row.querySelector<HTMLElement>('[data-done]')
        if (marker) marker.hidden = false
      }
      const progress = section.querySelector<HTMLElement>('[data-progress]')
      if (progress && done > 0) {
        progress.textContent = (progress.dataset.template ?? '').replace('{n}', String(done)).replace('{m}', String(rows.length))
        progress.hidden = false
      }
    }
  }
</script>

<style>
  .curriculum-map { position: relative; display: grid; gap: var(--space-xl); }
  .curriculum-map::before { content: ''; position: absolute; left: 1.45rem; top: 2rem; bottom: 2rem; width: 2px; background: linear-gradient(var(--accent), var(--kelp), var(--sonar), var(--coral)); }
  .track-section { --tier-color: var(--accent); position: relative; padding-left: 5rem; }
  .track-section--core { --tier-color: var(--kelp); }
  .track-section--advanced { --tier-color: var(--sonar); }
  .track-section--frontier { --tier-color: var(--coral); }
  .track-section > header { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-lg); align-items: end; padding: var(--space-lg) 0; border-top: 1px solid var(--rule-strong); }
  .track-section__marker { position: absolute; left: 0; top: 1.5rem; z-index: 1; display: grid; place-items: center; width: 3rem; aspect-ratio: 1; border: 2px solid var(--tier-color); border-radius: 50%; color: var(--tier-color); background: var(--paper); font: var(--weight-semibold) var(--text-sm) var(--font-data); }
  .track-section__meta { margin: 0; color: var(--tier-color); font: var(--weight-semibold) var(--text-3xs) var(--font-data); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }
  .track-section h2 { margin-top: var(--space-xs); font-size: clamp(var(--text-xl), 3vw, var(--text-3xl)); }
  .track-section h2 a { text-decoration: none; }
  .track-section h2 a:hover { color: var(--tier-color); }
  .track-section header p:not([class]) { max-width: var(--measure); margin: var(--space-xs) 0 0; color: var(--ink-muted); }
  .track-section__progress { margin: var(--space-xs) 0 0; color: var(--kelp); font: var(--weight-semibold) var(--text-xs) var(--font-ui); }
  .track-section__open { display: inline-flex; gap: var(--space-xs); align-items: center; min-height: 2.75rem; color: var(--tier-color); font: var(--weight-semibold) var(--text-xs) var(--font-ui); white-space: nowrap; }
  .track-section ol { margin: 0; padding: 0; list-style: none; border-bottom: 1px solid var(--rule-strong); }
  .track-section li { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) 1.5rem; gap: var(--space-sm); align-items: baseline; border-top: 1px solid var(--rule); }
  .track-section__position { color: var(--ink-faint); font: var(--text-xs) var(--font-data); font-variant-numeric: tabular-nums; }
  /* The whole row is the target, not just the words: 44px tall on touch. */
  .track-section li a { padding-block: 0.7rem; font-weight: var(--weight-medium); text-decoration: none; }
  .track-section li a:hover { color: var(--tier-color); }
  .track-section__done { align-self: center; color: var(--kelp); }
  .track-section li[data-complete='true'] .track-section__position { color: var(--kelp); }

  @media (min-width: 70rem) {
    .track-section { margin-left: calc(var(--track-order) * 1.5rem); }
  }
  @media (max-width: 42rem) {
    .track-section { padding-left: 3.75rem; }
    .track-section > header { grid-template-columns: 1fr; gap: var(--space-sm); }
    .track-section__marker { width: 2.6rem; }
    .track-section li { grid-template-columns: 2.75rem minmax(0, 1fr) 1.25rem; gap: var(--space-xs); }
  }
</style>
