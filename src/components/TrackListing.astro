---
import { trackTitleTransitionName } from '~/lib/sky-data'
/**
 * The lesson catalog of one or more tracks.
 *
 * `full` (a track page): one row per lesson with its summary and reading time.
 * `compact` (the tracks index): every track's lessons in a dense grid, under a
 * header that links the track. Completion marks come from progress-client
 * after render; the HTML is the same for everyone.
 */
import { lessonPath, readingMinutes, trackPath, type LessonEntry, type TrackEntry } from '~/lib/content'
import { positionOf, tierLabels, type Locale } from '~/lib/i18n'
import ConstellationChart from '~/components/ConstellationChart.astro'

interface Props {
  locale: Locale
  tracks: TrackEntry[]
  lessons: LessonEntry[]
  detail: 'full' | 'compact'
}

const { locale, tracks, lessons, detail } = Astro.props
const isPt = locale === 'pt-br'
const copy = isPt
  ? { lessons: 'aulas', open: 'Abrir trilha', done: 'Concluída neste dispositivo', progress: '{n} de {m} concluídas', minutes: 'min' }
  : { lessons: 'lessons', open: 'Open track', done: 'Completed on this device', progress: '{n} of {m} complete', minutes: 'min' }
---

<div class={`listing listing--${detail}`}>
  {tracks.map((track) => {
    const trackLessons = lessons
      .filter((lesson) => lesson.data.track === track.data.id)
      .sort((left, right) => left.data.order - right.data.order)
    return (
      <section class="listing__track arrive" data-tier={track.data.tier} aria-labelledby={detail === 'compact' ? `track-${track.data.id}` : undefined}>
        {detail === 'compact' && (
          <header class="listing__head">
            <div class="listing__figure">
              <ConstellationChart locale={locale} trackId={track.data.id} lessons={trackLessons} variant="mini" />
            </div>
            <div>
              <h2 id={`track-${track.data.id}`}>
                <a href={trackPath(locale, track.data.id)} style={`view-transition-name: ${trackTitleTransitionName(track.data.id)}`}>
                  <b data-numeric>{positionOf(track.data.id)}</b> <span class="plate-name">{track.data.title}</span>
                </a>
              </h2>
              <p>{track.data.summary}</p>
              <p class="listing__meta">
                <span class="listing__tier">{tierLabels[locale][track.data.tier]}</span> · {trackLessons.length} {copy.lessons}
                <span class="listing__progress" data-course-progress data-lesson-ids={trackLessons.map((lesson) => lesson.data.id).join(' ')} data-template={` · ${copy.progress}`} hidden><span data-count></span></span>
              </p>
            </div>
          </header>
        )}
        <ol class="listing__lessons">
          {trackLessons.map((lesson) => (
            <li data-lesson-key={`${locale}:${lesson.data.id}`}>
              <span class="star-mark" aria-hidden="true"></span>
              <span class="listing__position" data-numeric>{positionOf(lesson.data.id)}</span>
              <span class="listing__text">
                <a href={lessonPath(locale, lesson)}>{lesson.data.title}</a>
                {detail === 'full' && <span class="listing__summary">{lesson.data.summary}</span>}
              </span>
              <span class="listing__minutes" data-numeric>{readingMinutes(lesson)} {copy.minutes}</span>
              <span class="visually-hidden listing__done">{copy.done}</span>
            </li>
          ))}
        </ol>
      </section>
    )
  })}
</div>

<style>
  .listing { display: grid; gap: var(--space-2xl); }
  .listing__head { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: var(--space-lg); align-items: center; padding-bottom: var(--space-md); }
  .listing__head h2 { font-size: clamp(var(--text-base), 0.9rem + 0.5vw, var(--text-lg)); line-height: 1.3; }
  .listing__head h2 a { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-xs); min-width: 0; color: var(--ink); text-decoration: none; }
  .listing__head h2 .plate-name { min-width: 0; overflow-wrap: break-word; }
  .listing__head h2 a:hover .plate-name { color: var(--tier); }
  .listing__head h2 b { color: var(--tier); font: var(--weight-bold) var(--text-2xl) / 1 var(--font-display); font-stretch: var(--stretch-wide); }
  .listing__head p { max-width: 64ch; margin: var(--space-2xs) 0 0; color: var(--ink-muted); font-size: var(--text-sm); }
  .listing__meta { font-size: var(--text-xs) !important; }
  .listing__tier { color: var(--tier); font-weight: var(--weight-semibold); }
  .listing__progress { color: var(--success); font-weight: var(--weight-semibold); }

  .listing__lessons { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--rule-strong); }
  .listing__lessons li {
    position: relative;
    display: grid;
    grid-template-columns: 1.25rem 3rem minmax(0, 1fr) auto;
    gap: var(--space-xs);
    align-items: baseline;
    padding: 0.7rem var(--space-2xs);
    border-bottom: 1px solid var(--rule);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .listing__lessons li:hover { background: var(--plate-raised); }
  .listing__lessons .star-mark { align-self: start; margin-top: 0.3em; }
  .listing__lessons li[data-complete='true'] > .star-mark { background: var(--tier); }
  .listing__lessons li:not([data-complete='true']) .listing__done { display: none; }
  .listing__position { color: var(--ink-faint); font: var(--text-xs) var(--font-data); }
  .listing__lessons li[data-complete='true'] .listing__position { color: var(--tier); }
  .listing__text { display: grid; gap: 0.2rem; }
  .listing__text a { color: var(--ink); font-weight: var(--weight-medium); text-decoration: none; }
  /* The whole row is the target: 44px tall on touch. */
  .listing__text a::after { content: ''; position: absolute; inset: 0; }
  .listing__lessons li:hover .listing__text a { color: var(--tier); }
  .listing__summary { color: var(--ink-muted); font-size: var(--text-sm); line-height: 1.45; }
  .listing__minutes { color: var(--ink-faint); font: var(--text-2xs) var(--font-data); white-space: nowrap; }

  .listing--full .listing__lessons li { padding-block: var(--space-sm); }
  .listing--full .listing__text a { font: var(--weight-semibold) var(--text-lg) / 1.3 var(--font-display); }

  /* The index: two columns of compact rows on wide screens. */
  @media (min-width: 64rem) {
    .listing--compact .listing__lessons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-xl); }
  }
  @media (max-width: 42rem) {
    .listing__head { grid-template-columns: 5rem minmax(0, 1fr); gap: var(--space-md); }
    .listing__lessons li { grid-template-columns: 1rem 2.5rem minmax(0, 1fr); }
    .listing__minutes { grid-column: 3; }
  }
</style>
