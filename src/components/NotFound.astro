---
/**
 * The 404 plate, both locales: a patch of the atlas where the requested page
 * should be and is not. The reticle sweeps three times and settles — finite,
 * so it needs no pause control (WCAG 2.2.2) — and is still under reduced
 * motion. Every route back is a real link; the chart is a picture.
 */
import type { Locale } from '~/lib/i18n'

interface Props { locale: Locale }
const { locale } = Astro.props
const base = locale === 'pt-br' ? '/pt-br' : ''
const copy = locale === 'pt-br'
  ? {
      title: 'Esta página não está no mapa',
      body: 'O link pode estar desatualizado, ou a aula pode ter sido renomeada. Todo o curso continua acessível a partir destes três pontos.',
      routes: [
        [`${base}/tracks/`, 'Todas as trilhas', 'O curso completo, em ordem'],
        [`${base}/explore/`, 'Explorador de anatomia', 'Desmonte um bloco transformer'],
        [`${base}/lessons/0-orientation-and-foundations/0.1-what-is-a-language-model/`, 'Comece pela aula 0.1', 'O que é um modelo de linguagem?'],
      ],
    }
  : {
      title: 'This page is not on the chart',
      body: 'The link may be out of date, or the lesson may have been renamed. The whole course is still reachable from these three places.',
      routes: [
        [`${base}/tracks/`, 'All tracks', 'The full course, in order'],
        [`${base}/explore/`, 'Anatomy explorer', 'Take a transformer block apart'],
        [`${base}/lessons/0-orientation-and-foundations/0.1-what-is-a-language-model/`, 'Start at lesson 0.1', 'What is a language model?'],
      ],
    }
const STEP = 40
const lines = Array.from({ length: 9 }, (_, index) => (index + 1) * STEP)
---

<section class="notfound">
  <div class="notfound__text">
    <p class="notfound__code" aria-hidden="true" data-numeric>404</p>
    <h1>{copy.title}</h1>
    <p class="notfound__body">{copy.body}</p>
    <ul class="notfound__routes">
      {copy.routes.map(([href, label, note]) => (
        <li><a href={href}>{label}<span aria-hidden="true">→</span></a><span>{note}</span></li>
      ))}
    </ul>
  </div>
  <figure class="notfound__chart" aria-hidden="true">
    <svg viewBox="0 0 400 400" focusable="false">
      <rect class="notfound__neat" x="0.5" y="0.5" width="399" height="399" />
      {lines.map((v) => <line x1={v} x2={v} y1="0" y2="400" />)}
      {lines.map((v) => <line x1="0" x2="400" y1={v} y2={v} />)}
      <circle class="notfound__gap" cx="200" cy="200" r="58" />
    </svg>
    <span class="reticle notfound__reticle"></span>
  </figure>
</section>

<style>
  .notfound {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: var(--space-2xl);
    align-items: center;
    max-width: 72rem;
    margin-inline: auto;
    padding: var(--space-3xl) clamp(var(--space-sm), 3vw, var(--space-lg));
  }
  .notfound__code { margin: 0; color: var(--reticle); font: var(--weight-black) clamp(4rem, 12vw, 7rem) / 0.85 var(--font-display); font-stretch: var(--stretch-extended); letter-spacing: -0.04em; }
  .notfound h1 { margin-top: var(--space-md); font-size: clamp(var(--text-2xl), 1.4rem + 2.4vw, var(--text-4xl)); font-stretch: var(--stretch-wide); }
  .notfound__body { max-width: 36rem; margin: var(--space-md) 0 0; color: var(--ink-muted); font-size: var(--text-lg); }
  .notfound__routes { margin: var(--space-xl) 0 0; padding: 0; list-style: none; border-bottom: 1px solid var(--rule-strong); }
  .notfound__routes li { position: relative; display: grid; gap: var(--space-3xs); padding: var(--space-md) 0; border-top: 1px solid var(--rule-strong); }
  .notfound__routes a { display: inline-flex; gap: var(--space-xs); align-items: baseline; color: var(--ink); font: var(--weight-bold) var(--text-xl) var(--font-display); text-decoration: none; }
  /* The whole row answers the click, not just its words. */
  .notfound__routes a::after { content: ''; position: absolute; inset: 0; }
  .notfound__routes a span { transition: translate var(--dur-base) var(--ease-out); }
  .notfound__routes li:hover a { color: var(--accent); }
  .notfound__routes li:hover a span { translate: 0.3rem 0; }
  .notfound__routes li > span { color: var(--ink-muted); font-size: var(--text-sm); }

  .notfound__chart { position: relative; margin: 0; aspect-ratio: 1; }
  .notfound__chart svg { display: block; width: 100%; height: 100%; }
  .notfound__chart line { stroke: var(--grid); stroke-width: 1; stroke-dasharray: 1 3; vector-effect: non-scaling-stroke; }
  .notfound__neat { fill: none; stroke: var(--rule-strong); vector-effect: non-scaling-stroke; }
  /* Where the page should be: an empty field, ringed. */
  .notfound__gap { fill: var(--plate); stroke: var(--reticle); stroke-width: 1.5; stroke-dasharray: 4 6; vector-effect: non-scaling-stroke; }
  .notfound__reticle { left: 50%; top: 50%; width: 3.2rem; }
  @media (prefers-reduced-motion: no-preference) {
    .notfound__reticle { animation: sweep 2.4s var(--ease-in-out) 0.3s 3 both; }
  }
  @keyframes sweep {
    0%, 100% { left: 50%; top: 50%; }
    25% { left: 28%; top: 34%; }
    50% { left: 70%; top: 30%; }
    75% { left: 62%; top: 72%; }
  }

  @media (max-width: 50rem) {
    .notfound { grid-template-columns: minmax(0, 1fr); }
    .notfound__chart { order: -1; max-width: 14rem; }
  }
</style>
