---
import { localePath, type Locale } from '~/lib/i18n'

interface Props { locale: Locale }
const { locale } = Astro.props
const copy = locale === 'pt-br'
  ? {
      title: 'Página não encontrada',
      body: 'O endereço pode ter mudado. Retome o curso por uma das rotas abaixo ou use a busca para localizar uma aula.',
      tracks: 'Ver todas as trilhas',
      explore: 'Explorar a anatomia de um LLM',
      start: 'Começar pela aula 0.1',
    }
  : {
      title: 'Page not found',
      body: 'The address may have changed. Pick a route below to get back to the course, or use search to find a lesson.',
      tracks: 'View all tracks',
      explore: 'Explore the anatomy of an LLM',
      start: 'Start at lesson 0.1',
    }
---

<section class="notfound">
  <div class="notfound__copy">
    <h1>{copy.title}</h1>
    <p>{copy.body}</p>
    <ul class="notfound__routes">
      <li>
        <a class="button button--primary" href={localePath(locale, '/tracks/')}>{copy.tracks} <span aria-hidden="true">→</span></a>
      </li>
      <li>
        <a href={localePath(locale, '/explore/')}>{copy.explore} <span aria-hidden="true">→</span></a>
      </li>
      <li>
        <a href={localePath(locale, '/lessons/0-orientation-and-foundations/0.1-what-is-a-language-model/')}>{copy.start} <span aria-hidden="true">→</span></a>
      </li>
    </ul>
  </div>

  <div class="notfound__field" aria-hidden="true">
    <svg class="notfound__scope" viewBox="0 0 480 360" fill="none" focusable="false">
      <path class="notfound__axis" d="M240 13v334M13 180h454" />
      <circle class="notfound__ring" cx="240" cy="180" r="137" />
      <circle class="notfound__ring" cx="240" cy="180" r="102" />
      <path class="notfound__ticks" d="M240 38v16m0 252v16M98 180h16m252 0h16M139 79l12 12m178 178 12 12M139 281l12-12M329 91l12-12" />
      <path class="notfound__signal" pathLength="1" d="M13 250h56l17-15 17 15h14l15-40 19 57 18-17h17" />
      <path class="notfound__gap" d="M186 250h108" />
      <path class="notfound__signal" pathLength="1" d="M294 250h41l12-19 13 19h107" />
      <circle class="notfound__fault" cx="240" cy="250" r="6" />
    </svg>
    <span class="notfound__code" data-numeric>404</span>
  </div>
</section>

<style>
  .notfound {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 6vw, 6rem);
    align-items: center;
    max-width: var(--shell-max);
    margin-inline: auto;
    padding: clamp(2rem, 8vw, 7rem) var(--space-lg);
  }

  .notfound h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.65rem, 1.75rem + 3.2vw, 5rem);
    font-weight: var(--weight-black);
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .notfound p {
    max-width: 43ch;
    margin: var(--space-sm) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  .notfound__routes {
    display: grid;
    justify-items: start;
    gap: var(--space-2xs);
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .notfound__routes a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-block-size: 2.75rem;
    font-weight: var(--weight-semibold);
  }

  .notfound__routes a span { flex: none; transition: translate var(--dur-fast) var(--ease-out); }
  .notfound__routes a:hover span, .notfound__routes a:focus-visible span { translate: 0.2rem 0; }

  .notfound__field {
    color-scheme: dark;
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    background:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px),
      var(--night);
    background-position: center;
    background-size: 2rem 2rem, 2rem 2rem, auto;
  }

  .notfound__scope { position: absolute; inset: 0; width: 100%; height: 100%; }
  .notfound__scope > * { vector-effect: non-scaling-stroke; }
  .notfound__axis, .notfound__ring { stroke: var(--rule-strong); }
  .notfound__axis { stroke-dasharray: 3 5; }
  .notfound__ticks { stroke: var(--ink-muted); }
  .notfound__signal { stroke: var(--tier-core); stroke-width: 1.5; }
  .notfound__gap { stroke: var(--reticle); stroke-dasharray: 2 6; }
  .notfound__fault { fill: var(--night); stroke: var(--reticle); stroke-width: 2; }
  .notfound__code {
    translate: 0 -0.09em;
    color: var(--ink);
    font: var(--weight-black) clamp(4rem, 10vw, 10rem) / 1 var(--font-display);
    letter-spacing: -0.08em;
    font-stretch: var(--stretch-extended);
    margin-inline-end: 0.08em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .notfound__signal { stroke-dasharray: 1; animation: draw-line var(--dur-focal) var(--ease-out) both; }
  }

  @media (max-width: 50rem) {
    .notfound { grid-template-columns: minmax(0, 1fr); }
    .notfound__field { width: 100%; max-width: 35rem; order: -1; }
  }

  @media (max-width: 42rem) {
    .notfound { padding-inline: var(--space-sm); }
  }
</style>
