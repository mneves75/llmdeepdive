---
/**
 * The bilingual AI Engineering Roadmap & 100-Day Study Path.
 *
 * Every lesson id declared in `roadmap-data.ts` is resolved against the real
 * Astro content collection here at build time: a missing or renamed lesson
 * throws during `astro build` instead of shipping a 404.
 *
 * Zero JavaScript is added for view switching or disclosures: the three study
 * modes use native `.visually-hidden` radios + sibling selectors (same pattern
 * as Home's mechanics plate), and level details use native `<details>` with
 * progressive `::details-content` transitions under reduced-motion guards.
 * Device-local completion progress is filled after render by `progress-client`.
 */
import { lessonPath, type LessonEntry } from '~/lib/content'
import { positionOf, tierLabels, type Locale } from '~/lib/i18n'
import {
  DEFENSE_DRILLS,
  HUNDRED_DAY_STAGES,
  PORTFOLIO_BLUEPRINTS,
  PROOF_RUBRIC,
  ROADMAP_LEVELS,
} from '~/lib/roadmap-data'

interface Props {
  locale: Locale
  lessons: LessonEntry[]
}

const { locale, lessons } = Astro.props
const isPt = locale === 'pt-br'
const lessonMap = new Map(lessons.map((lesson) => [lesson.data.id, lesson]))

function resolveLessons(ids: readonly string[], context: string): LessonEntry[] {
  return ids.map((id) => {
    const found = lessonMap.get(id)
    if (!found) throw new Error(`Roadmap (${locale}, ${context}): unknown lesson id "${id}"`)
    return found
  })
}

const resolvedLevels = ROADMAP_LEVELS.map((level) => ({
  ...level,
  resolved: resolveLessons(level.lessonIds, level.code),
}))

const resolvedStages = HUNDRED_DAY_STAGES.map((stage) => ({
  ...stage,
  resolved: resolveLessons(stage.lessonIds, `100d-${stage.index}`),
}))

const resolvedBlueprints = PORTFOLIO_BLUEPRINTS.map((bp) => ({
  ...bp,
  resolved: resolveLessons(bp.lessonIds, bp.id),
}))

const resolvedDrills = DEFENSE_DRILLS.map((drill) => ({
  ...drill,
  resolved: resolveLessons(drill.lessonIds, drill.id),
}))

const uniqueRoadmapIds = [...new Set(ROADMAP_LEVELS.flatMap((level) => level.lessonIds))]
const uniqueHundredDayIds = [...new Set(HUNDRED_DAY_STAGES.flatMap((stage) => stage.lessonIds))]
const phases = [...new Set(ROADMAP_LEVELS.map((level) => level.phase[locale]))]

const copy = isPt
  ? {
      title: 'Roteiro de engenharia de IA',
      lede: 'Das primeiras aulas sobre modelos de linguagem à defesa de uma arquitetura de produção, siga as aulas e os projetos em uma sequência de dezesseis níveis.',
      modeLabel: 'Modos de estudo do roteiro',
      tabFull: 'Roteiro completo (16 níveis)',
      tab100: 'Trilha acelerada (100 dias)',
      tabProof: 'Portfólio e defesa técnica',
      fullTitle: 'Todos os 16 níveis em ordem',
      fullSub: 'Comece onde estiver. Cada nível agrupa as aulas exatas que cobrem o mecanismo, o projeto final e o que entregar para provar domínio.',
      hundredTitle: '100 dias de Engenharia de IA',
      hundredSub: 'Uma sequência prática em seis etapas cobrindo o núcleo de produção — da inferência e APIs até RAG híbrido, agentes auditados e LLMOps.',
      proofTitle: 'Prova de engenharia e defesa de arquitetura',
      proofSub: 'O que separa uma demonstração de um sistema de produção: rubrica verificável, projetos de portfólio e simulações de incidentes.',
      rubricHeading: 'Rubrica de prova para cada projeto',
      projectsHeading: 'Cinco arquiteturas de portfólio',
      drillsHeading: 'Simulações de depuração e defesa',
      progressTemplate: '{n} de {m} aulas concluídas',
      deliverables: 'Entregáveis e critérios',
      capstone: 'Entrega do nível',
      milestone: 'Marco da etapa',
      problem: 'Problema',
      proof: 'Critério de prova',
      firstCheck: 'Primeiro diagnóstico',
      lessonsHeading: 'Aulas ligadas neste bloco',
      openDetails: 'Ver entregáveis, projeto e aulas',
      done: 'Concluída neste dispositivo',
      tierPrefix: 'Nível',
    }
  : {
      title: 'AI engineering roadmap',
      lede: 'Follow sixteen levels of lessons and builds, from language model foundations to defending the architecture of a production system.',
      modeLabel: 'Roadmap study views',
      tabFull: 'Full roadmap (16 levels)',
      tab100: '100-day accelerated path',
      tabProof: 'Portfolio & system defense',
      fullTitle: 'All 16 levels, in order',
      fullSub: 'Start where you are. Each level links directly to the lessons that teach the mechanism, lists concrete deliverables, and names the build that proves it.',
      hundredTitle: '100 Days of AI Engineering',
      hundredSub: 'A six-stage accelerated path through the production core — from inference and LLM APIs to hybrid RAG, audited agents and LLMOps.',
      proofTitle: 'Engineering proof & architecture defense',
      proofSub: 'What separates a weekend demo from a production system: a verifiable proof rubric, five portfolio blueprints, and production incident drills.',
      rubricHeading: 'Proof rubric for every build',
      projectsHeading: 'Five portfolio blueprints',
      drillsHeading: 'Production debugging & defense drills',
      progressTemplate: '{n} of {m} lessons complete',
      deliverables: 'Deliverables & checks',
      capstone: 'Level capstone',
      milestone: 'Stage milestone',
      problem: 'Problem',
      proof: 'Proof bar',
      firstCheck: 'First diagnostic move',
      lessonsHeading: 'Linked lessons in this unit',
      openDetails: 'Inspect deliverables, capstone & lessons',
      done: 'Completed on this device',
      tierPrefix: 'Tier',
    }

const tiers = tierLabels[locale]
---

<div class="roadmap">
  <header class="roadmap__head">
    <div>
      <h1>{copy.title}</h1>
      <p>{copy.lede}</p>
    </div>
    <ol class="roadmap__sequence">
      {phases.map((phase) => <li>{phase}</li>)}
    </ol>
  </header>

  <div class="roadmap__frame" role="group" aria-label={copy.modeLabel}>
    <input class="roadmap__radio visually-hidden" type="radio" name="roadmap-view" id="roadmap-view-full" checked />
    <input class="roadmap__radio visually-hidden" type="radio" name="roadmap-view" id="roadmap-view-100" />
    <input class="roadmap__radio visually-hidden" type="radio" name="roadmap-view" id="roadmap-view-proof" />

    <div class="roadmap__tabs" data-pagefind-ignore>
      <label class="roadmap__tab" for="roadmap-view-full">
        <span>{copy.tabFull}</span>
        <b class="roadmap__tab-progress" data-course-progress data-lesson-ids={uniqueRoadmapIds.join(' ')} data-template="{n}/{m}" hidden><span data-count></span></b>
      </label>
      <label class="roadmap__tab" for="roadmap-view-100">
        <span>{copy.tab100}</span>
        <b class="roadmap__tab-progress" data-course-progress data-lesson-ids={uniqueHundredDayIds.join(' ')} data-template="{n}/{m}" hidden><span data-count></span></b>
      </label>
      <label class="roadmap__tab" for="roadmap-view-proof">
        <span>{copy.tabProof}</span>
      </label>
    </div>

    <div class="roadmap__panels">
      <!-- Panel 1: Full 16-level roadmap -->
      <section class="roadmap__panel roadmap__panel--full" aria-labelledby="roadmap-full-heading">
        <header class="roadmap__section-head">
          <h2 id="roadmap-full-heading">{copy.fullTitle}</h2>
          <p>{copy.fullSub}</p>
        </header>

        <ol class="roadmap__levels">
          {resolvedLevels.map((level) => (
            <li class="level" data-tier={level.tier}>
              <div class="level__header">
                <span class="level__code" data-numeric>{level.code}</span>
                <div class="level__intro">
                  <p class="level__meta">
                    <span>{level.phase[locale]}</span> · <span class="level__tier">{tiers[level.tier]}</span>
                    <span
                      class="level__progress"
                      data-course-progress
                      data-lesson-ids={level.lessonIds.join(' ')}
                      data-template={` · ${copy.progressTemplate}`}
                      hidden
                    ><span data-count></span></span>
                  </p>
                  <h3>{level.title[locale]}</h3>
                  <p class="level__goal">{level.goal[locale]}</p>
                  {level.resolved[0] && (
                    <a class="level__start" data-roadmap-start href={lessonPath(locale, level.resolved[0])}>
                      <span>{locale === 'pt-br' ? 'Primeira aula' : 'First lesson'}</span>
                      <strong>{level.resolved[0].data.title}</strong>
                      <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </div>

              <details class="level__details">
                <summary>{copy.openDetails} ({level.resolved.length})</summary>
                <div class="level__body">
                  <div class="level__deliverables">
                    <p class="level__sublabel">{copy.deliverables}</p>
                    <ul>
                      {level.deliverables[locale].map((item) => <li>{item}</li>)}
                    </ul>
                    <p class="level__capstone"><strong>{copy.capstone}:</strong> {level.capstone[locale]}</p>
                  </div>

                  <div class="level__lessons-wrap">
                    <p class="level__sublabel">{copy.lessonsHeading}</p>
                    <ol class="roadmap__lesson-list">
                      {level.resolved.map((lesson) => (
                        <li data-lesson-key={`${locale}:${lesson.data.id}`} data-tier={lesson.data.tier}>
                          <span class="star-mark" aria-hidden="true"></span>
                          <span class="roadmap__pos" data-numeric>{positionOf(lesson.data.id)}</span>
                          <a href={lessonPath(locale, lesson)}>{lesson.data.title}</a>
                          <span class="visually-hidden roadmap__done">{copy.done}</span>
                        </li>
                      ))}
                    </ol>
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ol>
      </section>

      <!-- Panel 2: 100-Day Accelerated Path -->
      <section class="roadmap__panel roadmap__panel--100" aria-labelledby="roadmap-100-heading">
        <header class="roadmap__section-head">
          <h2 id="roadmap-100-heading">{copy.hundredTitle}</h2>
          <p>{copy.hundredSub}</p>
        </header>

        <ol class="roadmap__stages">
          {resolvedStages.map((stage) => (
            <li class="stage" data-tier={stage.tier}>
              <header class="stage__head">
                <span class="stage__days" data-numeric>{stage.days[locale]}</span>
                <div>
                  <h3>{stage.title[locale]}</h3>
                  <p class="stage__focus">{stage.focus[locale]}</p>
                  <p class="stage__milestone"><strong>{copy.milestone}:</strong> {stage.milestone[locale]}</p>
                  <p
                    class="stage__progress"
                    data-course-progress
                    data-lesson-ids={stage.lessonIds.join(' ')}
                    data-template={copy.progressTemplate}
                    hidden
                  ><span data-count></span></p>
                </div>
              </header>
              <ol class="roadmap__lesson-list roadmap__lesson-list--grid">
                {stage.resolved.map((lesson) => (
                  <li data-lesson-key={`${locale}:${lesson.data.id}`} data-tier={lesson.data.tier}>
                    <span class="star-mark" aria-hidden="true"></span>
                    <span class="roadmap__pos" data-numeric>{positionOf(lesson.data.id)}</span>
                    <a href={lessonPath(locale, lesson)}>{lesson.data.title}</a>
                    <span class="visually-hidden roadmap__done">{copy.done}</span>
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ol>
      </section>

      <!-- Panel 3: Portfolio Blueprints & Defense Drills -->
      <section class="roadmap__panel roadmap__panel--proof" aria-labelledby="roadmap-proof-heading">
        <header class="roadmap__section-head">
          <h2 id="roadmap-proof-heading">{copy.proofTitle}</h2>
          <p>{copy.proofSub}</p>
        </header>

        <div class="rubric">
          <h3>{copy.rubricHeading}</h3>
          <ol class="rubric__list">
            {PROOF_RUBRIC[locale].map((item) => <li>{item}</li>)}
          </ol>
        </div>

        <h3 class="roadmap__group-title">{copy.projectsHeading}</h3>
        <ol class="blueprints">
          {resolvedBlueprints.map((bp) => (
            <li class="blueprint" data-tier={bp.tier}>
              <h4>{bp.title[locale]}</h4>
              <p><strong>{copy.problem}:</strong> {bp.problem[locale]}</p>
              <p><strong>{copy.proof}:</strong> {bp.proof[locale]}</p>
              <ol class="roadmap__lesson-list">
                {bp.resolved.map((lesson) => (
                  <li data-lesson-key={`${locale}:${lesson.data.id}`} data-tier={lesson.data.tier}>
                    <span class="star-mark" aria-hidden="true"></span>
                    <span class="roadmap__pos" data-numeric>{positionOf(lesson.data.id)}</span>
                    <a href={lessonPath(locale, lesson)}>{lesson.data.title}</a>
                    <span class="visually-hidden roadmap__done">{copy.done}</span>
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ol>

        <h3 class="roadmap__group-title">{copy.drillsHeading}</h3>
        <ol class="drills">
          {resolvedDrills.map((drill) => (
            <li class="drill">
              <p class="drill__scenario">{drill.scenario[locale]}</p>
              <details class="level__details">
                <summary>{copy.firstCheck}</summary>
                <div class="drill__body">
                  <p>{drill.firstCheck[locale]}</p>
                  <ol class="roadmap__lesson-list">
                    {drill.resolved.map((lesson) => (
                      <li data-lesson-key={`${locale}:${lesson.data.id}`} data-tier={lesson.data.tier}>
                        <span class="star-mark" aria-hidden="true"></span>
                        <span class="roadmap__pos" data-numeric>{positionOf(lesson.data.id)}</span>
                        <a href={lessonPath(locale, lesson)}>{lesson.data.title}</a>
                        <span class="visually-hidden roadmap__done">{copy.done}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              </details>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>
</div>

<style>
  .roadmap {
    max-width: var(--shell-max);
    margin-inline: auto;
    padding: clamp(var(--space-lg), 5vw, var(--space-2xl)) clamp(1rem, 5vw, 4.5rem) var(--space-3xl);
  }
  .roadmap__head {
    color-scheme: dark;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: var(--space-lg) var(--space-2xl);
    align-items: center;
    padding: clamp(1.35rem, 5vw, 4.5rem);
    border-top: 3px solid var(--tier-core);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    background: var(--night);
    color: var(--ink-on-night);
  }
  .roadmap h1 {
    max-width: 14ch;
    font-size: clamp(2.65rem, 6vw, 6rem);
    font-weight: var(--weight-black);
    font-stretch: 90%;
    letter-spacing: -0.044em;
  }
  .roadmap__head p {
    max-width: 43ch;
    margin: var(--space-md) 0 0;
    color: var(--ink-muted-on-night);
    font-size: var(--text-lg);
  }
  .roadmap__sequence { position: relative; display: grid; gap: 0.35rem; margin: 0; padding: 0; list-style: none; }
  .roadmap__sequence::before { content: ''; position: absolute; inset: 0.85rem auto 0.85rem 0.27rem; width: 1px; background: var(--tier-core); transform-origin: 50% 0; }
  .roadmap__sequence li { display: flex; align-items: center; gap: var(--space-xs); min-height: 1.75rem; color: var(--ink-on-night); font-size: var(--text-sm); }
  .roadmap__sequence li::before { content: ''; z-index: 1; flex: 0 0 0.58rem; aspect-ratio: 1; border: 1px solid var(--tier-core); border-radius: 50%; background: var(--night); }
  .roadmap__sequence li:last-child::before { background: var(--tier-core); }

  .roadmap__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--rule-strong);
    background: var(--rule-strong);
  }
  .roadmap__tab {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-xs);
    min-height: 3.5rem;
    padding: 0.75rem clamp(0.9rem, 2vw, 1.4rem);
    border-top: 3px solid transparent;
    background: var(--plate);
    color: var(--ink);
    font: var(--weight-semibold) var(--text-sm) var(--font-ui);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .roadmap__tab:hover { background: var(--plate-raised); }
  .roadmap__tab-progress { color: var(--success); font: var(--weight-semibold) var(--text-xs) var(--font-data); }

  #roadmap-view-full:checked ~ .roadmap__tabs label[for='roadmap-view-full'],
  #roadmap-view-100:checked ~ .roadmap__tabs label[for='roadmap-view-100'],
  #roadmap-view-proof:checked ~ .roadmap__tabs label[for='roadmap-view-proof'] {
    border-top-color: var(--reticle);
    background: var(--plate-raised);
    color: var(--reticle);
  }
  #roadmap-view-full:checked ~ .roadmap__tabs label[for='roadmap-view-full'] .roadmap__tab-progress,
  #roadmap-view-100:checked ~ .roadmap__tabs label[for='roadmap-view-100'] .roadmap__tab-progress {
    color: var(--reticle);
  }
  #roadmap-view-full:focus-visible ~ .roadmap__tabs label[for='roadmap-view-full'],
  #roadmap-view-100:focus-visible ~ .roadmap__tabs label[for='roadmap-view-100'],
  #roadmap-view-proof:focus-visible ~ .roadmap__tabs label[for='roadmap-view-proof'] {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .roadmap__panel { display: none; padding-top: clamp(var(--space-lg), 4vw, var(--space-2xl)); }
  #roadmap-view-full:checked ~ .roadmap__panels .roadmap__panel--full,
  #roadmap-view-100:checked ~ .roadmap__panels .roadmap__panel--100,
  #roadmap-view-proof:checked ~ .roadmap__panels .roadmap__panel--proof {
    display: block;
  }

  .roadmap__section-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.65fr); align-items: end; gap: var(--space-sm) var(--space-xl); margin-bottom: var(--space-lg); }
  .roadmap__section-head h2 { font-size: clamp(1.9rem, 3.85vw, 3.75rem); font-weight: var(--weight-black); letter-spacing: -0.036em; }
  .roadmap__section-head p { max-width: 52ch; margin: 0; color: var(--ink-muted); }

  .roadmap__levels, .roadmap__stages, .blueprints, .drills {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .level, .stage, .blueprint, .drill { padding: clamp(var(--space-sm), 2.5vw, var(--space-lg)); border: 1px solid var(--rule-strong); border-top: 2px solid var(--tier, var(--tier-core)); border-radius: var(--radius-sm); }

  .level__header, .stage__head {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--space-md);
    align-items: start;
  }
  .level__code {
    color: var(--tier);
    font: var(--weight-black) clamp(2.3rem, 4vw, 4rem) / 0.9 var(--font-display);
    letter-spacing: -0.055em;
  }
  .stage__days {
    color: var(--tier);
    font: var(--weight-bold) var(--text-sm) / 1.3 var(--font-data);
    padding-top: 0.25rem;
  }
  .level__meta {
    margin: 0 0 var(--space-3xs);
    color: var(--ink-muted);
    font-size: var(--text-xs);
  }
  .level__start {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.3rem 0.65rem;
    width: fit-content; min-height: 2.75rem; padding: 0.55rem 0.75rem; margin-block-start: 0.8rem;
    border: 1px solid var(--rule-strong); border-radius: var(--radius-sm); color: var(--reticle);
    font-size: var(--text-sm); text-decoration: none; overflow-wrap: anywhere;
  }
  .level__start:hover { background: var(--plate-raised); }
  .level__start > span:first-child { color: var(--ink-muted); }
  .level__tier { color: var(--tier); font-weight: var(--weight-semibold); }
  .level__progress, .stage__progress { color: var(--success); font-weight: var(--weight-semibold); font-size: var(--text-xs); }
  .level h3, .stage h3, .blueprint h4 {
    margin: 0;
    font-size: clamp(var(--text-xl), 2.45vw, var(--text-3xl));
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .level__goal, .stage__focus, .stage__milestone, .blueprint p {
    max-width: 66ch;
    margin: var(--space-2xs) 0 0;
    color: var(--ink-muted);
  }
  .stage__milestone strong, .blueprint strong, .level__capstone strong { color: var(--ink); }

  /* Native details disclosure with progressive ::details-content transition
     (modern-web-guidance: accordion). Marker sits directly before label text. */
  .level__details {
    margin-top: var(--space-md);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--plate-raised);
  }
  .level > .level__details { margin-inline-start: calc(7rem + var(--space-md)); }
  .level__details > summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.65rem var(--space-md);
    color: var(--ink);
    font: var(--weight-semibold) var(--text-sm) var(--font-ui);
    cursor: pointer;
  }
  .level__details > summary::-webkit-details-marker { display: none; }
  .level__details > summary::before {
    content: '';
    inline-size: 0.5rem;
    block-size: 0.5rem;
    flex-shrink: 0;
    border-inline-end: 2px solid var(--ink-muted);
    border-block-end: 2px solid var(--ink-muted);
    rotate: -45deg;
  }
  .level__details[open] > summary::before { rotate: 45deg; }

  .level__details::details-content {
    interpolate-size: allow-keywords;
    overflow: clip;
    contain: layout;
  }
  .level__details:not([open])::details-content {
    block-size: 0;
    visibility: hidden;
  }
  .level__details[open]::details-content {
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .roadmap__sequence::before { animation: roadmap-draw var(--dur-focal) var(--ease-out) both; }
    .roadmap__panel { animation: roadmap-arrival var(--dur-slow) var(--ease-out) both; }
    .level__details > summary::before { transition: rotate 0.2s var(--ease-out); }
    .level__details::details-content {
      transition: block-size, content-visibility, visibility, display;
      transition-duration: 0.26s;
      transition-timing-function: var(--ease-out);
      transition-behavior: allow-discrete;
    }
  }
  @keyframes roadmap-draw { from { scale: 1 0; } }
  @keyframes roadmap-arrival { from { translate: 0 0.5rem; } }

  .level__body {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-lg);
    padding: 0 var(--space-md) var(--space-md);
    border-top: 1px solid var(--rule);
  }
  .level__sublabel {
    margin: var(--space-md) 0 var(--space-xs);
    color: var(--ink);
    font: var(--weight-semibold) var(--text-xs) var(--font-ui);
  }
  .level__deliverables ul { margin: 0; padding-inline-start: 1.2rem; color: var(--ink-muted); display: grid; gap: 0.35rem; }
  .level__capstone { margin: var(--space-sm) 0 0; color: var(--ink-muted); font-size: var(--text-sm); }

  .roadmap__lesson-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
