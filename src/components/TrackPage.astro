---
/**
 * One track: its constellation, what it covers, how long it takes, where to
 * start (or continue), then every lesson in order. Shared by both locales.
 */
import TrackListing from '~/components/TrackListing.astro'
import ConstellationChart from '~/components/ConstellationChart.astro'
import { lessonPath, readingMinutes, type LessonEntry, type TrackEntry } from '~/lib/content'
import { positionOf, tierLabels, type Locale } from '~/lib/i18n'

interface Props {
  locale: Locale
  track: TrackEntry
  lessons: LessonEntry[]
  /** The next track in course order, if any. */
  nextTrack?: TrackEntry
}

const { locale, track, lessons, nextTrack } = Astro.props
const isPt = locale === 'pt-br'
const base = isPt ? '/pt-br' : ''
const ordered = [...lessons].sort((left, right) => left.data.order - right.data.order)
const first = ordered[0]
const minutes = ordered.reduce((sum, lesson) => sum + readingMinutes(lesson), 0)
const hours = Math.floor(minutes / 60)
const rest = minutes % 60
const duration = hours === 0 ? `${rest} min` : rest === 0 ? `${hours} h` : `${hours} h ${rest} min`
const copy = isPt
  ? {
      back: 'Todas as trilhas', track: 'Trilha', lessons: 'aulas', reading: 'de leitura',
      start: `Começar pela aula ${first ? positionOf(first.data.id) : ''}`, continue: 'Continuar:',
      progress: '{n} de {m} concluídas neste dispositivo', next: 'Próxima trilha',
    }
  : {
      back: 'All tracks', track: 'Track', lessons: 'lessons', reading: 'of reading',
      start: `Start with lesson ${first ? positionOf(first.data.id) : ''}`, continue: 'Continue:',
      progress: '{n} of {m} completed on this device', next: 'Next track',
    }
---

<div class="track" data-tier={track.data.tier}>
  <header class="track__hero">
    <div class="track__text">
      <a class="track__back" href={`${base}/tracks/`} data-pagefind-ignore><span aria-hidden="true">←</span> {copy.back}</a>
      <p class="track__number" aria-hidden="true" data-numeric>{positionOf(track.data.id)}</p>
      <h1 style={`view-transition-name: track-title-${positionOf(track.data.id)}`}>
        <span class="visually-hidden">{copy.track} {positionOf(track.data.id)}: </span>{track.data.title}
      </h1>
      <p class="track__summary">{track.data.summary}</p>
      <p class="track__facts">
        <span class="track__tier">{tierLabels[locale][track.data.tier]}</span>
        <span>{ordered.length} {copy.lessons}</span>
        <span data-numeric>≈ {duration} {copy.reading}</span>
      </p>
      <div class="track__actions">
        {first && <a class="button button--primary" href={lessonPath(locale, first)}>{copy.start}<span aria-hidden="true">→</span></a>}
        <p class="track__continue" data-continue hidden>
          {copy.continue} <a data-continue-link href={first ? lessonPath(locale, first) : `${base}/tracks/`}><b data-continue-position data-numeric></b> <span data-continue-title></span></a>
        </p>
      </div>
      <p class="track__progress" data-course-progress data-lesson-ids={ordered.map((lesson) => lesson.data.id).join(' ')} data-template={copy.progress} hidden>
        <span class="track__meter" aria-hidden="true"><i></i></span><span data-count></span>
      </p>
    </div>
    <div class="track__chart">
      <ConstellationChart locale={locale} trackId={track.data.id} lessons={ordered} variant="track" />
    </div>
  </header>

  <TrackListing locale={locale} tracks={[track]} lessons={ordered} detail="full" />

  {nextTrack && (
    <a class="track__next" href={`${base}/tracks/${nextTrack.data.id}/`} data-tier={nextTrack.data.tier} data-pagefind-ignore>
      <span>{copy.next} →</span>
      <strong><b data-numeric>{positionOf(nextTrack.data.id)}</b> <span class="plate-name">{nextTrack.data.title}</span></strong>
    </a>
  )}
</div>

<style>
  .track { max-width: 78rem; margin-inline: auto; padding: var(--space-xl) clamp(var(--space-sm), 3vw, var(--space-lg)) var(--space-3xl); }
  .track__hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-2xl); align-items: center; padding-bottom: var(--space-2xl); }
  .track__back { display: inline-flex; align-items: center; gap: var(--space-2xs); min-height: 2.75rem; color: var(--ink-muted); font: var(--weight-semibold) var(--text-sm) var(--font-ui); text-decoration: none; }
  .track__back:hover { color: var(--ink); }
  .track__number { margin: var(--space-lg) 0 0; color: var(--tier); font: var(--weight-black) clamp(4rem, 3rem + 5vw, 7.5rem) / 0.8 var(--font-display); font-stretch: var(--stretch-extended); letter-spacing: -0.04em; }
  .track h1 { margin-top: var(--space-md); font-size: clamp(var(--text-2xl), 1.4rem + 2.6vw, var(--text-4xl)); font-stretch: var(--stretch-wide); hyphens: auto; }
  .track__summary { max-width: 36rem; margin: var(--space-md) 0 0; color: var(--ink-muted); font-size: var(--text-lg); line-height: 1.5; }
  .track__facts { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-md); margin: var(--space-md) 0 0; color: var(--ink-muted); font-size: var(--text-sm); }
  .track__tier { color: var(--tier); font-weight: var(--weight-semibold); }
  .track__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm) var(--space-md); margin-top: var(--space-lg); }
  .track__continue { margin: 0; color: var(--ink-muted); font-size: var(--text-sm); }
  .track__continue a { color: var(--ink); font-weight: var(--weight-semibold); }
  .track__continue b { color: var(--reticle); font-family: var(--font-data); }
  .track__progress { display: flex; align-items: center; gap: var(--space-sm); margin: var(--space-md) 0 0; color: var(--success); font: var(--weight-semibold) var(--text-xs) var(--font-ui); }
  /* A measured scale, filled to the share this device has completed. */
  .track__meter { position: relative; width: 8rem; height: 4px; border-radius: 2px; background: var(--rule); overflow: hidden; }
  .track__meter i { position: absolute; inset: 0; background: var(--success); transform-origin: 0 50%; scale: var(--share, 0) 1; transition: scale var(--dur-focal) var(--ease-out); }
  .track__chart { min-width: 0; overflow-x: clip; }

  .track__next {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-2xl);
    padding: var(--space-lg);
    border: 1px solid color-mix(in srgb, var(--tier) 55%, var(--rule));
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--tier) 5%, var(--plate));
    color: var(--ink);
    text-decoration: none;
  }
  .track__next:hover { color: var(--ink); background: var(--plate-raised); }
  .track__next > span { color: var(--tier); font: var(--weight-semibold) var(--text-sm) var(--font-ui); }
  .track__next strong { display: flex; align-items: baseline; gap: var(--space-sm); font-size: var(--text-lg); }
  .track__next b { color: var(--tier); font: var(--weight-bold) var(--text-2xl) / 1 var(--font-display); }

  @media (max-width: 56rem) {
    .track__hero { grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
    .track__chart { max-width: 34rem; }
  }
</style>
