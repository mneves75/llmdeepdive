---
/**
 * The whole curriculum as one star chart (home, tracks index).
 *
 * Server-rendered and complete on its own: every lesson a star at its sky
 * position, every track a constellation drawn in course order, the course
 * route bridging one constellation to the next. Where WebGL is available,
 * `sky-client` lifts this exact chart onto a turning sphere and keeps the
 * HTML names pinned to their constellations by updating `--x`/`--y`.
 *
 * Names are HTML links laid over the chart (a label in SVG does not wrap and
 * pt-BR runs 15–25% longer); the stars are a picture and hidden from
 * assistive tech. Ambient motion obeys the pause control, which needs no
 * script: the paused state is a checkbox and `:has()`.
 */
import { positionOf, type Locale } from '~/lib/i18n'
import { constellationPath, SKY_HEIGHT, SKY_WIDTH } from '~/lib/sky'
import { getSky } from '~/lib/sky-data'
import { trackPath } from '~/lib/content'

interface Props {
  locale: Locale
  /** Accessible name of the chart's navigation. */
  label: string
  variant: 'hero' | 'index'
}

const { locale, label, variant } = Astro.props
const sky = await getSky(locale)
const copy = locale === 'pt-br'
  ? { animate: 'Animar o céu', key: 'Legenda do mapa', open: 'Aula', done: 'Concluída neste dispositivo', line: 'Ordem do curso', bridge: 'Para a próxima trilha', bright: 'Base de muitas aulas' }
  : { animate: 'Animate the sky', key: 'Chart key', open: 'Lesson', done: 'Completed on this device', line: 'Course order', bridge: 'On to the next track', bright: 'Many lessons build on it' }
const pct = (value: number, span: number): string => `${((value / span) * 100).toFixed(3)}%`

// The course route: each constellation's own lines, then a bridge from its
// last star to the next constellation's first.
const bridges = sky.constellations.slice(1).map((constellation, index) => {
  const from = sky.constellations[index]?.stars.at(-1)
  const to = constellation.stars[0]
  return from && to ? `M${from.x} ${from.y} L${to.x} ${to.y}` : ''
}).filter(Boolean)
const route = sky.constellations.map((constellation) => constellationPath(constellation)).join(' ')
  .replace(/ M/gu, ' L')

// The graticule every 80 units, inside a neatline ticked every 20: an atlas
// plate's frame, which locates the figures without papering the chart.
const STEP = 80
const TICK = 20
const meridians = Array.from({ length: Math.floor(SKY_WIDTH / STEP) - 1 }, (_, index) => (index + 1) * STEP)
const parallels = Array.from({ length: Math.floor(SKY_HEIGHT / STEP) - 1 }, (_, index) => (index + 1) * STEP)
const ticksX = Array.from({ length: Math.floor(SKY_WIDTH / TICK) - 1 }, (_, index) => (index + 1) * TICK)
const ticksY = Array.from({ length: Math.floor(SKY_HEIGHT / TICK) - 1 }, (_, index) => (index + 1) * TICK)
---

<figure class={`sky sky--${variant}`} data-sky-stage data-locale={locale} data-pagefind-ignore>
  <div class="sky__poster">
    <svg class="sky__chart" viewBox={`0 0 ${SKY_WIDTH} ${SKY_HEIGHT}`} aria-hidden="true" focusable="false">
      <g class="sky__grid">
        {meridians.map((x) => <line x1={x} x2={x} y1="0" y2={SKY_HEIGHT} />)}
        {parallels.map((y) => <line x1="0" x2={SKY_WIDTH} y1={y} y2={y} />)}
      </g>
      <g class="sky__neatline">
        <rect x="0" y="0" width={SKY_WIDTH} height={SKY_HEIGHT} />
        {ticksX.map((x) => <path d={`M${x} 0v${x % STEP === 0 ? 9 : 4}M${x} ${SKY_HEIGHT}v-${x % STEP === 0 ? 9 : 4}`} />)}
        {ticksY.map((y) => <path d={`M0 ${y}h${y % STEP === 0 ? 9 : 4}M${SKY_WIDTH} ${y}h-${y % STEP === 0 ? 9 : 4}`} />)}
      </g>
      <g class="sky__bridges">{bridges.map((d) => <path d={d} />)}</g>
      {sky.constellations.map((constellation) => (
        <g data-constellation={constellation.id} data-tier={constellation.tier} style={`--order: ${constellation.order}`}>
          <path data-constellation-path d={constellationPath(constellation)} pathLength="1" />
          {constellation.stars.map((star, index) => (
            <circle
              data-star={star.id}
              data-lesson-key={`${locale}:${star.id}`}
              class={star.inDegree >= 3 ? 'sky__star sky__star--bright' : 'sky__star'}
              cx={star.x}
              cy={star.y}
              r={star.r}
              style={`--i: ${index}`}
            />
          ))}
        </g>
      ))}
      <path class="sky__comet" d={route} pathLength="1" />
    </svg>
  </div>
  <canvas class="sky__canvas" data-sky-canvas hidden></canvas>
  <nav class="sky__names" aria-label={label}>
    <ol>
      {sky.constellations.map((constellation) => (
        <li
          data-constellation-label={constellation.id}
          data-tier={constellation.tier}
          data-anchor={constellation.label.anchor}
          data-attach-y={constellation.label.anchor === 'above' ? constellation.box.y : constellation.box.y + constellation.box.height}
          style={`--x: ${pct(constellation.label.x, SKY_WIDTH)}; --y: ${pct(constellation.label.y, SKY_HEIGHT)}; --order: ${constellation.order}`}
        >
          <a href={trackPath(locale, constellation.id)}>
            <b data-numeric>{positionOf(constellation.id)}</b>
            <span>{constellation.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <label class="sky__motion">
    <input type="checkbox" data-motion-toggle checked />
    <span class="sky__motion-mark" aria-hidden="true"></span>
    <span>{copy.animate}</span>
  </label>
</figure>
{/* An atlas always prints its key: the marks are explained, not guessed. */}
<ul class="sky-key" aria-label={copy.key} data-pagefind-ignore>
  <li><i class="sky-key__ring" aria-hidden="true"></i>{copy.open}</li>
  <li><i class="sky-key__ring sky-key__ring--done" aria-hidden="true"></i>{copy.done}</li>
  <li><i class="sky-key__ring sky-key__ring--bright" aria-hidden="true"></i>{copy.bright}</li>
  <li><i class="sky-key__line" aria-hidden="true"></i>{copy.line}</li>
  <li><i class="sky-key__line sky-key__line--bridge" aria-hidden="true"></i>{copy.bridge}</li>
</ul>

<script>import '~/lib/sky-client'</script>

<style>
  .sky {
    position: relative;
    container-type: inline-size;
    margin: 0;
    aspect-ratio: 1000 / 560;
    color: var(--ink);
  }
  .sky__poster, .sky__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* sky-client sets data-sky-state="live" after the first WebGL frame, which
     is drawn identically to this poster; the two cross-fade. */
  .sky__poster { transition: opacity var(--dur-slow) var(--ease-out); }
  .sky[data-sky-state='live'] .sky__poster { opacity: 0; }
  .sky__chart { display: block; width: 100%; height: 100%; overflow: visible; }
  .sky__canvas { display: block; }
  .sky__canvas[hidden] { display: none; }

  .sky__grid line { stroke: var(--grid); stroke-width: 1; stroke-dasharray: 1 3; vector-effect: non-scaling-stroke; }
  .sky__neatline rect, .sky__neatline path { fill: none; stroke: var(--rule-strong); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .sky__bridges path { fill: none; stroke: var(--rule-strong); stroke-width: 1; stroke-dasharray: 2 5; vector-effect: non-scaling-stroke; }
  /* Dash-animated paths keep user-unit strokes: a non-scaling stroke makes
     Chromium measure the pathLength dash in screen space and stop short. */
  [data-constellation-path] { fill: none; stroke: var(--tier); stroke-width: 1.6; stroke-linejoin: round; stroke-dasharray: 1; opacity: 0.8; }
  .sky__star { fill: var(--plate); stroke: var(--tier); stroke-width: 1.4; vector-effect: non-scaling-stroke; transform-box: fill-box; transform-origin: center; }
  .sky__star[data-complete='true'] { fill: var(--tier); }
  /* The comet: one short lit segment travelling the whole course route once
     per sky period. Hidden where it cannot move. */
  .sky__comet { fill: none; stroke: none; }

  /* Constellation names, pinned to the figure by --x/--y (the 3D sky updates
     them every frame; the server writes the flat chart's positions). */
  .sky__names ol { margin: 0; padding: 0; list-style: none; }
  .sky__names li { position: absolute; left: var(--x); top: var(--y); translate: -50% -50%; }
  .sky__names a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    padding: 0.35em 0.55em;
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    background: color-mix(in srgb, var(--plate) 72%, transparent);
    font: var(--weight-semibold) clamp(0.56rem, 1.1cqi, 0.78rem) / 1.15 var(--font-display);
    font-stretch: var(--stretch-wide);
    letter-spacing: 0.06em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .sky__names a b { color: var(--tier); font-family: var(--font-data); font-weight: var(--weight-bold); letter-spacing: 0; }
  .sky__names span { max-width: 9em; text-wrap: balance; }
  .sky__names a:hover { color: var(--ink); background: var(--plate); }
  .sky:has(.sky__names li:hover) [data-constellation] { opacity: 0.35; transition: opacity var(--dur-base) var(--ease-out); }

  /* Below the plate's corner, never over the chart. */
  .sky__motion {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2xs));
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    padding-inline: var(--space-xs);
    color: var(--ink-muted);
    font: var(--weight-medium) var(--text-xs) var(--font-ui);
    cursor: pointer;
  }
  .sky__motion input { position: absolute; opacity: 0; }
  .sky__motion-mark { position: relative; width: 2rem; height: 1.1rem; border: 1.5px solid var(--rule-field); border-radius: var(--radius-sm); }
  .sky__motion-mark::after { content: ''; position: absolute; top: 50%; left: 0.2rem; width: 0.55rem; aspect-ratio: 1; border-radius: 50%; background: var(--ink-faint); translate: 0 -50%; transition: translate var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out); }
  .sky__motion input:checked + .sky__motion-mark::after { translate: 0.85rem -50%; background: var(--reticle); }
  .sky__motion input:focus-visible + .sky__motion-mark { outline: 2px solid var(--focus); outline-offset: 2px; }
  .sky__motion:hover { color: var(--ink); }

  @media (prefers-reduced-motion: no-preference) {
    /* Arrival: the constellations draw themselves in course order, then their
       stars ignite. One authored sequence, once. */
    [data-constellation-path] { animation: draw-line 1.2s var(--ease-in-out) both; animation-delay: calc(0.2s + var(--order) * 0.14s); }
    .sky__star { animation: ignite var(--dur-slow) var(--ease-out) both; animation-delay: calc(0.45s + var(--order) * 0.14s + min(var(--i), 12) * 0.04s); }
    .sky__names li { animation: name-in var(--dur-slow) var(--ease-out) both; animation-delay: calc(0.6s + var(--order) * 0.14s); }

    /* Ambient: on the shared clock. The bright stars (the ones most lessons
       stand on) breathe; a comet runs the course route. */
    .sky__star--bright { animation: ignite var(--dur-slow) var(--ease-out) both, breathe calc(var(--sky-period) / 24) ease-in-out calc(2.5s + var(--i) * 0.7s) infinite; }
    .sky__comet { stroke: var(--reticle); stroke-width: 2.6; stroke-linecap: round; stroke-dasharray: 0.006 0.994; animation: comet var(--sky-period) linear 2.4s infinite; }
    .sky:has([data-motion-toggle]:not(:checked)) * { animation-play-state: paused !important; }
    .sky:has([data-motion-toggle]:not(:checked)) .sky__comet { opacity: 0.35; }
  }
  @media (prefers-reduced-motion: reduce) { .sky__motion { display: none; } }

  .sky-key {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    margin: var(--space-sm) 0 0;
    padding: 0 11rem 0 0;
    color: var(--ink-muted);
    font-size: var(--text-xs);
    list-style: none;
  }
  .sky-key li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .sky-key__ring { width: 0.6rem; aspect-ratio: 1; border: 1.5px solid var(--ink-muted); border-radius: 50%; }
  .sky-key__ring--done { background: var(--ink-muted); }
  .sky-key__ring--bright { width: 0.9rem; }
  .sky-key__line { width: 1.4rem; height: 0; border-top: 1.5px solid var(--ink-muted); }
  .sky-key__line--bridge { border-top-style: dashed; border-top-width: 1px; }
  @media (max-width: 40rem) { .sky-key { padding: var(--space-xl) 0 0; } }

  @keyframes name-in { from { opacity: 0; translate: -50% -30%; } to { opacity: 1; translate: -50% -50%; } }
  @keyframes breathe { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
  @keyframes comet { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }

  /* A narrow chart keeps the track numbers only; the full names are in the
     catalog below it. */
  @container (max-width: 34rem) {
    .sky__names span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .sky__names a { padding: 0.5em 0.7em; font-size: 0.75rem; }
  }
</style>
