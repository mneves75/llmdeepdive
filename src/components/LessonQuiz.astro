---
import type { QuizItem } from '~/lib/content'

interface Props { lessonKey: string; items: QuizItem[]; locale: 'en' | 'pt-br' }
const { lessonKey, items, locale } = Astro.props
const copy = locale === 'pt-br'
  ? {
      check: 'Conferir respostas', answer: 'Resposta e explicação',
      right: 'Correto', wrong: 'Ainda não — releia e tente de novo',
      summary: '{n} de {m} corretas. Reveja as perguntas marcadas com “Ainda não”.',
      passed: 'Correto.',
      unsaved: 'Correto, mas não foi possível salvar neste dispositivo. A lição não será marcada como concluída.',
    }
  : {
      check: 'Check answers', answer: 'Answer and explanation',
      right: 'Correct', wrong: 'Not yet — reread and try again',
      summary: '{n} of {m} correct. Look again at the questions marked “Not yet”.',
      passed: 'Correct.',
      unsaved: 'Correct, but this device could not save it. The lesson will not be marked complete.',
    }
---

<section
  class="quiz"
  data-lesson-quiz
  data-lesson-key={lessonKey}
  data-correct={JSON.stringify(items.map((item) => item.correctIndex))}
  data-right={copy.right}
  data-wrong={copy.wrong}
  data-summary={copy.summary}
  data-passed={copy.passed}
  data-unsaved={copy.unsaved}
>
  {items.map((item, questionIndex) => (
    <fieldset>
      <legend><span data-numeric>{questionIndex + 1}</span>{item.question}</legend>
      <div class="quiz__options">
        {item.options.map((option, optionIndex) => (
          <label>
            <input type="radio" name={`quiz-${lessonKey}-${questionIndex}`} value={optionIndex} />
            <span class="quiz__key">{String.fromCharCode(65 + optionIndex)}</span>
            <span>{option}</span>
          </label>
        ))}
      </div>
      <p class="quiz__verdict" data-verdict></p>
      {/* Readable without JavaScript, where nothing can be checked anyway. The
          script hides each explanation until its question is answered right,
          so completing a lesson still means answering, not reading ahead; a
          right answer opens its explanation. */}
      <details data-explanation>
        <summary>{copy.answer}</summary>
        <p><strong>{item.options[item.correctIndex]}</strong> — {item.explanation}</p>
      </details>
    </fieldset>
  ))}
  <div class="quiz__submit">
    <button type="button" data-quiz-check>{copy.check}<span aria-hidden="true">→</span></button>
    <p class="quiz-status" role="status"></p>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-lesson-quiz]')) {
    const lessonKey = root.dataset.lessonKey
    const encodedAnswers = root.dataset.correct
    const button = root.querySelector<HTMLButtonElement>('[data-quiz-check]')
    const status = root.querySelector<HTMLElement>('[role="status"]')
    if (!lessonKey || !encodedAnswers || !button || !status) continue
    const parsed: unknown = JSON.parse(encodedAnswers)
    if (!Array.isArray(parsed) || !parsed.every((value) => typeof value === 'number')) continue
    const correctAnswers: number[] = parsed
    const fieldsets = [...root.querySelectorAll<HTMLFieldSetElement>('fieldset')]

    let passedBefore = false
    try { passedBefore = localStorage.getItem(`ldd:quiz:${lessonKey}`) === 'true' } catch { passedBefore = false }
    // A learner who already passed keeps the explanations; everyone else earns
    // each one by answering it.
    for (const fieldset of fieldsets) {
      const explanation = fieldset.querySelector<HTMLDetailsElement>('[data-explanation]')
      if (explanation) explanation.hidden = !passedBefore
      // Changing an answer withdraws the verdict it no longer describes.
      for (const input of fieldset.querySelectorAll<HTMLInputElement>('input')) {
        input.addEventListener('change', () => {
          delete fieldset.dataset.result
          const verdict = fieldset.querySelector<HTMLElement>('[data-verdict]')
          if (verdict) verdict.textContent = ''
        })
      }
    }

    button.addEventListener('click', () => {
      const selected = fieldsets.map((fieldset) => {
        const checked = fieldset.querySelector<HTMLInputElement>('input:checked')
        return checked ? Number(checked.value) : -1
      })
      let rightCount = 0
      fieldsets.forEach((fieldset, index) => {
        const right = selected[index] === correctAnswers[index]
        if (right) rightCount += 1
        fieldset.dataset.result = right ? 'right' : 'wrong'
        const verdict = fieldset.querySelector<HTMLElement>('[data-verdict]')
        if (verdict) verdict.textContent = (right ? root.dataset.right : root.dataset.wrong) ?? ''
        // A right answer earns its reason, shown at once rather than behind
        // another click.
        const explanation = fieldset.querySelector<HTMLDetailsElement>('[data-explanation]')
        if (explanation && right) {
          explanation.hidden = false
          explanation.open = true
        }
      })
      const correct = selected.length === correctAnswers.length && selected.every((answer, index) => answer === correctAnswers[index])
      let persisted = false
      try {
        localStorage.setItem(`ldd:quiz:${lessonKey}`, String(correct))
        persisted = true
      } catch {
        persisted = false
      }
      const valid = correct && persisted
      root.dataset.complete = String(valid)
      status.textContent = !correct
        ? (root.dataset.summary ?? '').replace('{n}', String(rightCount)).replace('{m}', String(correctAnswers.length))
        : (persisted ? root.dataset.passed : root.dataset.unsaved) ?? ''
      document.dispatchEvent(new CustomEvent('ldd:quiz', { detail: { lessonKey, valid } }))
    })
  }
</script>

<style>
  .quiz { display: grid; gap: var(--space-md); }
  /* A legend sits in the fieldset's border band; it carries the top spacing. */
  fieldset { margin: 0; padding: 0 var(--space-md) var(--space-md); border: 1px solid var(--rule); border-radius: var(--radius-md); transition: border-color var(--dur-base) var(--ease-out); }
  fieldset[data-result='right'] { border-color: color-mix(in srgb, var(--success) 55%, var(--rule)); }
  fieldset[data-result='wrong'] { border-color: color-mix(in srgb, var(--danger) 55%, var(--rule)); }
  legend { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); gap: var(--space-xs); float: left; width: 100%; padding-top: var(--space-md); margin-bottom: var(--space-md); font: var(--weight-semibold) var(--text-lg) / var(--leading-snug) var(--font-display); }
  legend + * { clear: both; }
  legend span { display: grid; place-items: center; width: 1.9rem; aspect-ratio: 1; border: 1.5px solid var(--tier, var(--accent)); border-radius: 50%; color: var(--tier, var(--accent)); font: var(--weight-semibold) var(--text-xs) / 1 var(--font-data); transition: background-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }
  fieldset[data-result='right'] legend span { color: var(--plate); border-color: var(--success); background: var(--success); }
  fieldset[data-result='wrong'] legend span { color: var(--danger); border-color: var(--danger); }
  .quiz__options { display: grid; gap: var(--space-2xs); }
  label {
    position: relative;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: center;
    min-height: 3.25rem;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--rule-field);
    border-radius: var(--radius-sm);
    background: var(--plate);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  label:hover { border-color: var(--ink); }
  label:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
  input { position: absolute; opacity: 0; }
  input:focus-visible + .quiz__key { outline: 2px solid var(--focus); outline-offset: 3px; }
  .quiz__key { display: grid; place-items: center; width: 1.7rem; aspect-ratio: 1; border: 1px solid var(--rule-strong); border-radius: 50%; color: var(--ink-muted); font: var(--weight-semibold) var(--text-xs) var(--font-data); transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), scale var(--dur-fast) var(--ease-out); }
  label:has(input:checked) .quiz__key { color: var(--accent-ink); border-color: var(--accent); background: var(--accent); scale: 1.08; }
  .quiz__verdict { margin: var(--space-sm) 0 0; font: var(--weight-semibold) var(--text-sm) var(--font-ui); }
  .quiz__verdict:empty { display: none; }
  fieldset[data-result='right'] .quiz__verdict { color: var(--success); }
  fieldset[data-result='wrong'] .quiz__verdict { color: var(--danger); }
  @media (prefers-reduced-motion: no-preference) {
    fieldset[data-result] .quiz__verdict { animation: verdict var(--dur-slow) var(--ease-out); }
  }
  @keyframes verdict { from { opacity: 0; translate: 0 -0.35rem; } }
  details { margin-top: var(--space-sm); color: var(--ink-muted); }
  summary { display: flex; align-items: center; min-height: 2.75rem; color: var(--ink); cursor: pointer; font: var(--weight-semibold) var(--text-sm) var(--font-ui); }
  .quiz__submit { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md); padding-top: var(--space-xs); }
  button { display: inline-flex; align-items: center; justify-content: space-between; gap: var(--space-xl); min-width: 12rem; min-height: 2.875rem; padding: 0.7rem 1.05rem; border: 1px solid var(--ink); border-radius: var(--radius-sm); color: var(--plate); background: var(--ink); font: var(--weight-semibold) var(--text-sm) var(--font-ui); cursor: pointer; transition: background-color var(--dur-fast) var(--ease-out), font-stretch var(--dur-base) var(--ease-out); }
  button:hover { background: color-mix(in srgb, var(--ink) 86%, var(--accent)); font-stretch: 106%; }
  button:active { translate: 0 1px; }
  .quiz-status { flex: 1 1 16rem; margin: 0; color: var(--danger); font-weight: var(--weight-semibold); }
  .quiz-status:empty { display: none; }
  [data-complete='true'] .quiz-status { color: var(--success); }
</style>
