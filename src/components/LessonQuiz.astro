---
import type { QuizItem } from '~/lib/content'

interface Props { lessonKey: string; items: QuizItem[]; locale: 'en' | 'pt-br' }
const { lessonKey, items, locale } = Astro.props
const copy = locale === 'pt-br'
  ? { check: 'Conferir respostas', answer: 'Resposta e explicação', correct: 'Correto.', retry: 'Revise as respostas e tente novamente.' }
  : { check: 'Check answers', answer: 'Answer and explanation', correct: 'Correct.', retry: 'Review your answers and try again.' }
---

<section class="quiz" data-lesson-quiz data-lesson-key={lessonKey} data-correct={JSON.stringify(items.map((item) => item.correctIndex))}>
  {items.map((item, questionIndex) => (
    <fieldset>
      <legend><span>{String(questionIndex + 1).padStart(2, '0')}</span>{item.question}</legend>
      <div class="quiz__options">
        {item.options.map((option, optionIndex) => (
          <label>
            <input type="radio" name={`quiz-${lessonKey}-${questionIndex}`} value={optionIndex} />
            <span class="quiz__key">{String.fromCharCode(65 + optionIndex)}</span>
            <span>{option}</span>
          </label>
        ))}
      </div>
      <details>
        <summary>{copy.answer}</summary>
        <p><strong>{item.options[item.correctIndex]}</strong> — {item.explanation}</p>
      </details>
    </fieldset>
  ))}
  <div class="quiz__submit">
    <button type="button">{copy.check}<span aria-hidden="true">→</span></button>
    <p class="quiz-status" role="status"></p>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-lesson-quiz]')) {
    const lessonKey = root.dataset.lessonKey
    const encodedAnswers = root.dataset.correct
    const button = root.querySelector<HTMLButtonElement>('button')
    const status = root.querySelector<HTMLElement>('[role="status"]')
    if (!lessonKey || !encodedAnswers || !button || !status) continue
    const parsed: unknown = JSON.parse(encodedAnswers)
    if (!Array.isArray(parsed) || !parsed.every((value) => typeof value === 'number')) continue
    const correctAnswers: number[] = parsed

    button.addEventListener('click', () => {
      const selected = [...root.querySelectorAll<HTMLFieldSetElement>('fieldset')].map((fieldset) => {
        const checked = fieldset.querySelector<HTMLInputElement>('input:checked')
        return checked ? Number(checked.value) : -1
      })
      const correct = selected.length === correctAnswers.length && selected.every((answer, index) => answer === correctAnswers[index])
      root.dataset.complete = String(correct)
      const portuguese = root.closest('[lang="pt-BR"]') !== null
      status.textContent = correct
        ? (portuguese ? 'Correto.' : 'Correct.')
        : (portuguese ? 'Revise as respostas e tente novamente.' : 'Review your answers and try again.')
      try { localStorage.setItem(`ldd:quiz:${lessonKey}`, String(correct)) } catch {}
      document.dispatchEvent(new CustomEvent('ldd:quiz', { detail: { lessonKey, valid: correct } }))
    })
  }
</script>

<style>
  .quiz { border-block: 1px solid var(--rule-strong); }
  fieldset { margin: 0; padding: var(--space-lg) 0; border: 0; border-bottom: 1px solid var(--rule-strong); }
  legend { display: grid; grid-template-columns: 2.5rem 1fr; gap: var(--space-sm); width: 100%; margin-bottom: var(--space-md); font: var(--weight-semibold) var(--text-lg) var(--font-ui); }
  legend span { color: var(--accent); font: var(--weight-semibold) var(--text-xs) var(--font-data); }
  .quiz__options { display: grid; gap: 1px; background: var(--rule); }
  label { position: relative; display: grid; grid-template-columns: 2rem 1fr; gap: var(--space-sm); align-items: center; min-height: 3.25rem; padding: var(--space-xs) var(--space-sm); background: var(--paper); cursor: pointer; }
  label:hover { background: var(--paper-sunken); }
  label:has(input:checked) { color: var(--ink-on-abyss); background: var(--abyss-raised); }
  input { position: absolute; opacity: 0; }
  input:focus-visible + .quiz__key { outline: 3px solid var(--focus); outline-offset: 3px; }
  .quiz__key { display: grid; place-items: center; width: 1.7rem; aspect-ratio: 1; border: 1px solid currentColor; border-radius: 50%; font: var(--text-xs) var(--font-data); }
  details { margin-top: var(--space-md); color: var(--ink-muted); }
  summary { cursor: pointer; font: var(--weight-semibold) var(--text-sm) var(--font-ui); }
  .quiz__submit { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md); padding-block: var(--space-lg); }
  button { display: inline-flex; justify-content: space-between; gap: var(--space-xl); min-width: 12rem; padding: 0.75rem 1rem; border: 1px solid var(--accent); border-radius: var(--radius-sm); color: var(--accent-ink); background: var(--accent); font: var(--weight-semibold) var(--text-sm) var(--font-ui); cursor: pointer; }
  .quiz-status { margin: 0; color: var(--coral); font-weight: var(--weight-semibold); }
  [data-complete='true'] .quiz-status { color: var(--kelp); }
</style>
