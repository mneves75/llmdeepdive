---
import Base from '~/layouts/Base.astro'
import '~/styles/prose.css'
import '~/styles/lab.css'
import LessonQuiz from '~/components/LessonQuiz.astro'
import TeachBack from '~/components/TeachBack.astro'
import PartHeading from '~/components/PartHeading.astro'
import Icon from '~/components/Icon.astro'
import Syllabus from '~/components/Syllabus.astro'
import ConstellationChart from '~/components/ConstellationChart.astro'
import KvBudgetLab from '~/components/labs/KvBudgetLab.astro'
import CostPerTokenLab from '~/components/labs/CostPerTokenLab.astro'
import VideoTokenLab from '~/components/labs/VideoTokenLab.astro'
import { lessonPath, readingMinutes, trackPath, type LessonEntry, type TrackEntry } from '~/lib/content'
import type { MarkdownHeading } from 'astro'
import { positionOf, tierLabels, ui } from '~/lib/i18n'
import { articleNode, breadcrumbNode, lessonCard, lessonTitle } from '~/lib/seo'

interface Props {
  lesson: LessonEntry
  track: TrackEntry
  /** Every lesson of this track, for the syllabus and the constellation. */
  trackLessons: LessonEntry[]
  previous?: LessonEntry
  next?: LessonEntry
  prerequisites: LessonEntry[]
  /** `##` headings inside the lesson body, from render(). Empty is valid. */
  headings: MarkdownHeading[]
}

const { lesson, track, trackLessons, previous, next, prerequisites, headings } = Astro.props
const { data } = lesson
const locale = data.locale
const lessonKey = `${locale}:${data.id}`
const path = `/lessons/${data.track}/${data.id}/`
const minutes = readingMinutes(lesson)
const copy = locale === 'pt-br'
  ? {
      concept: 'Conceito', analogy: 'Analogia', lab: 'Laboratório',
      labFallback: 'Este laboratório é um complemento. Todo o conceito necessário está explicado no texto.',
      teachBack: 'Explique de volta', quiz: 'Teste seu entendimento', prerequisites: 'Antes desta aula',
      none: 'Nenhum pré-requisito — você pode começar aqui.', track: 'Trilha', previous: 'Aula anterior', next: 'Próxima aula',
      sources: 'Fontes', updated: 'Atualizada em',
      progress: 'Conclua sua explicação e acerte o quiz para finalizar a aula.',
      complete: 'Aula concluída neste dispositivo.',
      lesson: 'Aula', sections: 'Nesta aula', syllabus: 'Aulas da trilha', minutes: `${minutes} min de leitura`,
      end: 'Fim da trilha', allTracks: 'Ver todas as trilhas',
    }
  : {
      concept: 'Concept', analogy: 'Analogy', lab: 'Lab',
      labFallback: 'This lab is an enhancement. Every concept you need is explained in the text.',
      teachBack: 'Teach it back', quiz: 'Check your understanding', prerequisites: 'Before this lesson',
      none: 'No prerequisites — you can start here.', track: 'Track', previous: 'Previous lesson', next: 'Next lesson',
      sources: 'Sources', updated: 'Updated',
      progress: 'Complete the teach-back and answer the quiz correctly to finish this lesson.',
      complete: 'Lesson completed on this device.',
      lesson: 'Lesson', sections: 'In this lesson', syllabus: 'Track lessons', minutes: `${minutes} min read`,
      end: 'End of the course', allTracks: 'See every track',
    }

const tierNames = tierLabels[locale]
const position = positionOf(data.id)

/**
 * One sequence drives the step list and every anchor. Body headings hang off
 * Concept, the only section whose content comes from the MDX. The cap keeps a
 * sticky list shorter than the viewport.
 */
const MAX_BODY_LINKS = 6
const bodyHeadings = headings.filter((heading) => heading.depth === 2).slice(0, MAX_BODY_LINKS)

const sections = [
  { anchor: 'concept-heading', label: copy.concept, children: bodyHeadings },
  { anchor: 'analogy-heading', label: copy.analogy, children: [] },
  ...(data.lab ? [{ anchor: 'lab-heading', label: copy.lab, children: [] }] : []),
  { anchor: 'teach-back-heading', label: copy.teachBack, children: [] },
  { anchor: 'quiz-heading', label: copy.quiz, children: [] },
]

const article = { modified: data.updated, section: track.data.title }
const structuredData = [
  breadcrumbNode(locale, [
    { name: ui[locale].tracks, path: '/tracks/' },
    { name: track.data.title, path: `/tracks/${track.data.id}/` },
    { name: data.title, path },
  ]),
  articleNode({
    locale,
    path,
    title: data.title,
    description: data.summary,
    ...article,
    tier: data.tier,
    citations: data.citations,
  }),
]
---

<Base
  title={lessonTitle({ lesson: data.title, track: track.data.title })}
  description={data.summary}
  locale={locale}
  path={path}
  marker={`lesson-${locale}-${data.id}`}
  imageAlt={lessonCard(locale, { lesson: data, track: track.data }).alt}
  structuredData={structuredData}
  article={article}
>
  {/* The reading gauge: a hairline that fills as the page is read. Scroll-driven
      CSS where supported; absent elsewhere rather than wrong. */}
  <div class="reading-gauge" aria-hidden="true" data-tier={data.tier}></div>

  <article
    class="lesson"
    data-tier={data.tier}
    data-lesson-progress
    data-lesson-key={lessonKey}
    data-lesson-id={data.id}
    data-lesson-path={lessonPath(locale, lesson)}
    data-lesson-title={data.title}
    data-lesson-position={position}
  >
    <Syllabus locale={locale} track={track} lessons={trackLessons} currentId={data.id} />

    <nav class="steps" aria-label={copy.sections} data-lesson-steps data-pagefind-ignore>
      <button class="steps__syllabus" type="button" popovertarget="syllabus">
        <Icon name="syllabus" />
        <span>{copy.syllabus}</span>
      </button>
      <ol>
        {sections.map((section) => (
          <li>
            <a href={`#${section.anchor}`} data-rail-link><i aria-hidden="true"></i><span>{section.label}</span></a>
            {section.children.length > 0 && (
              <ul class="steps__sub">
                {section.children.map((heading) => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
        {data.citations && <li><a href="#sources-heading" data-rail-link><i aria-hidden="true"></i><span>{copy.sources}</span></a></li>}
      </ol>
    </nav>

    <div class="lesson__body">
      <header class="lesson-head">
        <div class="lesson-head__text">
          <nav class="lesson-head__crumb" aria-label={copy.track} data-pagefind-ignore>
            {/* Shares its transition name with the track page's title, which
                glides down into this crumb when a lesson is opened from it. */}
            <a href={trackPath(locale, data.track)} style={`view-transition-name: track-title-${positionOf(data.track)}`}>{copy.track} {positionOf(data.track)} · {track.data.title}</a>
            <span aria-current="page">{copy.lesson} {position}</span>
          </nav>
          {/* The position is data (and already in the crumb for assistive tech);
              the h1 stays the exact title, which the Article headline repeats. */}
          <p class="lesson-head__position" aria-hidden="true" data-numeric>{position}</p>
          <h1>{data.title}</h1>
          <p class="lesson-head__summary">{data.summary}</p>
          <p class="lesson-head__meta" data-pagefind-ignore>
            <span class="lesson-head__tier"><span class="star-mark" aria-hidden="true"></span>{tierNames[data.tier]}</span>
            <span data-reading-minutes={minutes}><Icon name="clock" />{copy.minutes}</span>
            {/* `timeZone: 'UTC'` is load-bearing: `coerce.date()` reads frontmatter
                dates as UTC midnight, so formatting in the build machine's zone
                rendered every lesson a day early from São Paulo and made the HTML
                depend on where it was built. */}
            <span>{copy.updated} <time datetime={data.updated.toISOString()}>{data.updated.toLocaleDateString(locale, { timeZone: 'UTC' })}</time></span>
          </p>
        </div>
        <ConstellationChart locale={locale} trackId={data.track} lessons={trackLessons} hereId={data.id} variant="here" />
      </header>

      <aside class="prerequisites" aria-labelledby="prerequisite-heading">
        <h2 id="prerequisite-heading">{copy.prerequisites}</h2>
        {prerequisites.length > 0
          ? <ul>{prerequisites.map((item) => <li data-lesson-key={`${locale}:${item.data.id}`}><span class="star-mark" data-tier={item.data.tier} aria-hidden="true"></span><a href={lessonPath(locale, item)}><span data-numeric>{positionOf(item.data.id)}</span> {item.data.title}</a></li>)}</ul>
          : <p>{copy.none}</p>}
      </aside>

      <section class="part prose" aria-labelledby="concept-heading">
        <PartHeading id="concept-heading">{copy.concept}</PartHeading>
        <slot />
      </section>

      <section class="part part--analogy" aria-labelledby="analogy-heading">
        <PartHeading id="analogy-heading">{copy.analogy}</PartHeading>
        <p>{data.analogy}</p>
      </section>

      {data.lab && (
        <section class="part part--lab" aria-labelledby="lab-heading" data-lab-id={data.lab.id}>
          <PartHeading id="lab-heading">{copy.lab}</PartHeading>
          {/* Each lab server-renders its defaults, so the section is a worked
              example before any script runs; the fallback covers an unknown id. */}
          {data.lab.id === 'kv-budget' ? <KvBudgetLab locale={locale} />
            : data.lab.id === 'cost-per-token' ? <CostPerTokenLab locale={locale} />
            : data.lab.id === 'video-tokens' ? <VideoTokenLab locale={locale} />
            : <p>{copy.labFallback}</p>}
        </section>
      )}

      <section class="part" aria-labelledby="teach-back-heading">
        <PartHeading id="teach-back-heading">{copy.teachBack}</PartHeading>
        <TeachBack lessonKey={lessonKey} prompt={data.teachBack.prompt} modelAnswer={data.teachBack.modelAnswer} locale={locale} />
      </section>

      <section class="part" aria-labelledby="quiz-heading">
        <PartHeading id="quiz-heading">{copy.quiz}</PartHeading>
        <LessonQuiz lessonKey={lessonKey} items={data.quiz} locale={locale} />
      </section>

      <p class="completion" role="status" data-incomplete={copy.progress} data-complete-text={copy.complete}>
        <span class="completion__star" aria-hidden="true"><Icon name="check" size="1rem" /></span>
        <span data-completion-text>{copy.progress}</span>
      </p>

      {data.citations && (
        <section class="sources" aria-labelledby="sources-heading">
          <h2 class="part-heading" id="sources-heading">{copy.sources}</h2>
          <ol>{data.citations.map((citation) => <li>{citation.authors} ({citation.year}). <a href={citation.url}>{citation.title}</a>.</li>)}</ol>
        </section>
      )}

      <nav class="lesson-nav" aria-label={locale === 'pt-br' ? 'Navegação entre aulas' : 'Lesson navigation'} data-pagefind-ignore>
        {previous
          ? <a class="lesson-nav__link" rel="prev" href={lessonPath(locale, previous)}><span>← {copy.previous}</span><strong><b data-numeric>{positionOf(previous.data.id)}</b> {previous.data.title}</strong></a>
          : <span></span>}
        {next
          ? <a class="lesson-nav__link lesson-nav__link--next" rel="next" href={lessonPath(locale, next)} data-tier={next.data.tier}><span>{copy.next} →</span><strong><b data-numeric>{positionOf(next.data.id)}</b> {next.data.title}</strong></a>
          : <a class="lesson-nav__link lesson-nav__link--next" href={locale === 'pt-br' ? '/pt-br/tracks/' : '/tracks/'}><span>{copy.end}</span><strong>{copy.allTracks} →</strong></a>}
      </nav>
    </div>
  </article>
</Base>

<script>
  // rehypeMathScroll and rehypeTableScroll ship every wide-content wrapper as a
  // named, focusable region so it works without JavaScript. A region that does
  // not actually scroll is only a redundant landmark and a dead tab stop, so it
  // keeps those semantics only while its content overflows.
  const syncScrollRegion = (region: HTMLElement): void => {
    region.dataset.scrollLabel ??= region.getAttribute('aria-label') ?? ''
    if (region.scrollWidth > region.clientWidth + 1) {
      region.setAttribute('role', 'region')
      region.setAttribute('tabindex', '0')
      region.setAttribute('aria-label', region.dataset.scrollLabel)
    } else {
      region.removeAttribute('role')
      region.removeAttribute('tabindex')
      region.removeAttribute('aria-label')
    }
  }
  const scrollRegions = document.querySelectorAll<HTMLElement>('.math-scroll, .table-scroll')
  if (scrollRegions.length > 0) {
    const observer = new ResizeObserver((entries) => {
      for (const entry of entries) if (entry.target instanceof HTMLElement) syncScrollRegion(entry.target)
    })
    for (const region of scrollRegions) observer.observe(region)
  }

  // The step list marks the section being read. Headings entering the upper part of
  // the viewport win; the last one passed stays current until the next arrives.
  const railLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]')]
  if (railLinks.length > 0 && 'IntersectionObserver' in window) {
    const byId = new Map(railLinks.map((link) => [link.hash.slice(1), link]))
    const targets = [...byId.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null)
    const mark = (id: string): void => {
      for (const [key, link] of byId) {
        if (key !== id) {
          link.removeAttribute('aria-current')
          continue
        }
        link.setAttribute('aria-current', 'true')
        // On a phone the steps are a horizontal strip; keep the current section
        // in it without moving the page (scrollIntoView would).
        const rail = link.closest<HTMLElement>('[data-lesson-steps] ol')
        if (rail && rail.scrollWidth > rail.clientWidth + 1) rail.scrollTo({ left: link.offsetLeft - rail.clientWidth / 3 })
      }
    }
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0]
      if (visible) mark(visible.target.id)
    }, { rootMargin: '0px 0px -65% 0px' })
    for (const target of targets) observer.observe(target)
  }

  type CompletionDetail = { lessonKey: string; valid: boolean }
  const isCompletionDetail = (value: unknown): value is CompletionDetail => {
    if (typeof value !== 'object' || value === null) return false
    return 'lessonKey' in value && typeof value.lessonKey === 'string'
      && 'valid' in value && typeof value.valid === 'boolean'
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-lesson-progress]')) {
    const lessonKey = root.dataset.lessonKey
    const status = root.querySelector<HTMLElement>('.completion')
    if (!lessonKey || !status) continue
    const locale = lessonKey.split(':')[0] ?? 'en'

    // The place to continue from, in this locale. Home and track pages read it
    // (progress-client), validating it as untrusted input before linking.
    try {
      localStorage.setItem(`ldd:last:${locale}`, JSON.stringify({
        id: root.dataset.lessonId,
        path: root.dataset.lessonPath,
        title: root.dataset.lessonTitle,
        position: root.dataset.lessonPosition,
      }))
    } catch { /* storage unavailable: nothing to continue from, which is honest */ }
    let teachBackValid = root.querySelector<HTMLElement>('[data-teach-back]')?.dataset.complete === 'true'
    let quizValid = false
    try { quizValid = localStorage.getItem(`ldd:quiz:${lessonKey}`) === 'true' } catch { quizValid = false }

    const sync = (): void => {
      const complete = teachBackValid && quizValid
      root.dataset.complete = String(complete)
      const message = (complete ? status.dataset.completeText : status.dataset.incomplete) ?? ''
      // A live region re-announces any write; only a real change is news.
      const text = status.querySelector<HTMLElement>('[data-completion-text]')
      if (text && text.textContent !== message) text.textContent = message
      // The one record track pages read to mark this lesson done. The lesson
      // page owns the completion rule, so nothing else re-derives it.
      try {
        if (complete) localStorage.setItem(`ldd:complete:${lessonKey}`, 'true')
        else localStorage.removeItem(`ldd:complete:${lessonKey}`)
      } catch { /* storage unavailable: the lesson says so in its own status */ }
      // Stars, the syllabus and the header count update without a reload.
      document.dispatchEvent(new CustomEvent('ldd:progress'))
    }

    document.addEventListener('ldd:teach-back', (event) => {
      if (!(event instanceof CustomEvent) || !isCompletionDetail(event.detail) || event.detail.lessonKey !== lessonKey) return
      teachBackValid = event.detail.valid
      sync()
    })
    document.addEventListener('ldd:quiz', (event) => {
      if (!(event instanceof CustomEvent) || !isCompletionDetail(event.detail) || event.detail.lessonKey !== lessonKey) return
      quizValid = event.detail.valid
      sync()
    })
    sync()
  }
</script>

<style>
  .reading-gauge { display: none; }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .reading-gauge {
        position: fixed;
        inset: 0 0 auto;
        z-index: calc(var(--z-sticky) + 1);
        display: block;
        height: 3px;
        background: var(--tier);
        transform-origin: 0 50%;
        animation: gauge linear both;
        animation-timeline: scroll(root);
      }
    }
  }
  @keyframes gauge { from { scale: 0 1; } to { scale: 1 1; } }

  .lesson {
    --reading-size: clamp(1.0625rem, 0.95rem + 0.45vw, 1.2rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 92rem;
    margin-inline: auto;
    padding: 0 clamp(var(--space-sm), 3vw, var(--space-lg)) var(--space-3xl);
  }
  .lesson__body { min-width: 0; }

  /* Steps: the lesson's loop as a fold sequence on one line. */
  .steps { min-width: 0; }
  .steps ol { position: relative; margin: 0; padding: 0; list-style: none; }
  .steps a { color: var(--ink-muted); text-decoration: none; }
  .steps a:hover { color: var(--ink); }
  .steps [data-rail-link] { position: relative; display: flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; font: var(--weight-medium) var(--text-sm) var(--font-ui); }
  .steps [data-rail-link] i { flex: none; width: 0.7rem; aspect-ratio: 1; border: 1.5px solid var(--tier); border-radius: 50%; background: var(--plate); transition: background-color var(--dur-base) var(--ease-out), scale var(--dur-base) var(--ease-out); }
  .steps [data-rail-link][aria-current='true'] { color: var(--ink); font-weight: var(--weight-semibold); }
  .steps [data-rail-link][aria-current='true'] i { background: var(--tier); scale: 1.25; }
  .steps__sub { margin: 0 0 var(--space-2xs); padding: 0 0 0 1.45rem; list-style: none; }
  .steps__sub a { display: block; padding-block: 0.3rem; color: var(--ink-faint); font-size: var(--text-xs); line-height: 1.35; }
  .steps__syllabus {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    padding: 0 var(--space-xs);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    color: var(--ink);
    background: var(--plate);
    font: var(--weight-semibold) var(--text-xs) var(--font-ui);
    cursor: pointer;
  }
  .steps__syllabus:hover { border-color: var(--ink); }

  /* Header: the title block and the "you are here" plate. */
  .lesson-head {
    /* The plate's reticle locks on from 2.2x scale; clip here, locally, so it
       never widens the page. Not on the page: that would hide real overflow. */
    overflow-x: clip;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(9rem, 26%, 15rem);
    gap: var(--space-lg);
    align-items: center;
    padding-block: var(--space-2xl) var(--space-xl);
  }
  .lesson-head__crumb { display: flex; flex-wrap: wrap; gap: 0.2rem 0.6rem; font: var(--weight-semibold) var(--text-sm) var(--font-ui); }
  .lesson-head__crumb a { color: var(--tier); text-decoration: none; }
  .lesson-head__crumb span { color: var(--ink-faint); }
  .lesson-head__crumb a:hover { text-decoration: underline; }
  .lesson-head h1 { margin-top: var(--space-2xs); font-size: clamp(2.1rem, 1.4rem + 2.6vw, 3.5rem); font-stretch: 96%; line-height: 1.02; hyphens: auto; }
  .lesson-head__position { margin: var(--space-md) 0 0; color: var(--tier); font: var(--weight-black) clamp(2.5rem, 2rem + 2vw, 3.75rem) / 0.9 var(--font-display); font-stretch: var(--stretch-extended); letter-spacing: -0.03em; view-transition-name: lesson-position; }
  .lesson-head__summary { max-width: 42rem; margin: var(--space-md) 0 0; color: var(--ink-muted); font-size: var(--text-lg); line-height: 1.5; }
  .lesson-head__meta { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-md); margin: var(--space-md) 0 0; color: var(--ink-faint); font-size: var(--text-xs); }
  .lesson-head__meta > span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .lesson-head__tier { color: var(--tier); font-weight: var(--weight-semibold); }
  .lesson-head__tier .star-mark { background: var(--tier); }

  .prerequisites { padding: var(--space-md) 0; border-block: 1px solid var(--rule-strong); }
  .prerequisites h2 { font-size: var(--text-sm); font-stretch: var(--stretch-normal); letter-spacing: 0; }
  .prerequisites ul { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-lg); margin: var(--space-xs) 0 0; padding: 0; list-style: none; }
  .prerequisites li { display: inline-flex; align-items: center; gap: var(--space-2xs); }
  .prerequisites li a { color: var(--ink); }
  .prerequisites li a span { color: var(--ink-faint); font-family: var(--font-data); font-size: 0.85em; }
  .prerequisites p { margin: var(--space-2xs) 0 0; color: var(--ink-muted); }

  .part, .sources { padding-block: var(--space-2xl); border-top: 1px solid var(--rule); }
  .prerequisites + .part { border-top: 0; }
  /* `.part-heading`, not `.part > h2`: an MDX body heading is ALSO a direct
     child, and would render as a section title. Anchor offsets come from
     `scroll-padding-top` on the root alone. */
  .lesson :global(.part-heading) { margin-bottom: var(--space-lg); font-size: clamp(var(--text-xl), 1.2rem + 1.6vw, var(--text-3xl)); font-stretch: var(--stretch-wide); }

  /* The analogy is read on the field edition: a night plate inside the page. */
  .part--analogy {
    color-scheme: dark;
    margin-block: var(--space-lg);
    padding: var(--space-xl) clamp(var(--space-md), 4vw, var(--space-xl));
    border: 0;
    border-radius: var(--radius-lg);
    color: var(--ink-on-night);
    background: var(--night);
  }
  .part--analogy :global(.part-heading) { color: var(--ink-on-night); }
  .part--analogy > p { margin: 0; max-width: 40rem; color: var(--ink-muted-on-night); font-size: clamp(var(--text-lg), 1rem + 0.6vw, 1.4rem); line-height: 1.55; }
  .part--analogy + .part { border-top: 0; }

  .completion {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    margin: var(--space-lg) 0;
    padding: var(--space-md);
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius-md);
    color: var(--ink-muted);
  }
  .completion__star { position: relative; display: grid; flex: none; place-items: center; width: 2rem; aspect-ratio: 1; border: 1.5px solid var(--rule-strong); border-radius: 50%; color: transparent; }
  [data-complete='true'] > .lesson__body > .completion { color: var(--success); border-style: solid; border-color: var(--success); background: color-mix(in srgb, var(--success) 7%, var(--plate)); }
  [data-complete='true'] > .lesson__body > .completion .completion__star { color: var(--plate); border-color: var(--success); background: var(--success); }
  @media (prefers-reduced-motion: no-preference) {
    [data-complete='true'] > .lesson__body > .completion .completion__star { animation: star-fill var(--dur-focal) var(--ease-out); }
