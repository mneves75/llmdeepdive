---
import Base from '~/layouts/Base.astro'
import LessonQuiz from '~/components/LessonQuiz.astro'
import TeachBack from '~/components/TeachBack.astro'
import { lessonPath, trackPath, type LessonEntry } from '~/lib/content'

interface Props {
  lesson: LessonEntry
  previous?: LessonEntry
  next?: LessonEntry
  prerequisites: LessonEntry[]
}

const { lesson, previous, next, prerequisites } = Astro.props
const { data } = lesson
const locale = data.locale
const lessonKey = `${locale}:${data.id}`
const path = `/lessons/${data.track}/${data.id}/`
const copy = locale === 'pt-br'
  ? {
      concept: 'Conceito', analogy: 'Analogia', lab: 'Laboratório',
      labFallback: 'Este laboratório é um complemento. Todo o conceito necessário está explicado no texto.',
      teachBack: 'Explique de volta', quiz: 'Teste seu entendimento', prerequisites: 'Pré-requisitos',
      none: 'Nenhum — você pode começar aqui.', track: 'Trilha', previous: 'Aula anterior', next: 'Próxima aula',
      sources: 'Fontes', updated: 'Atualizada em',
      progress: 'Conclua o teach-back e acerte o quiz para finalizar a aula.',
      sections: 'Seções da aula', evidence: 'Marcador de evidência',
    }
  : {
      concept: 'Concept', analogy: 'Analogy', lab: 'Lab',
      labFallback: 'This lab is an enhancement. Every concept you need is explained in the text.',
      teachBack: 'Teach it back', quiz: 'Check your understanding', prerequisites: 'Prerequisites',
      none: 'None — you can start here.', track: 'Track', previous: 'Previous lesson', next: 'Next lesson',
      sources: 'Sources', updated: 'Updated',
      progress: 'Complete the teach-back and answer the quiz correctly to finish this lesson.',
      sections: 'Lesson sections', evidence: 'Evidence marker',
    }

const tierLabels = locale === 'pt-br'
  ? { foundations: 'Fundamentos', core: 'Essencial', advanced: 'Avançado', frontier: 'Fronteira' }
  : { foundations: 'Foundations', core: 'Core', advanced: 'Advanced', frontier: 'Frontier' }
---

<Base title={`${data.title} — llmdeepdive`} description={data.summary} locale={locale} path={path} marker={`lesson-${locale}-${data.id}`}>
  <article class={`lesson-shell lesson-shell--${data.tier}`} data-lesson-progress data-lesson-key={lessonKey}>
    <aside class="lesson-rail" aria-label={copy.sections} data-pagefind-ignore>
      <div class="lesson-rail__position">
        <span>{data.id}</span>
        <i aria-hidden="true"></i>
      </div>
      <nav>
        <a href="#concept-heading"><span>01</span>{copy.concept}</a>
        <a href="#analogy-heading"><span>02</span>{copy.analogy}</a>
        {data.lab && <a href="#lab-heading"><span>03</span>{copy.lab}</a>}
        <a href="#teach-back-heading"><span>{data.lab ? '04' : '03'}</span>{copy.teachBack}</a>
        <a href="#quiz-heading"><span>{data.lab ? '05' : '04'}</span>{copy.quiz}</a>
        {data.citations && <a href="#sources-heading"><span>◎</span>{copy.sources}</a>}
      </nav>
    </aside>

    <header class="lesson-header">
      <nav class="lesson-header__crumb" aria-label={copy.track}>
        <a href={trackPath(locale, data.track)}>{copy.track} {data.track.split('-')[0]}</a>
        <span aria-hidden="true">/</span>
        <span>{data.id}</span>
      </nav>
      <p class="lesson-header__tier">{tierLabels[data.tier]}</p>
      <h1>{data.title}</h1>
      <p class="summary">{data.summary}</p>
      <p class="updated">{copy.updated} <time datetime={data.updated.toISOString()}>{data.updated.toLocaleDateString(locale)}</time></p>
    </header>

    <aside class="prerequisites" aria-labelledby="prerequisite-heading">
      <span class="prerequisites__marker" aria-hidden="true">⌁</span>
      <div>
        <h2 id="prerequisite-heading">{copy.prerequisites}</h2>
        {prerequisites.length > 0
          ? <ul>{prerequisites.map((item) => <li><a href={lessonPath(locale, item)}>{item.data.title}</a></li>)}</ul>
          : <p>{copy.none}</p>}
      </div>
    </aside>

    <section class="lesson-part prose" aria-labelledby="concept-heading">
      <p class="part-number">01 · {copy.concept}</p>
      <h2 id="concept-heading">{copy.concept}</h2>
      <slot />
    </section>

    <section class="lesson-part analogy" aria-labelledby="analogy-heading">
      <p class="part-number">02 · {copy.analogy}</p>
      <h2 id="analogy-heading">{copy.analogy}</h2>
      <p>{data.analogy}</p>
    </section>

    {data.lab && (
      <section class="lesson-part lab" aria-labelledby="lab-heading" data-lab-id={data.lab.id}>
        <p class="part-number">03 · {copy.lab}</p>
        <h2 id="lab-heading">{copy.lab}</h2>
        <p>{copy.labFallback}</p>
        <noscript><p>{copy.labFallback}</p></noscript>
      </section>
    )}

    <section class="lesson-part" aria-labelledby="teach-back-heading">
      <p class="part-number">{data.lab ? '04' : '03'} · {copy.teachBack}</p>
      <h2 id="teach-back-heading">{copy.teachBack}</h2>
      <TeachBack lessonKey={lessonKey} prompt={data.teachBack.prompt} modelAnswer={data.teachBack.modelAnswer} locale={locale} />
    </section>

    <section class="lesson-part" aria-labelledby="quiz-heading">
      <p class="part-number">{data.lab ? '05' : '04'} · {copy.quiz}</p>
      <h2 id="quiz-heading">{copy.quiz}</h2>
      <LessonQuiz lessonKey={lessonKey} items={data.quiz} locale={locale} />
    </section>

    <p class="completion" role="status"><span aria-hidden="true">✓</span>{copy.progress}</p>

    {data.citations && (
      <section class="sources" aria-labelledby="sources-heading">
        <p class="part-number">◎ · {copy.evidence}</p>
        <h2 id="sources-heading">{copy.sources}</h2>
        <ol>{data.citations.map((citation) => <li>{citation.authors} ({citation.year}). <a href={citation.url}>{citation.title}</a>.</li>)}</ol>
      </section>
    )}

    <nav class="lesson-nav" aria-label={locale === 'pt-br' ? 'Navegação entre aulas' : 'Lesson navigation'}>
      {previous ? <a rel="prev" href={lessonPath(locale, previous)}><span>← {copy.previous}</span><strong>{previous.data.title}</strong></a> : <span></span>}
      {next && <a rel="next" href={lessonPath(locale, next)}><span>{copy.next} →</span><strong>{next.data.title}</strong></a>}
    </nav>
  </article>
</Base>

<script>
  type CompletionDetail = { lessonKey: string; valid: boolean }
  const isCompletionDetail = (value: unknown): value is CompletionDetail => {
    if (typeof value !== 'object' || value === null) return false
    return 'lessonKey' in value && typeof value.lessonKey === 'string'
      && 'valid' in value && typeof value.valid === 'boolean'
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-lesson-progress]')) {
    const lessonKey = root.dataset.lessonKey
    const status = root.querySelector<HTMLElement>('.completion')
    if (!lessonKey || !status) continue
    let teachBackValid = root.querySelector<HTMLElement>('[data-teach-back]')?.dataset.complete === 'true'
    let quizValid = false
    try { quizValid = localStorage.getItem(`ldd:quiz:${lessonKey}`) === 'true' } catch { quizValid = false }

    const sync = (): void => {
      const complete = teachBackValid && quizValid
      root.dataset.complete = String(complete)
      status.lastChild!.textContent = complete
        ? (document.documentElement.lang === 'pt-BR' ? ' Aula concluída neste dispositivo.' : ' Lesson completed on this device.')
        : (document.documentElement.lang === 'pt-BR'
            ? ' Conclua o teach-back e acerte o quiz para finalizar a aula.'
            : ' Complete the teach-back and answer the quiz correctly to finish this lesson.')
      try { localStorage.setItem(`ldd:progress:${lessonKey}`, String(complete)) } catch {}
    }

    document.addEventListener('ldd:teach-back', (event) => {
      if (!(event instanceof CustomEvent) || !isCompletionDetail(event.detail) || event.detail.lessonKey !== lessonKey) return
      teachBackValid = event.detail.valid
      sync()
    })
    document.addEventListener('ldd:quiz', (event) => {
      if (!(event instanceof CustomEvent) || !isCompletionDetail(event.detail) || event.detail.lessonKey !== lessonKey) return
      quizValid = event.detail.valid
      sync()
    })
    sync()
  }
</script>

<style>
  .lesson-shell { --lesson-tier: var(--accent); --lesson-reading-size: calc(var(--text-base) * 1.3); display: grid; grid-template-columns: 13rem minmax(0, 40rem); column-gap: clamp(2rem, 5vw, 5rem); max-width: 68rem; margin-inline: auto; padding: var(--space-2xl) var(--space-lg) var(--space-3xl); }
  .lesson-shell--core { --lesson-tier: var(--kelp); }
  .lesson-shell--advanced { --lesson-tier: var(--sonar); }
  .lesson-shell--frontier { --lesson-tier: var(--coral); }
  .lesson-shell > :not(.lesson-rail) { grid-column: 2; min-width: 0; }

  .lesson-rail { grid-column: 1; grid-row: 1 / span 30; align-self: start; position: sticky; top: calc(var(--header-h) + var(--space-xl)); padding-right: var(--space-lg); }
  .lesson-rail__position { display: flex; align-items: center; gap: var(--space-sm); color: var(--lesson-tier); font: var(--weight-semibold) var(--text-sm) var(--font-data); }
  .lesson-rail__position i { flex: 1; height: 2px; background: var(--lesson-tier); }
  .lesson-rail nav { display: grid; margin-top: var(--space-lg); }
  .lesson-rail nav a { display: grid; grid-template-columns: 2rem 1fr; gap: var(--space-2xs); padding: 0.6rem 0; border-top: 1px solid var(--rule); color: var(--ink-muted); font: var(--text-xs) var(--font-ui); text-decoration: none; }
  .lesson-rail nav a:hover { color: var(--lesson-tier); }
  .lesson-rail nav span { color: var(--lesson-tier); font-family: var(--font-data); }

  .lesson-header { padding-block: var(--space-xl) var(--space-2xl); }
  .lesson-header__crumb { display: flex; flex-wrap: wrap; gap: var(--space-xs); color: var(--ink-faint); font: var(--text-xs) var(--font-data); }
  .lesson-header__tier { display: inline-block; margin: var(--space-lg) 0 var(--space-sm); color: var(--lesson-tier); font: var(--weight-semibold) var(--text-3xs) var(--font-data); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }
  .lesson-header h1 { max-width: 16ch; font-size: clamp(var(--text-3xl), 6vw, 4.75rem); text-transform: uppercase; }
  .summary { max-width: 44rem; margin-block: var(--space-lg) var(--space-sm); color: var(--ink-muted); font-size: var(--text-lg); }
  .updated { margin: 0; color: var(--ink-faint); font: var(--text-xs) var(--font-data); }

  .prerequisites { display: grid; grid-template-columns: auto 1fr; gap: var(--space-md); margin-bottom: var(--space-2xl); padding: var(--space-md) 0; border-block: 1px solid var(--rule-strong); }
  .prerequisites__marker { color: var(--sonar); font-size: var(--text-2xl); line-height: 1; }
  .prerequisites h2 { font-size: var(--text-lg); }
  .prerequisites p, .prerequisites ul { margin-block: var(--space-xs) 0; }

  .lesson-part, .sources { padding-block: var(--space-2xl); border-top: 1px solid var(--rule-strong); }
  .lesson-part > h2, .sources h2 { scroll-margin-top: calc(var(--header-h) + var(--space-md)); margin-bottom: var(--space-lg); font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl)); text-transform: uppercase; }
  .part-number { margin: 0 0 var(--space-sm); color: var(--lesson-tier); font: var(--weight-semibold) var(--text-3xs) var(--font-data); letter-spacing: var(--tracking-eyebrow); }
  .prose { font-size: var(--lesson-reading-size); }
  .prose :global(h2), .prose :global(h3) { margin-top: var(--space-2xl); }
  .prose :global(p:not(.part-number)), .prose :global(li) { line-height: 1.65; }
  .prose :global(p:not(.part-number)) { margin-block: 0 1.25em; }
  .prose :global(ul), .prose :global(ol) { display: grid; gap: 0.4em; margin-block: 1.25em; padding-inline-start: 1.5em; }
  .prose :global(li) { padding-inline-start: 0.25em; }
  .prose :global(li::marker) { color: var(--lesson-tier); font-family: var(--font-data); font-size: 0.72em; font-weight: var(--weight-semibold); }
  .prose :global(pre) { overflow-x: auto; padding: var(--space-md); border-radius: var(--radius-sm); }
  .prose :global(blockquote) { margin-inline: 0; padding-left: var(--space-md); border-left: 1px solid var(--lesson-tier); color: var(--ink-muted); }
  .prose :global(.callout) { border-radius: var(--radius-md); }

  .analogy { position: relative; margin-inline: calc(var(--space-lg) * -1); padding-inline: var(--space-lg); color: var(--ink-on-abyss); background: var(--abyss); border-top: 4px solid var(--sonar); clip-path: polygon(0 1.25rem, 100% 0, 100% calc(100% - 1rem), 0 100%); }
  .analogy .part-number { color: var(--sonar); }
  .analogy > p:last-child { color: var(--ink-muted-on-abyss); font-size: var(--text-lg); }
  .lab { background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 8%, transparent), transparent); }

  .completion { display: flex; gap: var(--space-sm); align-items: center; margin: var(--space-lg) 0; padding: var(--space-md); border: 1px solid var(--rule-strong); border-radius: var(--radius-sm); color: var(--ink-muted); }
  .completion span { display: grid; place-items: center; width: 1.8rem; aspect-ratio: 1; border: 1px solid currentColor; border-radius: 50%; }
  [data-complete='true'] > .completion { color: var(--kelp); border-color: var(--kelp); }
  .sources ol { padding-left: var(--space-lg); }
  .sources li { margin-block: var(--space-xs); }

  .lesson-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin-top: var(--space-2xl); background: var(--rule-strong); border-block: 1px solid var(--rule-strong); }
  .lesson-nav a { display: grid; gap: var(--space-xs); padding: var(--space-lg); background: var(--paper); text-decoration: none; }
  .lesson-nav a:last-child { text-align: end; }
  .lesson-nav a:hover { background: var(--paper-sunken); }
  .lesson-nav span { color: var(--ink-faint); font: var(--text-3xs) var(--font-data); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }
  .lesson-nav strong { font: var(--weight-semibold) var(--text-base) var(--font-ui); }

  @media (max-width: 58rem) {
    .lesson-shell { grid-template-columns: 1fr; max-width: 48rem; padding-top: var(--space-lg); }
    .lesson-shell > :not(.lesson-rail), .lesson-rail { grid-column: 1; }
    .lesson-rail { grid-row: auto; position: sticky; top: 7.4rem; z-index: var(--z-raised); display: flex; align-items: center; gap: var(--space-sm); padding: var(--space-xs); overflow-x: auto; background: var(--paper); border-block: 1px solid var(--rule-strong); }
    .lesson-rail__position { flex: 0 0 auto; }
    .lesson-rail__position i { display: none; }
    .lesson-rail nav { display: flex; flex: 0 0 auto; margin: 0; }
    .lesson-rail nav a { display: flex; border: 0; padding: var(--space-xs); white-space: nowrap; }
    .lesson-header { padding-top: var(--space-2xl); }
    .lesson-part > h2, .sources h2 { scroll-margin-top: calc(7.4rem + 4.25rem + var(--space-sm)); }
  }

  @media (max-width: 36rem) {
    .lesson-shell { padding-inline: var(--space-sm); }
    .lesson-header h1 { font-size: 3rem; }
    .analogy { margin-inline: calc(var(--space-sm) * -1); padding-inline: var(--space-sm); }
    .lesson-nav { grid-template-columns: 1fr; }
  }
</style>
