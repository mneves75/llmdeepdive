---
import Base from '~/layouts/Base.astro'
import LessonQuiz from '~/components/LessonQuiz.astro'
import TeachBack from '~/components/TeachBack.astro'
import { lessonPath, trackPath, type LessonEntry } from '~/lib/content'

interface Props {
  lesson: LessonEntry
  previous?: LessonEntry
  next?: LessonEntry
  prerequisites: LessonEntry[]
}

const { lesson, previous, next, prerequisites } = Astro.props
const { data } = lesson
const locale = data.locale
const lessonKey = `${locale}:${data.id}`
const path = `/lessons/${data.track}/${data.id}/`
const copy = locale === 'pt-br'
  ? {
      concept: 'Conceito',
      analogy: 'Como explicar para uma criança de cinco anos',
      lab: 'Laboratório prático',
      labFallback: 'Este laboratório é um complemento. Todo o conceito necessário está explicado no texto.',
      teachBack: 'Ensine de volta',
      quiz: 'Teste seu entendimento',
      prerequisites: 'Pré-requisitos',
      none: 'Nenhum — você pode começar aqui.',
      track: 'Trilha',
      previous: 'Aula anterior',
      next: 'Próxima aula',
      sources: 'Fontes',
      updated: 'Atualizada em',
      progress: 'Conclua o teach-back e acerte o quiz para finalizar a aula.',
      complete: 'Aula concluída neste dispositivo.',
    }
  : {
      concept: 'Concept',
      analogy: 'Explain it like I am five',
      lab: 'Hands-on lab',
      labFallback: 'This lab is an enhancement. Every concept you need is explained in the text.',
      teachBack: 'Teach it back',
      quiz: 'Check your understanding',
      prerequisites: 'Prerequisites',
      none: 'None — you can start here.',
      track: 'Track',
      previous: 'Previous lesson',
      next: 'Next lesson',
      sources: 'Sources',
      updated: 'Updated',
      progress: 'Complete the teach-back and answer the quiz correctly to finish this lesson.',
      complete: 'Lesson completed on this device.',
    }

const tierLabels = locale === 'pt-br'
  ? { foundations: 'Fundamentos', core: 'Essencial', advanced: 'Avançado', frontier: 'Fronteira' }
  : { foundations: 'Foundations', core: 'Core', advanced: 'Advanced', frontier: 'Frontier' }
---

<Base
  title={`${data.title} — llmdeepdive`}
  description={data.summary}
  locale={locale}
  path={path}
  marker={`lesson-${locale}-${data.id}`}
>
  <article class="lesson-shell" data-lesson-progress data-lesson-key={lessonKey}>
    <header class="lesson-header">
      <nav aria-label={copy.track}>
        <a href={trackPath(locale, data.track)}>{copy.track}</a>
      </nav>
      <p class={`tier tier--${data.tier}`}>{tierLabels[data.tier]}</p>
      <h1>{data.title}</h1>
      <p class="summary">{data.summary}</p>
      <p class="updated">{copy.updated} <time datetime={data.updated.toISOString()}>{data.updated.toLocaleDateString(locale)}</time></p>
    </header>

    <aside class="prerequisites panel" aria-labelledby="prerequisite-heading">
      <h2 id="prerequisite-heading">{copy.prerequisites}</h2>
      {prerequisites.length > 0 ? (
        <ul>
          {prerequisites.map((item) => <li><a href={lessonPath(locale, item)}>{item.data.title}</a></li>)}
        </ul>
      ) : <p>{copy.none}</p>}
    </aside>

    <section class="lesson-part prose" aria-labelledby="concept-heading">
      <p class="part-number">1</p>
      <h2 id="concept-heading">{copy.concept}</h2>
      <slot />
    </section>

    <section class="lesson-part analogy panel" aria-labelledby="analogy-heading">
      <p class="part-number">2</p>
      <h2 id="analogy-heading">{copy.analogy}</h2>
      <p>{data.analogy}</p>
    </section>

    {data.lab && (
      <section class="lesson-part" aria-labelledby="lab-heading" data-lab-id={data.lab.id}>
        <p class="part-number">3</p>
        <h2 id="lab-heading">{copy.lab}</h2>
        <p>{copy.labFallback}</p>
        <noscript><p>{copy.labFallback}</p></noscript>
      </section>
    )}

    <section class="lesson-part" aria-labelledby="teach-back-heading">
      <p class="part-number">{data.lab ? '4' : '3'}</p>
      <h2 id="teach-back-heading">{copy.teachBack}</h2>
      <TeachBack lessonKey={lessonKey} prompt={data.teachBack.prompt} modelAnswer={data.teachBack.modelAnswer} locale={locale} />
    </section>

    <section class="lesson-part" aria-labelledby="quiz-heading">
      <p class="part-number">{data.lab ? '5' : '4'}</p>
      <h2 id="quiz-heading">{copy.quiz}</h2>
      <LessonQuiz lessonKey={lessonKey} items={data.quiz} locale={locale} />
    </section>

    <p class="completion panel" role="status">{copy.progress}</p>

    {data.citations && (
      <section class="sources" aria-labelledby="sources-heading">
        <h2 id="sources-heading">{copy.sources}</h2>
        <ol>
          {data.citations.map((citation) => (
            <li>{citation.authors} ({citation.year}). <a href={citation.url}>{citation.title}</a>.</li>
          ))}
        </ol>
      </section>
    )}

    <nav class="lesson-nav" aria-label={locale === 'pt-br' ? 'Navegação entre aulas' : 'Lesson navigation'}>
      {previous ? <a rel="prev" href={lessonPath(locale, previous)}><span>{copy.previous}</span>{previous.data.title}</a> : <span></span>}
      {next && <a rel="next" href={lessonPath(locale, next)}><span>{copy.next}</span>{next.data.title}</a>}
    </nav>
  </article>
</Base>

<script>
  type CompletionDetail = { lessonKey: string; valid: boolean }

  const isCompletionDetail = (value: unknown): value is CompletionDetail => {
    if (typeof value !== 'object' || value === null) return false
    return 'lessonKey' in value && typeof value.lessonKey === 'string'
      && 'valid' in value && typeof value.valid === 'boolean'
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-lesson-progress]')) {
    const lessonKey = root.dataset.lessonKey
    const status = root.querySelector<HTMLElement>('.completion')
    if (!lessonKey || !status) continue

    let teachBackValid = root.querySelector<HTMLElement>('[data-teach-back]')?.dataset.complete === 'true'
    let quizValid = false
    try {
      quizValid = localStorage.getItem(`ldd:quiz:${lessonKey}`) === 'true'
    } catch {
      quizValid = false
    }

    const sync = (): void => {
      const complete = teachBackValid && quizValid
      root.dataset.complete = String(complete)
      status.textContent = complete
        ? (document.documentElement.lang === 'pt-BR' ? 'Aula concluída neste dispositivo.' : 'Lesson completed on this device.')
        : (document.documentElement.lang === 'pt-BR'
            ? 'Conclua o teach-back e acerte o quiz para finalizar a aula.'
            : 'Complete the teach-back and answer the quiz correctly to finish this lesson.')
      try {
        localStorage.setItem(`ldd:progress:${lessonKey}`, String(complete))
      } catch {
        // Completion remains visible for this page view when storage is unavailable.
      }
    }

    document.addEventListener('ldd:teach-back', (event) => {
      if (!(event instanceof CustomEvent) || !isCompletionDetail(event.detail) || event.detail.lessonKey !== lessonKey) return
      teachBackValid = event.detail.valid
      sync()
    })
    document.addEventListener('ldd:quiz', (event) => {
      if (!(event instanceof CustomEvent) || !isCompletionDetail(event.detail) || event.detail.lessonKey !== lessonKey) return
      quizValid = event.detail.valid
      sync()
    })
    sync()
  }
</script>

<style>
  .lesson-shell { max-width: 78rem; margin-inline: auto; padding: var(--space-xl) var(--space-lg) var(--space-2xl); }
  .lesson-header, .lesson-part, .sources { max-width: var(--measure); margin-inline: auto; }
  .lesson-header { padding-block: var(--space-xl); }
  .lesson-header nav, .updated { font: var(--text-xs) var(--font-ui); color: var(--ink-faint); }
  .lesson-header h1 { font-size: clamp(var(--text-2xl), 6vw, var(--text-4xl)); margin-block: var(--space-sm); }
  .summary { font-size: var(--text-lg); color: var(--ink-muted); }
  .tier { display: inline-block; margin: var(--space-sm) 0 0; padding: 0.2rem 0.55rem; border-radius: var(--radius-full); font: var(--weight-semibold) var(--text-3xs) var(--font-ui); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; background: var(--paper-raised); border: 1px solid currentColor; }
  .tier--foundations { color: var(--sage); }
  .tier--core { color: var(--violet); }
  .tier--advanced { color: var(--accent); }
  .tier--frontier { color: var(--tier-miss); }
  .prerequisites { max-width: var(--measure); box-sizing: border-box; margin: 0 auto var(--space-xl); padding: var(--space-md); }
  .prerequisites h2 { font-size: var(--text-lg); }
  .prerequisites p, .prerequisites ul { margin-bottom: 0; }
  .lesson-part { position: relative; padding-block: var(--space-xl); border-top: 1px solid var(--rule); }
  .lesson-part > h2, .sources h2 { font-size: var(--text-2xl); margin-bottom: var(--space-md); }
  .part-number { font: var(--weight-semibold) var(--text-xs) var(--font-ui); color: var(--accent); margin: 0 0 var(--space-xs); }
  .prose :global(h2), .prose :global(h3) { margin-top: var(--space-xl); }
  .prose :global(p), .prose :global(li) { line-height: var(--leading-relaxed); }
  .analogy { box-sizing: border-box; padding-inline: var(--space-lg); }
  .completion { max-width: var(--measure); box-sizing: border-box; margin: var(--space-lg) auto; padding: var(--space-md); color: var(--ink-muted); }
  [data-complete='true'] > .completion { color: var(--sage); font-weight: var(--weight-semibold); }
  .sources { padding-block: var(--space-xl); }
  .sources li { overflow-wrap: anywhere; }
  .lesson-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-md); border-top: 1px solid var(--rule); padding-top: var(--space-xl); }
  .lesson-nav a { display: block; padding: var(--space-md); border: 1px solid var(--rule); border-radius: var(--radius-lg); text-decoration: none; }
  .lesson-nav a:last-child { text-align: right; }
  .lesson-nav span { display: block; margin-bottom: var(--space-xs); color: var(--ink-faint); font: var(--text-xs) var(--font-ui); text-transform: uppercase; letter-spacing: var(--tracking-eyebrow); }
  @media (max-width: 42rem) { .lesson-shell { padding-inline: var(--space-md); } .lesson-nav { grid-template-columns: 1fr; } }
</style>
