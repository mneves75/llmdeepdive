---
import '~/styles/global.css'
import ThemeToggle from '~/components/ThemeToggle.astro'
import Search from '~/components/Search.astro'
import Icon from '~/components/Icon.astro'
import { REPO, SITE, VERSION } from '~/lib/site'
import { alternatesFor, localePath, ogLocale, ui, type Locale } from '~/lib/i18n'
import { BRAND, OG_IMAGE, ogImageUrl, organizationNode } from '~/lib/seo'
import { serializeJsonLd, type LdNode } from '~/lib/json-ld'
import { getCollection } from 'astro:content'
import type { LessonEntry } from '~/lib/content'
// The same file the @font-face rule points at, so the preload and the face
// resolve to one hashed URL.
import displayFace from '@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url'

type Props = {
  title: string
  description: string
  locale: Locale
  path: string
  marker: string
} & (
  // A page that is not a destination (the 404s) is kept out of the index and
  // claims no canonical, alternates, card or structured data.
  | { noindex: true }
  | {
      noindex?: false
      /** Alt text for the page's social card (`seo.ts` card builders). */
      imageAlt: string
      /** JSON-LD nodes for this page; the Organization node is added here. */
      structuredData: LdNode[]
      article?: { modified: Date; section: string }
    }
)

const props = Astro.props
const { title, description, locale, path, marker } = props
const alternates = alternatesFor(path)
const fullPath = localePath(locale, path)
const canonical = new URL(fullPath, SITE).href
const indexable = props.noindex === true ? null : props
const otherLocale: Locale = locale === 'en' ? 'pt-br' : 'en'
const htmlLang = locale === 'pt-br' ? 'pt-BR' : 'en'
const base = locale === 'pt-br' ? '/pt-br' : ''
const languageHref = localePath(otherLocale, path)
// Where the reader is in the course, for the primary nav: lessons live inside
// tracks, so both mark Tracks.
const section = path.startsWith('/tracks/') || path.startsWith('/lessons/') ? 'tracks' : path.startsWith('/explore/') ? 'explore' : null
const copy = locale === 'pt-br'
  ? {
      skip: 'Pular para o conteúdo',
      tracks: 'Trilhas',
      anatomy: 'Anatomia',
      language: 'View in English',
      free: ui['pt-br'].tagline,
      license: 'Código no GitHub',
      progress: '{n}/{m}',
      progressLabel: 'aulas concluídas neste dispositivo',
      home: 'llmdeepdive — início',
      nav: 'Navegação principal',
      footerNav: 'Links do rodapé',
      footerClose: 'Sem conta. Sem paywall. Sem rastreamento. Seu progresso fica neste dispositivo.',
    }
  : {
      skip: 'Skip to content',
      tracks: 'Tracks',
      anatomy: 'Anatomy',
      language: 'Ver em português',
      free: ui.en.tagline,
      license: 'Source on GitHub',
      progress: '{n}/{m}',
      progressLabel: 'lessons completed on this device',
      home: 'llmdeepdive home',
      nav: 'Primary navigation',
      footerNav: 'Footer links',
      footerClose: 'No account. No paywall. No tracking. Your progress stays on this device.',
    }
// Total lessons in this locale, for the header's course count. Derived, so it
// cannot drift as the corpus grows.
const allLessons: LessonEntry[] = await getCollection('lessons')
const lessonTotal = allLessons.filter((lesson) => lesson.data.locale === locale).length
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The cross-document view-transition opt-in is inline and first: Chromium
        reads the incoming page's opt-in when it reveals it, and with the rule
        only in the linked stylesheet most navigations aborted with
        "ViewTransition opt-in disabled" (measured 0–2 of 8; 8/8 inline). One
        CSP style hash, pinned in tests/rendered-html.test.mjs. */}
    <style is:inline>@media (prefers-reduced-motion:no-preference){@view-transition{navigation:auto}}</style>
    <script is:inline>
      try {
        var t = localStorage.getItem('ldd-theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch (_) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? (
      <>
        <meta name="robots" content="max-image-preview:large" />
        <link rel="canonical" href={canonical} />
        {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(path, SITE).href} />
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <meta property="og:type" content={indexable?.article ? 'article' : 'website'} />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLocale]} />
    {indexable && (
      <>
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImageUrl(fullPath)} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(OG_IMAGE.width)} />
        <meta property="og:image:height" content={String(OG_IMAGE.height)} />
        <meta property="og:image:alt" content={indexable.imageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {indexable?.article && (
      <>
        <meta property="article:modified_time" content={indexable.article.modified.toISOString()} />
        <meta property="article:section" content={indexable.article.section} />
      </>
    )}
    {indexable && <script is:inline type="application/ld+json" set:html={serializeJsonLd([organizationNode, ...indexable.structuredData])} />}
    <link rel="preload" href={displayFace} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skip}</a>

    <header class="masthead" data-pagefind-ignore>
      <a class="wordmark" href={`${base}/`} aria-label={copy.home}>
        <svg class="wordmark__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <circle cx="16" cy="16" r="11" fill="none" stroke="currentColor" stroke-width="1.6" />
          <path d="M16 1.5v6M16 24.5v6M1.5 16h6M24.5 16h6" stroke="currentColor" stroke-width="1.6" />
          <path class="wordmark__star" d="M16 10.5 17.5 14.5 21.5 16 17.5 17.5 16 21.5 14.5 17.5 10.5 16 14.5 14.5Z" />
        </svg>
        <span class="wordmark__name">llmdeepdive</span>
      </a>

      <nav class="masthead__nav" aria-label={copy.nav}>
        <a href={`${base}/tracks/`} aria-current={section === 'tracks' ? 'page' : undefined}>{copy.tracks}</a>
        <a href={`${base}/explore/`} aria-current={section === 'explore' ? 'page' : undefined}>{copy.anatomy}</a>
        <a class="language language--nav" href={languageHref} hreflang={locale === 'en' ? 'pt-BR' : 'en'} lang={locale === 'en' ? 'pt-BR' : 'en'}>
          <Icon name="language" />
          <span aria-hidden="true">{locale === 'en' ? 'PT' : 'EN'}</span>
          <span class="visually-hidden">{copy.language}</span>
        </a>
      </nav>

      <div class="masthead__actions">
        {/* Filled on this device only (progress-client); every visitor gets this hidden. */}
        <a class="course-count" href={`${base}/tracks/`} data-course-progress data-total={lessonTotal} data-template={copy.progress} hidden>
          <span class="star-mark" data-complete="true" aria-hidden="true"></span>
          <span data-count></span>
          <span class="visually-hidden">{copy.progressLabel}</span>
        </a>
        <a class="language language--bar" href={languageHref} hreflang={locale === 'en' ? 'pt-BR' : 'en'} lang={locale === 'en' ? 'pt-BR' : 'en'}>
          <Icon name="language" />
          <span aria-hidden="true">{locale === 'en' ? 'PT' : 'EN'}</span>
          <span class="visually-hidden">{copy.language}</span>
        </a>
        <Search locale={locale} />
        <ThemeToggle locale={locale} />
      </div>
    </header>

    <main id="main" data-page-marker={marker}>
      <slot />
    </main>

    <footer class="colophon" data-pagefind-ignore>
      <div class="colophon__plate">
        <a class="wordmark wordmark--footer" href={`${base}/`}>
          <svg class="wordmark__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <circle cx="16" cy="16" r="11" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path d="M16 1.5v6M16 24.5v6M1.5 16h6M24.5 16h6" stroke="currentColor" stroke-width="1.6" />
            <path class="wordmark__star" d="M16 10.5 17.5 14.5 21.5 16 17.5 17.5 16 21.5 14.5 17.5 10.5 16 14.5 14.5Z" />
          </svg>
          <span class="wordmark__name">llmdeepdive</span>
        </a>
        <p class="colophon__close">{copy.footerClose}</p>
        <nav aria-label={copy.footerNav}>
          <a href={`${base}/tracks/`}>{copy.tracks}</a>
          <a href={`${base}/explore/`}>{copy.anatomy}</a>
          <a href={languageHref} hreflang={locale === 'en' ? 'pt-BR' : 'en'} lang={locale === 'en' ? 'pt-BR' : 'en'}>{copy.language}</a>
          <a href={REPO}>{copy.license}</a>
        </nav>
      </div>
      <p class="colophon__license">{copy.free} MIT · llmdeepdive.com · <span data-site-version>v{VERSION}</span></p>
    </footer>

    <script>import '~/lib/progress-client'</script>

    <style>
      .masthead {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: var(--space-xl);
        min-height: var(--header-h);
        padding: var(--space-2xs) clamp(var(--space-sm), 3vw, var(--space-lg));
        background: color-mix(in srgb, var(--plate) 88%, transparent);
        border-bottom: 1px solid var(--rule);
        backdrop-filter: blur(14px) saturate(1.2);
        /* Held still while the plate beneath it cross-fades. */
        view-transition-name: masthead;
      }

      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        min-height: 2.75rem;
        color: var(--ink);
        font: var(--weight-bold) 1.3rem / 1 var(--font-display);
        font-stretch: var(--stretch-wide);
        letter-spacing: -0.02em;
        text-decoration: none;
      }
      .wordmark:hover { color: var(--ink); }
      .wordmark__mark { width: 1.7rem; height: 1.7rem; flex: none; color: var(--accent); overflow: visible; }
      .wordmark__star { fill: var(--reticle); transform-origin: 16px 16px; transition: rotate var(--dur-slow) var(--ease-out), scale var(--dur-slow) var(--ease-out); }
      .wordmark:hover .wordmark__star { rotate: 45deg; scale: 1.15; }

      .masthead__nav { display: flex; align-items: center; gap: var(--space-md); }
      .masthead__nav a,
      .language {
        position: relative;
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        color: var(--ink-muted);
        font: var(--weight-semibold) var(--text-sm) var(--font-ui);
        text-decoration: none;
      }
      .masthead__nav a:hover, .language:hover { color: var(--ink); }
      /* The current section is underlined by a rule that grows from its centre. */
      .masthead__nav a::after { content: ''; position: absolute; inset: auto 0 0.45rem; height: 2px; background: var(--reticle); scale: 0 1; transition: scale var(--dur-base) var(--ease-out); }
      .masthead__nav a[aria-current='page'] { color: var(--ink); }
      .masthead__nav a[aria-current='page']::after,
      .masthead__nav a:hover::after { scale: 1 1; }
      .masthead__nav .language--nav { display: none; }
      .masthead__nav .language::after { display: none; }

      .masthead__actions { display: flex; align-items: center; justify-content: flex-end; gap: var(--space-2xs); }
      .language { gap: 0.35rem; padding-inline: 0.5rem; }

      .course-count {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 2.75rem;
        padding-inline: 0.6rem;
        color: var(--ink-muted);
        font: var(--weight-semibold) var(--text-xs) var(--font-data);
        text-decoration: none;
      }
      .course-count .star-mark { --mark: var(--success); }
      .course-count:hover { color: var(--ink); }

      .colophon {
        color-scheme: dark;
        color: var(--ink-muted-on-night);
        background: var(--night);
      }
      .colophon__plate {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: var(--space-md) var(--space-xl);
        align-items: center;
        max-width: var(--shell-max);
        margin-inline: auto;
        padding: var(--space-2xl) clamp(var(--space-sm), 3vw, var(--space-lg));
        border-bottom: 1px solid rgb(214 224 255 / 0.14);
      }
      .wordmark--footer, .wordmark--footer:hover { color: var(--ink-on-night); }
      .colophon__close { max-width: 36rem; margin: 0; }
      .colophon nav { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-md); }
      .colophon nav a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--ink-on-night); font: var(--weight-semibold) var(--text-sm) var(--font-ui); text-decoration: none; }
      .colophon nav a:hover { color: var(--ink-on-night); text-decoration: underline; }
      .colophon__license { max-width: var(--shell-max); margin: 0 auto; padding: var(--space-md) clamp(var(--space-sm), 3vw, var(--space-lg)); font-size: var(--text-xs); }
      .colophon__license span { font-family: var(--font-data); }

      @media (max-width: 60rem) {
        .colophon__plate { grid-template-columns: minmax(0, 1fr); }
      }

      @media (max-width: 50rem) {
        /* On a phone two sticky rows cost a fifth of the screen on every lesson.
           The bar scrolls away; lessons keep their own sticky strip. */
        .masthead { position: relative; grid-template-columns: minmax(0, 1fr) auto; gap: 0 var(--space-sm); padding-block: var(--space-2xs) 0; }
        .masthead__nav { grid-row: 2; grid-column: 1 / -1; gap: var(--space-md); border-top: 1px solid var(--rule); }
        .masthead__actions { gap: var(--space-3xs); }
        .language--bar { display: none; }
        .masthead__nav .language--nav { display: inline-flex; margin-inline-start: auto; padding-inline: 0; }
      }

      /* 320px with a wide system font is the budget: the wordmark may shrink
         before the page is allowed to scroll sideways. */
      @media (max-width: 28rem) {
        .wordmark { min-width: 0; gap: 0.4rem; font-size: 1.05rem; }
        .wordmark__name { overflow: hidden; text-overflow: ellipsis; }
        .wordmark__mark { width: 1.35rem; height: 1.35rem; }
        .course-count { padding-inline: 0.3rem; }
      }
    </style>
  </body>
</html>
