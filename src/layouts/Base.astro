---
import '~/styles/global.css'
import ThemeToggle from '~/components/ThemeToggle.astro'
import Search from '~/components/Search.astro'
import Icon from '~/components/Icon.astro'
import { REPO, SITE, VERSION } from '~/lib/site'
import { alternatesFor, localePath, ogLocale, ui, type Locale } from '~/lib/i18n'
import { BRAND, OG_IMAGE, ogImageUrl, organizationNode } from '~/lib/seo'
import { serializeJsonLd, type LdNode } from '~/lib/json-ld'

type Props = {
  title: string
  description: string
  locale: Locale
  path: string
  marker: string
} & (
  // A page that is not a destination (the 404s) is kept out of the index and
  // claims no canonical, alternates, card or structured data.
  | { noindex: true }
  | {
      noindex?: false
      /** Alt text for the page's social card (`seo.ts` card builders). */
      imageAlt: string
      /** JSON-LD nodes for this page; the Organization node is added here. */
      structuredData: LdNode[]
      article?: { modified: Date; section: string }
    }
)

const props = Astro.props
const { title, description, locale, path, marker } = props
const alternates = alternatesFor(path)
const fullPath = localePath(locale, path)
const canonical = new URL(fullPath, SITE).href
const indexable = props.noindex === true ? null : props
const otherLocale: Locale = locale === 'en' ? 'pt-br' : 'en'
const htmlLang = locale === 'pt-br' ? 'pt-BR' : 'en'
const base = locale === 'pt-br' ? '/pt-br' : ''
const languageHref = localePath(otherLocale, path)
// Where the reader is in the course, for the primary nav: lessons live inside
// tracks, so both mark Tracks.
const section = path.startsWith('/tracks/') || path.startsWith('/lessons/') ? 'tracks' : path.startsWith('/explore/') ? 'explore' : null
const copy = locale === 'pt-br'
  ? {
      skip: 'Pular para o conteúdo',
      tracks: 'Trilhas',
      anatomy: 'Anatomia',
      language: 'View in English',
      free: ui['pt-br'].tagline,
      license: 'Código no GitHub',
    }
  : {
      skip: 'Skip to content',
      tracks: 'Tracks',
      anatomy: 'Anatomy',
      language: 'Ver em português',
      free: ui.en.tagline,
      license: 'Source on GitHub',
    }
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        var t = localStorage.getItem('ldd-theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch (_) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? (
      <>
        <meta name="robots" content="max-image-preview:large" />
        <link rel="canonical" href={canonical} />
        {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(path, SITE).href} />
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <meta property="og:type" content={indexable?.article ? 'article' : 'website'} />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLocale]} />
    {indexable && (
      <>
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImageUrl(fullPath)} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(OG_IMAGE.width)} />
        <meta property="og:image:height" content={String(OG_IMAGE.height)} />
        <meta property="og:image:alt" content={indexable.imageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {indexable?.article && (
      <>
        <meta property="article:modified_time" content={indexable.article.modified.toISOString()} />
        <meta property="article:section" content={indexable.article.section} />
      </>
    )}
    {indexable && <script is:inline type="application/ld+json" set:html={serializeJsonLd([organizationNode, ...indexable.structuredData])} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skip}</a>

    <header class="site-header" data-pagefind-ignore>
      <a class="wordmark" href={`${base}/`} aria-label={locale === 'pt-br' ? 'llmdeepdive — início' : 'llmdeepdive home'}>
        <span class="wordmark__mark" aria-hidden="true"><i></i></span>
        <span>llmdeepdive</span>
      </a>

      <nav class="site-nav" aria-label={locale === 'pt-br' ? 'Navegação principal' : 'Primary navigation'}>
        <a href={`${base}/tracks/`} aria-current={section === 'tracks' ? 'page' : undefined}>{copy.tracks}</a>
        <a href={`${base}/explore/`} aria-current={section === 'explore' ? 'page' : undefined}>{copy.anatomy}</a>
        <a class="language language--nav" href={languageHref} hreflang={locale === 'en' ? 'pt-BR' : 'en'} lang={locale === 'en' ? 'pt-BR' : 'en'}>
          <Icon name="language" />
          <span aria-hidden="true">{locale === 'en' ? 'PT' : 'EN'}</span>
          <span class="visually-hidden">{copy.language}</span>
        </a>
      </nav>

      <div class="header-actions">
        <a class="language language--bar" href={languageHref} hreflang={locale === 'en' ? 'pt-BR' : 'en'} lang={locale === 'en' ? 'pt-BR' : 'en'}>
          <Icon name="language" />
          <span aria-hidden="true">{locale === 'en' ? 'PT' : 'EN'}</span>
          <span class="visually-hidden">{copy.language}</span>
        </a>
        <Search locale={locale} />
        <ThemeToggle locale={locale} />
      </div>
    </header>

    <main id="main" data-page-marker={marker}>
      <slot />
    </main>

    <footer class="site-footer" data-pagefind-ignore>
      <a class="wordmark wordmark--footer" href={`${base}/`}>
        <span class="wordmark__mark" aria-hidden="true"><i></i></span>
        <span>llmdeepdive</span>
      </a>
      <p>{copy.free}</p>
      <nav aria-label={locale === 'pt-br' ? 'Links do rodapé' : 'Footer links'}>
        <a class="footer-language" href={languageHref} hreflang={locale === 'en' ? 'pt-BR' : 'en'} lang={locale === 'en' ? 'pt-BR' : 'en'}>{copy.language}</a>
        <a href={`${base}/tracks/`}>{copy.tracks}</a>
        <a href={`${base}/explore/`}>{copy.anatomy}</a>
        <a href={REPO}>{copy.license}</a>
      </nav>
      <p class="site-footer__license">MIT · llmdeepdive.com · <span class="site-footer__version">v{VERSION}</span></p>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: var(--space-xl);
        min-height: var(--header-h);
        max-width: var(--shell-max);
        margin-inline: auto;
        padding: var(--space-sm) var(--space-lg);
        background: color-mix(in srgb, var(--paper) 94%, transparent);
        border-bottom: 1px solid var(--rule);
        backdrop-filter: blur(12px);
        /* Held still while the page beneath it cross-fades. */
        view-transition-name: site-header;
      }


      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        min-height: 2.75rem;
        font-family: var(--font-display);
        font-size: var(--text-xl);
        font-weight: var(--weight-bold);
        letter-spacing: -0.035em;
        text-decoration: none;
      }

      .wordmark__mark {
        position: relative;
        width: 1.55rem;
        aspect-ratio: 1;
        border: 2px solid var(--accent);
        border-radius: 50%;
      }

      .wordmark__mark::before,
      .wordmark__mark::after,
      .wordmark__mark i {
        content: '';
        position: absolute;
        inset: 50% auto auto 50%;
        translate: -50% -50%;
        background: var(--accent);
      }

      .wordmark__mark::before { width: 130%; height: 1px; }
      .wordmark__mark::after { width: 1px; height: 130%; }
      .wordmark__mark i { width: 0.38rem; height: 0.38rem; border-radius: 50%; }

      .site-nav { display: flex; align-items: center; gap: var(--space-lg); }
      .site-nav a,
      .language {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        font: var(--weight-semibold) var(--text-xs) var(--font-ui);
        text-decoration: none;
      }
      .site-nav a:hover, .language:hover { color: var(--accent); }
      .site-nav a[aria-current='page'] { text-decoration: underline 2px var(--accent); text-underline-offset: 0.5em; }
      .site-nav .language--nav { display: none; }

      .header-actions { display: flex; align-items: center; justify-content: flex-end; gap: var(--space-2xs); }
      .language { gap: 0.35rem; padding-inline: 0.55rem; color: var(--ink-muted); }

      .site-footer {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: var(--space-sm) var(--space-xl);
        max-width: var(--shell-max);
        margin-inline: auto;
        padding: var(--space-2xl) var(--space-lg);
        color: var(--ink-muted-on-abyss);
        background: var(--abyss);
        border-top: 4px solid var(--accent);
      }

      .wordmark--footer { color: var(--ink-on-abyss); }
      .site-footer p { margin: 0; }
      .site-footer nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-md); }
      .site-footer nav a { font: var(--weight-semibold) var(--text-sm) var(--font-ui); color: var(--ink-on-abyss); }
      .footer-language { display: none; }
      .site-footer__license { grid-column: 1 / -1; padding-top: var(--space-sm); border-top: 1px solid rgb(255 255 255 / 0.16); font: var(--text-2xs) var(--font-data); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; }

      @media (max-width: 50rem) {
        /* On a phone two sticky rows cost a fifth of the screen on every lesson.
           The bar scrolls away; lessons keep their own sticky section strip. */
        .site-header { position: relative; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2xs) var(--space-sm); padding-block: var(--space-xs) 0; padding-inline: var(--space-sm); }
        .site-nav { grid-row: 2; grid-column: 1 / -1; gap: var(--space-md); border-top: 1px solid var(--rule); }
        .header-actions { gap: var(--space-3xs); }
        .language--bar { display: none; }
        .site-nav .language--nav { display: inline-flex; margin-inline-start: auto; padding-inline: 0; }
        .site-footer { grid-template-columns: 1fr; }
        .site-footer nav { justify-content: flex-start; }
        .footer-language { display: inline; }
        .site-footer__license { grid-column: auto; }
      }

      /* 320px with a wide system font (Verdana, DejaVu Sans) is the budget:
         the wordmark may shrink before the page is allowed to scroll sideways. */
      @media (max-width: 28rem) {
        .wordmark { min-width: 0; gap: 0.45rem; font-size: var(--text-base); }
        .wordmark > span:last-child { overflow: hidden; text-overflow: ellipsis; }
        .wordmark__mark { flex: none; width: 1.15rem; }
        .header-actions { gap: 2px; }
      }
    </style>
  </body>
</html>
