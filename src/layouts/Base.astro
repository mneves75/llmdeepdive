---
import '~/styles/global.css'
import ThemeToggle from '~/components/ThemeToggle.astro'
import Search from '~/components/Search.astro'
import Icon from '~/components/Icon.astro'
import Wordmark from '~/components/Wordmark.astro'
import { REPO, SITE, VERSION } from '~/lib/site'
import { alternatesFor, localePath, ogLocale, ui, type Locale } from '~/lib/i18n'
import { BRAND, OG_IMAGE, ogImageUrl, organizationNode } from '~/lib/seo'
import { serializeJsonLd, type LdNode } from '~/lib/json-ld'
import { getCollection } from 'astro:content'
import type { LessonEntry } from '~/lib/content'
// The same file the @font-face rule points at, so the preload and the face
// resolve to one hashed URL.
import displayFace from '@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url'

type Props = {
  title: string
  description: string
  locale: Locale
  path: string
  marker: string
} & (
  // A page that is not a destination (the 404s) is kept out of the index and
  // claims no canonical, alternates, card or structured data.
  | { noindex: true }
  | {
      noindex?: false
      /** Alt text for the page's social card (`seo.ts` card builders). */
      imageAlt: string
      /** JSON-LD nodes for this page; the Organization node is added here. */
      structuredData: LdNode[]
      article?: { modified: Date; section: string }
    }
)

const props = Astro.props
const { title, description, locale, path, marker } = props
const alternates = alternatesFor(path)
const fullPath = localePath(locale, path)
const canonical = new URL(fullPath, SITE).href
const indexable = props.noindex === true ? null : props
const otherLocale: Locale = locale === 'en' ? 'pt-br' : 'en'
const htmlLang = locale === 'pt-br' ? 'pt-BR' : 'en'
const base = locale === 'pt-br' ? '/pt-br' : ''
const languageHref = localePath(otherLocale, path)
// Where the reader is in the course, for the primary nav: lessons live inside
// tracks, so both mark Tracks.
const trackSection = path === '/tracks/' ? 'page' : path.startsWith('/tracks/') || path.startsWith('/lessons/') ? 'location' : undefined
const copy = locale === 'pt-br'
  ? {
      skip: 'Pular para o conteúdo',
      tracks: 'Trilhas',
      roadmap: 'Roteiro',
      anatomy: 'Anatomia',
      language: 'View in English',
      free: ui['pt-br'].tagline,
      license: 'Código no GitHub',
      progress: '{n}/{m}',
      progressLabel: 'aulas concluídas neste dispositivo',
      home: 'llmdeepdive — início',
      nav: 'Navegação principal',
      footerNav: 'Links do rodapé',
      footerClose: 'Seu progresso fica neste dispositivo.',
      top: 'Voltar ao topo',
    }
  : {
      skip: 'Skip to content',
      tracks: 'Tracks',
      roadmap: 'Roadmap',
      anatomy: 'Anatomy',
      language: 'Ver em português',
      free: ui.en.tagline,
      license: 'Source on GitHub',
      progress: '{n}/{m}',
      progressLabel: 'lessons completed on this device',
      home: 'llmdeepdive home',
      nav: 'Primary navigation',
      footerNav: 'Footer links',
      footerClose: 'Your progress stays on this device.',
      top: 'Back to top',
    }
// Total lessons in this locale, for the header's course count. Derived, so it
// cannot drift as the corpus grows.
const allLessons: LessonEntry[] = await getCollection('lessons')
const lessonTotal = allLessons.filter((lesson) => lesson.data.locale === locale).length
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Both editions exist: the browser paints the right canvas, controls and
        scrollbars before tokens.css arrives. `color-scheme` on :root (the theme
        toggle) overrides it. */}
    <meta name="color-scheme" content="light dark" />
    {/* The cross-document view-transition opt-in is inline and first: Chromium
        reads the incoming page's opt-in when it reveals it, and with the rule
        only in the linked stylesheet most navigations aborted with
        "ViewTransition opt-in disabled" (measured 0–2 of 8; 8/8 inline). One
        CSP style hash, pinned in tests/rendered-html.test.mjs. */}
    <style is:inline>@media (prefers-reduced-motion:no-preference){@view-transition{navigation:auto}}</style>
    <script is:inline>
      try {
        var t = localStorage.getItem('ldd-theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch (_) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? (
      <>
        <meta name="robots" content="max-image-preview:large" />
        <link rel="canonical" href={canonical} />
        {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(path, SITE).href} />
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <meta property="og:type" content={indexable?.article ? 'article' : 'website'} />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLocale]} />
    {indexable && (
      <>
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImageUrl(fullPath)} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(OG_IMAGE.width)} />
        <meta property="og:image:height" content={String(OG_IMAGE.height)} />
        <meta property="og:image:alt" content={indexable.imageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {indexable?.article && (
      <>
        <meta property="article:modified_time" content={indexable.article.modified.toISOString()} />
        <meta property="article:section" content={indexable.article.section} />
      </>
    )}
    {indexable && <script is:inline type="application/ld+json" set:html={serializeJsonLd([organizationNode, ...indexable.structuredData])} />}
    <link rel="preload" href={displayFace} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body id="site-start" tabindex="-1">
    <a class="skip-link" href="#main">{copy.skip}</a>

    <header class="masthead" data-pagefind-ignore>
      <div class="masthead__identity">
        <Wordmark href={`${base}/`} label={copy.home} />
        <a class="course-count" href={`${base}/tracks/`} data-course-progress data-total={lessonTotal} data-template={copy.progress} hidden>
          <span class="star-mark" data-complete="true" aria-hidden="true"></span>
          <span data-count></span>
          <span class="visually-hidden">{copy.progressLabel}</span>
        </a>
      </div>

      <nav class="masthead__nav" aria-label={copy.nav}>
        <a href={`${base}/tracks/`} aria-current={trackSection}>{copy.tracks}</a>
        <a href={`${base}/roadmap/`} aria-current={path === '/roadmap/' ? 'page' : undefined}>{copy.roadmap}</a>
        <a href={`${base}/explore/`} aria-current={path === '/explore/' ? 'page' : undefined}>{copy.anatomy}</a>
        <a class="language language--nav" href={languageHref} hreflang={locale === 'en' ? 'pt-BR' : 'en'} lang={locale === 'en' ? 'pt-BR' : 'en'}>
          <Icon name="language" />
          {/* The visible code is part of the name, so "click PT" works (WCAG 2.5.3). */}
          <span>{locale === 'en' ? 'PT' : 'EN'}</span>
          <span class="visually-hidden">{copy.language}</span>
        </a>
      </nav>

      <div class="masthead__actions">
        <a class="language language--bar" href={languageHref} hreflang={locale === 'en' ? 'pt-BR' : 'en'} lang={locale === 'en' ? 'pt-BR' : 'en'}>
          <Icon name="language" />
          {/* The visible code is part of the name, so "click PT" works (WCAG 2.5.3). */}
          <span>{locale === 'en' ? 'PT' : 'EN'}</span>
          <span class="visually-hidden">{copy.language}</span>
        </a>
        <Search locale={locale} />
        <ThemeToggle locale={locale} />
      </div>
    </header>

    <main id="main" data-page-marker={marker}>
      <slot />
    </main>

    <footer class="colophon" data-pagefind-ignore>
      <div class="colophon__plate">
        <Wordmark href={`${base}/`} label={copy.home} />
        <a class="colophon__top" href="#site-start">{copy.top}<Icon name="up" /></a>
        <nav aria-label={copy.footerNav}>
          <a href={`${base}/tracks/`}>{copy.tracks}</a>
          <a href={`${base}/roadmap/`}>{copy.roadmap}</a>
          <a href={`${base}/explore/`}>{copy.anatomy}</a>
          <a href={languageHref} hreflang={locale === 'en' ? 'pt-BR' : 'en'} lang={locale === 'en' ? 'pt-BR' : 'en'}>{copy.language}</a>
          <a href={REPO}>{copy.license}</a>
        </nav>
      </div>
      <div class="colophon__license">
        <p>{copy.free} MIT · <span data-site-version>v{VERSION}</span></p>
        <p>{copy.footerClose}</p>
      </div>
    </footer>

    <script>import '~/lib/progress-client'</script>

    <style is:global>
      .masthead {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
        display: grid;
        grid-template-columns: minmax(max-content, 1fr) auto minmax(max-content, 1fr);
        align-items: center;
        gap: var(--space-md);
        min-height: var(--header-h);
        padding: .4rem max(clamp(1rem, 3vw, 2.5rem), calc((100vw - var(--shell-max)) / 2));
        background: var(--plate);
        border-bottom: 1px solid var(--rule-strong);
        view-transition-name: masthead;
      }
      .masthead__identity, .masthead__nav, .masthead__actions, .language, .course-count, .colophon__top { display: flex; align-items: center; }
      .masthead__identity { flex-wrap: wrap; gap: 0 .5rem; }
      .masthead__nav { gap: .2rem; }
      .masthead__nav a, .language, .course-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.75rem;
        padding: .35rem clamp(.55rem, 1vw, 1rem);
        color: var(--ink-muted);
        font: var(--weight-semibold) var(--text-sm)/1 var(--font-ui);
        text-decoration: none;
      }
      .masthead__nav a { position: relative; isolation: isolate; }
      .masthead__nav a::before {
        content: '';
        position: absolute;
        z-index: -1;
        inset: .28rem 0;
        border-radius: var(--radius-xs);
        background: var(--plate-raised);
        transform: scaleY(0);
        transform-origin: bottom;
        transition: transform var(--dur-base) var(--ease-out);
      }
      .masthead__nav a:is(:hover,:focus-visible,[aria-current])::before { transform: scaleY(1); }
      .masthead__nav [aria-current]::before { background: var(--ink); view-transition-name: active-section; }
      .masthead__nav a[aria-current] { color: var(--plate); }
      .masthead__nav .language--nav { display: none; }
      .masthead__actions { justify-content: flex-end; gap: .45rem; }
      .language, .course-count { gap: .35rem; padding-inline: .4rem; }
      .course-count { font: var(--weight-semibold) var(--text-xs)/1 var(--font-data); }
      .course-count .star-mark { --mark: var(--success); }

      .colophon { color-scheme: dark; color: var(--ink); background: var(--night); border-top: 4px solid var(--reticle); }
      .colophon__plate, .colophon__license { width: min(calc(100% - clamp(2rem, 8vw, 8rem)), var(--shell-max)); margin-inline: auto; }
      .colophon__plate { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: var(--space-md); padding-block: clamp(2rem, 6vw, 5rem) 1.5rem; }
      .colophon .wordmark { font-size: clamp(2.2rem, 6vw, 6rem); gap: .24em; }
      .colophon .wordmark svg { width: .84em; height: .84em; }
      .colophon__top { gap: .65rem; color: var(--ink); }
      .colophon__top svg { transition: translate var(--dur-base) var(--ease-out); }
      .colophon__top:hover svg { translate: 0 -.25rem; }
      .colophon nav { grid-column: 1/-1; display: flex; flex-wrap: wrap; gap: 0 var(--space-md); }
      .colophon :is(nav a,.colophon__top) { width: fit-content; display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: var(--weight-semibold); text-decoration: none; }
      .colophon :is(nav a,.colophon__top):hover { color: var(--ink); text-decoration: underline; }
      .colophon__license { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .25rem 1rem; border-top: 1px solid var(--rule-strong); padding-block: 1.15rem 2rem; color: var(--ink-muted); font-size: var(--text-xs); }

      @media (max-width: 54rem) {
        .masthead { gap: .4rem; }
      }
      @media (max-width: 50rem) {
        .masthead { position: relative; grid-template-columns: minmax(0, 1fr) auto; padding-block: .25rem 0; }
        .masthead__nav { grid-row: 2; grid-column: 1/-1; flex-wrap: wrap; border-top: 1px solid var(--rule); }
        .masthead__nav .language--nav { display: inline-flex; margin-inline-start: auto; }
        .language--bar { display: none; }
        .masthead__actions { gap: .25rem; }
      }
      @media (max-width: 28rem) {
        .masthead { padding-inline: .65rem; }
        .masthead .wordmark { font-size: 1.05rem; gap: .3em; }
        .course-count { padding: 0; min-height: 1.5rem; }
        .colophon__plate { grid-template-columns: minmax(0, 1fr); gap: .6rem; }
      }
    </style>
  </body>
</html>
